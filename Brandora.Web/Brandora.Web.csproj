    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Brandora.Web-5a51779d-a8cf-4361-9cb8-2cea108c3cd5</UserSecretsId>
