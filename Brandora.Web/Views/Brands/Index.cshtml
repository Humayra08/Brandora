@model Brandora.Web.Models.Brands.BrandListViewModel
@using Brandora.Web.Models.Influencers
@using Brandora.Web.Models.Domain
@{
    ViewData["Title"] = "Browse Brands";
    ViewData["ActiveNav"] = "Chat";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Brandora</title>
    <link rel="icon" href="~/images/brandora-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
    <style>
        /* =========================================================
           PAGE HERO — reproduced from Views/Shared/_AppLayout.cshtml's
           .page-hero system (itself a mirror of the influencer side's
           .dashboard-hero), so Browse Brands matches the brand side's
           Browse Influencers page exactly.
        ========================================================= */
        .brands-page { padding: 12px 20px 24px; }
        .page-hero {
            position: relative;
            isolation: isolate;
            display: flex;
            align-items: center;
            min-height: 170px;
            margin: 0 0 26px;
            padding: 26px 40px;
            border-radius: 18px;
            overflow: hidden;
            background:
                radial-gradient(ellipse at 61% 0%, #a9c9ff99, transparent 58%),
                linear-gradient(110deg, #edf8ff55, #dcefff99 55%, #edf8ff55);
            border: 1px solid #d1e2ff;
        }
        .page-hero-waves { position: absolute; inset: auto 0 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
        .page-hero-intro { position: relative; z-index: 2; max-width: 52%; }
        .page-hero-eyebrow { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: #4b6398; }
        .page-hero-title { margin-top: 6px; font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: clamp(24px, 2.6vw, 34px); line-height: 1.2; letter-spacing: -.5px; color: #171d3d; }
        .page-hero-title span { background: linear-gradient(115deg, #7224ff, #3735ff 55%, #087fff); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
        .page-hero-sub { margin-top: 8px; max-width: 480px; font-family: 'Inter', sans-serif; font-size: 13.5px; line-height: 1.55; color: #426098; }
        .page-hero-stats { display: flex; gap: 26px; margin-top: 14px; }
        .page-hero-stats > div + div { border-left: 1px solid #9ebce9; padding-left: 26px; }
        .page-hero-stats dd { margin: 0; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700; line-height: 1.1; color: #171d3d; }
        .page-hero-stats dt { margin: 2px 0 0; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 500; color: #2b467d; }
        .page-hero-art { position: absolute; z-index: 1; width: 230px; height: 200px; left: 48%; top: 22px; transform: rotate(10deg) skewX(-3deg); }
        .hero-glass { position: absolute; border: 1px solid #ffffffb8; border-radius: 18px; background: linear-gradient(125deg, #ffffff80, #d4ebff35 55%, #ffffff5c); box-shadow: inset 0 0 20px #ffffff44, 0 10px 30px #4488da0b; }
        .hero-glass-back { inset: 0; }
        .hero-glass-front { inset: 22px 18px -18px 16px; padding: 17px 19px; font-family: 'DM Sans', sans-serif; font-size: 15px; line-height: 1.4; color: #244988; backdrop-filter: blur(1px); }
        .hero-glass-copy { display: block; transform: skewX(3deg) rotate(-10deg); transform-origin: top left; padding-top: 3px; }
        .hero-glass-copy > span, .page-hero-motto span { display: block; width: 34px; height: 3px; margin-top: 11px; border-radius: 4px; background: linear-gradient(110deg, #6323ff, #0759ff); }
        .hero-sparkle { position: absolute; top: 20px; right: -6px; width: 16px; height: 16px; background: radial-gradient(ellipse, white, transparent 65%); }
        .hero-sparkle::before, .hero-sparkle::after { content: ""; position: absolute; inset: 7px -4px; background: linear-gradient(90deg, transparent, white, transparent); }
        .hero-sparkle::after { transform: rotate(90deg); }
        .page-hero-motto { margin-left: auto; padding: 4px 4% 4px 32px; position: relative; z-index: 2; border-left: 1px solid #adcdec; font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 600; line-height: 1.5; color: #1e427c; }
        @@media(max-width: 1100px) { .page-hero-art { left: auto; right: 26px; } .page-hero-intro { max-width: 60%; } }
        @@media(max-width: 900px) { .page-hero-motto { display: none; } }
        @@media(max-width: 760px) { .page-hero { padding: 22px 24px; flex-wrap: wrap; } .page-hero-art { display: none; } .page-hero-intro { max-width: 100%; } }

        /* ---- Discovery toolbar (search + filters) ---- */
        .discovery-toolbar { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 9px; padding: 12px; margin-bottom: 24px; border: 1px solid #d1e2ff; border-radius: 20px; background: linear-gradient(120deg, #eef6ffcc, #f7fbffcc); box-shadow: 0 12px 35px rgba(35, 25, 91, .05); }
        .filter-input, .filter-select { height: 42px; border: 1px solid #d1e2ff; border-radius: 14px; background: #fff; color: #2a3157; font: 500 12.5px 'Inter', sans-serif; outline: none; transition: border-color .2s ease, box-shadow .2s ease; }
        .filter-input { flex: 1 1 245px; min-width: 210px; padding: 0 15px; }
        .filter-select { min-width: 145px; padding: 0 12px; }
        .filter-input:focus, .filter-select:focus { border-color: #7ea8ff; box-shadow: 0 0 0 4px rgba(23,108,255,.08); }
        .filter-input:hover, .filter-select:hover { border-color: #a9c9ff; }
        .discovery-toolbar .btn-search { height: 42px; border-radius: 12px; padding: 0 18px; border: 0; color: #fff; font: 700 12.5px 'Inter', sans-serif; cursor: pointer; background: linear-gradient(115deg, #7224ff, #3735ff 55%, #087fff); }

        /* ---- Brand grid + cards (mirrors the brand side's .creator-grid/.creator-card) ---- */
        .brand-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
        .brand-card { --card-accent: #0759ff; position: relative; overflow: hidden; min-width: 0; border: 1px solid #e8e7f2; border-radius: 22px; background: #fff; box-shadow: 0 10px 30px rgba(32, 24, 82, .055); opacity: 0; transform: translateY(28px); transition: opacity .65s ease, transform .65s cubic-bezier(.22,1,.36,1), box-shadow .4s ease, border-color .35s ease; }
        .brand-card.is-visible { opacity: 1; transform: translateY(0); }
        .brand-card:hover { transform: translateY(-8px); border-color: rgba(23,108,255,.28); box-shadow: 0 25px 55px rgba(31, 55, 119, .12), 0 0 0 1px rgba(23,108,255,.04); }
        .brand-media { position: relative; height: 130px; overflow: hidden; }
        .brand-mark { position: absolute; inset: 0; display: grid; place-items: center; color: rgba(255,255,255,.55); font: 700 54px 'Playfair Display', serif; }
        .industry-badge, .verified-badge { position: absolute; z-index: 3; top: 12px; border: 1px solid rgba(255,255,255,.68); background: rgba(255,255,255,.91); box-shadow: 0 8px 22px rgba(20, 20, 60, .10); border-radius: 999px; padding: 7px 10px; font: 700 10px 'Inter', sans-serif; }
        .industry-badge { left: 12px; color: #343a5b; }
        .verified-badge { right: 12px; color: #2d7651; }
        .verified-badge::before { content: ""; display: inline-block; width: 6px; height: 6px; margin-right: 5px; border-radius: 50%; background: #45bd79; box-shadow: 0 0 0 3px rgba(69,189,121,.13); }
        .brand-overlay { position: absolute; left: 14px; right: 14px; bottom: 12px; z-index: 4; display: flex; align-items: center; gap: 10px; color: #fff; }
        .brand-avatar { width: 47px; height: 47px; flex: 0 0 47px; overflow: hidden; border: 3px solid rgba(255,255,255,.92); border-radius: 50%; background: linear-gradient(135deg, #0759ff, #18a9ff); box-shadow: 0 8px 20px rgba(20,20,50,.22); display: grid; place-items: center; color: #fff; font: 700 17px 'DM Sans', sans-serif; }
        .brand-name-row { display: flex; align-items: center; gap: 6px; margin: 0; color: #fff; font: 750 15px 'DM Sans', sans-serif; }
        .brand-contact { margin-top: 2px; color: rgba(255,255,255,.77); font: 500 10px 'Inter', sans-serif; }
        .brand-body { position: relative; z-index: 2; padding: 16px 17px 17px; }
        .brand-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
        .brand-tags .tag { padding: 6px 8px; border: 1px solid #ebe8f7; border-radius: 999px; background: #f6f9ff; color: #656c8c; font: 650 9.5px 'Inter', sans-serif; }
        .brand-figures { display: grid; grid-template-columns: repeat(2, 1fr); gap: 7px; padding: 12px 0; margin-bottom: 14px; border-top: 1px solid #eeeef5; border-bottom: 1px solid #eeeef5; }
        .figure { min-width: 0; padding-right: 8px; border-right: 1px solid #eeeef5; }
        .figure:last-child { border-right: 0; }
        .figure-value { color: #171d3d; font: 800 16px 'DM Sans', sans-serif; }
        .figure-label { margin-top: 2px; color: #969bb3; font: 650 8.5px 'Inter', sans-serif; letter-spacing: .05em; text-transform: uppercase; }
        .brand-actions { display: flex; gap: 8px; }
        .brand-actions .btn-outline, .brand-actions .btn-gradient { flex: 1; display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 39px; border-radius: 11px; font: 700 11px 'Inter', sans-serif; cursor: pointer; text-decoration: none; transition: transform .2s ease; }
        .brand-actions .btn-outline:hover, .brand-actions .btn-gradient:hover { transform: translateY(-2px); }
        .brand-actions .btn-outline { border: 1px solid #e3e1ed; color: #444b6b; background: #fff; }
        .brand-actions .btn-outline:hover { border-color: #9dc2ff; color: #0759ff; }
        .brand-actions .btn-gradient { border: 0; color: #fff; background: linear-gradient(110deg, #0759ff, #18a9ff); box-shadow: 0 8px 20px rgba(23,108,255,.18); }
        .brand-actions form { margin: 0; flex: 1; }
        .empty-block { padding: 40px 24px; text-align: center; border-radius: 22px; border: 1px solid #e9e7f3; background: #fff; box-shadow: 0 12px 35px rgba(35,25,91,.05); }
        .empty-title { font: 700 18px 'Playfair Display', serif; color: #171d3d; margin-bottom: 8px; }
        .empty-text { color: #6475a2; font-size: 13px; }

        @@media (max-width: 1180px) { .brand-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @@media (max-width: 650px) {
            .brand-grid { grid-template-columns: 1fr; }
            .discovery-toolbar { align-items: stretch; }
            .filter-input, .filter-select, .discovery-toolbar .btn-search { width: 100%; flex-basis: 100%; }
        }
        @@media (prefers-reduced-motion: reduce) { .brand-card, .brand-card.is-visible { opacity: 1; transform: none; } }
    </style>
</head>
<body>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
@await Html.PartialAsync("_InfluencerSidebar")
<main class="dashboard-page brands-page" id="dashboardMain">
    <header class="dashboard-topbar">
        <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
        <form class="dashboard-search" method="get" action="/Brands" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="search" value="@Model.Search" placeholder="Search brands by company name..." aria-label="Search brands" />
            <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
        </form>
        <details class="dashboard-notifications">
            <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
            <div class="dashboard-notification-panel">
                <div class="dashboard-notification-panel-head">
                    <h2>Notifications</h2>
                    @if (Model.Notifications.Count > 0)
                    {
                        <form method="post" asp-controller="Notifications" asp-action="ClearAll">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <button type="submit" class="dashboard-notification-clear">Clear</button>
                        </form>
                    }
                </div>
                @foreach (var notification in Model.Notifications)
                {
                    <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                }
                @if (Model.Notifications.Count == 0) { <p>No notifications yet.</p> }
            </div>
        </details>
        <a class="dashboard-account" href="/InfluencerSettings">
            <span class="dashboard-avatar">@if (!string.IsNullOrEmpty(ViewData["ProfilePictureUrl"] as string)) { <img src="@ViewData["ProfilePictureUrl"]" alt="" /> } else { @FollowerFormat.InitialsOf(Model.InfluencerName) }</span>
            <span><strong>@Model.InfluencerName</strong><small>Influencer</small></span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </a>
    </header>

    <a href="/InfluencerMessages" class="back-to-dashboard" style="display:inline-flex;align-items:center;gap:7px;margin-bottom:14px;color:#70789a;font:600 12px 'Inter',sans-serif;text-decoration:none;">
        <i class="bi bi-chevron-left" aria-hidden="true"></i> Back to Chat
    </a>

    <section class="page-hero">
        @await Html.PartialAsync("_HeroWaves")
        <div class="page-hero-intro">
            <p class="page-hero-eyebrow">Brandora Brand Network</p>
            <h1 class="page-hero-title">Browse <span>Brands</span></h1>
            <p class="page-hero-sub">Find brands whose campaigns fit your niche, and start a conversation.</p>
            <dl class="page-hero-stats">
                <div><dd>@Model.TotalCount</dd><dt>Brands</dt></div>
                <div><dd>@Model.VerifiedCount</dd><dt>Verified</dt></div>
                <div><dd>@Model.IndustryCount</dd><dt>Industries</dt></div>
            </dl>
        </div>
        <div class="page-hero-art" aria-hidden="true">
            <div class="hero-glass hero-glass-back"></div>
            <div class="hero-glass hero-glass-front"><span class="hero-glass-copy">Explore<br />Evaluate<br />Connect<span></span></span></div>
            <span class="hero-sparkle"></span>
        </div>
        <div class="page-hero-motto">Real Brands.<br />Real Opportunities.<span></span></div>
    </section>

    <form method="get" action="/Brands" class="discovery-toolbar">
        <input type="text" name="search" class="filter-input" placeholder="Search by company name..." value="@Model.Search" />
        <select name="industry" class="filter-select" onchange="this.form.submit()">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Industry))">All industries</option>
            @foreach (var industry in new[] { "Fashion & Apparel", "Beauty & Cosmetics", "Food & Beverage", "Technology", "Health & Fitness", "Travel & Tourism", "Finance", "Education", "Home & Lifestyle", "Other" })
            {
                <option value="@industry" selected="@(Model.Industry == industry)">@industry</option>
            }
        </select>
        <button type="submit" class="btn-search">Search</button>
    </form>

    @if (Model.Brands.Count > 0)
    {
        <div class="brand-grid">
            @foreach (var brand in Model.Brands)
            {
                var hue = (brand.Id * 47) % 360;
                var hue2 = (hue + 48) % 360;
                var initial = string.IsNullOrEmpty(brand.CompanyName) ? "?" : brand.CompanyName[..1].ToUpperInvariant();
                <article class="brand-card" data-reveal style="--card-accent: hsl(@(hue)deg 85% 58%);">
                    <div class="brand-media" style="background: linear-gradient(135deg, hsl(@(hue)deg 85% 62%), hsl(@(hue2)deg 85% 58%));">
                        <div class="brand-mark" aria-hidden="true">@initial</div>
                        <div class="industry-badge">@brand.Industry</div>
                        @if (brand.VerificationStatus == VerificationStatus.Verified)
                        {
                            <div class="verified-badge">Verified</div>
                        }
                        <div class="brand-overlay">
                            <div class="brand-avatar" style="background: linear-gradient(135deg, hsl(@(hue)deg 80% 55%), hsl(@(hue2)deg 80% 50%));">@initial</div>
                            <div>
                                <h2 class="brand-name-row">@brand.CompanyName</h2>
                                <div class="brand-contact">@brand.ContactFullName</div>
                            </div>
                        </div>
                    </div>
                    <div class="brand-body">
                        <div class="brand-tags">
                            <span class="tag">@brand.Industry</span>
                            <span class="tag">@brand.MonthlyBudget</span>
                        </div>
                        <div class="brand-figures">
                            <div class="figure"><div class="figure-value">@Model.ActiveCampaignsFor(brand.Id)</div><div class="figure-label">Active Campaigns</div></div>
                            <div class="figure"><div class="figure-value">@brand.CreatedAt.ToString("MMM yyyy")</div><div class="figure-label">Member Since</div></div>
                        </div>
                        <div class="brand-actions">
                            @if (!string.IsNullOrEmpty(brand.WebsiteUrl))
                            {
                                <a href="@brand.WebsiteUrl" target="_blank" rel="noopener noreferrer" class="btn-outline">Website</a>
                            }
                            <form method="post" action="/InfluencerMessages/StartWithBrand">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="brandId" value="@brand.Id" />
                                <button type="submit" class="btn-gradient">Message</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else if (Model.TotalCount == 0)
    {
        <div class="empty-block">
            <div class="empty-title">No brands yet</div>
            <p class="empty-text">Once brands join Brandora, they'll appear here for you to discover and message.</p>
        </div>
    }
    else
    {
        <div class="empty-block">
            <div class="empty-title">No brands match these filters</div>
            <p class="empty-text">Try a different search term or clear your filters.</p>
            <a href="/Brands" class="btn-outline" style="margin-top:16px;display:inline-flex;">Clear Filters</a>
        </div>
    }
</main>
<script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>
<script>
    (function () {
        var cards = document.querySelectorAll('.brand-card[data-reveal]');
        if (!cards.length) return;
        if (!('IntersectionObserver' in window)) {
            cards.forEach(function (c) { c.classList.add('is-visible'); });
            return;
        }
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        cards.forEach(function (card, index) {
            card.style.transitionDelay = Math.min(index % 12, 8) * 45 + 'ms';
            observer.observe(card);
        });
    })();
</script>
</body>
</html>
