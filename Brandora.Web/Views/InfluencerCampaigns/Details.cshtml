@model Brandora.Web.Models.Dashboard.InfluencerCampaignDetailsViewModel
@using Brandora.Web.Models.Domain
@using Brandora.Web.Models.Influencers
@using System.Globalization
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveNav"] = "Campaigns";
    Layout = null;
    var name = Model.Profile.FullName;
    string Money(decimal amount) => "৳" + amount.ToString("N0", CultureInfo.InvariantCulture);
    var milestoneDates = Model.Milestones.Where(m => m.DueDate.HasValue).Select(m => m.DueDate!.Value).OrderBy(d => d).ToList();
    var safeWebsite = Uri.TryCreate(Model.BrandWebsiteUrl, UriKind.Absolute, out var website) && (website.Scheme == "https" || website.Scheme == "http");
    var closed = Model.Status is CampaignStatus.Completed or CampaignStatus.Cancelled || Model.Deadline < DateTime.UtcNow;
    var statusLabel = Model.IsCollabCompleted ? "Completed" : Model.IsCollaborating ? "In Progress" : Model.MyProposalStatus == ProposalStatus.Pending ? "In Review" : Model.MyProposalStatus == ProposalStatus.Accepted ? "Accepted" : Model.MyProposalStatus.HasValue ? "Not Selected" : closed ? "Closed" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title - Brandora</title>
    <link rel="icon" href="~/images/brandora-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-campaigns.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-campaign-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-campaign-details-reference.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    @await Html.PartialAsync("_InfluencerSidebar")
    <main class="dashboard-page campaigns-page campaign-details-page campaign-detail-reference" id="dashboardMain">
        <header class="dashboard-topbar">
            <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
            <form class="dashboard-search" method="get" asp-controller="InfluencerCampaigns" asp-action="Index" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="search" placeholder="Search campaigns, brands..." aria-label="Search campaigns and brands" />
                <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>
            <details class="dashboard-notifications">
                <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
                <div class="dashboard-notification-panel">
                    <div class="dashboard-notification-panel-head">
                        <h2>Notifications</h2>
                        @if (Model.Notifications.Count > 0)
                        {
                            <form method="post" asp-controller="Notifications" asp-action="ClearAll">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="dashboard-notification-clear">Clear</button>
                            </form>
                        }
                    </div>
                    @foreach (var notification in Model.Notifications)
                    {
                        <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                    }
                    @if (Model.Notifications.Count == 0) { <p>No notifications yet.</p> }
                </div>
            </details>
            <a class="dashboard-account" href="/InfluencerSettings">
                <span class="dashboard-avatar">@FollowerFormat.InitialsOf(name)</span>
                <span><strong>@name</strong><small>Influencer</small></span>
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </a>
        </header>

        <section class="detail-banner" aria-labelledby="campaign-heading">
            <nav class="campaign-crumb" aria-label="Breadcrumb"><a asp-controller="InfluencerCampaigns" asp-action="Index">Campaigns</a><i class="bi bi-chevron-right" aria-hidden="true"></i><strong>Campaign Details</strong></nav>
            <div class="detail-hero">
                <div class="detail-brand">
                    <div class="detail-logo">
                        @if (!string.IsNullOrWhiteSpace(Model.BrandLogoUrl)) { <img src="@Model.BrandLogoUrl" alt="@Model.BrandName logo" /> }
                        else { <span>@FollowerFormat.InitialsOf(Model.BrandName)</span> }
                    </div>
                    <strong>@Model.BrandName</strong>
                    @if (Model.BrandVerified) { <span class="detail-verified"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Verified Brand</span> }
                </div>
                <div class="detail-hero-copy">
                    <div class="detail-tags">@if (!string.IsNullOrWhiteSpace(Model.Niche)) { <span>@Model.Niche</span> } @if (!string.IsNullOrWhiteSpace(Model.Platform)) { <span>@Model.Platform</span> }</div>
                    <h1 id="campaign-heading">@Model.Title</h1>
                    <p>@Model.Description</p>
                    <dl class="detail-stats"><div><dt>Budget</dt><dd>@Money(Model.Budget)</dd></div><div><dt>Applications</dt><dd>@Model.ApplicantCount</dd></div><div><dt>Milestones</dt><dd>@Model.Milestones.Count</dd></div><div><dt>Deadline</dt><dd>@(Model.Deadline?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Not set")</dd></div></dl>
                </div>
                <div class="detail-motto">Real Brands.<br />Real Opportunities.<span></span></div>
            </div>
        </section>

        <div class="campaign-details-grid">
            <div class="campaign-details-main">
                <nav class="campaign-tabs" role="tablist" aria-label="Campaign information">
                    <button type="button" class="is-active" data-tab="overview" role="tab" aria-selected="true">Overview</button>
                    <button type="button" data-tab="milestones" role="tab" aria-selected="false">Milestones</button>
                    <button type="button" data-tab="brand" role="tab" aria-selected="false">Brand Info</button>
                    <button type="button" data-tab="guidelines" role="tab" aria-selected="false">Guidelines</button>
                    <button type="button" data-tab="faqs" role="tab" aria-selected="false">FAQs</button>
                </nav>

                <section class="campaign-tab-panel dashboard-card" data-panel="overview">
                    <h2>Campaign Overview</h2>
                    <p class="campaign-full-description">@Model.Description</p>

                    @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
                    {
                        <div class="detail-section">
                            @await Html.PartialAsync("_CampaignReel", new Brandora.Web.Models.Campaigns.CampaignReelModel(Model.VideoUrl, Model.BannerUrl, Model.BrandName, true))
                        </div>
                    }

                    <div class="detail-section">
                        <h2>Milestones &amp; Deliverables</h2>
                        @await Html.PartialAsync("_DetailsMilestones", Model)
                    </div>
                    <div class="detail-section">
                        <h2>Timeline</h2>
                        <ol class="detail-timeline">
                            <li><span></span><strong>Campaign Posted</strong><time>@Model.CreatedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</time></li>
                            <li><span></span><strong>Application Deadline</strong><time>@(Model.Deadline?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Not set")</time></li>
                            <li><span></span><strong>Milestone Due Dates</strong><time>@(milestoneDates.Count > 0 ? $"{milestoneDates.First():MMM d} - {milestoneDates.Last():MMM d, yyyy}" : "Not scheduled")</time></li>
                            <li><span></span><strong>Review &amp; Payment</strong><time>@(Model.IsCollabCompleted ? "Completed" : "Per agreed milestones")</time></li>
                        </ol>
                    </div>
                </section>
                <section class="campaign-tab-panel dashboard-card" data-panel="milestones" hidden>
                    <h2>Milestones &amp; Deliverables</h2>
                    <p class="detail-help">Milestones assigned to your collaboration with this brand.</p>
                    @await Html.PartialAsync("_DetailsMilestones", Model)
                </section>

                <section class="campaign-tab-panel dashboard-card" data-panel="brand" hidden>
                    <h2>Brand Info</h2>
                    <dl class="campaign-fact-list">
                        <div><dt>Company</dt><dd>@Model.BrandName</dd></div>
                        <div><dt>Industry</dt><dd>@(string.IsNullOrWhiteSpace(Model.BrandIndustry) ? "Not specified" : Model.BrandIndustry)</dd></div>
                        @if (safeWebsite)
                        {
                            <div><dt>Website</dt><dd><a href="@Model.BrandWebsiteUrl" target="_blank" rel="noopener">@Model.BrandWebsiteUrl</a></dd></div>
                        }
                    </dl>
                </section>

                <section class="campaign-tab-panel dashboard-card" data-panel="guidelines" hidden>
                    <h2>Submission Guidelines</h2>
                    <ul class="campaign-list">
                        <li>Make sure your content matches the brand's tone and the platform requested for this campaign.</li>
                        <li>Clearly describe your planned deliverables and timeline when you submit your proposal.</li>
                        <li>Keep communication with the brand professional and responsive once a proposal is accepted.</li>
                        <li>Submit proof of your published content through Upload Proof for review and payment.</li>
                    </ul>
                </section>

                <section class="campaign-tab-panel dashboard-card" data-panel="faqs" hidden>
                    <h2>Frequently Asked Questions</h2>
                    <div class="campaign-faq">
                        <h3>How do I apply to this campaign?</h3>
                        <p>Select Apply Now, describe your idea, add your social accounts, and review your application before submitting.</p>
                    </div>
                    <div class="campaign-faq">
                        <h3>When will I hear back?</h3>
                        <p>The brand reviews proposals directly. You can track your proposal status from My Proposals.</p>
                    </div>
                    <div class="campaign-faq">
                        <h3>When do I get paid?</h3>
                        <p>Payments follow the milestones the brand sets once your proposal is accepted.</p>
                    </div>
                </section>
            </div>

            <aside class="campaign-details-side">
                <div class="dashboard-card campaign-apply-card">
                    <h2>Apply for Campaign</h2>
                    <p>Showcase your creativity and be part of this campaign.</p>
                    @if (Model.CanApply)
                    {
                        <a class="campaign-apply-btn" asp-controller="InfluencerCampaigns" asp-action="Apply" asp-route-id="@Model.CampaignId">Apply Now <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        @if (Model.Deadline.HasValue)
                        {
                            <small>You can apply until @Model.Deadline.Value.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</small>
                        }
                    }
                    else
                    {
                        <span class="campaigns-status campaign-apply-status">@(statusLabel ?? "Not accepting proposals")</span>
                        @if (Model.MyProposalId.HasValue) { <a class="detail-proposal-link" asp-controller="InfluencerProposals" asp-action="Detail" asp-route-id="@Model.MyProposalId">View My Proposal <i class="bi bi-arrow-right" aria-hidden="true"></i></a> }
                    }
                </div>

                <div class="dashboard-card campaign-facts-card">
                    <h2>Campaign Details</h2>
                    <dl class="campaign-fact-list">
                        <div><dt>Category</dt><dd>@(Model.Niche ?? "Not specified")</dd></div>
                        <div><dt>Platform</dt><dd>@(Model.Platform ?? "Not specified")</dd></div>
                        <div><dt>Content Type</dt><dd>Not specified</dd></div>
                        <div><dt>Posted</dt><dd>@Model.CreatedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</dd></div>
                        <div><dt>Deadline</dt><dd>@(Model.Deadline?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Not set")</dd></div>
                        <div><dt>Target Audience</dt><dd>Not specified</dd></div>
                        <div><dt>Language</dt><dd>Not specified</dd></div>
                    </dl>
                </div>

                <div class="dashboard-card campaign-support-card">
                    <i class="bi bi-lightbulb" aria-hidden="true"></i>
                    <div>
                        <h6>Have Questions?</h6>
                        <p>Feel free to reach out to our team for any clarification regarding this campaign.</p>
                        <a asp-controller="Home" asp-action="Contact">Contact Support <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
            </aside>
        </div>

    </main>
    <script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>
    <script src="~/js/brandora-campaign-details.js" asp-append-version="true"></script>
</body>
</html>
