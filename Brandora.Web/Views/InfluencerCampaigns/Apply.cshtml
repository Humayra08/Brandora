@model Brandora.Web.Models.Dashboard.CampaignApplyViewModel
@using Brandora.Web.Models.Influencers
@{
    ViewData["Title"] = "Apply - " + Model.Title;
    ViewData["ActiveNav"] = "Campaigns";
    Layout = null;
    var name = Model.Profile.FullName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Apply - @Model.Title - Brandora</title>
    <link rel="icon" href="~/images/brandora-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-campaigns.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-campaign-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-campaign-details-reference.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-campaign-apply.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    @await Html.PartialAsync("_InfluencerSidebar")
    <main class="dashboard-page campaigns-page campaign-details-page campaign-detail-reference campaign-apply-page" id="dashboardMain">
        <header class="dashboard-topbar">
            <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
            <form class="dashboard-search" method="get" asp-controller="InfluencerCampaigns" asp-action="Index" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="search" placeholder="Search campaigns, brands..." aria-label="Search campaigns and brands" />
                <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>
            <details class="dashboard-notifications">
                <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
                <div class="dashboard-notification-panel">
                    <div class="dashboard-notification-panel-head">
                        <h2>Notifications</h2>
                        @if (Model.Notifications.Count > 0)
                        {
                            <form method="post" asp-controller="Notifications" asp-action="ClearAll">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="dashboard-notification-clear">Clear</button>
                            </form>
                        }
                    </div>
                    @foreach (var notification in Model.Notifications)
                    {
                        <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                    }
                    @if (Model.Notifications.Count == 0) { <p>No notifications yet.</p> }
                </div>
            </details>
            <a class="dashboard-account" href="/InfluencerSettings">
                <span class="dashboard-avatar">@if (!string.IsNullOrEmpty(ViewData["ProfilePictureUrl"] as string)) { <img src="@ViewData["ProfilePictureUrl"]" alt="" /> } else { @FollowerFormat.InitialsOf(name) }</span>
                <span><strong>@name</strong><small>Influencer</small></span>
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </a>
        </header>

        @await Html.PartialAsync("~/Views/InfluencerCampaigns/_ApplyHero.cshtml", Model)

        <div class="apply-grid">
            <div class="apply-stepper-col">
                @await Html.PartialAsync("~/Views/InfluencerCampaigns/_ApplyStepper.cshtml", Model.Step)
            </div>

            <div class="apply-main-col">
                <form method="post" asp-action="Apply" class="dashboard-card apply-form">
                    <input type="hidden" name="CampaignId" value="@Model.CampaignId" />
                    <h2>Your Proposal</h2>
                    <p class="apply-form-intro">Tell the brand why you're the perfect fit and how you plan to create amazing content.</p>

                    <label class="apply-field">
                        <span>Your Concept / Idea <em>*</em></span>
                        <textarea name="Concept" id="concept-field" maxlength="1000" rows="4" placeholder="Share your creative idea for this campaign...">@Model.Concept</textarea>
                        <small><span id="concept-count">@Model.Concept.Length</span>/1000</small>
                    </label>
                    @if (ViewData.ModelState["Concept"]?.Errors.Count > 0)
                    {
                        <p class="apply-field-error">@ViewData.ModelState["Concept"]!.Errors[0].ErrorMessage</p>
                    }

                    <label class="apply-field">
                        <span>Why Are You a Good Fit? <em>*</em></span>
                        <textarea name="WhyGoodFit" id="whyfit-field" maxlength="500" rows="4" placeholder="Explain why your content and audience align with the brand...">@Model.WhyGoodFit</textarea>
                        <small><span id="whyfit-count">@Model.WhyGoodFit.Length</span>/500</small>
                    </label>
                    @if (ViewData.ModelState["WhyGoodFit"]?.Errors.Count > 0)
                    {
                        <p class="apply-field-error">@ViewData.ModelState["WhyGoodFit"]!.Errors[0].ErrorMessage</p>
                    }

                    <div class="apply-field">
                        <span>Sample Work (Optional)</span>
                        <p class="apply-field-hint">Add links to your previous relevant content (Instagram, TikTok, YouTube, etc.)</p>
                        <label class="apply-link-input"><i class="bi bi-instagram" aria-hidden="true"></i><input type="text" name="InstagramLink" value="@Model.InstagramLink" placeholder="https://instagram.com/your-reel" /></label>
                        <label class="apply-link-input"><i class="bi bi-tiktok" aria-hidden="true"></i><input type="text" name="TikTokLink" value="@Model.TikTokLink" placeholder="https://tiktok.com/@@your-video" /></label>
                        <label class="apply-link-input"><i class="bi bi-youtube" aria-hidden="true"></i><input type="text" name="YouTubeLink" value="@Model.YouTubeLink" placeholder="https://youtube.com/your-video" /></label>
                    </div>

                    <div class="apply-form-actions">
                        <a class="apply-btn-secondary" href="@Url.Action("Details", new { id = Model.CampaignId })">Back</a>
                        <button type="submit" class="apply-btn-primary">Next Step <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                    </div>
                </form>
            </div>

            <div class="apply-side-col">
                @await Html.PartialAsync("~/Views/InfluencerCampaigns/_ApplyCampaignSummary.cshtml", Model)

                <div class="dashboard-card apply-tips-card">
                    <div class="apply-tips-head"><i class="bi bi-lightbulb" aria-hidden="true"></i><h2>Tips for a Strong Proposal</h2></div>
                    <ul>
                        <li>Be authentic and showcase your unique style</li>
                        <li>Explain how your content aligns with the brand</li>
                        <li>Share relevant past work examples</li>
                        <li>Highlight your audience and engagement</li>
                        <li>Be clear and concise</li>
                    </ul>
                </div>

                <div class="dashboard-card apply-motivate-card">
                    <h6>Create. Collaborate. Get Rewarded.</h6>
                    <p>Turn your creativity into real opportunities with Brandora.</p>
                    <span class="apply-motivate-accent"></span>
                </div>
            </div>
        </div>
    </main>
    <script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>
    <script src="~/js/brandora-campaign-apply.js" asp-append-version="true"></script>
</body>
</html>
