@model Brandora.Web.Models.Dashboard.InfluencerCampaignsViewModel
@using Brandora.Web.Models.Domain
@using Brandora.Web.Models.Influencers
@using System.Globalization
@{
    ViewData["Title"] = "Campaigns";
    ViewData["ActiveNav"] = "Campaigns";
    Layout = null;
    var name = Model.Profile.FullName;
    var tabs = new[] { ("all", "All Campaigns"), ("open", "Open"), ("ongoing", "In Progress"), ("completed", "Completed"), ("closed", "Closed") };
    string PageUrl(string tab, int page = 1) => Url.Action("Index", new { tab, page, search = Model.Search, category = Model.Category, platform = Model.Platform, sort = Model.Sort, budget = Model.Budget })!;
    string Money(decimal amount) => "\u09F3" + amount.ToString("N0", CultureInfo.InvariantCulture);
    string Posted(DateTime date)
    {
        var days = Math.Max(0, (int)(DateTime.UtcNow - date).TotalDays);
        return days == 0 ? "today" : days == 1 ? "1 day ago" : days < 7 ? $"{days} days ago" : date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    }
    bool SafeImage(string? url) => !string.IsNullOrWhiteSpace(url) && ((url.StartsWith("/") && !url.StartsWith("//") && !url.Contains('\\')) || (Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Scheme == "https"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Campaigns - Brandora</title>
    <link rel="icon" href="~/images/brandora-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-campaigns.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    @await Html.PartialAsync("_InfluencerSidebar")
    <main class="dashboard-page campaigns-page" id="dashboardMain">
        <header class="dashboard-topbar">
            <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
            <form class="dashboard-search" method="get" asp-controller="InfluencerCampaigns" asp-action="Index" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="search" placeholder="Search campaigns, brands, categories..." aria-label="Search campaigns and brands" />
                <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>
            <details class="dashboard-notifications">
                <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
                <div class="dashboard-notification-panel">
                    <h2>Notifications</h2>
                    @foreach (var notification in Model.Notifications)
                    {
                        <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                    }
                    @if (Model.Notifications.Count == 0) { <p>No notifications yet.</p> }
                </div>
            </details>
            <a class="dashboard-account" href="/InfluencerSettings">
                <span class="dashboard-avatar">@FollowerFormat.InitialsOf(name)</span>
                <span><strong>@name</strong><small>Influencer</small></span>
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </a>
        </header>
        <section class="dashboard-hero" aria-labelledby="campaigns-heading">
            @await Html.PartialAsync("~/Views/InfluencerDashboard/_Waves.cshtml", "hero")
            <div class="dashboard-introduction">
                <p class="campaigns-eyebrow">CAMPAIGNS</p>
                <h1 id="campaigns-heading">Discover Campaigns<br />That Match Your Style</h1>
                <p class="campaigns-intro">Collaborate with amazing brands and turn your creativity into real opportunities.</p>
                <span class="campaigns-accent"></span>
            </div>
            <div class="dashboard-hero-art" aria-hidden="true">
                <div class="dashboard-glass dashboard-glass-back"></div>
                <div class="dashboard-glass dashboard-glass-front">
                    <div class="dashboard-glass-copy">Create<br />Collaborate<br />Get Rewarded<span></span></div>
                </div>
                <span class="dashboard-sparkle"></span>
            </div>
            <div class="dashboard-hero-motto">Real Brands.<br />Real Opportunities.<span></span></div>
        </section>

        <div class="campaigns-toolbar">
            <nav class="campaigns-tabs" aria-label="Campaign status">
                @foreach (var tab in tabs)
                {
                    <a href="@PageUrl(tab.Item1)" class="@(Model.Tab == tab.Item1 ? "is-active" : "")" aria-current="@(Model.Tab == tab.Item1 ? "page" : null)">@tab.Item2</a>
                }
            </nav>
            <form method="get" class="campaigns-filters">
                <input type="hidden" name="tab" value="@Model.Tab" />
                @if (!string.IsNullOrWhiteSpace(Model.Budget))
                {
                    <input type="hidden" name="budget" value="@Model.Budget" />
                }
                <label class="campaigns-search">
                    <button type="submit" aria-label="Search campaigns"><i class="bi bi-search" aria-hidden="true"></i></button>
                    <input type="search" name="search" value="@Model.Search" placeholder="Search campaigns..." aria-label="Search campaigns" />
                </label>
                <select name="category" aria-label="Category">
                    <option value="">Category</option>
                    @foreach (var category in Model.CategoryOptions)
                    {
                        <option value="@category" selected="@(category == Model.Category)">@category</option>
                    }
                </select>
                <select name="platform" aria-label="Platform">
                    <option value="">Platform</option>
                    @foreach (var platform in Model.PlatformOptions)
                    {
                        <option value="@platform" selected="@(platform == Model.Platform)">@platform</option>
                    }
                </select>
                <select name="sort" aria-label="Sort by">
                    <option value="">Sort By</option>
                    <option value="budget" selected="@(Model.Sort == "budget")">Highest budget</option>
                    <option value="deadline" selected="@(Model.Sort == "deadline")">Deadline</option>
                </select>
                <noscript><button type="submit">Apply filters</button></noscript>
            </form>
        </div>

        <section class="campaigns-list" aria-label="Campaigns">
            @foreach (var campaign in Model.Campaigns)
            {
                var closed = campaign.Status is CampaignStatus.Completed or CampaignStatus.Cancelled || campaign.Deadline < DateTime.UtcNow;
                var status = campaign.IsCollabCompleted ? "Completed" : campaign.IsCollaborating ? "In Progress" : campaign.MyProposalStatus == ProposalStatus.Pending ? "In Review" : campaign.MyProposalStatus == ProposalStatus.Accepted ? "Accepted" : campaign.MyProposalStatus.HasValue ? "Not Selected" : closed ? "Closed" : null;
                <article class="campaigns-row dashboard-card">
                    <div class="campaigns-summary">
                        <div class="campaigns-image">
                            <span>@FollowerFormat.InitialsOf(campaign.BrandName)</span>
                            @if (SafeImage(campaign.MediaUrl))
                            {
                                <img src="@campaign.MediaUrl" alt="@campaign.BrandName campaign" loading="lazy" />
                            }
                        </div>
                        <div class="campaigns-copy">
                            <h2>@campaign.Title</h2>
                            <p class="campaigns-meta"><strong>@campaign.BrandName</strong>@if (!string.IsNullOrWhiteSpace(campaign.Niche)) { <span>@campaign.Niche</span> }<span>Posted @Posted(campaign.CreatedAt)</span></p>
                            <p class="campaigns-description">@campaign.Description</p>
                            <div class="campaigns-tags">
                                @if (!string.IsNullOrWhiteSpace(campaign.Platform)) { <span>@campaign.Platform</span> }
                                @if (!string.IsNullOrWhiteSpace(campaign.Niche)) { <span>@campaign.Niche</span> }
                            </div>
                        </div>
                    </div>
                    <dl class="campaigns-facts">
                        <div><dt>Budget</dt><dd>@Money(campaign.Budget)</dd></div>
                        <div><dt>Milestones</dt><dd>@(campaign.MilestoneCount?.ToString() ?? "Not set")</dd></div>
                        <div><dt>Deadline</dt><dd>@(campaign.Deadline?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Not set")</dd></div>
                    </dl>
                    <div class="campaigns-actions">
                        <button type="button" data-dialog="details-@campaign.CampaignId">View Details</button>
                        @if (status is not null)
                        {
                            <span class="campaigns-status">@status</span>
                        }
                        else
                        {
                            <button type="button" class="campaigns-apply" data-dialog="apply-@campaign.CampaignId">Apply</button>
                        }
                        <small>@campaign.ApplicantCount applied</small>
                    </div>
                    <dialog id="details-@campaign.CampaignId" aria-labelledby="details-title-@campaign.CampaignId">
                        <form method="dialog"><button class="campaigns-close" aria-label="Close details">×</button></form>
                        <h2 id="details-title-@campaign.CampaignId">@campaign.Title</h2>
                        <p>@campaign.BrandName</p>
                        <p class="campaigns-full-description">@campaign.Description</p>
                        <p>Budget: @Money(campaign.Budget)</p>
                        <p>Deadline: @(campaign.Deadline?.ToString("MMM d, yyyy") ?? "Not set")</p>
                    </dialog>
                    @if (status is null)
                    {
                        <dialog id="apply-@campaign.CampaignId" aria-labelledby="apply-title-@campaign.CampaignId">
                            <form method="dialog"><button class="campaigns-close" aria-label="Close application">×</button></form>
                            <h2 id="apply-title-@campaign.CampaignId">Apply to @campaign.Title</h2>
                            <p>Send your proposal to the brand for review.</p>
                            <form method="post" asp-action="Apply" class="campaigns-application">
                                <input type="hidden" name="campaignId" value="@campaign.CampaignId" />
                                <label>Proposed amount (&#2547;)<input type="number" name="proposedAmount" min="1" step="0.01" value="@campaign.Budget.ToString(CultureInfo.InvariantCulture)" required /></label>
                                <label>Deliverables<textarea name="deliverables" rows="3" required></textarea></label>
                                <label>Message to brand (optional)<textarea name="message" rows="3"></textarea></label>
                                <button type="submit" class="campaigns-apply">Send Proposal</button>
                            </form>
                        </dialog>
                    }
                </article>
            }
            @if (Model.Campaigns.Count == 0)
            {
                <div class="campaigns-empty dashboard-card"><i class="bi bi-inboxes" aria-hidden="true"></i><h2>No campaigns found</h2><p>Try changing your search or filters.</p><a href="@Url.Action("Index")">Clear filters</a></div>
            }
        </section>

        <footer class="campaigns-pagination">
            <p>Showing @(Model.TotalFilteredCount == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + 1)–@Math.Min(Model.PageNumber * Model.PageSize, Model.TotalFilteredCount) of @Model.TotalFilteredCount campaigns</p>
            <nav aria-label="Campaign pages">
                @if (Model.PageNumber > 1) { <a href="@PageUrl(Model.Tab, Model.PageNumber - 1)" aria-label="Previous page">‹</a> }
                @for (var page = Math.Max(1, Model.PageNumber - 2); page <= Math.Min(Model.TotalPages, Model.PageNumber + 2); page++)
                {
                    <a href="@PageUrl(Model.Tab, page)" class="@(page == Model.PageNumber ? "is-active" : "")" aria-current="@(page == Model.PageNumber ? "page" : null)">@(page)</a>
                }
                @if (Model.PageNumber < Model.TotalPages) { <a href="@PageUrl(Model.Tab, Model.PageNumber + 1)" aria-label="Next page">›</a> }
            </nav>
        </footer>
    </main>
    <script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>
    <script src="~/js/brandora-influencer-campaigns.js" asp-append-version="true"></script>
</body>
</html>