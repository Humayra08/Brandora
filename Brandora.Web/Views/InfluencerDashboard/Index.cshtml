@model Brandora.Web.Models.Dashboard.InfluencerDashboardViewModel
@using Brandora.Web.Models.Domain
@using Brandora.Web.Models.Influencers
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
    Layout = null;

    var name = Model.Profile.FullName.Trim();
    var nameParts = name.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
    var firstName = nameParts.FirstOrDefault() ?? "Your profile";
    var remainingName = nameParts.Length > 1 ? nameParts[1] : "";
    var chartMaximum = Model.EarningsSeries.Select(p => p.Amount).DefaultIfEmpty().Max();
    var chartScale = chartMaximum > 0 ? Math.Ceiling(chartMaximum / 4m) * 4m : 1000m;
    string Money(decimal value) => "৳" + value.ToString("N0", CultureInfo.InvariantCulture);
    string Axis(decimal value) => value >= 1000 ? (value / 1000m).ToString("0.#", CultureInfo.InvariantCulture) + "K" : value.ToString("0", CultureInfo.InvariantCulture);
    string Ago(DateTime date)
    {
        var elapsed = DateTime.UtcNow - date;
        return elapsed.TotalMinutes < 1 ? "Just now"
            : elapsed.TotalHours < 1 ? $"{(int)elapsed.TotalMinutes}m ago"
            : elapsed.TotalDays < 1 ? $"{(int)elapsed.TotalHours}h ago"
            : elapsed.TotalDays < 30 ? $"{(int)elapsed.TotalDays}d ago"
            : date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    }
    var stats = new[]
    {
        ("Active Campaigns", Model.ActiveCampaignCount.ToString(), "Campaigns you're working on", "View all", "/InfluencerCampaigns?tab=ongoing", "bi-rocket-takeoff", "violet"),
        ("Pending Earnings", Money(Model.PendingEarnings), "Awaiting brand payment", "View earnings", "/InfluencerEarnings?tab=transactions", "bi-bar-chart-line", "pink"),
        ("Completed Campaigns", Model.CompletedCampaignCount.ToString(), "Successfully finished", "View history", "/InfluencerCampaigns?tab=completed", "bi-calendar-check", "cyan"),
        ("Total Earnings", Money(Model.TotalEarnings), "All time earnings", "View details", "/InfluencerEarnings", "bi-wallet2", "violet")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard - Brandora</title>
    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    @await Html.PartialAsync("_InfluencerSidebar")

    <main class="dashboard-page" id="dashboardMain">
        <header class="dashboard-topbar">
            <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
            <form class="dashboard-search" method="get" asp-controller="InfluencerCampaigns" asp-action="Index" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="search" placeholder="Search campaigns, brands..." aria-label="Search campaigns and brands" />
                <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>
            <details class="dashboard-notifications">
                <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
                <div class="dashboard-notification-panel">
                    <div class="dashboard-notification-panel-head">
                        <h2>Notifications</h2>
                        @if (Model.Notifications.Count > 0)
                        {
                            <form method="post" asp-controller="Notifications" asp-action="ClearAll">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="dashboard-notification-clear">Clear</button>
                            </form>
                        }
                    </div>
                    @foreach (var notification in Model.Notifications)
                    {
                        <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                    }
                    @if (Model.Notifications.Count == 0) { <p>No notifications yet.</p> }
                </div>
            </details>
            <a class="dashboard-account" href="/InfluencerSettings">
                <span class="dashboard-avatar">@FollowerFormat.InitialsOf(name)</span>
                <span><strong>@name</strong><small>Influencer</small></span>
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </a>
        </header>

        <section class="dashboard-hero" aria-labelledby="dashboard-greeting">
            @await Html.PartialAsync("_Waves", "hero")
            <div class="dashboard-introduction">
                <p>Good to see you again,</p>
                <h1 id="dashboard-greeting">@firstName <span>@remainingName</span></h1>
                <div class="dashboard-profile-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.ContentNiche)) { <span class="dashboard-niche">@Model.Profile.ContentNiche</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.Location)) { <span><i class="bi bi-geo-alt" aria-hidden="true"></i> @Model.Profile.Location</span> }
                </div>
                <dl class="dashboard-profile-stats">
                    <div><dd>@FollowerFormat.Format(Model.Profile.Followers)</dd><dt>Followers</dt></div>
                    <div><dd>@Model.Profile.EngagementRate.ToString("0.##", CultureInfo.InvariantCulture)%</dd><dt>Engagement Rate</dt></div>
                </dl>
            </div>
            <div class="dashboard-hero-art" aria-hidden="true">
                <div class="dashboard-glass dashboard-glass-back"></div>
                <div class="dashboard-glass dashboard-glass-front"><div class="dashboard-glass-copy">Turn<br />Your Creativity<br />into Opportunities<span></span></div></div>
                <span class="dashboard-sparkle"></span>
            </div>
            <div class="dashboard-hero-motto">Create<br />Collaborate<br />Get Rewarded<span></span></div>
        </section>

        <section class="dashboard-stats" aria-label="Your account overview">
            @foreach (var stat in stats)
            {
                <article class="dashboard-stat dashboard-card">
                    <div class="dashboard-stat-main"><span class="dashboard-icon @stat.Item7"><i class="bi @stat.Item6" aria-hidden="true"></i></span><div><h2>@stat.Item1</h2><strong>@stat.Item2</strong><p>@stat.Item3</p></div></div>
                    <footer><span class="dashboard-accent"></span><a href="@stat.Item5">@stat.Item4 <i class="bi bi-arrow-right" aria-hidden="true"></i><span class="dashboard-sr-only">: @stat.Item1</span></a></footer>
                </article>
            }
        </section>

        <div class="dashboard-work-grid">
            <section class="dashboard-card dashboard-panel" id="active-campaigns">
                <header><h2>Active Campaigns</h2><a href="/InfluencerCampaigns?tab=ongoing">View all <i class="bi bi-arrow-right" aria-hidden="true"></i></a></header>
                @if (Model.ActiveCampaigns.Count == 0)
                {
                    <div class="dashboard-empty"><span class="dashboard-empty-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span><strong>No active campaigns yet.</strong><p>Once a brand accepts your proposal, it'll show up here.</p></div>
                }
                else
                {
                    <div class="dashboard-campaigns">
                        @foreach (var campaign in Model.ActiveCampaigns)
                        {
                            <article class="dashboard-campaign-row">
                                <div><a asp-controller="InfluencerEarnings" asp-action="Index" asp-route-campaignId="@campaign.CampaignId">@campaign.CampaignTitle</a><small>@campaign.BrandName</small></div>
                                <strong>@Money(campaign.TotalValue)</strong>
                                <div class="dashboard-progress"><progress value="@campaign.ProgressPercent" max="100" aria-label="@campaign.CampaignTitle milestone progress">@campaign.ProgressPercent%</progress><small>@campaign.CompletedMilestones of @campaign.TotalMilestones milestones approved</small></div>
                            </article>
                        }
                    </div>
                }
            </section>
            <section class="dashboard-card dashboard-panel" id="upcoming-milestones">
                <header><h2>Upcoming Milestones</h2><a href="/InfluencerEarnings">View all <i class="bi bi-arrow-right" aria-hidden="true"></i></a></header>
                @if (Model.UpcomingMilestones.Count == 0)
                {
                    <div class="dashboard-empty"><span class="dashboard-empty-icon"><i class="bi bi-calendar" aria-hidden="true"></i></span><strong>Nothing due.</strong><p>Milestones from your active collaborations will appear here.</p></div>
                }
                else
                {
                    <div class="dashboard-milestones">
                        @foreach (var milestone in Model.UpcomingMilestones)
                        {
                            <article class="dashboard-milestone-row">
                                <span class="dashboard-small-icon"><i class="bi bi-calendar-event" aria-hidden="true"></i></span>
                                <div><a asp-controller="InfluencerEarnings" asp-action="Index" asp-route-campaignId="@milestone.CampaignId">@milestone.MilestoneTitle</a><small>@milestone.CampaignTitle</small><small>@(milestone.DueDate.HasValue ? "Due " + milestone.DueDate.Value.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) : "No due date set")</small></div>
                                <strong>@Money(milestone.Amount)</strong>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="dashboard-bottom-grid">
            <section class="dashboard-card dashboard-panel dashboard-earnings" id="earnings">
                <header>
                    <h2>Earnings Overview</h2>
                    <form method="get" asp-action="Index" class="dashboard-period">
                        <input type="hidden" name="allActivity" value="@Model.AllActivity.ToString().ToLowerInvariant()" />
                        <label class="dashboard-sr-only" for="dashboard-period">Earnings period</label>
                        <select name="period" id="dashboard-period">
                            <option value="month" selected="@(Model.Period == "month")">This Month</option>
                            <option value="last-month" selected="@(Model.Period == "last-month")">Last Month</option>
                            <option value="year" selected="@(Model.Period == "year")">This Year</option>
                        </select>
                        <button type="submit">Apply</button>
                    </form>
                </header>
                <dl class="dashboard-earning-totals">
                    <div><dt>Total Earnings</dt><dd>@Money(Model.MonthTotal)</dd></div>
                    <div><dt>Paid</dt><dd>@Money(Model.MonthPaid)</dd></div>
                    <div><dt>Pending</dt><dd>@Money(Model.MonthPending)</dd></div>
                </dl>
                <div class="dashboard-chart" aria-label="Earnings for @Model.PeriodLabel">
                    <div class="dashboard-chart-axis" aria-hidden="true">
                        @for (var tick = 4; tick >= 0; tick--) { <span>@Axis(chartScale * tick / 4)</span> }
                    </div>
                    <div class="dashboard-chart-plot">
                        <div class="dashboard-chart-columns">
                            @foreach (var point in Model.EarningsSeries)
                            {
                                var height = (point.Amount / chartScale * 100m).ToString("0.####", CultureInfo.InvariantCulture);
                                <div class="dashboard-chart-column">
                                    <button type="button" class="dashboard-chart-hit" aria-label="@point.Label: @Money(point.Amount)">
                                        <span class="dashboard-chart-bar" style="height: @(height)%"></span>
                                        <span class="dashboard-chart-tooltip"><strong>@Money(point.Amount)</strong><small>@point.Label · @Model.PeriodLabel</small></span>
                                    </button>
                                    <span class="dashboard-chart-label">@point.Label</span>
                                </div>
                            }
                        </div>
                        @if (chartMaximum == 0) { <p class="dashboard-chart-empty">No earnings in this period.</p> }
                    </div>
                </div>
                <p class="dashboard-chart-caption">@Model.PeriodLabel · Paid and pending payments</p>
            </section>
            <section class="dashboard-card dashboard-panel dashboard-activity" id="recent-activity">
                <header><h2>Recent Activity</h2><a asp-action="Index" asp-route-period="@Model.Period" asp-route-allActivity="@(!Model.AllActivity)" asp-fragment="recent-activity">@(Model.AllActivity ? "Show less" : "View all") <i class="bi bi-arrow-right" aria-hidden="true"></i></a></header>
                @foreach (var activity in Model.Activity)
                {
                    <article><div><strong>@activity.Title</strong><p>@activity.Description</p></div><time datetime="@activity.Date.ToString("O")" title="@activity.Date.ToString("MMM d, yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)">@Ago(activity.Date)</time></article>
                }
                @if (Model.Activity.Count == 0)
                {
                    <div class="dashboard-empty"><span class="dashboard-empty-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span><strong>No activity yet.</strong><p>Your campaign and payment updates will appear here.</p></div>
                }
            </section>
        </div>

        <section class="dashboard-discover" aria-labelledby="discover-title">
            <div><h2 id="discover-title">Discover New Campaigns</h2><p>Find brands that match your style.</p></div>
            <a href="/InfluencerCampaigns">Browse Campaigns <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </section>
    </main>
    <script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>
</body>
</html>