@model Brandora.Web.Models.Dashboard.UploadProofViewModel
@using Brandora.Web.Models.Influencers
@using System.Text.Json
@{
    ViewData["Title"] = "Upload Proof";
    ViewData["ActiveNav"] = "UploadProof";
    Layout = null;
    var campaignsJson = JsonSerializer.Serialize(Model.Campaigns.Select(c => new {
        id = c.CollaborationId, title = c.Title, brand = c.BrandName, platform = c.Platform,
        niche = c.Niche, mediaUrl = c.MediaUrl,
        deadline = c.Deadline?.ToString("MMM d, yyyy"),
        milestones = c.Milestones.Select(m => new { id = m.MilestoneId, title = m.Title, amount = m.Amount })
    }));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Upload Proof - Brandora</title>
    <link rel="icon" href="~/images/brandora-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-upload-proof.css" asp-append-version="true" />
</head>
<body>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
@await Html.PartialAsync("_InfluencerSidebar")
<main class="dashboard-page proof-page" id="dashboardMain">
    <header class="dashboard-topbar">
        <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
        <form class="dashboard-search" method="get" asp-controller="InfluencerCampaigns" asp-action="Index" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="search" placeholder="Search campaigns, brands..." aria-label="Search campaigns and brands" />
            <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
        </form>
        <details class="dashboard-notifications">
            <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
            <div class="dashboard-notification-panel">
                <div class="dashboard-notification-panel-head">
                    <h2>Notifications</h2>
                    @if (Model.Notifications.Count > 0)
                    {
                        <form method="post" asp-controller="Notifications" asp-action="ClearAll">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <button type="submit" class="dashboard-notification-clear">Clear</button>
                        </form>
                    }
                </div>
                @foreach (var notification in Model.Notifications)
                {
                    <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                }
                @if (Model.Notifications.Count == 0) { <p>No notifications yet.</p> }
            </div>
        </details>
        <a class="dashboard-account" href="/InfluencerSettings" aria-label="Your profile settings">
            <span class="dashboard-avatar">@if (!string.IsNullOrEmpty(Model.Profile.ProfilePictureUrl)) { <img src="@Model.Profile.ProfilePictureUrl" alt="" /> } else { @FollowerFormat.InitialsOf(Model.Profile.FullName) }</span>
            <span><strong>@Model.Profile.FullName</strong><small>Influencer</small></span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </a>
    </header>
    <section class="dashboard-hero" aria-labelledby="proof-title">
        @await Html.PartialAsync("~/Views/InfluencerDashboard/_Waves.cshtml", "hero")
        <div class="dashboard-introduction proof-introduction">
            <p class="proof-eyebrow">Upload Proof</p>
            <h1 id="proof-title">Share Your Work. <span>Keep the Momentum Going.</span></h1>
            <p class="proof-description">Upload your proof of work for the completed milestone and let the brand review your submission.</p>
            <ul class="proof-benefits" aria-label="Submission benefits">
                <li>Secure Submission</li><li>Flexible File Formats</li><li>Quick Review</li>
            </ul>
        </div>
        <div class="dashboard-hero-art" aria-hidden="true">
            <div class="dashboard-glass dashboard-glass-back"></div>
            <div class="dashboard-glass dashboard-glass-front"><div class="dashboard-glass-copy">Your<br />Creativity<br />Creates Impact.<span></span></div></div>
        </div>
        <div class="dashboard-hero-motto">Real Brands.<br />Real Opportunities.<span></span></div>
    </section>
    <ol class="proof-steps" aria-label="Submission progress">
        <li class="is-active" data-step="1" aria-current="step"><span class="proof-step-number">1</span><div><strong>Select Campaign</strong><small>Choose your campaign</small></div></li>
        <li data-step="2"><span class="proof-step-number">2</span><div><strong>Select Milestone</strong><small>Choose completed milestone</small></div></li>
        <li data-step="3"><span class="proof-step-number">3</span><div><strong>Upload Proof</strong><small>Add your proof</small></div></li>
        <li data-step="4"><span class="proof-step-number">4</span><div><strong>Review &amp; Submit</strong><small>Final review</small></div></li>
    </ol>
    @if (TempData["ProofError"] is not null)
    {
        <p class="proof-notice is-error" role="alert">@TempData["ProofError"]</p>
    }
    @if (TempData["ProofSubmitted"] is not null)
    {
        <p class="proof-notice" role="status"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Proof submitted! The brand has been notified and will review it shortly.</p>
    }
    @if (Model.Campaigns.Count == 0)
    {
        <div class="proof-notice" role="status">You have no milestones ready for proof submission. <a href="/InfluencerCampaigns">Explore campaigns</a> or check your active collaborations.</div>
    }
    <noscript><p class="proof-notice">Enable JavaScript to select a milestone and upload your proof.</p></noscript>
    <div class="proof-grid">
        <form class="proof-card proof-form" method="post" asp-action="Submit" enctype="multipart/form-data" id="proofForm">
            @Html.AntiForgeryToken()
            <section class="proof-section" aria-labelledby="campaign-heading">
                <h2 id="campaign-heading"><label for="campaignSelect">1. Select Campaign</label></h2>
                <p>Choose the campaign you're working on.</p>
                <div class="proof-select">
                    <span class="proof-select-icon" id="campaignIcon" aria-hidden="true"><i class="bi bi-briefcase"></i></span>
                    <div class="proof-select-copy" aria-hidden="true"><strong id="campaignLabel">Select a campaign</strong><small id="campaignSubtitle">Your active collaborations</small></div>
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    <select id="campaignSelect" required disabled="@(Model.Campaigns.Count == 0)">
                        <option value="">Choose a campaign</option>
                        @foreach (var campaign in Model.Campaigns)
                        {
                            <option value="@campaign.CollaborationId">@campaign.Title — @campaign.BrandName</option>
                        }
                    </select>
                </div>
            </section>
            <section class="proof-section" aria-labelledby="milestone-heading">
                <h2 id="milestone-heading"><label for="milestoneSelect">2. Select Milestone</label></h2>
                <p>Choose the milestone you've completed.</p>
                <div class="proof-select">
                    <span class="proof-select-icon proof-milestone-icon" aria-hidden="true"><i class="bi bi-camera-reels"></i></span>
                    <div class="proof-select-copy" aria-hidden="true"><strong id="milestoneLabel">Select a milestone</strong><small id="milestoneSubtitle">Choose a campaign first</small></div>
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    <select id="milestoneSelect" name="milestoneId" required disabled><option value="">Choose a milestone</option></select>
                </div>
            </section>
            <section class="proof-section" aria-labelledby="upload-heading">
                <h2 id="upload-heading">3. Upload Your Proof</h2>
                <p>Upload clear and valid proof as per the campaign guidelines.</p>
                <div class="proof-dropzone" id="dropzone">
                    <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                    <strong>Drag &amp; drop your file here</strong><span>or</span>
                    <button class="proof-primary proof-choose" type="button" id="chooseFileBtn">Choose File</button>
                    <small id="fileHelp">Images: up to 15MB · Videos: up to 80MB · PDFs: up to 100MB</small>
                    <input type="file" id="proofFile" name="proofFile" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime,application/pdf" aria-label="Proof file" aria-describedby="fileHelp" hidden />
                </div>
                <div class="proof-file-list" id="fileList" aria-live="polite"></div>
                <p class="proof-field-error" id="fileError" role="alert" hidden></p>
            </section>
            <div class="proof-fields">
                <div class="proof-field">
                    <label for="proofUrl">Post Link (if applicable)</label>
                    <div class="proof-input"><i class="bi bi-link-45deg" aria-hidden="true"></i><input type="url" id="proofUrl" name="proofUrl" placeholder="https://www.instagram.com/reel/..." /></div>
                </div>
                <div class="proof-field">
                    <label for="proofNotes">Additional Notes (optional)</label>
                    <div class="proof-input proof-notes"><i class="bi bi-pencil" aria-hidden="true"></i><textarea id="proofNotes" name="proofNotes" rows="1" maxlength="500" placeholder="Add any additional information..." aria-describedby="notesCount"></textarea><small id="notesCount">0/500</small></div>
                </div>
            </div>
            <div class="proof-actions"><button class="proof-primary" type="button" id="continueBtn" disabled>Continue <i class="bi bi-arrow-right" aria-hidden="true"></i></button></div>
            <dialog class="proof-review" id="reviewDialog" aria-labelledby="reviewTitle">
                <h2 id="reviewTitle" tabindex="-1">Review &amp; Submit</h2>
                <p>Check your proof before sending it to the brand.</p>
                <dl id="reviewDetails"></dl>
                <p class="proof-review-hint" id="reviewHint" hidden>Your uploaded file will be submitted as proof. The post link is used when no file is attached.</p>
                <div class="proof-actions"><button class="proof-secondary" type="button" id="editProofBtn">Back to edit</button><button class="proof-primary" type="submit" id="submitProofBtn">Submit Proof <i class="bi bi-arrow-right" aria-hidden="true"></i></button></div>
            </dialog>
        </form>
        <aside class="proof-aside" aria-label="Campaign information and help">
            <section class="proof-card">
                <h2>Campaign Details</h2>
                <p class="proof-empty" id="campaignEmpty">Select a campaign to see its details here.</p>
                <div id="campaignDetails" hidden>
                    <div class="proof-campaign"><span class="proof-campaign-image" id="detailsImage" aria-hidden="true"></span><div><h3 id="detailsTitle"></h3><p id="detailsBrand"></p></div></div>
                    <dl class="proof-meta"><div><dt>Deadline</dt><dd id="detailsDeadline"></dd></div><div><dt>Platform</dt><dd id="detailsPlatform"></dd></div><div><dt>Milestone</dt><dd id="detailsMilestone">Choose a milestone</dd></div></dl>
                </div>
            </section>
            <section class="proof-card proof-guidelines">
                <i class="bi bi-lightbulb-fill proof-bulb" aria-hidden="true"></i>
                <div><h2>Submission Guidelines</h2><ul>
                    <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Upload original and authentic content</li>
                    <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Make sure the post is public</li>
                    <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Follow all campaign requirements</li>
                    <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Include any additional proof if needed</li>
                    <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Ensure the content matches the milestone</li>
                </ul></div>
            </section>
            <section class="proof-card proof-help">
                <h2>Need Help?</h2><p>If you face any issue while uploading your proof, feel free to contact our support team.</p>
                <a href="/InfluencerMessages">Go to Chat <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                <svg viewBox="0 0 400 170" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="proof-help-wave" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#0955ca" stop-opacity="0"/><stop offset=".65" stop-color="#168cff" stop-opacity=".5"/><stop offset="1" stop-color="#783dff" stop-opacity=".15"/></linearGradient></defs><path d="M-20 160 C100 50 140 220 260 105 S350 85 420 20 L420 190 H-20Z" fill="url(#proof-help-wave)"/><path d="M-20 164 C110 90 140 230 270 120 S360 70 420 40" fill="none" stroke="#2799ff" stroke-opacity=".4"/></svg>
            </section>
        </aside>
    </div>
</main>
<script type="application/json" id="proofCampaignData">@Html.Raw(campaignsJson)</script>
<script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>
<script src="~/js/brandora-upload-proof.js" asp-append-version="true"></script>
</body>
</html>