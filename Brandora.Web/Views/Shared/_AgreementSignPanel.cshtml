@model Brandora.Web.Models.Domain.Agreement
@{
    var signActionUrl = ViewData["SignActionUrl"] as string ?? "";
    var signerNamePlaceholder = ViewData["SignerNamePlaceholder"] as string ?? "";
}
<style>
    .agreement-sign-panel { max-width: 860px; margin: 22px auto 0; padding: 24px 28px; background: #fbfbff; border: 1px solid #e3e7f2; border-radius: 10px; }
    .agreement-sign-panel h2 { font-size: 16px; margin: 0 0 4px; }
    .agreement-sign-panel > p { font-size: 12.5px; color: #6b7290; margin: 0 0 16px; }
    .agreement-sign-tabs { display: flex; gap: 8px; margin-bottom: 14px; }
    .agreement-sign-tabs button { border: 1px solid #d6dcf0; background: #fff; color: #40467a; padding: 8px 16px; border-radius: 8px; font-size: 12.5px; font-weight: 600; cursor: pointer; }
    .agreement-sign-tabs button.is-active { border-color: #0759ff; color: #0759ff; background: #eef4ff; }
    .agreement-sign-canvas-wrap { position: relative; }
    .agreement-sign-canvas-wrap canvas { width: 100%; height: 160px; border: 1.5px dashed #c7d0ea; border-radius: 8px; background: #fff; touch-action: none; cursor: crosshair; }
    .agreement-sign-clear { margin-top: 8px; border: 0; background: transparent; color: #c22540; font-size: 12px; font-weight: 600; cursor: pointer; }
    .agreement-sign-upload input[type="file"] { display: block; width: 100%; padding: 10px; border: 1.5px dashed #c7d0ea; border-radius: 8px; background: #fff; font-size: 12.5px; }
    .agreement-sign-field { margin-top: 16px; }
    .agreement-sign-field label { display: block; font-size: 12px; font-weight: 600; color: #40467a; margin-bottom: 6px; }
    .agreement-sign-field input[type="text"] { width: 100%; padding: 10px 12px; border: 1px solid #d6dcf0; border-radius: 8px; font-size: 13px; }
    .agreement-sign-consent { display: flex; align-items: flex-start; gap: 8px; margin-top: 16px; font-size: 12.5px; color: #40467a; }
    .agreement-sign-submit { margin-top: 18px; border: 0; background: linear-gradient(115deg, #7224ff, #3735ff 55%, #087fff); color: #fff; padding: 11px 22px; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; }
    .agreement-sign-error { color: #c22540; font-size: 12.5px; margin-bottom: 12px; }
</style>
<section class="agreement-sign-panel" data-signature-panel>
    <h2>Sign Agreement</h2>
    <p>Draw your signature or upload an image, then confirm your name to sign this agreement.</p>

    @if (TempData["AgreementError"] is string signError)
    {
        <p class="agreement-sign-error">@signError</p>
    }

    <form method="post" action="@signActionUrl" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="signatureDataUrl" value="" data-signature-dataurl />

        <div class="agreement-sign-tabs">
            <button type="button" class="is-active" data-signature-tab="draw">Draw Signature</button>
            <button type="button" data-signature-tab="upload">Upload Signature</button>
        </div>

        <div data-signature-pane="draw">
            <div class="agreement-sign-canvas-wrap">
                <canvas data-signature-canvas></canvas>
            </div>
            <button type="button" class="agreement-sign-clear" data-signature-clear>Clear</button>
        </div>

        <div data-signature-pane="upload" class="agreement-sign-upload" hidden>
            <input type="file" name="signatureFile" accept="image/jpeg,image/png,image/webp" data-signature-file />
        </div>

        <div class="agreement-sign-field">
            <label for="signerName">Your full name</label>
            <input type="text" id="signerName" name="signerName" placeholder="@signerNamePlaceholder" required />
        </div>

        <label class="agreement-sign-consent">
            <input type="checkbox" name="consent" value="true" required />
            <span>I have read and agree to the terms of this Campaign Collaboration Agreement, and I intend this as my signature.</span>
        </label>

        <button type="submit" class="agreement-sign-submit"><i class="bi bi-pen"></i> Sign Agreement</button>
    </form>
</section>
<script src="~/js/brandora-signature-pad.js" asp-append-version="true"></script>
