@{
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var appSection = ViewData["AppSection"] as string ?? "Brand";
    var isInfluencer = appSection == "Influencer";
    var homeAppUrl = isInfluencer ? "/InfluencerDashboard" : "/Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />

    <style>

        /* =========================================================
           GLOBAL
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            background: #ffffff;
            color-scheme: light;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #ffffff;
            color: #20283a;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }

        ::selection {
            background: rgba(155,44,255,.25);
        }


        /* =========================================================
           APP SHELL
        ========================================================= */

        .app-shell {
            display: flex;
            min-height: 100vh;
        }


        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar {
            width: 264px;
            flex-shrink: 0;

            background:
                radial-gradient(circle at 0% 30%, rgba(139,34,255,.18), transparent 30%),
                linear-gradient(180deg, #070c22 0%, #0a1028 100%);

            color: #ffffff;

            display: flex;
            flex-direction: column;

            padding: 20px 18px;

            position: sticky;
            top: 0;
            height: 100vh;
            z-index: 1;

            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;

            transition: width .3s cubic-bezier(.22,1,.36,1), min-width .3s cubic-bezier(.22,1,.36,1), padding .3s cubic-bezier(.22,1,.36,1), opacity .2s ease;
        }

        .sidebar::-webkit-scrollbar {
            width: 0;
            height: 0;
        }

        .sidebar.is-hidden {
            width: 0;
            min-width: 0;
            padding: 20px 0;
            opacity: 0;
            pointer-events: none;
        }

        .sidebar::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;

            background:
                radial-gradient(circle at 18% 8%, rgba(175,60,255,.45), transparent 42%),
                radial-gradient(circle at 88% 22%, rgba(255,60,190,.24), transparent 38%),
                radial-gradient(circle at 75% 96%, rgba(0,169,255,.3), transparent 48%),
                radial-gradient(circle at 10% 70%, rgba(120,80,255,.2), transparent 40%);

            animation: sidebar-glow 14s ease-in-out infinite;
        }

        @@keyframes sidebar-glow {
            0%, 100% { opacity: .8; transform: scale(1) rotate(0deg); }
            50% { opacity: 1; transform: scale(1.12) rotate(4deg); }
        }

        .side-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .side-brand {
            display: flex;
            align-items: center;
            gap: 10px;

            padding: 0 6px;

            min-width: 0;
        }

        .side-brand-full {
            height: 34px;
            width: auto;
            flex-shrink: 0;

            display: block;

            filter: drop-shadow(0 0 8px rgba(150,100,255,.4));
        }

        .side-nav-wrap {
            position: relative;
            margin-top: 22px;
        }

        .side-nav-glass {
            position: relative;

            padding: 8px;

            border-radius: 14px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.12);

            background: rgba(255,255,255,.05);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            box-shadow: 0 8px 30px rgba(0,0,0,.18);
        }

        .side-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .side-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;

            padding: 9px 14px;

            border-radius: 10px;

            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 500;

            position: relative;

            color: rgba(255,255,255,.75);
            transition: background .25s ease, color .25s ease, transform .2s ease;
        }

        a.side-nav-item:hover {
            background: rgba(255,255,255,.06);
            color: #ffffff;
            transform: translateX(3px);
        }

        a.side-nav-item:active {
            transform: translateX(3px) scale(.97);
        }

        .side-nav-item.is-active {
            color: #ffffff;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.35),
                inset 0 0 0 1px rgba(255,255,255,.18),
                0 8px 25px rgba(106, 37, 213, .25);
        }

        .side-nav-item.is-soon {
            color: rgba(255,255,255,.4);
        }

        .nav-label {
            flex: 1;
            min-width: 0;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;

            white-space: nowrap;
        }

        .nav-letter {
            display: none;
            position: relative;
            flex-shrink: 0;

            width: 30px;
            height: 30px;

            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: rgba(255,255,255,.06);

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 12.5px;
        }

        .nav-dot {
            position: absolute;
            top: -2px;
            right: -2px;

            width: 9px;
            height: 9px;
            border-radius: 50%;

            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            border: 2px solid #0a1028;
        }

        .soon-tag {
            padding: 2px 8px;

            border-radius: 20px;
            border: 1px solid rgba(255,255,255,.14);

            font-size: 10px;
            font-weight: 600;
            letter-spacing: .4px;

            color: rgba(255,255,255,.45);
        }

        .unread-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            min-width: 20px;
            height: 20px;
            padding: 0 6px;

            border-radius: 20px;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

            font-size: 10.5px;
            font-weight: 700;
            color: #ffffff;
        }

        .side-foot {
            margin-top: auto;

            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,.1);
        }

        .side-foot-company {
            padding: 0 6px;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #ffffff;

            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .side-foot-role {
            padding: 0 6px;
            margin-top: 2px;

            font-family: 'Inter', sans-serif;
            font-size: 11.5px;
            color: rgba(255,255,255,.5);
        }

        .side-logout-form {
            margin-top: 10px;
        }

        .side-logout-btn {
            width: 100%;

            padding: 10px 14px;

            border: 1px solid rgba(255,255,255,.14);
            border-radius: 9px;
            background: transparent;

            color: rgba(255,255,255,.75);

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 500;

            cursor: pointer;
            transition: .2s;
        }

        .logout-mark {
            display: none;
        }

        .side-logout-btn:hover {
            border-color: rgba(255,255,255,.35);
            color: #ffffff;
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .main {
            flex: 1;
            min-width: 0;

            padding: 34px 42px 60px;
        }


        /* =========================================================
           SHARED: PANELS, EMPTY STATES, PILLS, BUTTONS
        ========================================================= */

        .panel {
            padding: 26px 28px;

            border-radius: 18px;
            background: #ffffff;
            border: 1px solid #dce7ff;

            animation: fade-up .5s ease both;
        }

        .panel-title {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 16px;
        }

        .panel-sub {
            margin-top: 3px;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            color: #8189a8;
        }

        .empty-block {
            margin-top: 22px;
            padding: 26px 20px;

            border-radius: 14px;
            border: 1px dashed #dde1f0;
            background: #fafbfe;

            text-align: center;
        }

        .empty-title {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 14.5px;
            color: #2a3157;
        }

        .empty-text {
            margin-top: 6px;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            line-height: 1.6;
            color: #8189a8;

            max-width: 360px;
            margin-left: auto;
            margin-right: auto;
        }

        .status-pill {
            display: inline-flex;
            width: fit-content;

            padding: 4px 11px;
            border-radius: 20px;

            font-family: 'Inter', sans-serif;
            font-size: 11.5px;
            font-weight: 600;
        }

        .status-pill.draft { background: #f8f0e3; color: #a05e12; }
        .status-pill.published { background: #e7eef8; color: #2362a9; }
        .status-pill.active { background: #e2faf1; color: #0d9c6c; }
        .status-pill.completed { background: #f3e8ff; color: #7a1fd6; }
        .status-pill.cancelled { background: #fde8ea; color: #c22540; }
        .status-pill.pending { background: #f8f0e3; color: #a05e12; }
        .status-pill.accepted { background: #e2faf1; color: #0d9c6c; }
        .status-pill.rejected { background: #fde8ea; color: #c22540; }
        .status-pill.submitted { background: #e7eef8; color: #2362a9; }
        .status-pill.approved { background: #e2faf1; color: #0d9c6c; }
        .status-pill.revisionrequested { background: #f8f0e3; color: #a05e12; }
        .status-pill.paid { background: #f3e8ff; color: #7a1fd6; }
        .status-pill.failed { background: #fde8ea; color: #c22540; }

        .form-errors {
            margin-bottom: 18px;
            padding: 14px 16px;

            border-radius: 10px;
            border: 1px solid rgba(220,50,70,.25);
            background: rgba(220,50,70,.06);

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #a71b34;
        }

        .form-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            height: 46px;
            padding: 0 22px;

            border-radius: 10px;
            border: none;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            font-weight: 600;

            cursor: pointer;
            transition: .2s;
            white-space: nowrap;
        }

        .btn-primary {
            color: #ffffff;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            background-size: 160% 160%;
            background-position: 0% 50%;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            background-position: 100% 50%;
            box-shadow: 0 10px 26px rgba(140,60,255,.35);
        }

        .btn-primary:active {
            transform: translateY(0) scale(.98);
        }

        .btn-secondary {
            color: #2a3157;
            background: #ffffff;
            border: 1px solid #dde1f0;
        }

        .btn-secondary:hover {
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow: 0 0 0 1.5px #9b2cff, 0 10px 22px rgba(140,60,255,.18);
        }

        .btn-secondary:active {
            transform: translateY(0);
        }

        .btn-ghost {
            color: #6b7290;
            background: transparent;
            border: 1px solid transparent;
        }

        .btn-ghost:hover {
            color: #9b2cff;
            background: rgba(155,44,255,.06);
        }


        /* =========================================================
           SHARED: BACK TO DASHBOARD
        ========================================================= */

        .back-to-dashboard {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            margin-bottom: 18px;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            color: #8189a8;

            transition: color .2s ease;
        }

        .back-to-dashboard svg {
            transition: transform .2s ease;
        }

        .back-to-dashboard:hover {
            color: #9b2cff;
        }

        .back-to-dashboard:hover svg {
            transform: translateX(-3px);
        }


        /* =========================================================
           SHARED: CREATOR PRIMITIVES
        ========================================================= */

        .tag {
            padding: 3px 10px;

            border-radius: 20px;
            background: #f2f3fa;

            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            color: #545b7d;
        }

        .creator-avatar {
            width: 56px;
            height: 56px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 18px;
            color: #ffffff;

            transition: transform .35s cubic-bezier(.22,1,.36,1);
        }

        .verified-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;

            padding: 2px 9px;

            border-radius: 20px;
            background: #e4f0ff;
            color: #1265d6;

            font-family: 'Inter', sans-serif;
            font-size: 10.5px;
            font-weight: 700;
        }

        .shortlist-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            height: 38px;
            padding: 0 16px;

            border-radius: 9px;
            border: 1px solid #dde1f0;
            background: #ffffff;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            color: #545b7d;

            cursor: pointer;
            transition: .2s;
        }

        .shortlist-btn:hover {
            border-color: #b7c0e0;
        }

        .shortlist-btn.is-saved {
            border-color: transparent;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
        }


        /* =========================================================
           MOTION
        ========================================================= */

        @@keyframes fade-up {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        /* =========================================================
           TOPBAR
        ========================================================= */

        .main-topbar {
            position: sticky;
            top: 0;
            z-index: 30;

            display: flex;
            align-items: center;
            gap: 16px;

            padding: 16px 42px;
            margin: -34px -42px 28px;

            background: rgba(255,255,255,.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid #eaecf5;
        }

        .topbar-menu-btn {
            flex-shrink: 0;

            width: 40px;
            height: 40px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;
            border: 1px solid #e2e5f2;
            background: #ffffff;

            color: #545b7d;
            cursor: pointer;

            transition: .2s;
        }

        .topbar-menu-btn:hover {
            border-color: #9b2cff;
            color: #9b2cff;
        }

        .topbar-search {
            flex: 1;
            max-width: 340px;
        }

        .topbar-search input {
            width: 100%;
            height: 40px;

            padding: 0 16px;

            border-radius: 10px;
            border: 1px solid #e2e5f2;
            background: #fbfbfe;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #2a3157;

            outline: none;
            transition: .2s;
        }

        .topbar-search input:focus {
            border-color: #a978ff;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(155,44,255,.1);
        }

        .topbar-actions {
            margin-left: auto;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            gap: 10px;
        }

        .topbar-icon-btn {
            position: relative;
            flex-shrink: 0;

            width: 40px;
            height: 40px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;
            border: 1px solid #e2e5f2;
            background: #ffffff;

            color: #545b7d;
            transition: .2s;
        }

        .topbar-icon-btn:hover {
            border-color: #9b2cff;
            color: #9b2cff;
        }

        .topbar-badge {
            position: absolute;
            top: -5px;
            right: -5px;

            min-width: 16px;
            height: 16px;
            padding: 0 4px;

            border-radius: 20px;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

            display: flex;
            align-items: center;
            justify-content: center;

            font-family: 'Inter', sans-serif;
            font-size: 9.5px;
            font-weight: 700;
            color: #ffffff;
        }

        .topbar-cta {
            flex-shrink: 0;

            height: 40px;
            padding: 0 20px;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;

            border-radius: 10px;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 700;
            color: #ffffff;
            white-space: nowrap;

            transition: transform .2s ease, box-shadow .2s ease;
        }

        .topbar-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(140,60,255,.3);
        }

        .topbar-profile-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .topbar-profile {
            overflow: hidden;

            border: none;
            border-radius: 50%;

            background: linear-gradient(135deg, #a326ff, #236eff);
            color: #ffffff;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 14px;

            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .topbar-profile:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(140,60,255,.3);
        }

        .topbar-profile-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .profile-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            z-index: 50;

            width: 260px;

            border-radius: 16px;
            border: 1px solid #eaecf5;
            background: #ffffff;
            box-shadow: 0 20px 46px rgba(30,34,90,.16);

            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(.98);
            transform-origin: top right;
            transition: opacity .18s ease, transform .18s cubic-bezier(.22,1,.36,1), visibility .18s;
        }

        .topbar-profile-wrap.is-open .profile-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .profile-dropdown-head {
            display: flex;
            align-items: center;
            gap: 12px;

            padding: 16px;
            border-bottom: 1px solid #f0f1f7;
        }

        .profile-dropdown-avatar {
            flex-shrink: 0;
            overflow: hidden;

            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: linear-gradient(135deg, #a326ff, #236eff);
            color: #ffffff;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

        .profile-dropdown-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-dropdown-identity {
            min-width: 0;
        }

        .profile-dropdown-name {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 13.5px;
            color: #171d3d;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-dropdown-email {
            margin-top: 2px;

            font-family: 'Inter', sans-serif;
            font-size: 11.5px;
            color: #8189a8;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-dropdown-links {
            padding: 8px;
        }

        .profile-dropdown-links a {
            display: block;
            padding: 10px 12px;

            border-radius: 9px;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 500;
            color: #2a3157;

            transition: background .15s ease, color .15s ease;
        }

        .profile-dropdown-links a:hover {
            background: rgba(155,44,255,.06);
            color: #7a1fd6;
        }

        .profile-dropdown-logout {
            padding: 8px;
            border-top: 1px solid #f0f1f7;
        }

        .profile-dropdown-logout button {
            width: 100%;
            padding: 10px 12px;

            border: none;
            border-radius: 9px;
            background: transparent;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #c22540;
            text-align: left;
            cursor: pointer;

            transition: background .15s ease;
        }

        .profile-dropdown-logout button:hover {
            background: rgba(220,50,70,.06);
        }

        @@media(max-width: 700px) {
            .topbar-search { display: none; }
        }

        @@media(max-width: 480px) {
            .main-topbar { padding: 14px 18px; margin: -18px -14px 22px; gap: 10px; }
            .topbar-cta span { display: none; }
            .topbar-cta { padding: 0 14px; }
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media(max-width: 820px) {
            .app-shell { flex-direction: column; }
            .sidebar { width: 100%; height: auto; position: relative; top: 0; flex-direction: row; align-items: center; overflow-x: auto; }
            .sidebar.is-hidden { width: 100%; min-width: 0; padding: 20px 18px; opacity: 1; pointer-events: auto; }
            .side-nav { margin-top: 0; margin-left: 24px; flex-direction: row; }
            .side-foot { display: none; }
            .main { padding: 24px 18px 40px; }
            .main-topbar { margin: -24px -18px 24px; padding: 14px 18px; }
        }

        @@media(max-width: 480px) {
            .sidebar { padding: 14px; }
            .side-top { flex: 1; }
            .side-brand-full { height: 28px; }
            .side-nav { margin-left: 14px; gap: 4px; }
            .side-nav-item { padding: 8px 10px; }
            .nav-label { font-size: 12px; }
            .main { padding: 18px 14px 32px; }
            .page-title { font-size: 22px !important; }
        }

        @RenderSection("Styles", required: false)

    </style>
</head>
<body>

<div class="app-shell">

    <aside class="sidebar" id="brandoraSidebar">

        <div class="side-top">
            <a href="@homeAppUrl" class="side-brand">
                <img src="~/images/Brandora.png" alt="Brandora" class="side-brand-full" />
            </a>
        </div>

        <div class="side-nav-wrap">
        <div class="side-nav-glass">
        <nav class="side-nav">
            @{
                var unread = ViewData["UnreadNotifications"] as int? ?? 0;
            }

            @if (isInfluencer)
            {
                <a href="/InfluencerDashboard" class="side-nav-item @(activeNav == "Dashboard" ? "is-active" : "")">
                    <span class="nav-letter">D</span>
                    <span class="nav-label side-toggle-hide">Dashboard</span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">B</span>
                    <span class="nav-label side-toggle-hide">Browse Campaigns <span class="soon-tag">Soon</span></span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">P</span>
                    <span class="nav-label side-toggle-hide">My Proposals <span class="soon-tag">Soon</span></span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">A</span>
                    <span class="nav-label side-toggle-hide">Active Campaigns <span class="soon-tag">Soon</span></span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">C</span>
                    <span class="nav-label side-toggle-hide">Chat <span class="soon-tag">Soon</span></span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">E</span>
                    <span class="nav-label side-toggle-hide">Earnings <span class="soon-tag">Soon</span></span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">S</span>
                    <span class="nav-label side-toggle-hide">Social Accounts <span class="soon-tag">Soon</span></span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">U</span>
                    <span class="nav-label side-toggle-hide">Upload Proof <span class="soon-tag">Soon</span></span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">P</span>
                    <span class="nav-label side-toggle-hide">Payments <span class="soon-tag">Soon</span></span>
                </a>

                <a href="#" class="side-nav-item is-soon">
                    <span class="nav-letter">S</span>
                    <span class="nav-label side-toggle-hide">Profile Settings <span class="soon-tag">Soon</span></span>
                </a>
            }
            else
            {
                <a href="/Dashboard" class="side-nav-item @(activeNav == "Dashboard" ? "is-active" : "")">
                    <span class="nav-letter">D</span>
                    <span class="nav-label side-toggle-hide">Dashboard</span>
                </a>

                <a href="/Campaigns" class="side-nav-item @(activeNav == "Campaigns" ? "is-active" : "")">
                    <span class="nav-letter">C</span>
                    <span class="nav-label side-toggle-hide">Campaigns</span>
                </a>

                <a href="/Influencers" class="side-nav-item @(activeNav == "Influencers" ? "is-active" : "")">
                    <span class="nav-letter">I</span>
                    <span class="nav-label side-toggle-hide">Influencers</span>
                </a>

                <a href="/Messages" class="side-nav-item @(activeNav == "Messages" ? "is-active" : "")">
                    <span class="nav-letter">M</span>
                    <span class="nav-label side-toggle-hide">Messages</span>
                </a>

                <a href="/Payments" class="side-nav-item @(activeNav == "Finance" ? "is-active" : "")">
                    <span class="nav-letter">F</span>
                    <span class="nav-label side-toggle-hide">Finance</span>
                </a>

                <a href="/Analytics" class="side-nav-item @(activeNav == "Analytics" ? "is-active" : "")">
                    <span class="nav-letter">A</span>
                    <span class="nav-label side-toggle-hide">Analytics</span>
                </a>

                <a href="/Notifications" class="side-nav-item @(activeNav == "Notifications" ? "is-active" : "")">
                    <span class="nav-letter">N@(unread > 0 ? Html.Raw("<span class=\"nav-dot\"></span>") : null)</span>
                    <span class="nav-label side-toggle-hide">
                        Notifications
                        @if (unread > 0)
                        {
                            <span class="unread-badge">@unread</span>
                        }
                    </span>
                </a>

                <a href="/Settings" class="side-nav-item @(activeNav == "Settings" ? "is-active" : "")">
                    <span class="nav-letter">S</span>
                    <span class="nav-label side-toggle-hide">Settings</span>
                </a>
            }

        </nav>
        </div>
        </div>

        <div class="side-foot">
            <div class="side-foot-company side-toggle-hide">@ViewData["CompanyName"]</div>
            <div class="side-foot-role side-toggle-hide">@(isInfluencer ? "Influencer Workspace" : "Brand Workspace")</div>

            <form method="post" action="/Account/Logout" class="side-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="side-logout-btn">
                    <span class="side-toggle-hide">Log Out</span>
                    <span class="logout-mark">L</span>
                </button>
            </form>
        </div>

    </aside>

    <main class="main">

        @if (!isInfluencer)
        {
            <div class="main-topbar">

                <button type="button" class="topbar-menu-btn" id="sidebarToggle" aria-label="Toggle sidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>

                <form method="get" action="/Campaigns" class="topbar-search">
                    <input type="text" name="search" placeholder="Search campaigns..." />
                </form>

                <div class="topbar-actions">

                    <a href="/Notifications" class="topbar-icon-btn" aria-label="Notifications">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 13 6 9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 18a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                        @if (unread > 0)
                        {
                            <span class="topbar-badge">@(unread > 9 ? "9+" : unread.ToString())</span>
                        }
                    </a>

                    <a href="/Campaigns/Create" class="topbar-cta">
                        <span>Create Campaign</span>
                    </a>

                    @{
                        var picUrl = ViewData["ProfilePictureUrl"] as string;
                        var companyName = ViewData["CompanyName"] as string ?? "Brand";
                        var contactName = ViewData["ContactFullName"] as string;
                        var email = ViewData["Email"] as string;
                        var initial = string.IsNullOrEmpty(companyName) ? "B" : companyName[..1].ToUpperInvariant();
                    }

                    <div class="topbar-profile-wrap" id="profileMenuWrap">
                        <button type="button" class="topbar-icon-btn topbar-profile" id="profileMenuBtn" aria-label="Brand account menu" aria-expanded="false">
                            @if (!string.IsNullOrEmpty(picUrl))
                            {
                                <img src="@picUrl" alt="@companyName" class="topbar-profile-img" />
                            }
                            else
                            {
                                @initial
                            }
                        </button>

                        <div class="profile-dropdown" id="profileDropdown">

                            <div class="profile-dropdown-head">
                                <div class="profile-dropdown-avatar">
                                    @if (!string.IsNullOrEmpty(picUrl))
                                    {
                                        <img src="@picUrl" alt="@companyName" />
                                    }
                                    else
                                    {
                                        @initial
                                    }
                                </div>
                                <div class="profile-dropdown-identity">
                                    <div class="profile-dropdown-name">@(string.IsNullOrEmpty(contactName) ? companyName : contactName)</div>
                                    <div class="profile-dropdown-email">@(email ?? companyName)</div>
                                </div>
                            </div>

                            <div class="profile-dropdown-links">
                                <a href="/Settings/Profile">View Profile</a>
                                <a href="/Settings">Edit Profile</a>
                            </div>

                            <form method="post" action="/Account/Logout" class="profile-dropdown-logout">
                                @Html.AntiForgeryToken()
                                <button type="submit">Log Out</button>
                            </form>

                        </div>
                    </div>

                </div>

            </div>
        }

        @RenderBody()
    </main>

</div>

<script>
    (function () {
        document.querySelectorAll('[data-count-to]').forEach(function (el) {
            var target = parseInt(el.dataset.countTo, 10) || 0;
            if (target === 0) { el.textContent = '0'; return; }

            var start = null;
            var duration = 700;

            function step(ts) {
                if (!start) start = ts;
                var progress = Math.min((ts - start) / duration, 1);
                var eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.round(eased * target).toString();
                if (progress < 1) requestAnimationFrame(step);
            }

            requestAnimationFrame(step);
        });

        document.querySelectorAll('[data-fill-to]').forEach(function (fill) {
            requestAnimationFrame(function () {
                fill.style.width = fill.dataset.fillTo + '%';
            });
        });

        // Profile dropdown
        var profileWrap = document.getElementById('profileMenuWrap');
        var profileBtn = document.getElementById('profileMenuBtn');

        if (profileWrap && profileBtn) {
            function closeProfileMenu() {
                profileWrap.classList.remove('is-open');
                profileBtn.setAttribute('aria-expanded', 'false');
            }

            profileBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = profileWrap.classList.toggle('is-open');
                profileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });

            document.addEventListener('click', function (e) {
                if (!profileWrap.contains(e.target)) {
                    closeProfileMenu();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeProfileMenu();
                }
            });
        }

        // Sidebar hide / show, toggled from the topbar menu button
        var sidebar = document.getElementById('brandoraSidebar');
        var toggle = document.getElementById('sidebarToggle');
        var appShell = document.querySelector('.app-shell');

        if (sidebar && toggle && appShell) {
            var STORAGE_KEY = 'brandora-sidebar-hidden';

            function setHidden(hidden) {
                sidebar.classList.toggle('is-hidden', hidden);
                appShell.classList.toggle('sidebar-is-hidden', hidden);
                toggle.setAttribute('aria-label', hidden ? 'Show sidebar' : 'Hide sidebar');
                try {
                    localStorage.setItem(STORAGE_KEY, hidden ? 'true' : 'false');
                } catch (e) {}
            }

            try {
                if (localStorage.getItem(STORAGE_KEY) === 'true') {
                    setHidden(true);
                }
            } catch (e) {}

            toggle.addEventListener('click', function () {
                setHidden(!sidebar.classList.contains('is-hidden'));
            });
        }
    })();
</script>

@RenderSection("Scripts", required: false)

</body>
</html>
