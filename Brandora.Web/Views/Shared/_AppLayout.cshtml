@using Brandora.Web.Models.Domain
@{
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var appSection = ViewData["AppSection"] as string ?? "Brand";
    var isInfluencer = appSection == "Influencer";
    var homeAppUrl = isInfluencer ? "/InfluencerDashboard" : "/Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />

    <style>

        /* =========================================================
           GLOBAL
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            background: #ffffff;
            color-scheme: light;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #ffffff;
            color: #20283a;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }

        ::selection {
            background: rgba(155,44,255,.25);
        }


        /* =========================================================
           APP SHELL
        ========================================================= */

        .app-shell {
            display: flex;
            min-height: 100vh;
        }


        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar {
            width: 264px;
            flex-shrink: 0;

            background:
                radial-gradient(circle at 0% 30%, rgba(139,34,255,.18), transparent 30%),
                linear-gradient(180deg, #070c22 0%, #0a1028 100%);

            color: #ffffff;

            display: flex;
            flex-direction: column;

            padding: 20px 18px;

            position: sticky;
            top: 0;
            height: 100vh;
            z-index: 1;

            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;

            transition: width .3s cubic-bezier(.22,1,.36,1), min-width .3s cubic-bezier(.22,1,.36,1), padding .3s cubic-bezier(.22,1,.36,1), opacity .2s ease;
        }

        .sidebar::-webkit-scrollbar {
            width: 0;
            height: 0;
        }

        .sidebar.is-hidden {
            width: 0;
            min-width: 0;
            padding: 20px 0;
            opacity: 0;
            pointer-events: none;
        }

        .sidebar-wave-img {
            position: absolute;
            left: 0;
            bottom: 60px;
            width: 100%;
            height: auto;
            pointer-events: none;
            z-index: -1;
            opacity: .9;
        }

        .side-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .side-brand {
            display: flex;
            align-items: center;
            gap: 10px;

            padding: 0 6px;

            min-width: 0;
        }

        .side-brand-full {
            height: 34px;
            width: auto;
            flex-shrink: 0;

            display: block;

            filter: drop-shadow(0 0 8px rgba(150,100,255,.4));
        }

        .side-nav-wrap {
            position: relative;
            margin-top: 22px;
        }

        .side-nav-wrap::before {
            content: "";
            position: absolute;
            top: -34px;
            left: -34px;
            right: -34px;
            bottom: 0;
            z-index: -1;
            pointer-events: none;

            background:
                radial-gradient(circle at 12% 5%, rgba(35,110,234,.2), transparent 30%),
                radial-gradient(circle at 88% 14%, rgba(163,38,255,.18), transparent 32%),
                radial-gradient(circle at 18% 50%, rgba(24,169,255,.16), transparent 30%),
                radial-gradient(circle at 85% 62%, rgba(163,38,255,.14), transparent 32%),
                radial-gradient(circle at 30% 90%, rgba(35,110,234,.16), transparent 34%);

            filter: blur(14px);
        }

        .side-nav-glass {
            position: relative;

            padding: 8px;

            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.12);

            background: rgba(255,255,255,.03);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);

            box-shadow: 0 8px 30px rgba(0,0,0,.18);
        }

        .side-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .side-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;

            padding: 9px 14px;

            border-radius: 10px;

            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 500;

            position: relative;

            color: rgba(255,255,255,.75);
            transition: background .25s ease, color .25s ease, transform .2s ease;
        }

        a.side-nav-item:hover {
            background: rgba(255,255,255,.06);
            color: #ffffff;
            transform: translateX(3px);
        }

        a.side-nav-item:active {
            transform: translateX(3px) scale(.97);
        }

        .side-nav-item.is-active {
            color: #ffffff;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.35),
                inset 0 0 0 1px rgba(255,255,255,.18),
                0 8px 25px rgba(106, 37, 213, .25);
        }

        .nav-chevron {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
            opacity: 0;
            transition: opacity .2s ease;
        }

        .side-nav-item.is-active .nav-chevron {
            opacity: 1;
        }

        .nav-label {
            flex: 1;
            min-width: 0;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;

            white-space: nowrap;
        }

        .nav-letter {
            display: none;
            position: relative;
            flex-shrink: 0;

            width: 30px;
            height: 30px;

            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: rgba(255,255,255,.06);

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 12.5px;
        }

        .nav-dot {
            position: absolute;
            top: -2px;
            right: -2px;

            width: 9px;
            height: 9px;
            border-radius: 50%;

            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            border: 2px solid #0a1028;
        }


        .unread-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            min-width: 20px;
            height: 20px;
            padding: 0 6px;

            border-radius: 20px;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

            font-size: 10.5px;
            font-weight: 700;
            color: #ffffff;
        }

        .side-foot {
            margin-top: auto;
            padding: 12px 8px 0;
        }

        .side-foot-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 10px;
            min-width: 0;
        }

        .side-foot-avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;

            width: 36px;
            height: 36px;

            border-radius: 50%;
            border: 2px solid rgba(255,255,255,.12);
            background: linear-gradient(145deg, #c93cff, #4e38ff 55%, #159cff);

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 12px;
            color: #ffffff;
            overflow: hidden;
        }

        .side-foot-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .side-foot-identity {
            min-width: 0;
        }

        .side-foot-company {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            color: #ffffff;

            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .side-foot-role {
            margin-top: 2px;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #afb4c6;
        }

        .side-logout-form {
            margin-top: 0;
        }

        .side-logout-btn {
            width: 100%;

            padding: 10px;

            border: 0;
            border-top: 1px solid rgba(255,255,255,.08);
            background: transparent;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;

            color: #dce0ea;

            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 500;

            cursor: pointer;
            transition: .2s;
        }

        .logout-mark {
            display: flex;
            width: 16px;
            height: 16px;
        }

        .logout-mark svg {
            width: 100%;
            height: 100%;
        }

        .side-logout-btn:hover {
            color: #ffffff;
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .main {
            flex: 1;
            min-width: 0;
            min-height: 100vh;

            padding: 34px 42px 60px;

            /* Exact Influencer-side page wash (brandora-influencer-dashboard.css
               .dashboard-page) — a soft blue tint, not flat white. */
            background:
                radial-gradient(ellipse at 66% 2%, #dceeff88, transparent 50%),
                linear-gradient(130deg, #f3faff, #f7fbff 65%, #edf6ff);
        }


        /* =========================================================
           SHARED: PAGE HERO
           Reproduces the Influencer side's exact hero-card visual
           system (brandora-influencer-dashboard.css: .dashboard-hero /
           .dashboard-glass / .dashboard-hero-motto) so every Brand page
           that includes this markup automatically matches it, in one
           place, without per-page duplication.
        ========================================================= */

        .page-hero {
            position: relative;
            isolation: isolate;

            display: flex;
            align-items: center;
            min-height: 170px;

            margin: 0 0 26px;
            padding: 26px 40px;

            border-radius: 18px;
            overflow: hidden;

            background:
                radial-gradient(ellipse at 61% 0%, #a9c9ff99, transparent 58%),
                linear-gradient(110deg, #edf8ff55, #dcefff99 55%, #edf8ff55);
            border: 1px solid #d1e2ff;

            animation: fade-up .5s ease both;
        }

        .page-hero-waves {
            position: absolute;
            inset: auto 0 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .page-hero-intro {
            position: relative;
            z-index: 2;
            max-width: 52%;
        }

        .page-hero-eyebrow {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            color: #4b6398;
        }

        .page-hero-title {
            margin-top: 6px;

            font-family: 'Playfair Display', Georgia, serif;
            font-weight: 600;
            font-size: clamp(24px, 2.6vw, 34px);
            line-height: 1.2;
            letter-spacing: -.5px;
            color: #171d3d;
        }

        .page-hero-title span {
            background: linear-gradient(115deg, #7224ff, #3735ff 55%, #087fff);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
        }

        .page-hero-sub {
            margin-top: 8px;
            max-width: 480px;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            line-height: 1.55;
            color: #426098;
        }

        .page-hero-stats {
            display: flex;
            gap: 26px;
            margin-top: 14px;
        }

        .page-hero-stats > div + div {
            border-left: 1px solid #9ebce9;
            padding-left: 26px;
        }

        .page-hero-stats dd {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.1;
            color: #171d3d;
        }

        .page-hero-stats dt {
            margin: 2px 0 0;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 500;
            color: #2b467d;
        }

        .page-hero-art {
            position: absolute;
            z-index: 1;
            width: 230px;
            height: 200px;
            left: 48%;
            top: 22px;
            transform: rotate(10deg) skewX(-3deg);
        }

        .hero-glass {
            position: absolute;
            border: 1px solid #ffffffb8;
            border-radius: 18px;
            background: linear-gradient(125deg, #ffffff80, #d4ebff35 55%, #ffffff5c);
            box-shadow: inset 0 0 20px #ffffff44, 0 10px 30px #4488da0b;
        }

        .hero-glass-back {
            inset: 0;
        }

        .hero-glass-front {
            inset: 22px 18px -18px 16px;
            padding: 17px 19px;

            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            line-height: 1.4;
            color: #244988;

            backdrop-filter: blur(1px);
        }

        .hero-glass-copy {
            display: block;
            transform: skewX(3deg) rotate(-10deg);
            transform-origin: top left;
            padding-top: 3px;
        }

        .hero-glass-copy > span,
        .page-hero-motto span {
            display: block;
            width: 34px;
            height: 3px;
            margin-top: 11px;

            border-radius: 4px;
            background: linear-gradient(110deg, #6323ff, #0759ff);
        }

        .hero-sparkle {
            position: absolute;
            top: 20px;
            right: -6px;
            width: 16px;
            height: 16px;
            background: radial-gradient(ellipse, white, transparent 65%);
        }

        .hero-sparkle::before,
        .hero-sparkle::after {
            content: "";
            position: absolute;
            inset: 7px -4px;
            background: linear-gradient(90deg, transparent, white, transparent);
        }

        .hero-sparkle::after {
            transform: rotate(90deg);
        }

        .page-hero-motto {
            margin-left: auto;
            padding: 4px 4% 4px 32px;

            position: relative;
            z-index: 2;

            border-left: 1px solid #adcdec;

            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            line-height: 1.5;
            color: #1e427c;
        }

        @@media(max-width: 1100px) {
            .page-hero-art { left: auto; right: 26px; }
            .page-hero-intro { max-width: 60%; }
        }

        @@media(max-width: 900px) {
            .page-hero-motto { display: none; }
        }

        @@media(max-width: 760px) {
            .page-hero { padding: 22px 24px; flex-wrap: wrap; }
            .page-hero-art { display: none; }
            .page-hero-intro { max-width: 100%; }
        }


        /* =========================================================
           SHARED: STAT CARDS
           Matches the Influencer side's .dashboard-stat/.dashboard-card:
           white-to-ice glass card, soft tinted icon circle, value/label
           row and footer accent-dash. Only the small icon circle carries
           a tint; the card surface always stays in the blue glass theme.
        ========================================================= */

        .metric-band {
            margin-top: 22px;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .metric-block {
            position: relative;
            overflow: hidden;
            isolation: isolate;

            min-height: 116px;
            padding: 16px 17px 12px;

            display: flex;
            flex-direction: column;

            border-radius: 11px;
            border: 1px solid #cfe2ff;

            background: linear-gradient(135deg, #ffffffbd, #f5faff8c 55%, #fafdffd9);
            box-shadow: inset 0 1px 2px #fff, 0 3px 10px #6f9bce07;

            transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s ease, border-color .3s ease;

            opacity: 0;
            transform: translateY(18px);
        }

        .metric-block::before {
            content: "";
            position: absolute;
            width: 150px;
            height: 240px;
            right: -57px;
            top: -25px;
            transform: rotate(36deg);
            background: linear-gradient(130deg, #d6eaff77, transparent 75%);
            border-radius: 65% 38% 0 0;
            z-index: -1;
        }

        .metric-block.is-visible {
            opacity: 1;
            transform: translateY(0);
            transition: opacity .5s ease, transform .5s cubic-bezier(.22,1,.36,1), box-shadow .3s ease, border-color .3s ease;
        }

        a.metric-block:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 34px rgba(30,34,90,.12);
            border-color: #a9c9ff;
        }

        .metric-main {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .metric-main > div {
            min-width: 0;
        }

        .metric-icon {
            display: grid;
            place-items: center;
            flex-shrink: 0;

            width: 46px;
            height: 46px;

            border-radius: 50%;
            background: #ebe8ff;
            color: #6545ff;
        }

        .metric-icon svg {
            width: 20px;
            height: 20px;
        }

        /* Soft tinted chips — the exact .violet/.cyan/.mint/.amber/.pink
           values from brandora-influencer-dashboard/payments.css. */
        .metric-block.tone-a .metric-icon { background: #ebe8ff; color: #6545ff; }
        .metric-block.tone-b .metric-icon { background: #e2efff; color: #176cff; }
        .metric-block.tone-c .metric-icon { background: #def7fc; color: #139fc1; }
        .metric-block.tone-d .metric-icon { background: #e2f7ed; color: #0d9c6c; }
        .metric-block.tone-e .metric-icon { background: #fdf0dc; color: #c07d16; }
        .metric-block.tone-f .metric-icon { background: #f6ecfa; color: #b554b5; }

        .metric-label {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 500;
            color: #56617f;
            margin-bottom: 5px;
        }

        .metric-value {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 24px;
            line-height: 1.25;
            color: #171d3d;
        }

        .metric-context {
            margin-top: 3px;
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            line-height: 1.5;
            color: #6681af;
        }

        .metric-footer {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: auto;
            padding-top: 12px;
        }

        .metric-accent {
            flex-shrink: 0;
            display: block;
            height: 2px;
            width: 20px;
            border-radius: 3px;
            background: linear-gradient(110deg, #6323ff, #0759ff);
        }

        .metric-footer-link {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            color: #2b467d;
            white-space: nowrap;
        }

        .metric-flag {
            position: absolute;
            top: 16px;
            right: 16px;
            z-index: 1;

            width: 8px;
            height: 8px;
            border-radius: 50%;

            background: linear-gradient(105deg, #3735ff, #087fff);
            box-shadow: 0 0 0 4px rgba(8,127,255,.16);

            animation: metric-flag-pulse 2s ease-in-out infinite;
        }

        @@keyframes metric-flag-pulse {
            0%, 100% { opacity: .7; }
            50% { opacity: 1; }
        }

        @@media(max-width: 900px) {
            .metric-band { grid-template-columns: repeat(2, 1fr); }
        }

        @@media(max-width: 560px) {
            .metric-band { grid-template-columns: 1fr; }
        }


        /* =========================================================
           SHARED: PANELS, EMPTY STATES, PILLS, BUTTONS
        ========================================================= */

        .panel {
            position: relative;
            padding: 20px 22px;

            border-radius: 12px;
            border: 1px solid #cfe2ff;
            background: linear-gradient(135deg, #ffffffbd, #f5faff8c 55%, #fafdffd9);
            box-shadow: inset 0 1px 2px #fff, 0 3px 10px #6f9bce07;

            animation: fade-up .5s ease both;
        }

        .panel-title {
            font-family: 'Playfair Display', Georgia, serif;
            font-weight: 600;
            font-size: 19px;
            line-height: 1.3;
            letter-spacing: -.4px;
            color: #0b084e;
        }

        .panel-sub {
            margin-top: 3px;

            font-family: 'Inter', sans-serif;
            font-size: 12px;
            line-height: 1.5;
            color: #5877ac;
        }

        .empty-block {
            margin-top: 18px;
            padding: 28px 20px;

            border-radius: 11px;
            border: 1px dashed #c9dcf8;
            background: #f3f8ffaa;

            text-align: center;
        }

        .empty-title {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 14px;
            color: #101d48;
        }

        .empty-text {
            margin-top: 6px;

            font-family: 'Inter', sans-serif;
            font-size: 12px;
            line-height: 1.6;
            color: #59699e;

            max-width: 360px;
            margin-left: auto;
            margin-right: auto;
        }

        .status-pill {
            display: inline-flex;
            width: fit-content;

            padding: 4px 11px;
            border-radius: 20px;

            font-family: 'Inter', sans-serif;
            font-size: 11.5px;
            font-weight: 600;
        }

        .status-pill.draft { background: #f8f0e3; color: #a05e12; }
        .status-pill.published { background: #e7eef8; color: #2362a9; }
        .status-pill.active { background: #e2faf1; color: #0d9c6c; }
        .status-pill.completed { background: #f3e8ff; color: #7a1fd6; }
        .status-pill.cancelled { background: #fde8ea; color: #c22540; }
        .status-pill.pending { background: #f8f0e3; color: #a05e12; }
        .status-pill.accepted { background: #e2faf1; color: #0d9c6c; }
        .status-pill.rejected { background: #fde8ea; color: #c22540; }
        .status-pill.submitted { background: #e7eef8; color: #2362a9; }
        .status-pill.approved { background: #e2faf1; color: #0d9c6c; }
        .status-pill.revisionrequested { background: #f8f0e3; color: #a05e12; }
        .status-pill.paid { background: #f3e8ff; color: #7a1fd6; }
        .status-pill.failed { background: #fde8ea; color: #c22540; }
        .status-pill.verified { background: #e2faf1; color: #0d9c6c; }

        .form-errors {
            margin-bottom: 18px;
            padding: 14px 16px;

            border-radius: 10px;
            border: 1px solid rgba(220,50,70,.25);
            background: rgba(220,50,70,.06);

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #a71b34;
        }

        .form-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            height: 46px;
            padding: 0 22px;

            border-radius: 10px;
            border: none;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            font-weight: 600;

            cursor: pointer;
            transition: .2s;
            white-space: nowrap;
        }

        .btn-primary {
            color: #ffffff;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            background-size: 160% 160%;
            background-position: 0% 50%;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            background-position: 100% 50%;
            box-shadow: 0 10px 26px rgba(140,60,255,.35);
        }

        .btn-primary:active {
            transform: translateY(0) scale(.98);
        }

        .btn-secondary {
            color: #0641ff;
            background: #ffffffb8;
            border: 1px solid #b4caff;
        }

        .btn-secondary:hover {
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow: 0 0 0 1.5px #9b2cff, 0 10px 22px rgba(140,60,255,.18);
        }

        .btn-secondary:active {
            transform: translateY(0);
        }

        .btn-ghost {
            color: #6b7290;
            background: transparent;
            border: 1px solid transparent;
        }

        .btn-ghost:hover {
            color: #9b2cff;
            background: rgba(155,44,255,.06);
        }

        .btn-outline-brand {
            color: #7a2df3;
            background: #ffffff;
            border: 1.5px solid rgba(163,38,255,.35);
        }

        .btn-outline-brand:hover {
            border-color: #a326ff;
            background: rgba(155,44,255,.06);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(140,60,255,.15);
        }

        .btn-outline-danger {
            color: #c22540;
            background: #ffffff;
            border: 1.5px solid #f6c3ca;
        }

        .btn-outline-danger:hover {
            border-color: transparent;
            color: #ffffff;
            background: linear-gradient(105deg, #ff4d6b, #d6234a);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(214,35,74,.25);
        }

        .btn-danger-solid {
            color: #ffffff;
            background: linear-gradient(105deg, #ff4d6b, #d6234a);
        }

        .btn-danger-solid:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(214,35,74,.3);
        }


        /* =========================================================
           SHARED: CHAT WIDGET
        ========================================================= */

        .chat-widget-backdrop {
            position: fixed;
            right: 26px;
            bottom: 26px;
            z-index: 210;

            opacity: 0;
            visibility: hidden;
            transform: translateY(16px) scale(.97);
            transform-origin: bottom right;
            transition: opacity .22s ease, visibility .22s ease, transform .22s cubic-bezier(.22,1,.36,1);
        }

        .chat-widget-backdrop.is-open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .chat-widget {
            width: min(380px, calc(100vw - 32px));
            height: min(560px, calc(100vh - 100px));

            display: flex;
            flex-direction: column;

            border-radius: 20px;
            background: #ffffff;
            border: 1px solid #eaecf5;
            box-shadow: 0 30px 70px rgba(20,20,60,.28);
            overflow: hidden;
        }

        .chat-widget-header {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 10px;

            padding: 14px 14px 14px 18px;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
        }

        .chat-widget-avatar {
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 12px;
            color: #ffffff;
            background: rgba(255,255,255,.25);
        }

        .chat-widget-name {
            flex: 1;
            min-width: 0;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-widget-icon-btn {
            width: 30px;
            height: 30px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 8px;
            border: none;
            background: rgba(255,255,255,.16);
            color: #ffffff;

            cursor: pointer;
            transition: background .2s ease;
        }

        .chat-widget-icon-btn:hover {
            background: rgba(255,255,255,.3);
        }

        .chat-widget-body {
            flex: 1;
            overflow: hidden;
            background: #f8f9fd;
        }

        .chat-widget-empty {
            padding: 30px 20px;
            text-align: center;
            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            color: #9096b3;
        }

        .chat-widget-messages {
            height: 100%;
            overflow-y: auto;
            padding: 16px;

            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .chat-widget-row {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            max-width: 84%;
        }

        .chat-widget-row.is-mine {
            align-self: flex-end;
            align-items: flex-end;
        }

        .chat-widget-bubble-row {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .chat-widget-row.is-mine .chat-widget-bubble-row {
            flex-direction: row-reverse;
        }

        .chat-widget-menu-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .chat-widget-menu-btn {
            width: 22px;
            height: 22px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: none;
            border-radius: 6px;
            background: transparent;
            color: #9096b3;

            cursor: pointer;
            opacity: 0;
            transition: opacity .15s ease, background .15s ease;
        }

        .chat-widget-row:hover .chat-widget-menu-btn {
            opacity: 1;
        }

        .chat-widget-menu-btn:hover {
            background: #eef0f8;
            color: #545b7d;
        }

        .chat-widget-menu {
            position: absolute;
            top: calc(100% + 4px);
            right: 0;
            z-index: 20;

            min-width: 120px;
            padding: 6px;

            border-radius: 10px;
            border: 1px solid #eaecf5;
            background: #ffffff;
            box-shadow: 0 12px 28px rgba(30,34,90,.16);

            display: none;
            flex-direction: column;
        }

        .chat-widget-row.is-mine .chat-widget-menu {
            right: auto;
            left: 0;
        }

        .chat-widget-menu.is-open {
            display: flex;
        }

        .chat-widget-menu-item {
            padding: 7px 10px;
            border: none;
            border-radius: 7px;
            background: transparent;
            text-align: left;

            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            color: #3c4363;

            cursor: pointer;
        }

        .chat-widget-menu-item:hover {
            background: #f4f5fa;
        }

        .chat-widget-menu-danger {
            color: #c22540;
        }

        .chat-widget-edit-form {
            margin-top: 4px;
            width: 100%;
        }

        .chat-widget-edit-input {
            width: 100%;
            min-height: 54px;
            padding: 8px 10px;

            border-radius: 10px;
            border: 1px solid #a978ff;
            background: #ffffff;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            color: #2a3157;
            outline: none;
            resize: vertical;
        }

        .chat-widget-edit-actions {
            margin-top: 6px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .chat-widget-edit-cancel,
        .chat-widget-edit-save {
            padding: 5px 12px;
            border-radius: 8px;
            border: none;
            font-family: 'Inter', sans-serif;
            font-size: 11.5px;
            font-weight: 700;
            cursor: pointer;
        }

        .chat-widget-edit-cancel {
            background: #f1f2f8;
            color: #545b7d;
        }

        .chat-widget-edit-save {
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
        }

        .chat-widget-attach-btn {
            width: 38px;
            height: 38px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            border: 1px solid #e2e5f2;
            background: #ffffff;
            color: #6b7290;

            cursor: pointer;
            transition: .2s;
        }

        .chat-widget-attach-btn:hover {
            border-color: #a978ff;
            color: #7a2df3;
        }

        .chat-widget-bubble {
            padding: 9px 13px;
            border-radius: 16px;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            line-height: 1.5;

            background: #ffffff;
            color: #2a3157;
            border: 1px solid #eaecf5;
            border-bottom-left-radius: 4px;
        }

        .chat-widget-row.is-mine .chat-widget-bubble {
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
            border: none;
            border-bottom-left-radius: 16px;
            border-bottom-right-radius: 4px;
        }

        .chat-widget-time {
            margin-top: 3px;
            padding: 0 4px;
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            color: #9096b3;
        }

        .chat-widget-media {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
        }

        .chat-widget-media-view {
            display: block;
            cursor: zoom-in;
        }

        .chat-widget-media img,
        .chat-widget-media video {
            display: block;
            width: 100%;
            max-width: 220px;
            max-height: 220px;
            object-fit: cover;
        }

        .chat-widget-media-download {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 2;

            width: 26px;
            height: 26px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            border: none;
            background: rgba(15,20,45,.55);
            color: #ffffff;
            backdrop-filter: blur(3px);

            transition: background .15s ease;
        }

        .chat-widget-media-download:hover {
            background: rgba(15,20,45,.8);
        }

        .chat-widget-bubble.has-media {
            padding: 6px;
        }

        .chat-widget-bubble.has-media.has-caption {
            padding-bottom: 10px;
        }

        .chat-widget-bubble.has-media .chat-widget-text {
            display: block;
            padding: 4px 6px 0;
        }

        .chat-widget-bubble.has-media:not(.has-caption) {
            padding: 0;
            background: none;
            border: none;
            border-radius: 0;
        }

        .chat-widget-composer {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 8px;

            padding: 12px 14px;
            border-top: 1px solid #eaecf5;
            background: #ffffff;
        }

        .chat-widget-composer input {
            flex: 1;
            min-width: 0;
            height: 40px;
            padding: 0 14px;

            border-radius: 20px;
            border: 1px solid #e2e5f2;
            background: #f8f9fd;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #171d3d;
            outline: none;
            transition: border-color .2s ease;
        }

        .chat-widget-composer input:focus {
            border-color: #a978ff;
        }

        .chat-widget-send {
            width: 38px;
            height: 38px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            border: none;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;

            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .chat-widget-send:hover {
            transform: translateY(-1px) scale(1.04);
            box-shadow: 0 8px 18px rgba(140,60,255,.3);
        }

        @@media(max-width: 480px) {
            .chat-widget-backdrop { right: 12px; bottom: 12px; left: 12px; }
            .chat-widget { width: 100%; }
        }


        /* =========================================================
           SHARED: CONFIRM MODAL
        ========================================================= */

        .confirm-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 200;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 20px;

            background: rgba(10,14,35,.45);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);

            opacity: 0;
            visibility: hidden;
            transition: opacity .2s ease, visibility .2s ease;
        }

        .confirm-modal-backdrop.is-open {
            opacity: 1;
            visibility: visible;
        }

        .confirm-modal {
            width: 100%;
            max-width: 380px;
            padding: 30px 28px 26px;

            border-radius: 20px;
            background: #ffffff;
            box-shadow: 0 30px 60px rgba(20,20,60,.25);

            text-align: center;

            transform: translateY(14px) scale(.96);
            transition: transform .25s cubic-bezier(.22,1,.36,1);
        }

        .confirm-modal-backdrop.is-open .confirm-modal {
            transform: translateY(0) scale(1);
        }

        .confirm-modal-icon {
            width: 46px;
            height: 46px;
            margin: 0 auto;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;

            font-family: 'DM Sans', sans-serif;
            font-weight: 800;
            font-size: 20px;
        }

        .confirm-modal-icon.is-danger {
            background: linear-gradient(105deg, #ff4d6b, #d6234a);
        }

        .confirm-modal-title {
            margin-top: 16px;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 16.5px;
            color: #171d3d;
        }

        .confirm-modal-text {
            margin-top: 8px;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            line-height: 1.6;
            color: #6b7290;
        }

        .confirm-modal-actions {
            margin-top: 22px;

            display: flex;
            gap: 10px;
        }

        .confirm-modal-actions .btn {
            flex: 1;
            height: 44px;
        }


        /* =========================================================
           SHARED: BACK TO DASHBOARD
        ========================================================= */

        .back-to-dashboard {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            margin-bottom: 18px;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            color: #5877ac;

            transition: color .2s ease;
        }

        .back-to-dashboard svg {
            transition: transform .2s ease;
        }

        .back-to-dashboard:hover {
            color: #1451ff;
        }

        .back-to-dashboard:hover svg {
            transform: translateX(-3px);
        }


        /* =========================================================
           SHARED: CREATOR PRIMITIVES
        ========================================================= */

        .tag {
            padding: 3px 10px;

            border-radius: 20px;
            background: #ffffffdf;
            border: 1px solid #d6e6ff;

            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            color: #101052;
        }

        .creator-avatar {
            width: 56px;
            height: 56px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 18px;
            color: #ffffff;

            transition: transform .35s cubic-bezier(.22,1,.36,1);
        }

        .verified-badge {
            display: inline-flex;
            align-items: center;
            flex-shrink: 0;
            gap: 4px;

            padding: 2px 9px;

            border-radius: 20px;
            background: #e4f0ff;
            color: #1265d6;
            white-space: nowrap;

            font-family: 'Inter', sans-serif;
            font-size: 10.5px;
            font-weight: 700;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .shortlist-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            height: 38px;
            padding: 0 16px;

            border-radius: 9px;
            border: 1px solid #dde1f0;
            background: #ffffff;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            color: #545b7d;

            cursor: pointer;
            transition: .2s;
        }

        .shortlist-btn:hover {
            border-color: #b7c0e0;
        }

        .shortlist-btn.is-saved {
            border-color: transparent;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
        }


        /* =========================================================
           SHARED: INFLUENCER-SIDE COMPONENT SYSTEM
           One place for the surfaces your Influencer pages use
           (brandora-influencer-dashboard / -payments / -upload-proof /
           -application-submitted / -campaign-details css): glass cards,
           soft icon chips, status badges, info rail cards, "what's
           next" timeline, guideline check-lists, FAQ accordion, dark
           help card, numbered flow stepper, fact lists and CTA banner.
        ========================================================= */

        .ui-card {
            position: relative;
            min-width: 0;
            padding: 18px 20px;
            border-radius: 12px;
            border: 1px solid #cfe2ff;
            background: linear-gradient(135deg, #ffffffbd, #f5faff8c 55%, #fafdffd9);
            box-shadow: inset 0 1px 2px #fff, 0 3px 10px #6f9bce07;
            animation: fade-up .5s ease both;
        }

        .ui-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 12px; }
        .ui-card-title { font: 600 19px/1.3 'Playfair Display', Georgia, serif; letter-spacing: -.4px; color: #0b084e; }
        .ui-card-sub { margin-top: 3px; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.5; color: #5877ac; }
        .ui-card-link { display: inline-flex; align-items: center; gap: 6px; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #1451ff; white-space: nowrap; }
        .ui-card-link i { transition: transform .2s ease; }
        .ui-card-link:hover i { transform: translateX(3px); }

        .icon-chip { display: grid; place-items: center; flex-shrink: 0; width: 42px; height: 42px; border-radius: 50%; font-size: 19px; background: #ebe8ff; color: #6545ff; }
        .icon-chip.sm { width: 34px; height: 34px; font-size: 15px; }
        .icon-chip.lg { width: 52px; height: 52px; font-size: 23px; }
        .icon-chip.violet { background: #ebe8ff; color: #6545ff; }
        .icon-chip.blue { background: #e2efff; color: #176cff; }
        .icon-chip.cyan { background: #def7fc; color: #139fc1; }
        .icon-chip.mint { background: #e2f7ed; color: #0d9c6c; }
        .icon-chip.amber { background: #fdf0dc; color: #c07d16; }
        .icon-chip.pink { background: #f6ecfa; color: #b554b5; }
        .icon-chip.soft { background: linear-gradient(135deg, #e4eeff, #cce2ff); color: #135bff; }

        .ui-badge { display: inline-flex; align-items: center; gap: 5px; width: fit-content; padding: 3px 10px; border-radius: 20px; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600; white-space: nowrap; }
        .ui-badge.is-success { background: #e2f7ed; color: #0d9c6c; }
        .ui-badge.is-info { background: #e7eefc; color: #2f5fd0; }
        .ui-badge.is-pending { background: #fdf0dc; color: #a05e12; }
        .ui-badge.is-danger { background: #fde8ea; color: #c22540; }
        .ui-badge.is-violet { background: #ebe8ff; color: #5b3df0; }
        .ui-badge.is-neutral { background: #edf1f8; color: #4d608c; }

        .page-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 16px; align-items: start; }
        .page-main, .page-rail { display: grid; gap: 16px; align-content: start; min-width: 0; }
        @@media(max-width: 1150px) { .page-grid { grid-template-columns: minmax(0, 1fr); } }

        .hero-highlights { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 14px; padding: 0; list-style: none; }
        .hero-highlights li { display: flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; color: #33477c; }
        .hero-highlights li::before { content: ''; flex-shrink: 0; width: 7px; height: 7px; border-radius: 50%; background: linear-gradient(110deg, #7557ff, #009fff); }

        .info-card {
            position: relative;
            overflow: hidden;
            padding: 18px 20px;
            border-radius: 12px;
            border: 1px solid #d6e6ff;
            background: radial-gradient(ellipse at 95% 100%, #c1ddff, transparent 65%), linear-gradient(120deg, #eff7ff, #e0eeff);
            animation: fade-up .5s ease both;
        }
        .info-card-head { display: flex; align-items: center; gap: 12px; }
        .info-card-title { font: 700 16px/1.3 'Playfair Display', Georgia, serif; color: #0b084e; }
        .info-card > p, .info-card-body > p { margin-top: 8px; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.6; color: #52649b; }
        .info-card-btn { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; padding: 8px 14px; border-radius: 10px; border: 1px solid #b7d3ff; background: #ffffffaa; box-shadow: 0 3px 8px #548cef12; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #1451ff; transition: .2s ease; }
        .info-card-btn:hover { background: #ffffff; border-color: #8fb8ff; transform: translateY(-1px); }

        .next-steps { list-style: none; margin: 14px 0 0 6px; padding: 0 0 0 26px; }
        .next-steps li { position: relative; padding-bottom: 18px; }
        .next-steps li:last-child { padding-bottom: 0; }
        .next-steps li::before { content: ''; position: absolute; left: -26px; top: 3px; width: 13px; height: 13px; border-radius: 50%; background: #a2b8e8; }
        .next-steps li.is-done::before { background: linear-gradient(130deg, #8a12ff, #0759ff 60%, #00b4ff); }
        .next-steps li.is-current::before { background: #0068ff; box-shadow: 0 0 0 4px #0068ff22; }
        .next-steps li:not(:last-child)::after { content: ''; position: absolute; left: -20px; top: 18px; bottom: -3px; width: 1px; background: #c1d7fa; }
        .next-steps h4 { margin: 0 0 3px; font-family: 'DM Sans', sans-serif; font-size: 12.5px; font-weight: 700; color: #101d48; }
        .next-steps p { margin: 0; font-family: 'Inter', sans-serif; font-size: 11.5px; line-height: 1.55; color: #59699e; }

        .check-list { display: grid; gap: 8px; margin: 12px 0 0; padding: 0; list-style: none; }
        .check-list li { display: flex; align-items: flex-start; gap: 8px; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.5; color: #4a5f98; }
        .check-list li i { margin-top: 1px; color: #087aff; }

        .faq-list details { border-top: 1px solid #e3edfc; }
        .faq-list details:first-child { border-top: 0; }
        .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; list-style: none; cursor: pointer; font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; color: #33477c; transition: color .2s ease; }
        .faq-list summary::-webkit-details-marker { display: none; }
        .faq-list summary:hover { color: #1451ff; }
        .faq-list summary i { flex-shrink: 0; font-size: 11px; color: #8095c4; transition: transform .2s ease; }
        .faq-list details[open] summary { color: #1451ff; }
        .faq-list details[open] summary i { transform: rotate(90deg); }
        .faq-list details p { margin: 0; padding-bottom: 12px; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.6; color: #5877ac; }

        .help-card { position: relative; isolation: isolate; overflow: hidden; padding: 20px; border-radius: 12px; background: linear-gradient(125deg, #040c20, #06163c 70%, #101b59); color: #ffffff; animation: fade-up .5s ease both; }
        .help-card h3 { margin: 0; font: 700 17px/1.3 'Playfair Display', Georgia, serif; color: #ffffff; }
        .help-card p { max-width: 260px; margin-top: 8px; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.6; color: #a9bbdf; }
        .help-card a { display: inline-flex; align-items: center; gap: 10px; margin-top: 14px; padding: 9px 20px; border-radius: 8px; border: 1px solid #7899e033; background: #17366580; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #ffffff; transition: .2s ease; }
        .help-card a:hover { background: #1f4a8acc; border-color: #7899e066; }
        .help-card svg { position: absolute; inset: auto 0 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }

        .fact-list { margin: 4px 0 0; }
        .fact-list > div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid #e3edfc; font-family: 'Inter', sans-serif; font-size: 12.5px; }
        .fact-list > div:first-child { border-top: 0; }
        .fact-list dt { font-weight: 400; color: #5877ac; }
        .fact-list dd { margin: 0; text-align: right; font-weight: 600; color: #101d48; overflow-wrap: anywhere; }

        .flow-steps { display: flex; align-items: center; gap: 16px; margin: 0 0 16px; padding: 16px 20px; list-style: none; border: 1px solid #e0ecfc; border-radius: 12px; background: #ffffff85; animation: fade-up .5s ease both; }
        .flow-steps li { display: flex; align-items: center; gap: 11px; flex: 1; min-width: 0; color: #546da6; }
        .flow-steps li:not(:last-child)::after { content: ''; flex: 1; min-width: 12px; height: 1px; margin-left: 7px; background: #bbcafa; }
        .flow-steps li.is-done::after { background: #7163ff; }
        .flow-step-num { display: grid; place-items: center; flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #c6d5f5, #afcdfb); color: #ffffff; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; }
        .flow-steps li:is(.is-done, .is-current) { color: #101d48; }
        .flow-steps li:is(.is-done, .is-current) .flow-step-num { background: linear-gradient(130deg, #8a12ff, #0759ff 60%, #00b4ff); box-shadow: inset 0 1px 3px #ffffff60; }
        .flow-steps li.is-current .flow-step-num { box-shadow: inset 0 1px 3px #ffffff60, 0 0 0 4px #5b4dff1f; }
        .flow-steps strong { display: block; font-family: 'DM Sans', sans-serif; font-size: 12.5px; font-weight: 700; }
        .flow-steps small { display: block; margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 10.5px; color: #687eb5; }
        @@media(max-width: 900px) {
            .flow-steps { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
            .flow-steps li::after { display: none; }
        }

        .motivation-card { padding: 22px 22px 26px; border-radius: 12px; border: 1px solid #d6e6ff; background: linear-gradient(120deg, #e0eeff, #edf6ff); }
        .motivation-card h3 { margin: 0; font: 700 21px/1.15 'Playfair Display', Georgia, serif; color: #0b084e; }
        .motivation-card span { display: block; width: 44px; height: 4px; margin-top: 14px; border-radius: 8px; background: linear-gradient(90deg, #7c23ff, #00b6ef); }

        .cta-banner { position: relative; isolation: isolate; display: flex; align-items: center; justify-content: space-between; gap: 24px; overflow: hidden; min-height: 104px; padding: 22px 26px; border-radius: 12px; background: radial-gradient(circle at 0% 30%, rgba(139,34,255,.18), transparent 30%), linear-gradient(180deg, #070c22 0%, #0a1028 100%); box-shadow: 0 18px 36px -12px rgba(7,12,34,.45), inset 0 1px 0 rgba(255,255,255,.12); color: #ffffff; }
        .cta-banner::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(ellipse at 8% 0%, rgba(139,34,255,.14), transparent 45%), radial-gradient(ellipse at 100% 100%, rgba(35,110,255,.16), transparent 50%); }
        .cta-banner h3 { margin: 0; font: 600 22px/1.35 'Playfair Display', Georgia, serif; color: #ffffff; }
        .cta-banner p { margin-top: 4px; font-family: 'Inter', sans-serif; font-size: 12.5px; color: #b8c6e8; }
        .cta-banner a, .cta-banner button { display: inline-flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 10px; border: 1px solid #64beff; background: linear-gradient(120deg, #258bff55, #468fff88); box-shadow: 0 8px 18px rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.24); font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; color: #ffffff; white-space: nowrap; cursor: pointer; transition: .2s ease; }
        .cta-banner a:hover, .cta-banner button:hover { transform: translateY(-2px); box-shadow: 0 0 22px rgba(35,110,255,.35); }
        @@media(max-width: 700px) { .cta-banner { flex-direction: column; align-items: flex-start; } }


        .metric-band.four { grid-template-columns: repeat(4, 1fr); }
        @@media(max-width: 1250px) { .metric-band.four { grid-template-columns: repeat(2, 1fr); } }
        @@media(max-width: 640px) { .metric-band.four { grid-template-columns: 1fr; } }

        /* ---- Detail hero (record pages: milestone, collaboration, proposal, campaign) ----
           Same surface as .page-hero, laid out like the Influencer
           Campaign Details hero: identity block + tags + stat row. */
        .detail-hero { align-items: stretch; flex-direction: column; min-height: 0; padding: 26px 34px 22px; }
        .detail-hero-top { position: relative; z-index: 2; display: flex; align-items: flex-start; gap: 20px; }
        .detail-hero-avatar { display: grid; place-items: center; flex: 0 0 76px; width: 76px; height: 76px; border-radius: 18px; background: #ffffff; box-shadow: 0 8px 24px #14265922; font: 600 24px 'Playfair Display', Georgia, serif; color: #123a85; overflow: hidden; }
        .detail-hero-avatar.is-person { border-radius: 50%; color: #ffffff; font-family: 'DM Sans', sans-serif; font-weight: 700; box-shadow: 0 8px 24px #3a2bb033, inset 0 0 8px #ffffff55; }
        .detail-hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .detail-hero-copy { min-width: 0; flex: 1; }
        .detail-hero-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
        .detail-hero-tags span { display: inline-flex; align-items: center; gap: 6px; padding: 5px 13px; border-radius: 20px; background: #ffffffcc; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600; color: #172857; }
        .detail-hero-tags span i { color: #5b4dff; }
        .detail-hero-copy h1 { margin: 0 0 6px; font: 600 clamp(24px, 2.6vw, 33px)/1.2 'Playfair Display', Georgia, serif; letter-spacing: -.6px; color: #101d48; overflow-wrap: anywhere; }
        .detail-hero-copy h1 span { background: linear-gradient(115deg, #7224ff, #3735ff 55%, #087fff); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
        .detail-hero-copy p { margin: 0; max-width: 620px; font-family: 'Inter', sans-serif; font-size: 13px; line-height: 1.55; color: #33477c; }
        .detail-hero-copy p a { color: #1451ff; font-weight: 600; }
        .detail-hero-side { position: relative; z-index: 2; flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
        .detail-hero-stats { position: relative; z-index: 2; display: flex; flex-wrap: wrap; margin: 20px 0 0; padding-top: 16px; border-top: 1px solid #ffffffa0; }
        .detail-hero-stats > div { padding: 0 26px; border-left: 1px solid #ffffffb0; }
        .detail-hero-stats > div:first-child { padding-left: 0; border-left: 0; }
        .detail-hero-stats dt { margin-bottom: 5px; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 500; color: #4a6099; }
        .detail-hero-stats dd { margin: 0; font-family: 'DM Sans', sans-serif; font-size: 18px; font-weight: 700; color: #101d48; }
        .detail-hero-stats dd small { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 500; color: #5877ac; }
        @@media(max-width: 760px) {
            .detail-hero { padding: 20px; }
            .detail-hero-top { flex-direction: column; }
            .detail-hero-side { align-items: flex-start; }
            .detail-hero-stats { gap: 12px; }
            .detail-hero-stats > div { padding: 0 14px 0 0; border-left: 0; }
        }

        .crumb-trail { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 14px; font-family: 'Inter', sans-serif; font-size: 12.5px; color: #5877ac; }
        .crumb-trail a { color: #5877ac; transition: color .2s ease; }
        .crumb-trail a:hover { color: #1451ff; }
        .crumb-trail i { font-size: 10px; color: #9fb3d9; }
        .crumb-trail strong { font-weight: 600; color: #142652; }

        /* ---- Notices (inline feedback, theme-toned) ---- */
        .notice { display: flex; align-items: flex-start; gap: 10px; margin: 0 0 14px; padding: 12px 16px; border-radius: 10px; border: 1px solid #c8e2f8; background: #eef8ff; font-family: 'Inter', sans-serif; font-size: 13px; line-height: 1.5; color: #34527b; animation: fade-up .4s ease both; }
        .notice i { margin-top: 1px; color: #1451ff; }
        .notice.is-success { border-color: #bfe9d6; background: #effbf5; color: #1c6a4b; }
        .notice.is-success i { color: #0d9c6c; }
        .notice.is-error { border-color: #f4c6cd; background: #fdf0f2; color: #a82749; }
        .notice.is-error i { color: #c22540; }

        /* ---- Decision card: the one thing the user should do next ---- */
        .decision-card { position: relative; overflow: hidden; isolation: isolate; padding: 22px 24px; border-radius: 14px; border: 1px solid #cddfff; background: radial-gradient(ellipse at 100% 0%, #d9e6ff, transparent 55%), radial-gradient(ellipse at 0% 100%, #efe6ff, transparent 50%), linear-gradient(130deg, #ffffffe6, #f3f8ffcc); box-shadow: 0 12px 30px -14px #3b5bdb33; animation: fade-up .5s ease both; }
        .decision-card-head { display: flex; align-items: flex-start; gap: 14px; }
        .decision-card-head .icon-chip { width: 48px; height: 48px; font-size: 21px; }
        .decision-card-eyebrow { font-family: 'Inter', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #5b4dff; }
        .decision-card-title { margin-top: 3px; font: 600 20px/1.3 'Playfair Display', Georgia, serif; letter-spacing: -.3px; color: #0b084e; }
        .decision-card-text { margin-top: 5px; font-family: 'Inter', sans-serif; font-size: 12.5px; line-height: 1.6; color: #52649b; }
        .decision-card-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 18px; }
        .decision-card-actions form { margin: 0; }
        .decision-card-note { display: flex; align-items: center; gap: 7px; margin-top: 14px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #6680ad; }
        .decision-card-note i { color: #1451ff; }
        .decision-breakdown { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 16px; border: 1px solid #dfebff; border-radius: 11px; background: #ffffffa6; }
        .decision-breakdown > div { padding: 12px 16px; border-left: 1px solid #e6effc; }
        .decision-breakdown > div:first-child { border-left: 0; }
        .decision-breakdown dt { font-family: 'Inter', sans-serif; font-size: 11px; color: #5877ac; }
        .decision-breakdown dd { margin: 3px 0 0; font-family: 'DM Sans', sans-serif; font-size: 17px; font-weight: 700; color: #101d48; }
        .decision-textarea { width: 100%; min-height: 76px; margin-top: 12px; padding: 11px 13px; resize: vertical; border-radius: 10px; border: 1px solid #d3e4ff; background: #ffffffcc; font-family: 'Inter', sans-serif; font-size: 13px; color: #20365f; transition: border-color .2s ease, box-shadow .2s ease; }
        .decision-textarea:focus { outline: none; border-color: #8f7bff; box-shadow: 0 0 0 3px #7862ef22; background: #ffffff; }
        .decision-textarea::placeholder { color: #7b8fbf; }
        .btn-bkash { display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 20px 0 8px; border-radius: 10px; border: 0; cursor: pointer; background: linear-gradient(105deg, #6425ff, #004dff 55%, #00a8f0); box-shadow: 0 10px 24px -8px #3b4dff80; font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 600; color: #ffffff; transition: .2s ease; }
        .btn-bkash:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -8px #3b4dffa0; }
        .btn-bkash .bkash-logo { display: grid; place-items: center; width: 32px; height: 32px; padding: 4px; border-radius: 8px; background: #ffffff; }
        .btn-bkash .bkash-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
        @@media(max-width: 640px) { .decision-breakdown { grid-template-columns: 1fr; } .decision-breakdown > div { border-left: 0; border-top: 1px solid #e6effc; } .decision-breakdown > div:first-child { border-top: 0; } }

        /* ---- Detail rows with round icon (Application Submitted style) ---- */
        .detail-rows { margin: 0; }
        .detail-rows > div { display: grid; grid-template-columns: 34% minmax(0, 1fr); gap: 12px; align-items: center; padding: 12px 0; border-top: 1px solid #e3edfc; }
        .detail-rows > div:first-child { border-top: 0; }
        .detail-rows dt { display: flex; align-items: center; gap: 12px; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; color: #33477c; }
        .detail-rows dt .icon-chip { width: 36px; height: 36px; font-size: 16px; background: linear-gradient(135deg, #e4eeff, #cce2ff); color: #135bff; }
        .detail-rows dd { margin: 0; font-family: 'Inter', sans-serif; font-size: 13px; color: #101d48; overflow-wrap: anywhere; white-space: pre-wrap; }
        .detail-rows dd small { display: block; margin-top: 3px; font-size: 11px; color: #59699e; white-space: normal; }
        @@media(max-width: 560px) { .detail-rows > div { grid-template-columns: 1fr; gap: 6px; } }

        /* ---- Proof-of-post preview ---- */
        .proof-preview { position: relative; overflow: hidden; border-radius: 12px; border: 1px solid #dfebfc; background: linear-gradient(125deg, #f0f5ffb0, #f5f6ff90); }
        .proof-preview img, .proof-preview video { display: block; width: 100%; max-height: 460px; object-fit: contain; background: radial-gradient(ellipse at 50% 0%, #dbe8ff, transparent 70%), linear-gradient(135deg, #eef4ff, #f4efff); }
        .proof-preview-link { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 34px 20px; text-align: center; font-family: 'Inter', sans-serif; font-size: 12px; color: #6b7fb1; }
        .proof-preview-link > i { font-size: 32px; color: #096aff; }
        .proof-preview-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 14px; border-top: 1px solid #e3edfc; background: #ffffffcc; font-family: 'Inter', sans-serif; font-size: 12px; color: #5877ac; }
        .proof-preview-bar a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: #1451ff; }
        .proof-quote { display: flex; gap: 10px; margin-top: 12px; padding: 12px 14px; border-radius: 10px; background: #eef4ffbd; border: 1px solid #dfe9ff; font-family: 'Inter', sans-serif; font-size: 12.5px; line-height: 1.6; color: #33477c; }
        .proof-quote i { color: #5b4dff; }

        /* ---- Person card (creator / brand summary in a rail) ---- */
        .person-card-top { display: flex; align-items: center; gap: 12px; }
        .person-avatar { display: grid; place-items: center; flex-shrink: 0; width: 48px; height: 48px; border-radius: 50%; color: #ffffff; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700; box-shadow: inset 0 0 6px #ffffff55; }
        .person-name { display: flex; align-items: center; gap: 6px; font-family: 'DM Sans', sans-serif; font-size: 14.5px; font-weight: 700; color: #101d48; }
        .person-name i { color: #1d7bff; font-size: 13px; }
        .person-handle { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #5877ac; }
        .person-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 14px; }
        .person-stats > div { padding: 9px 6px; border-radius: 9px; border: 1px solid #e1ecfa; background: #fafdff99; text-align: center; }
        .person-stats strong { display: block; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 700; color: #101d48; }
        .person-stats span { font-family: 'Inter', sans-serif; font-size: 10.5px; color: #5877ac; }
        .person-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }
        .person-actions a, .person-actions button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; border-radius: 9px; border: 1px solid #d7e8ff; background: #ffffffb8; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #1451ff; cursor: pointer; transition: .2s ease; }
        .person-actions a:hover, .person-actions button:hover { border-color: #1451ff; transform: translateY(-1px); }


        /* =========================================================
           MOTION
        ========================================================= */

        @@keyframes fade-up {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        /* =========================================================
           TOPBAR
        ========================================================= */

        .main-topbar {
            position: sticky;
            top: 0;
            z-index: 30;

            display: flex;
            align-items: center;
            gap: 16px;

            padding: 16px 42px;
            margin: -34px -42px 28px;

            background: linear-gradient(120deg, #eef6ffcc, #f3faffcc);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid #d1e2ff;
        }

        .topbar-menu-btn {
            flex-shrink: 0;

            width: 34px;
            height: 34px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 0;
            background: transparent;

            color: #172952;
            cursor: pointer;

            transition: .2s;
        }

        .topbar-menu-btn:hover {
            color: #9b2cff;
        }

        .topbar-search {
            flex: 1;
            max-width: 465px;
        }

        .topbar-search input {
            width: 100%;
            height: 44px;

            padding: 0 18px;

            border-radius: 12px;
            border: 1px solid #d1e2ff;
            background: #ffffffb8;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            color: #20365f;

            outline: none;
            transition: .2s;
            box-shadow: 0 3px 12px #7ea8da0a;
        }

        .topbar-search input::placeholder {
            color: #5a74a8;
            opacity: 1;
        }

        .topbar-search input:focus {
            border-color: #a978ff;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(155,44,255,.1);
        }

        .topbar-actions {
            margin-left: auto;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            gap: 14px;
        }

        .topbar-icon-btn {
            position: relative;
            flex-shrink: 0;

            width: 40px;
            height: 40px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 0;
            border-radius: 12px;
            background: #e4f0ff;
            transition: background .2s ease;

            color: #101d48;
            transition: .2s;
        }

        .topbar-icon-btn svg {
            width: 22px;
            height: 22px;
        }

        .topbar-icon-btn:hover {
            background: #d3e6ff;
            color: #101d48;
        }

        .topbar-badge {
            position: absolute;
            top: 4px;
            right: 5px;

            width: 10px;
            height: 10px;

            border-radius: 50%;
            background: #f75177;
            border: 2px solid #e4f0ff;

            display: flex;
            align-items: center;
            justify-content: center;

            font-family: 'Inter', sans-serif;
            font-size: 9.5px;
            font-weight: 700;
            color: #ffffff;
        }

        .topbar-cta {
            flex-shrink: 0;

            height: 40px;
            padding: 0 20px;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;

            border-radius: 10px;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 700;
            color: #ffffff;
            white-space: nowrap;

            transition: transform .2s ease, box-shadow .2s ease;
        }

        .topbar-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(140,60,255,.3);
        }

        .topbar-profile-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .topbar-account {
            display: flex;
            align-items: center;
            gap: 10px;

            border: none;
            border-left: 1px solid #c8dfff;
            background: transparent;

            padding: 0 0 0 18px;
            max-width: 265px;

            cursor: pointer;
            transition: .2s;
        }

        .topbar-profile {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;

            width: 38px;
            height: 38px;
            overflow: hidden;

            border-radius: 50%;

            background: radial-gradient(circle at 70% 65%, #5086ff, #4f12ff);
            box-shadow: inset 0 0 6px #ffffff55;
            color: #ffffff;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 14px;

            transition: transform .2s ease, box-shadow .2s ease;
        }

        .topbar-account:hover .topbar-profile {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(140,60,255,.3);
        }

        .topbar-profile-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .topbar-account-text {
            min-width: 0;
            text-align: left;
        }

        .topbar-account-text strong {
            display: block;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 700;
            color: #101d48;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .topbar-account-text small {
            display: block;
            margin-top: 2px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            color: #476499;
        }

        .topbar-account-chevron {
            flex-shrink: 0;
            color: #476499;
            transition: transform .2s ease;
        }

        .topbar-profile-wrap.is-open .topbar-account-chevron {
            transform: rotate(180deg);
        }

        .profile-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            z-index: 50;

            width: 260px;

            border-radius: 16px;
            border: 1px solid #eaecf5;
            background: #ffffff;
            box-shadow: 0 20px 46px rgba(30,34,90,.16);

            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(.98);
            transform-origin: top right;
            transition: opacity .18s ease, transform .18s cubic-bezier(.22,1,.36,1), visibility .18s;
        }

        .topbar-profile-wrap.is-open .profile-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .profile-dropdown-head {
            display: flex;
            align-items: center;
            gap: 12px;

            padding: 16px;
            border-bottom: 1px solid #f0f1f7;
        }

        .profile-dropdown-avatar {
            flex-shrink: 0;
            overflow: hidden;

            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: linear-gradient(135deg, #a326ff, #236eff);
            color: #ffffff;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

        .profile-dropdown-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-dropdown-identity {
            min-width: 0;
        }

        .profile-dropdown-name {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 13.5px;
            color: #171d3d;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-dropdown-email {
            margin-top: 2px;

            font-family: 'Inter', sans-serif;
            font-size: 11.5px;
            color: #8189a8;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-dropdown-links {
            padding: 8px;
        }

        .profile-dropdown-links a {
            display: block;
            padding: 10px 12px;

            border-radius: 9px;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 500;
            color: #2a3157;

            transition: background .15s ease, color .15s ease;
        }

        .profile-dropdown-links a:hover {
            background: rgba(155,44,255,.06);
            color: #7a1fd6;
        }

        .profile-dropdown-logout {
            padding: 8px;
            border-top: 1px solid #f0f1f7;
        }

        .profile-dropdown-logout button {
            width: 100%;
            padding: 10px 12px;

            border: none;
            border-radius: 9px;
            background: transparent;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #c22540;
            text-align: left;
            cursor: pointer;

            transition: background .15s ease;
        }

        .profile-dropdown-logout button:hover {
            background: rgba(220,50,70,.06);
        }

        .topbar-notif-wrap {
            position: relative;
        }

        .notif-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            z-index: 50;

            width: 340px;
            max-width: calc(100vw - 32px);
            max-height: 420px;
            overflow-y: auto;

            border-radius: 16px;
            border: 1px solid #eaecf5;
            background: #ffffff;
            box-shadow: 0 20px 46px rgba(30,34,90,.16);

            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(.98);
            transform-origin: top right;
            transition: opacity .18s ease, transform .18s cubic-bezier(.22,1,.36,1), visibility .18s;
        }

        .topbar-notif-wrap.is-open .notif-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .notif-dropdown-head {
            padding: 16px 18px 12px;
            border-bottom: 1px solid #f0f1f7;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 15px;
            color: #171d3d;
        }

        .notif-dropdown-list {
            padding: 6px;
        }

        .notif-dropdown-item {
            display: block;
            padding: 10px 12px;
            border-radius: 10px;
            border-bottom: 1px solid #f0f1f7;
            transition: background .15s ease;
        }

        .notif-dropdown-item:last-child {
            border-bottom: none;
        }

        .notif-dropdown-item:hover {
            background: rgba(155,44,255,.06);
        }

        .notif-dropdown-item-title {
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            font-size: 13.5px;
            color: #171d3d;
        }

        .notif-dropdown-item-body {
            margin-top: 3px;
            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            color: #4f6ea8;
            line-height: 1.4;
        }

        .notif-dropdown-item.is-unread .notif-dropdown-item-title::before {
            content: "";
            display: inline-block;
            width: 6px;
            height: 6px;
            margin-right: 6px;
            border-radius: 50%;
            background: #a326ff;
        }

        .notif-dropdown-empty {
            padding: 28px 18px;
            text-align: center;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #8189a8;
        }

        .notif-dropdown-foot {
            padding: 8px;
            border-top: 1px solid #f0f1f7;
        }

        .notif-dropdown-foot a {
            display: block;
            padding: 10px 12px;
            border-radius: 9px;
            text-align: center;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #7a1fd6;
            transition: background .15s ease;
        }

        .notif-dropdown-foot a:hover {
            background: rgba(155,44,255,.06);
        }

        @@media(max-width: 700px) {
            .topbar-search { display: none; }
        }

        @@media(max-width: 560px) {
            .topbar-account-text { display: none; }
            .topbar-account { padding-left: 10px; }
        }

        @@media(max-width: 480px) {
            .main-topbar { padding: 14px 18px; margin: -18px -14px 22px; gap: 10px; }
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media(max-width: 820px) {
            .app-shell { flex-direction: column; }
            .sidebar { width: 100%; height: auto; position: relative; top: 0; flex-direction: row; align-items: center; overflow-x: auto; }
            .sidebar.is-hidden { width: 100%; min-width: 0; padding: 20px 18px; opacity: 1; pointer-events: auto; }
            .side-nav { margin-top: 0; margin-left: 24px; flex-direction: row; }
            .side-foot { display: none; }
            .main { padding: 24px 18px 40px; }
            .main-topbar { margin: -24px -18px 24px; padding: 14px 18px; }
        }

        @@media(max-width: 480px) {
            .sidebar { padding: 14px; }
            .side-top { flex: 1; }
            .side-brand-full { height: 28px; }
            .side-nav { margin-left: 14px; gap: 4px; }
            .side-nav-item { padding: 8px 10px; }
            .nav-label { font-size: 12px; }
            .main { padding: 18px 14px 32px; }
            .page-title { font-size: 22px !important; }
        }

        @RenderSection("Styles", required: false)

    </style>
</head>
<body>

<div class="app-shell">

    <aside class="sidebar" id="brandoraSidebar">

        <img src="~/images/Sidebar Wave.png" alt="" class="sidebar-wave-img" />

        <div class="side-top">
            <a href="@homeAppUrl" class="side-brand">
                <img src="~/images/Brandora.png" alt="Brandora" class="side-brand-full" />
            </a>
        </div>

        <div class="side-nav-wrap">
        <div class="side-nav-glass">
        <nav class="side-nav">
            @{
                var unread = ViewData["UnreadNotifications"] as int? ?? 0;
                var unreadMessages = ViewData["UnreadMessages"] as int? ?? 0;
            }

            @{
                // _AppLayout is only ever rendered by real Brand-side controllers
                // (BrandControllerBase); every Influencer-facing page is a
                // self-contained Layout = null view with its own sidebar
                // (see Views/Shared/_InfluencerSidebar.cshtml convention), so
                // this layout only needs to render the Brand nav.
            }
                @{
                    var navChevron = Html.Raw("<svg class=\"nav-chevron\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>");
                }

                <a href="/Dashboard" data-nav-key="Dashboard" class="side-nav-item @(activeNav == "Dashboard" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">Dashboard</span>
                    @navChevron
                </a>

                <a href="/Campaigns" data-nav-key="Campaigns" class="side-nav-item @(activeNav == "Campaigns" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">Campaigns</span>
                    @navChevron
                </a>

                <a href="/Proposals" data-nav-key="Applications" class="side-nav-item @(activeNav == "Applications" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">
                        Applications
                        @{ var pendingApplicants = ViewData["PendingApplicantCount"] as int? ?? 0; }
                        @if (pendingApplicants > 0)
                        {
                            <span class="unread-badge">@(pendingApplicants > 9 ? "9+" : pendingApplicants.ToString())</span>
                        }
                    </span>
                    @navChevron
                </a>

                <a href="/Influencers" data-nav-key="Influencers" class="side-nav-item @(activeNav == "Influencers" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">Find Influencers</span>
                    @navChevron
                </a>

                <a href="/Collaborations" data-nav-key="Collaborations" class="side-nav-item @(activeNav == "Collaborations" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">Manage Collaborations</span>
                    @navChevron
                </a>

                <a href="/Messages" data-nav-key="Messages" class="side-nav-item @(activeNav == "Messages" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">
                        Messages
                        @if (unreadMessages > 0)
                        {
                            <span class="unread-badge">@(unreadMessages > 9 ? "9+" : unreadMessages.ToString())</span>
                        }
                    </span>
                    @navChevron
                </a>

                <a href="/Payments" data-nav-key="Finance" class="side-nav-item @(activeNav == "Finance" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">Finance</span>
                    @navChevron
                </a>

                <a href="/Analytics" data-nav-key="Analytics" class="side-nav-item @(activeNav == "Analytics" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">Analytics</span>
                    @navChevron
                </a>

                <a href="/Settings/Profile" data-nav-key="Profile" class="side-nav-item @(activeNav == "Profile" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">Brand Profile</span>
                    @navChevron
                </a>

                <a href="/Settings" data-nav-key="Settings" class="side-nav-item @(activeNav == "Settings" ? "is-active" : "")">
                    <span class="nav-label side-toggle-hide">Settings</span>
                    @navChevron
                </a>

        </nav>
        </div>
        </div>

        <div class="side-foot">

            <div class="side-foot-user side-toggle-hide">
                @{
                    var footPicUrl = ViewData["ProfilePictureUrl"] as string;
                    var footCompanyName = ViewData["CompanyName"] as string ?? "Brand";
                    var footInitial = string.IsNullOrEmpty(footCompanyName) ? "B" : footCompanyName[..1].ToUpperInvariant();
                }
                <div class="side-foot-avatar">
                    @if (!string.IsNullOrEmpty(footPicUrl))
                    {
                        <img src="@footPicUrl" alt="@footCompanyName" />
                    }
                    else
                    {
                        @footInitial
                    }
                </div>
                <div class="side-foot-identity">
                    <div class="side-foot-company">@footCompanyName</div>
                    <div class="side-foot-role">Brand</div>
                </div>
            </div>

            <form method="post" action="/Account/Logout" class="side-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="side-logout-btn">
                    <span class="logout-mark">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="side-toggle-hide">Logout</span>
                </button>
            </form>
        </div>

    </aside>

    <main class="main">

        @if (!isInfluencer)
        {
            <div class="main-topbar">

                <button type="button" class="topbar-menu-btn" id="sidebarToggle" aria-label="Toggle sidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>

                <form method="get" action="/Search" class="topbar-search">
                    <input type="text" name="q" placeholder="Search campaigns, influencers, applications..." />
                </form>

                <div class="topbar-actions">

                    @{
                        var recentNotifications = ViewData["RecentNotifications"] as List<Notification> ?? new List<Notification>();
                    }

                    <div class="topbar-notif-wrap" id="notifMenuWrap">
                        <button type="button" class="topbar-icon-btn" id="notifMenuBtn" aria-label="Notifications" aria-expanded="false">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 13 6 9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 18a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                            @if (unread > 0)
                            {
                                <span class="topbar-badge" aria-label="@unread unread notifications"></span>
                            }
                        </button>

                        <div class="notif-dropdown" id="notifDropdown">
                            <div class="notif-dropdown-head">Notifications</div>

                            <div class="notif-dropdown-list">
                                @if (recentNotifications.Count == 0)
                                {
                                    <div class="notif-dropdown-empty">No notifications yet.</div>
                                }
                                else
                                {
                                    @foreach (var n in recentNotifications)
                                    {
                                        <a href="/Notifications/Open/@n.Id" class="notif-dropdown-item @(n.IsRead ? "" : "is-unread")">
                                            <div class="notif-dropdown-item-title">@n.Title</div>
                                            <div class="notif-dropdown-item-body">@n.Body</div>
                                        </a>
                                    }
                                }
                            </div>

                            <div class="notif-dropdown-foot">
                                <a href="/Notifications">View all notifications</a>
                            </div>
                        </div>
                    </div>

                    @{
                        var picUrl = ViewData["ProfilePictureUrl"] as string;
                        var companyName = ViewData["CompanyName"] as string ?? "Brand";
                        var contactName = ViewData["ContactFullName"] as string;
                        var email = ViewData["Email"] as string;
                        var initial = string.IsNullOrEmpty(companyName) ? "B" : companyName[..1].ToUpperInvariant();
                    }

                    <div class="topbar-profile-wrap" id="profileMenuWrap">
                        <button type="button" class="topbar-account" id="profileMenuBtn" aria-label="Brand account menu" aria-expanded="false">
                            <span class="topbar-profile">
                                @if (!string.IsNullOrEmpty(picUrl))
                                {
                                    <img src="@picUrl" alt="@companyName" class="topbar-profile-img" />
                                }
                                else
                                {
                                    @initial
                                }
                            </span>
                            <span class="topbar-account-text">
                                <strong>@companyName</strong>
                                <small>Brand</small>
                            </span>
                            <svg class="topbar-account-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>

                        <div class="profile-dropdown" id="profileDropdown">

                            <div class="profile-dropdown-head">
                                <div class="profile-dropdown-avatar">
                                    @if (!string.IsNullOrEmpty(picUrl))
                                    {
                                        <img src="@picUrl" alt="@companyName" />
                                    }
                                    else
                                    {
                                        @initial
                                    }
                                </div>
                                <div class="profile-dropdown-identity">
                                    <div class="profile-dropdown-name">@(string.IsNullOrEmpty(contactName) ? companyName : contactName)</div>
                                    <div class="profile-dropdown-email">@(email ?? companyName)</div>
                                </div>
                            </div>

                            <div class="profile-dropdown-links">
                                <a href="/Settings/Profile">View Profile</a>
                                <a href="/Settings">Edit Profile</a>
                            </div>

                            <form method="post" action="/Account/Logout" class="profile-dropdown-logout">
                                @Html.AntiForgeryToken()
                                <button type="submit">Log Out</button>
                            </form>

                        </div>
                    </div>

                </div>

            </div>
        }

        @RenderBody()
    </main>

</div>

@if (appSection != "Influencer")
{
    <div class="chat-widget-backdrop" id="chatWidget">
        <div class="chat-widget">
            <div class="chat-widget-header">
                <div class="chat-widget-avatar" id="chatWidgetAvatar"></div>
                <div class="chat-widget-name" id="chatWidgetName">Conversation</div>
                <a href="/Messages" class="chat-widget-icon-btn" id="chatWidgetExpand" title="Open in Messages" aria-label="Open in Messages">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 21h6v-6M21 3l-8 8M3 21l8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <button type="button" class="chat-widget-icon-btn" id="chatWidgetClose" aria-label="Close chat">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
            </div>
            <div class="chat-widget-body" id="chatWidgetBody">
                <div class="chat-widget-empty">Loading conversation…</div>
            </div>
            <form class="chat-widget-composer" id="chatWidgetForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="influencerId" id="chatWidgetInfluencerId" />
                <input type="file" name="mediaFile" id="chatWidgetFile" accept="image/*,video/*" hidden />
                <button type="button" class="chat-widget-attach-btn" id="chatWidgetAttachBtn" aria-label="Attach a file">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 11.5 12.5 20a4.5 4.5 0 0 1-6.4-6.4L14.6 5a3 3 0 0 1 4.3 4.3L10.4 18a1.5 1.5 0 0 1-2.1-2.1l7.1-7.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <input type="text" name="body" id="chatWidgetInput" placeholder="Type a message…" autocomplete="off" />
                <button type="submit" class="chat-widget-send" aria-label="Send message">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 2 11 13M22 2 15 22l-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </form>
        </div>
    </div>
}

<div class="confirm-modal-backdrop" id="brandoraConfirmModal">
    <div class="confirm-modal" role="alertdialog" aria-modal="true">
        <div class="confirm-modal-icon">!</div>
        <div class="confirm-modal-title">Are you sure?</div>
        <p class="confirm-modal-text"></p>
        <div class="confirm-modal-actions">
            <button type="button" class="btn btn-secondary confirm-modal-cancel">Cancel</button>
            <button type="button" class="btn btn-primary confirm-modal-confirm">Confirm</button>
        </div>
    </div>
</div>

<script>
    window.brandoraConfirm = function (triggerEl, opts) {
        opts = opts || {};
        var modal = document.getElementById('brandoraConfirmModal');
        if (!modal) { return; }

        var form = triggerEl && triggerEl.closest ? triggerEl.closest('form') : null;

        modal.querySelector('.confirm-modal-title').textContent = opts.title || 'Are you sure?';
        modal.querySelector('.confirm-modal-text').textContent = opts.text || '';

        var icon = modal.querySelector('.confirm-modal-icon');
        icon.classList.toggle('is-danger', !!opts.danger);

        var confirmBtn = modal.querySelector('.confirm-modal-confirm');
        confirmBtn.textContent = opts.confirmLabel || 'Confirm';
        confirmBtn.classList.toggle('btn-primary', !opts.danger);
        confirmBtn.classList.toggle('btn-danger-solid', !!opts.danger);

        function close() {
            modal.classList.remove('is-open');
            confirmBtn.onclick = null;
            document.removeEventListener('keydown', onKeydown);
        }

        function onKeydown(e) {
            if (e.key === 'Escape') { close(); }
        }

        confirmBtn.onclick = function () {
            close();
            if (form) { form.submit(); }
            else if (typeof opts.onConfirm === 'function') { opts.onConfirm(); }
        };

        modal.querySelector('.confirm-modal-cancel').onclick = close;
        modal.onclick = function (e) { if (e.target === modal) { close(); } };
        document.addEventListener('keydown', onKeydown);

        modal.classList.add('is-open');
    };

    (function () {
        var widget = document.getElementById('chatWidget');
        if (!widget) { return; }

        var body = document.getElementById('chatWidgetBody');
        var nameEl = document.getElementById('chatWidgetName');
        var avatarEl = document.getElementById('chatWidgetAvatar');
        var influencerIdInput = document.getElementById('chatWidgetInfluencerId');
        var expandLink = document.getElementById('chatWidgetExpand');
        var form = document.getElementById('chatWidgetForm');
        var input = document.getElementById('chatWidgetInput');
        var closeBtn = document.getElementById('chatWidgetClose');
        var attachBtn = document.getElementById('chatWidgetAttachBtn');
        var fileInput = document.getElementById('chatWidgetFile');

        function initials(name) {
            return (name || '').trim().split(/\s+/).map(function (w) { return w[0]; }).slice(0, 2).join('').toUpperCase();
        }

        function scrollToBottom() {
            var pane = document.getElementById('chatWidgetMessages');
            if (pane) { pane.scrollTop = pane.scrollHeight; }
        }

        function render(html) {
            body.innerHTML = html;
            var pane = document.getElementById('chatWidgetMessages');
            if (pane && pane.dataset.conversationId) {
                expandLink.href = '/Messages?open=' + pane.dataset.conversationId;
            }
            scrollToBottom();
        }

        function token() {
            return form.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        window.openChatWidget = function (influencerId, name, hue) {
            nameEl.textContent = name || 'Conversation';
            avatarEl.textContent = initials(name);
            avatarEl.style.background = hue !== undefined
                ? 'hsl(' + hue + 'deg 70% 45%)'
                : 'rgba(255,255,255,.25)';
            influencerIdInput.value = influencerId;
            body.innerHTML = '<div class="chat-widget-empty">Loading conversation…</div>';
            widget.classList.add('is-open');
            input.focus();

            fetch('/Messages/Widget?influencerId=' + encodeURIComponent(influencerId), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function (r) { return r.text(); })
                .then(render)
                .catch(function () { body.innerHTML = '<div class="chat-widget-empty">Couldn\'t load this conversation.</div>'; });
        };

        function closeWidget() {
            widget.classList.remove('is-open');
        }

        closeBtn.addEventListener('click', closeWidget);

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && widget.classList.contains('is-open')) { closeWidget(); }
        });

        document.addEventListener('click', function (e) {
            var trigger = e.target.closest('.js-open-chat');
            if (!trigger) { return; }
            e.preventDefault();
            window.openChatWidget(trigger.dataset.influencerId, trigger.dataset.influencerName, trigger.dataset.hue);
        });

        function send(formData) {
            formData.set('influencerId', influencerIdInput.value);
            formData.set('__RequestVerificationToken', token());

            return fetch('/Messages/SendWidget', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            })
                .then(function (r) { return r.text(); })
                .then(render);
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var text = input.value.trim();
            if (!text) { return; }
            input.value = '';

            var formData = new FormData();
            formData.set('body', text);
            send(formData);
        });

        attachBtn.addEventListener('click', function () {
            fileInput.click();
        });

        fileInput.addEventListener('change', function () {
            var file = fileInput.files && fileInput.files[0];
            if (!file) { return; }

            var formData = new FormData();
            formData.set('mediaFile', file);
            send(formData).finally(function () { fileInput.value = ''; });
        });

        // Delegated handlers for per-message actions inside the fetched,
        // repeatedly-replaced message list (menu toggle, edit, copy, unsend).
        body.addEventListener('click', function (e) {
            var menuToggle = e.target.closest('[data-widget-menu-toggle]');
            if (menuToggle) {
                var id = menuToggle.dataset.widgetMenuToggle;
                var menu = document.getElementById('chatWidgetMenu-' + id);
                var wasOpen = menu.classList.contains('is-open');
                body.querySelectorAll('.chat-widget-menu.is-open').forEach(function (m) { m.classList.remove('is-open'); });
                if (!wasOpen) { menu.classList.add('is-open'); }
                return;
            }

            var copyBtn = e.target.closest('[data-widget-copy]');
            if (copyBtn) {
                var text = copyBtn.dataset.copyText || '';
                if (navigator.clipboard) { navigator.clipboard.writeText(text).catch(function () {}); }
                copyBtn.closest('.chat-widget-menu').classList.remove('is-open');
                return;
            }

            var editBtn = e.target.closest('[data-widget-edit]');
            if (editBtn) {
                var msgId = editBtn.dataset.widgetEdit;
                document.getElementById('chatWidgetEditForm-' + msgId).hidden = false;
                document.getElementById('chatWidgetBubble-' + msgId).style.display = 'none';
                editBtn.closest('.chat-widget-menu').classList.remove('is-open');
                return;
            }

            var cancelBtn = e.target.closest('[data-widget-edit-cancel]');
            if (cancelBtn) {
                var cid = cancelBtn.dataset.widgetEditCancel;
                document.getElementById('chatWidgetEditForm-' + cid).hidden = true;
                document.getElementById('chatWidgetBubble-' + cid).style.display = '';
                return;
            }

            var saveBtn = e.target.closest('[data-widget-edit-save]');
            if (saveBtn) {
                var sid = saveBtn.dataset.widgetEditSave;
                var newBody = document.getElementById('chatWidgetEditInput-' + sid).value.trim();
                if (!newBody) { return; }

                var formData = new FormData();
                formData.set('messageId', sid);
                formData.set('influencerId', influencerIdInput.value);
                formData.set('body', newBody);
                formData.set('__RequestVerificationToken', token());

                fetch('/Messages/EditMessageWidget', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                }).then(function (r) { return r.text(); }).then(render);
                return;
            }

            var unsendBtn = e.target.closest('[data-widget-unsend]');
            if (unsendBtn) {
                var uid = unsendBtn.dataset.widgetUnsend;
                unsendBtn.closest('.chat-widget-menu').classList.remove('is-open');
                window.brandoraConfirm(unsendBtn, {
                    title: 'Unsend this message?',
                    text: 'This will remove the message for both of you.',
                    confirmLabel: 'Unsend',
                    danger: true,
                    onConfirm: function () {
                        var formData = new FormData();
                        formData.set('messageId', uid);
                        formData.set('influencerId', influencerIdInput.value);
                        formData.set('__RequestVerificationToken', token());

                        fetch('/Messages/DeleteMessageWidget', {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            body: formData
                        }).then(function (r) { return r.text(); }).then(render);
                    }
                });
                return;
            }

            body.querySelectorAll('.chat-widget-menu.is-open').forEach(function (m) { m.classList.remove('is-open'); });
        });
    })();

    document.addEventListener('click', function (e) {
        var backLink = e.target.closest('.back-to-dashboard');
        if (backLink && window.history.length > 1) {
            e.preventDefault();
            window.history.back();
            return;
        }
    });

    document.addEventListener('click', function (e) {
        var trigger = e.target.closest('.js-confirm');
        if (!trigger) { return; }
        e.preventDefault();
        window.brandoraConfirm(trigger, {
            title: trigger.dataset.confirmTitle,
            text: trigger.dataset.confirmText,
            confirmLabel: trigger.dataset.confirmLabel,
            danger: trigger.dataset.confirmDanger === 'true'
        });
    });
</script>

<script>
    // Remembers the last URL visited under each sidebar section (list page,
    // filters, pagination, or a specific detail page) so jumping to another
    // section and back resumes exactly where the brand left off, instead of
    // always resetting to that section's bare list view.
    (function () {
        var STORAGE_PREFIX = 'brandora:lastUrl:';
        var currentNavKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(activeNav));
        var currentUrl = location.pathname + location.search;

        if (currentNavKey) {
            try { sessionStorage.setItem(STORAGE_PREFIX + currentNavKey, currentUrl); } catch (e) {}
        }

        document.querySelectorAll('.side-nav-item[data-nav-key]').forEach(function (link) {
            link.addEventListener('click', function (e) {
                var key = link.dataset.navKey;
                if (key === currentNavKey) { return; }

                var saved = null;
                try { saved = sessionStorage.getItem(STORAGE_PREFIX + key); } catch (err) {}

                if (saved && saved !== currentUrl) {
                    e.preventDefault();
                    location.href = saved;
                }
            });
        });
    })();
</script>

<script>
    (function () {
        document.querySelectorAll('[data-count-to]').forEach(function (el) {
            var target = parseInt(el.dataset.countTo, 10) || 0;
            if (target === 0) { el.textContent = '0'; return; }

            var start = null;
            var duration = 700;

            function step(ts) {
                if (!start) start = ts;
                var progress = Math.min((ts - start) / duration, 1);
                var eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.round(eased * target).toString();
                if (progress < 1) requestAnimationFrame(step);
            }

            requestAnimationFrame(step);
        });

        document.querySelectorAll('[data-fill-to]').forEach(function (fill) {
            requestAnimationFrame(function () {
                fill.style.width = fill.dataset.fillTo + '%';
            });
        });

        // Profile dropdown
        var profileWrap = document.getElementById('profileMenuWrap');
        var profileBtn = document.getElementById('profileMenuBtn');

        function closeProfileMenu() {
            if (profileWrap && profileBtn) {
                profileWrap.classList.remove('is-open');
                profileBtn.setAttribute('aria-expanded', 'false');
            }
        }

        if (profileWrap && profileBtn) {
            profileBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                closeNotifMenu();
                var isOpen = profileWrap.classList.toggle('is-open');
                profileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });

            document.addEventListener('click', function (e) {
                if (!profileWrap.contains(e.target)) {
                    closeProfileMenu();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeProfileMenu();
                }
            });
        }

        // Notifications dropdown
        var notifWrap = document.getElementById('notifMenuWrap');
        var notifBtn = document.getElementById('notifMenuBtn');

        function closeNotifMenu() {
            if (notifWrap && notifBtn) {
                notifWrap.classList.remove('is-open');
                notifBtn.setAttribute('aria-expanded', 'false');
            }
        }

        if (notifWrap && notifBtn) {
            notifBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                closeProfileMenu();
                var isOpen = notifWrap.classList.toggle('is-open');
                notifBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });

            document.addEventListener('click', function (e) {
                if (!notifWrap.contains(e.target)) {
                    closeNotifMenu();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeNotifMenu();
                }
            });
        }

        // Sidebar hide / show, toggled from the topbar menu button
        var sidebar = document.getElementById('brandoraSidebar');
        var toggle = document.getElementById('sidebarToggle');
        var appShell = document.querySelector('.app-shell');

        if (sidebar && toggle && appShell) {
            var STORAGE_KEY = 'brandora-sidebar-hidden';

            function setHidden(hidden) {
                sidebar.classList.toggle('is-hidden', hidden);
                appShell.classList.toggle('sidebar-is-hidden', hidden);
                toggle.setAttribute('aria-label', hidden ? 'Show sidebar' : 'Hide sidebar');
                try {
                    localStorage.setItem(STORAGE_KEY, hidden ? 'true' : 'false');
                } catch (e) {}
            }

            try {
                if (localStorage.getItem(STORAGE_KEY) === 'true') {
                    setHidden(true);
                }
            } catch (e) {}

            toggle.addEventListener('click', function () {
                setHidden(!sidebar.classList.contains('is-hidden'));
            });
        }
    })();
</script>

@RenderSection("Scripts", required: false)

</body>
