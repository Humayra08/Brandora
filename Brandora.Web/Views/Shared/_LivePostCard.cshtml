@model Brandora.Web.Models.Domain.LivePostCard
@using Brandora.Web.Models.Domain
@*
    "This … is live on Instagram — View on Instagram" callout. Styles live in
    _AppLayout (Brand pages) and brandora-public-profile.css (public pages).
*@
@{
    var platform = SocialPlatform.FromUrl(Model.Url);
    var host = Uri.TryCreate(Model.Url, UriKind.Absolute, out var postUri) ? postUri.Host.Replace("www.", "") : Model.Url;
    var platformName = platform?.Name ?? host;
}
<a class="live-post-card" href="@Model.Url" target="_blank" rel="noopener noreferrer">
    <span class="social-chip" style="background: @(platform?.Background ?? "linear-gradient(130deg, #7224ff, #3735ff 55%, #087fff)");" aria-hidden="true"><i class="bi @(platform?.Icon ?? "bi-link-45deg")"></i></span>
    <span class="live-post-copy">
        <strong>@Model.Heading.Replace("{platform}", platformName)</strong>
        <small>@host</small>
    </span>
    <span class="live-post-cta">View on @(platform?.Name ?? "site") <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></span>
</a>
