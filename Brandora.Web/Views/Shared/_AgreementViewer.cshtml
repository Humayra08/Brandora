@model Brandora.Web.Models.Domain.Agreement
@using System.Globalization
<section class="agreement-viewer" aria-label="Agreement document">
            <div class="agreement-viewer-toolbar agreement-no-print">
                <div class="agreement-page-controls">
                    <button type="button" data-page-prev aria-label="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                    <output data-page-count aria-live="polite">1 / 1</output>
                    <button type="button" data-page-next aria-label="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
                <div class="agreement-zoom-controls">
                    <button type="button" data-zoom-out aria-label="Zoom out"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
                    <button type="button" data-zoom-reset aria-label="Reset zoom">100%</button>
                    <button type="button" data-zoom-in aria-label="Zoom in"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                </div>
                <div class="agreement-export-controls">
                    <button type="button" data-download-pdf><i class="bi bi-download" aria-hidden="true"></i> Download PDF</button>
                    <button type="button" data-print-agreement><i class="bi bi-printer" aria-hidden="true"></i> Print</button>
                </div>
            </div>
            <p class="agreement-export-message agreement-no-print" data-export-message role="status" hidden></p>
            <div class="agreement-viewer-body">
                <nav class="agreement-thumbnails agreement-no-print" data-page-thumbnails aria-label="Document pages"></nav>
                <div class="agreement-document-viewport" tabindex="0" aria-label="Agreement page preview">
                    <div data-document-pages></div>
                </div>
            </div>
            <div data-document-source>
                @await Html.PartialAsync("_AgreementDocument", Model)
            </div>
            <template data-paper-heading>
                <div class="agreement-brand-letterhead">
                    <span class="agreement-brandora-wordmark" role="img" aria-label="Brandora"><img src="~/images/brandora-mark.png" width="44" height="55" alt="" /><strong aria-hidden="true">Bran<span>dora</span></strong></span>
                    <span class="agreement-letterhead-tagline">Create. Collaborate. Grow.</span>
                </div>
                <p class="agreement-document-meta"><strong>Agreement ID:</strong> @Model.Code <span>|</span> <strong>Version:</strong> @Model.Version.ToString("0.0") <span>|</span> <strong>Date:</strong> @Model.CreatedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</p>
            </template>
        </section>
