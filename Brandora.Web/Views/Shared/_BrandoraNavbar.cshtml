@using Brandora.Web.Models.Domain
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    // Set ViewData["ActiveNav"] to "platform", "brands" or "influencers" to
    // underline that link. Pages that set nothing (e.g. Home) render as before.
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var aboutNavClass = "nav-link-underline" + (activeNav == "platform" ? " is-active" : "");
    var brandsNavClass = "nav-link-underline" + (activeNav == "brands" ? " is-active" : "");
    var influencersNavClass = "nav-link-underline" + (activeNav == "influencers" ? " is-active" : "");

    var dashboardUrl = "/Dashboard";
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser?.Role == UserRole.Influencer)
        {
            dashboardUrl = "/InfluencerDashboard";
        }
    }
}
<div class="navbar-fixed">
<nav class="navbar">

    <a href="/" class="brand-logo">

        <img src="~/images/Brandora.png" alt="Brandora" class="brand-mark-img" />

    </a>


    <div class="nav-links">

        <a href="/platform" class="@aboutNavClass">
            About
        </a>

        <a href="/for-brands" class="@brandsNavClass">
            Brands
        </a>

        <a href="/for-influencers" class="@influencersNavClass">
            Influencers
        </a>

        <a href="/#contact">
            Contact
        </a>

    </div>


    <div class="nav-actions">

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/Account/Logout" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="login-btn">Log Out</button>
            </form>

            <a href="@dashboardUrl" class="get-started-btn">
                Dashboard
            </a>
        }
        else
        {
            <a href="/Account/Login"
               class="login-btn">
                Log In
            </a>

            <a href="/Account/Register"
               class="get-started-btn">
                Get Started
            </a>
        }

    </div>

    <button type="button" class="nav-burger" id="navBurger" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
    </button>

</nav>

<div class="nav-mobile-panel" id="navMobilePanel">

    <a href="/platform">About</a>
    <a href="/for-brands">Brands</a>
    <a href="/for-influencers">Influencers</a>
    <a href="/#contact">Contact</a>

    <div class="nav-mobile-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/Account/Logout" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="login-btn">Log Out</button>
            </form>

            <a href="@dashboardUrl" class="get-started-btn">
                Dashboard
            </a>
        }
        else
        {
            <a href="/Account/Login" class="login-btn">
                Log In
            </a>

            <a href="/Account/Register" class="get-started-btn">
                Get Started
            </a>
        }
    </div>

</div>
</div>

<script>
    (function () {
        var burger = document.getElementById('navBurger');
        var panel = document.getElementById('navMobilePanel');
        if (!burger || !panel) return;

        burger.addEventListener('click', function () {
            var isOpen = panel.classList.toggle('is-open');
            burger.classList.toggle('is-open', isOpen);
            burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            burger.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
        });

        panel.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () {
                panel.classList.remove('is-open');
                burger.classList.remove('is-open');
                burger.setAttribute('aria-expanded', 'false');
                burger.setAttribute('aria-label', 'Open menu');
            });
        });
    })();
</script>
