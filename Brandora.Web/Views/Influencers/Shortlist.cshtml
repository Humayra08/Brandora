@model List<Brandora.Web.Models.Domain.InfluencerProfile>
@using Brandora.Web.Models.Influencers
@{
    ViewData["Title"] = "Shortlist";
    ViewData["ActiveNav"] = "Influencers";
    Layout = "_AppLayout";
}

@section Styles {

    .page-head {
        animation: fade-up .4s ease both;
    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 28px;
    }

    .page-sub {
        margin-top: 6px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    .creator-grid {
        margin-top: 26px;

        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 18px;
    }

    .creator-card {
        padding: 24px 22px 22px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        transition: transform .2s ease, box-shadow .2s ease;

        animation: fade-up .5s ease both;
    }

    .creator-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 36px rgba(30,34,90,.1);
    }

    .creator-card-head {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .creator-name-row {
        display: flex;
        align-items: center;
        gap: 7px;

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 16px;
        color: #171d3d;
    }

    .creator-handle {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #8189a8;
    }

    .creator-tags {
        margin-top: 12px;

        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .creator-figures {
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid #f0f1f7;

        display: flex;
        justify-content: space-between;
    }

    .figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 18px;
        color: #171d3d;
    }

    .figure-label {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .creator-actions {
        margin-top: 18px;

        display: flex;
        gap: 8px;
    }

    .creator-actions .btn {
        flex: 1;
        height: 40px;
        font-size: 12.5px;
    }

    .creator-actions .shortlist-btn {
        flex: 1;
        height: 40px;
    }

}

<a href="/Dashboard" class="back-to-dashboard">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Back to Dashboard
</a>

<div class="page-head">
    <h1 class="page-title">Your Shortlist</h1>
    <p class="page-sub">@Model.Count creator@(Model.Count == 1 ? "" : "s") saved for comparison.</p>
</div>

@if (Model.Count > 0)
{
    <div class="creator-grid">
        @foreach (var creator in Model)
        {
            var hue = (creator.Id * 47) % 360;
            <div class="creator-card">

                <div class="creator-card-head">
                    <div class="creator-avatar" style="background: linear-gradient(135deg, hsl(@(hue)deg 75% 58%), hsl(@((hue + 45) % 360)deg 75% 48%));">
                        @FollowerFormat.InitialsOf(creator.FullName)
                    </div>
                    <div>
                        <div class="creator-name-row">
                            @creator.FullName
                            @if (creator.Verified)
                            {
                                <span class="verified-badge">Verified</span>
                            }
                        </div>
                        <div class="creator-handle">@creator.PrimaryPlatform &middot; @creator.PlatformUsername</div>
                    </div>
                </div>

                <div class="creator-tags">
                    <span class="tag">@creator.ContentNiche</span>
                    @if (!string.IsNullOrEmpty(creator.Location))
                    {
                        <span class="tag">@creator.Location</span>
                    }
                </div>

                <div class="creator-figures">
                    <div>
                        <div class="figure-value">@FollowerFormat.Format(creator.Followers)</div>
                        <div class="figure-label">Followers</div>
                    </div>
                    <div>
                        <div class="figure-value">@creator.EngagementRate.ToString("0.0")%</div>
                        <div class="figure-label">Engagement</div>
                    </div>
                </div>

                <div class="creator-actions">
                    <a href="/Influencers/Profile/@creator.Id" class="btn btn-secondary">View Profile</a>

                    <form method="post" action="/Influencers/ToggleShortlist">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="influencerId" value="@creator.Id" />
                        <input type="hidden" name="returnUrl" value="/Influencers/Shortlist" />
                        <button type="submit" class="shortlist-btn is-saved">Remove</button>
                    </form>
                </div>

            </div>
        }
    </div>
}
else
{
    <div class="panel empty-block" style="margin-top: 24px;">
        <div class="empty-title">Your shortlist is empty</div>
        <p class="empty-text">Save creators you're interested in from Discovery to compare them here.</p>
        <a href="/Influencers" class="btn btn-primary" style="margin-top: 16px;">Discover Creators</a>
    </div>
}
