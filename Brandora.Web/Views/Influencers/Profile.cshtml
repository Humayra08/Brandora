@model Brandora.Web.Models.Influencers.CreatorProfileViewModel
@using Brandora.Web.Models.Influencers
@{
    var creator = Model.Creator;
    var hue = (creator.Id * 47) % 360;
    ViewData["Title"] = creator.FullName;
    ViewData["ActiveNav"] = "Influencers";
    Layout = "_AppLayout";
}

@section Styles {

    .profile-shell {
        max-width: 780px;
        margin: 0 auto;

        animation: fade-up .4s ease both;
    }

    .detail-crumb {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #8189a8;
    }

    .profile-header {
        margin-top: 16px;
        padding: 32px;

        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        display: flex;
        align-items: flex-start;
        gap: 22px;
    }

    .profile-avatar {
        width: 84px;
        height: 84px;
        font-size: 26px;
    }

    .profile-name-row {
        display: flex;
        align-items: center;
        gap: 10px;

        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 25px;
        color: #171d3d;
    }

    .profile-handle {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    .profile-tags {
        margin-top: 12px;

        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .profile-side-actions {
        margin-left: auto;

        display: flex;
        flex-direction: column;
        gap: 10px;

        flex-shrink: 0;
    }

    .profile-side-actions .shortlist-btn {
        width: 160px;
    }

    .stat-strip {
        margin-top: 18px;

        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;

        padding: 26px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 22px;
        color: #171d3d;
    }

    .figure-label {
        margin-top: 3px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .profile-section {
        margin-top: 18px;
        padding: 26px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .profile-section-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 15px;
        color: #171d3d;
    }

    .profile-bio {
        margin-top: 12px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        line-height: 1.75;
        color: #3c4363;

        white-space: pre-wrap;
    }

    @@media(max-width: 640px) {
        .profile-header { flex-direction: column; }
        .profile-side-actions { margin-left: 0; flex-direction: row; }
        .stat-strip { grid-template-columns: 1fr 1fr; }
    }

}

<div class="profile-shell">

    <div class="detail-crumb"><a href="/Influencers">Discover Creators</a> / @creator.FullName</div>

    <div class="profile-header">
        <div class="creator-avatar profile-avatar" style="background: linear-gradient(135deg, hsl(@(hue)deg 75% 58%), hsl(@((hue + 45) % 360)deg 75% 48%));">
            @FollowerFormat.InitialsOf(creator.FullName)
        </div>

        <div>
            <div class="profile-name-row">
                @creator.FullName
                @if (creator.Verified)
                {
                    <span class="verified-badge">Verified</span>
                }
            </div>
            <div class="profile-handle">@creator.PrimaryPlatform &middot; @creator.PlatformUsername</div>

            <div class="profile-tags">
                <span class="tag">@creator.ContentNiche</span>
                @if (!string.IsNullOrEmpty(creator.Location))
                {
                    <span class="tag">@creator.Location</span>
                }
                <span class="tag">@creator.AudienceSize audience</span>
            </div>
        </div>

        <div class="profile-side-actions">
            <form method="post" action="/Influencers/ToggleShortlist">
                @Html.AntiForgeryToken()
                <input type="hidden" name="influencerId" value="@creator.Id" />
                <input type="hidden" name="returnUrl" value="/Influencers/Profile/@creator.Id" />
                <button type="submit" class="shortlist-btn @(Model.IsShortlisted ? "is-saved" : "")">
                    @(Model.IsShortlisted ? "Shortlisted" : "+ Add to Shortlist")
                </button>
            </form>
        </div>
    </div>

    <div class="stat-strip">
        <div>
            <div class="figure-value">@FollowerFormat.Format(creator.Followers)</div>
            <div class="figure-label">Followers</div>
        </div>
        <div>
            <div class="figure-value">@creator.EngagementRate.ToString("0.0")%</div>
            <div class="figure-label">Engagement Rate</div>
        </div>
        <div>
            <div class="figure-value">@(string.IsNullOrEmpty(creator.RateNote) ? "Not listed" : creator.RateNote)</div>
            <div class="figure-label">Rate</div>
        </div>
    </div>

    <div class="profile-section">
        <div class="profile-section-title">About</div>
        <p class="profile-bio">@(string.IsNullOrEmpty(creator.Bio) ? "This creator hasn't added a bio yet." : creator.Bio)</p>
    </div>

    <div class="profile-section">
        <div class="profile-section-title">Collaboration History</div>
        <div class="empty-block">
            <div class="empty-title">No collaborations yet</div>
            <p class="empty-text">Past campaigns with this creator will appear here once collaboration launches.</p>
        </div>
    </div>

</div>
