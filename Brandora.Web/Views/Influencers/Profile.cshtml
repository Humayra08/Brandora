@model Brandora.Web.Models.Influencers.CreatorProfileViewModel
@using Brandora.Web.Models.Influencers
@using Brandora.Web.Models.Domain
@{
    var creator = Model.Creator;
    var hue = (creator.Id * 47) % 360;
    ViewData["Title"] = creator.FullName;
    ViewData["ActiveNav"] = "Influencers";
    Layout = "_AppLayout";

    var avatarGradient = $"linear-gradient(135deg, hsl({hue}deg 75% 58%), hsl({(hue + 45) % 360}deg 75% 48%))";
    var inviteError = TempData["InviteError"] as string;
    var firstName = creator.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? creator.FullName;
    var existing = Model.ExistingProposal;

    (string Label, string Badge) ProposalBadge(ProposalStatus status) => status switch
    {
        ProposalStatus.Pending => ("Pending Review", "is-pending"),
        ProposalStatus.Accepted => ("Accepted", "is-success"),
        ProposalStatus.Rejected => ("Not Selected", "is-neutral"),
        _ => (status.ToString(), "is-neutral")
    };

    (string Label, string Badge) VerificationBadge() => creator.VerificationStatus switch
    {
        VerificationStatus.Verified => ("Verified Creator", "is-info"),
        VerificationStatus.Rejected => ("Not Verified", "is-neutral"),
        _ => ("Verification Pending", "is-pending")
    };
    var verification = VerificationBadge();

    (string Label, string Badge) CollabBadge(CollaborationStatus status) => status switch
    {
        CollaborationStatus.Active => ("Active", "is-info"),
        CollaborationStatus.Completed => ("Completed", "is-success"),
        CollaborationStatus.Cancelled => ("Cancelled", "is-neutral"),
        _ => (status.ToString(), "is-neutral")
    };

    var faqs = new[]
    {
        ("How do I invite this creator?", "Choose Invite to Campaign and pick one of your open campaigns. You set the amount, deliverables and timeline — the invite is saved as a pending application for this creator."),
        ("Can I talk to them before inviting?", "Yes. Message opens a direct chat so you can check availability, rates and ideas before you commit to anything."),
        ("How are creators paid?", "Accepted work runs as a collaboration split into milestones. Each milestone is paid through bKash only after you and Brandora have both approved the creator's proof of post."),
        ("What does the verification badge mean?", "Brandora's team reviews each creator's account. Verified means the account has been confirmed as theirs; Pending means the review hasn't finished yet.")
    };
}

@section Styles {

    .cp-body { align-items: start; }

    .cp-bio { margin: 0; font-family: 'Inter', sans-serif; font-size: 13px; line-height: 1.75; color: #33477c; white-space: pre-wrap; }
    .cp-muted { font-family: 'Inter', sans-serif; font-size: 12.5px; color: #6680ad; }
    .cp-link { color: #1451ff; font-weight: 600; }
    .cp-link:hover { text-decoration: underline; }

    .collab-list { display: grid; gap: 10px; }
    .collab-row {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto auto;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #e3edfc;
        background: #ffffff8c;
        box-shadow: 0 3px 9px #9bbfe90b;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .collab-row:hover { transform: translateY(-2px); border-color: #b9d3ff; box-shadow: 0 12px 24px #5b83c41a; }
    .collab-row strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 700; color: #101d48; }
    .collab-row small { display: block; margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #5877ac; }
    .collab-row > i { color: #8095c4; transition: transform .2s ease, color .2s ease; }
    .collab-row:hover > i { transform: translateX(3px); color: #1451ff; }
    @@media(max-width: 560px) {
        .collab-row { grid-template-columns: auto minmax(0, 1fr) auto; row-gap: 8px; }
        .collab-row .ui-badge { grid-column: 2; grid-row: 2; justify-self: start; }
        .collab-row > i { grid-column: 3; grid-row: 1 / span 2; }
    }

    .cp-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 26px 16px; border: 1px dashed #cfdcf5; border-radius: 12px; background: #f7faffb3; text-align: center; font-family: 'Inter', sans-serif; font-size: 12px; color: #6b7fb1; }
    .cp-empty strong { font-family: 'DM Sans', sans-serif; font-size: 13.5px; color: #142652; }

    .cp-actions { display: grid; gap: 10px; }
    .cp-actions form { margin: 0; }
    .cp-actions .btn, .cp-actions .shortlist-btn { width: 100%; height: 44px; }
    .cp-actions .btn i, .cp-actions .shortlist-btn i { margin-right: 8px; }
    .cp-actions .shortlist-btn { border-color: #d7e8ff; background: #ffffffb8; font-size: 13px; color: #1451ff; }
    .cp-actions .shortlist-btn:hover { border-color: #1451ff; transform: translateY(-1px); }
    .cp-actions .shortlist-btn.is-saved { border-color: transparent; background: linear-gradient(110deg, #6425ff, #004dff 55%, #00a8f0); color: #ffffff; }
    .cp-existing { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; padding: 10px 12px; border-radius: 10px; border: 1px solid #dfe9ff; background: #eef4ffbd; font-family: 'Inter', sans-serif; font-size: 12px; color: #33477c; }
    .cp-rate { margin-top: 12px; padding: 10px 12px; border-radius: 9px; background: #eef4ffbd; border: 1px solid #dfe9ff; font-family: 'Inter', sans-serif; font-size: 11.5px; line-height: 1.5; color: #33477c; }
    .cp-rate strong { color: #101d48; }

}

<nav class="crumb-trail" aria-label="Breadcrumb">
    <a href="/Dashboard">Dashboard</a><i class="bi bi-chevron-right"></i>
    <a href="/Influencers">Find Influencers</a><i class="bi bi-chevron-right"></i>
    <strong>@creator.FullName</strong>
</nav>

@if (!string.IsNullOrEmpty(inviteError))
{
    <div class="notice is-error" role="alert"><i class="bi bi-exclamation-circle-fill"></i><span>@inviteError <a href="/Campaigns" style="font-weight:600;text-decoration:underline;">Go to Campaigns</a></span></div>
}

<section class="page-hero detail-hero">
    @await Html.PartialAsync("_HeroWaves")
    <div class="detail-hero-top">
        <div class="detail-hero-avatar is-person" style="background: @avatarGradient;">@FollowerFormat.InitialsOf(creator.FullName)</div>
        <div class="detail-hero-copy">
            <div class="detail-hero-tags">
                <span><i class="bi bi-person-badge"></i> Creator</span>
                @if (!string.IsNullOrWhiteSpace(creator.PrimaryPlatform))
                {
                    <span><i class="bi bi-broadcast"></i> @creator.PrimaryPlatform</span>
                }
                @if (!string.IsNullOrWhiteSpace(creator.ContentNiche))
                {
                    <span><i class="bi bi-tags"></i> @creator.ContentNiche</span>
                }
                @if (!string.IsNullOrWhiteSpace(creator.Location))
                {
                    <span><i class="bi bi-geo-alt"></i> @creator.Location</span>
                }
            </div>
            <h1>@creator.FullName @if (creator.Verified) { <i class="bi bi-patch-check-fill" style="font-size:22px;color:#1d7bff;" title="Verified"></i> }</h1>
            <p>
                @if (!string.IsNullOrWhiteSpace(creator.PlatformUsername))
                {
                    <text>@@@creator.PlatformUsername on @creator.PrimaryPlatform</text>
                }
                else
                {
                    <text>@creator.PrimaryPlatform creator</text>
                }
                @if (!string.IsNullOrWhiteSpace(creator.AudienceSize))
                {
                    <text> &middot; @creator.AudienceSize audience</text>
                }
                &middot; on Brandora since @creator.CreatedAt.ToString("MMM yyyy")
            </p>
        </div>
        <div class="detail-hero-side">
            <span class="ui-badge @verification.Badge"><i class="bi bi-shield-check"></i> @verification.Label</span>
            <div class="page-hero-motto" style="margin-left:0;">Find the Right<br />Creative Voice.<span></span></div>
        </div>
    </div>
    <dl class="detail-hero-stats">
        <div><dt>Followers</dt><dd>@FollowerFormat.Format(creator.Followers)</dd></div>
        <div><dt>Engagement Rate</dt><dd>@creator.EngagementRate.ToString("0.0")%</dd></div>
        <div><dt>Audience Size</dt><dd>@(string.IsNullOrWhiteSpace(creator.AudienceSize) ? "—" : creator.AudienceSize)</dd></div>
        <div><dt>Collaborations with You</dt><dd>@Model.PastCollaborations.Count</dd></div>
    </dl>
</section>

<div class="page-grid cp-body">

    <div class="page-main">

        <section class="ui-card">
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">About @firstName</div>
                    <p class="ui-card-sub">In the creator's own words.</p>
                </div>
            </div>
            @if (string.IsNullOrWhiteSpace(creator.Bio))
            {
                <p class="cp-muted">This creator hasn't added a bio yet. Send a message to learn more about their content.</p>
            }
            else
            {
                <p class="cp-bio">@creator.Bio</p>
            }
        </section>

        <section class="ui-card">
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Creator Details</div>
                    <p class="ui-card-sub">Account and audience information from @firstName's profile.</p>
                </div>
            </div>
            <dl class="detail-rows">
                <div><dt><span class="icon-chip"><i class="bi bi-broadcast"></i></span>Primary Platform</dt><dd>@(string.IsNullOrWhiteSpace(creator.PrimaryPlatform) ? "Not specified" : creator.PrimaryPlatform)</dd></div>
                <div><dt><span class="icon-chip"><i class="bi bi-at"></i></span>Handle</dt><dd>@(string.IsNullOrEmpty(creator.PlatformUsername) ? "Not specified" : creator.PlatformUsername)</dd></div>
                <div><dt><span class="icon-chip"><i class="bi bi-tags"></i></span>Content Niche</dt><dd>@(string.IsNullOrWhiteSpace(creator.ContentNiche) ? "Not specified" : creator.ContentNiche)</dd></div>
                <div><dt><span class="icon-chip"><i class="bi bi-people"></i></span>Audience</dt><dd>@(string.IsNullOrWhiteSpace(creator.AudienceSize) ? "Not specified" : creator.AudienceSize)<small>@creator.Followers.ToString("N0") followers &middot; @creator.EngagementRate.ToString("0.0")% engagement</small></dd></div>
                <div><dt><span class="icon-chip"><i class="bi bi-geo-alt"></i></span>Location</dt><dd>@(string.IsNullOrEmpty(creator.Location) ? "Not specified" : creator.Location)</dd></div>
                <div><dt><span class="icon-chip"><i class="bi bi-cash-coin"></i></span>Rate</dt><dd>@(string.IsNullOrEmpty(creator.RateNote) ? "Not listed" : creator.RateNote)</dd></div>
                <div><dt><span class="icon-chip"><i class="bi bi-shield-check"></i></span>Verification</dt><dd>@creator.VerificationStatus @if (creator.VerifiedAt.HasValue) { <small>Verified on @creator.VerifiedAt.Value.ToString("MMM d, yyyy")</small> }</dd></div>
                @if (!string.IsNullOrEmpty(creator.WebsiteUrl))
                {
                    <div><dt><span class="icon-chip"><i class="bi bi-globe2"></i></span>Website</dt><dd><a href="@creator.WebsiteUrl" target="_blank" rel="noopener" class="cp-link">@creator.WebsiteUrl</a></dd></div>
                }
            </dl>
        </section>

        <section class="ui-card">
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Collaboration History</div>
                    <p class="ui-card-sub">Campaigns you've run with @firstName.</p>
                </div>
                @if (Model.PastCollaborations.Count > 0)
                {
                    <span class="ui-badge is-violet">@Model.PastCollaborations.Count total</span>
                }
            </div>
            @if (Model.PastCollaborations.Count == 0)
            {
                <div class="cp-empty">
                    <span class="icon-chip soft"><i class="bi bi-people"></i></span>
                    <strong>No collaborations yet</strong>
                    <span>Past campaigns with this creator will appear here once an application is accepted.</span>
                </div>
            }
            else
            {
                <div class="collab-list">
                    @foreach (var collab in Model.PastCollaborations)
                    {
                        var cb = CollabBadge(collab.Status);
                        <a href="/Collaborations/Detail/@collab.Id" class="collab-row">
                            <span class="icon-chip sm blue"><i class="bi bi-megaphone"></i></span>
                            <div style="min-width:0;">
                                <strong>@collab.Campaign.Title</strong>
                                <small>Started @collab.CreatedAt.ToString("MMM d, yyyy")</small>
                            </div>
                            <span class="ui-badge @cb.Badge">@cb.Label</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                </div>
            }
        </section>

    </div>

    <aside class="page-rail">

        <section class="ui-card">
            <div class="ui-card-head" style="margin-bottom:10px;">
                <div>
                    <div class="ui-card-title" style="font-size:17px;">Work with @firstName</div>
                    <p class="ui-card-sub">Invite, save or start a conversation.</p>
                </div>
                <span class="icon-chip sm violet"><i class="bi bi-lightning-charge"></i></span>
            </div>

            @if (existing is not null)
            {
                var pb = ProposalBadge(existing.Status);
                <div class="cp-existing"><span>Latest application</span><span class="ui-badge @pb.Badge">@pb.Label</span></div>
            }

            <div class="cp-actions">
                @if (existing is not null)
                {
                    var statusText = existing.Status == ProposalStatus.Rejected ? "Not Selected" : existing.Status.ToString();
                    <a href="/Proposals/Detail/@existing.Id" class="btn btn-primary"><i class="bi bi-file-earmark-text"></i>View Application &middot; @statusText</a>
                }
                else
                {
                    <a href="/Proposals/Invite?influencerId=@creator.Id" class="btn btn-primary"><i class="bi bi-send"></i>Invite to Campaign</a>
                }

                <button type="button" class="btn btn-outline-brand js-open-chat"
                        data-influencer-id="@creator.Id"
                        data-influencer-name="@creator.FullName"
                        data-hue="@hue"><i class="bi bi-chat-dots"></i>Message</button>

                <form method="post" action="/Influencers/ToggleShortlist">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="influencerId" value="@creator.Id" />
                    <input type="hidden" name="returnUrl" value="/Influencers/Profile/@creator.Id" />
                    <button type="submit" class="shortlist-btn @(Model.IsShortlisted ? "is-saved" : "")">
                        @if (Model.IsShortlisted)
                        {
                            <i class="bi bi-bookmark-check-fill"></i><text>Shortlisted</text>
                        }
                        else
                        {
                            <i class="bi bi-bookmark-plus"></i><text>Add to Shortlist</text>
                        }
                    </button>
                </form>
            </div>

            @if (!string.IsNullOrEmpty(creator.RateNote))
            {
                <p class="cp-rate"><i class="bi bi-cash-coin"></i> Rate guide: <strong>@creator.RateNote</strong></p>
            }
        </section>

        <section class="ui-card">
            <div class="ui-card-head" style="margin-bottom:6px;">
                <div class="ui-card-title" style="font-size:17px;">Fit at a Glance</div>
            </div>
            <dl class="fact-list">
                <div><dt>Platform</dt><dd>@(string.IsNullOrWhiteSpace(creator.PrimaryPlatform) ? "—" : creator.PrimaryPlatform)</dd></div>
                <div><dt>Niche</dt><dd>@(string.IsNullOrWhiteSpace(creator.ContentNiche) ? "—" : creator.ContentNiche)</dd></div>
                <div><dt>Followers</dt><dd>@creator.Followers.ToString("N0")</dd></div>
                <div><dt>Engagement rate</dt><dd>@creator.EngagementRate.ToString("0.0")%</dd></div>
                <div><dt>Verification</dt><dd>@verification.Label</dd></div>
                <div><dt>In your shortlist</dt><dd>@(Model.IsShortlisted ? "Yes" : "No")</dd></div>
                <div><dt>Collaborations with you</dt><dd>@Model.PastCollaborations.Count</dd></div>
            </dl>
        </section>

        <section class="info-card">
            <div class="info-card-head">
                <span class="icon-chip soft"><i class="bi bi-signpost-2"></i></span>
                <div class="info-card-title">How Working Together Works</div>
            </div>
            <ol class="next-steps">
                <li class="@(Model.IsShortlisted || existing is not null ? "is-done" : "is-current")"><h4>Shortlist &amp; compare</h4><p>Save creators you like and compare their reach and engagement.</p></li>
                <li class="@(existing is not null ? "is-done" : Model.IsShortlisted ? "is-current" : "")"><h4>Send an invite</h4><p>Propose an amount, deliverables and timeline for one of your campaigns.</p></li>
                <li class="@(existing?.Status == ProposalStatus.Accepted ? "is-done" : existing?.Status == ProposalStatus.Pending ? "is-current" : "")"><h4>Start the collaboration</h4><p>Accepting creates the collaboration and its milestones from your campaign plan.</p></li>
                <li><h4>Approve &amp; pay via bKash</h4><p>Each milestone is paid once you and Brandora approve the proof of post.</p></li>
            </ol>
        </section>

        <section class="ui-card">
            <div class="ui-card-head" style="margin-bottom:2px;">
                <div class="ui-card-title" style="font-size:17px;">Frequently Asked Questions</div>
            </div>
            <div class="faq-list">
                @foreach (var faq in faqs)
                {
                    <details>
                        <summary>@faq.Item1<i class="bi bi-chevron-right"></i></summary>
                        <p>@faq.Item2</p>
                    </details>
                }
            </div>
        </section>

        <section class="help-card">
            <h3>Need Help?</h3>
            <p>Questions about a creator or how to invite them? Our support team can help.</p>
            <a href="/contact?accountType=Brand#contactForm">Contact Support <i class="bi bi-arrow-right"></i></a>
            <svg viewBox="0 0 400 170" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="cp-help-wave" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#0955ca" stop-opacity="0"/><stop offset=".65" stop-color="#168cff" stop-opacity=".5"/><stop offset="1" stop-color="#783dff" stop-opacity=".15"/></linearGradient></defs><path d="M-20 160 C100 50 140 220 260 105 S350 85 420 20 L420 190 H-20Z" fill="url(#cp-help-wave)"/><path d="M-20 164 C110 90 140 230 270 120 S360 70 420 40" fill="none" stroke="#2799ff" stroke-opacity=".4"/></svg>
        </section>

    </aside>

</div>
