@model Brandora.Web.Models.Influencers.CreatorProfileViewModel
@using Brandora.Web.Models.Influencers
@{
    var creator = Model.Creator;
    var hue = (creator.Id * 47) % 360;
    ViewData["Title"] = creator.FullName;
    ViewData["ActiveNav"] = "Influencers";
    Layout = "_AppLayout";
}

@section Styles {

    .profile-shell {
        max-width: 780px;
        margin: 0 auto;

        animation: fade-up .4s ease both;
    }

    .detail-crumb {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #8189a8;
    }

    .profile-header {
        margin-top: 16px;
        padding: 32px;

        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        display: flex;
        align-items: flex-start;
        gap: 22px;
    }

    .profile-avatar {
        width: 84px;
        height: 84px;
        font-size: 26px;
    }

    .profile-name-row {
        display: flex;
        align-items: center;
        gap: 10px;

        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 25px;
        color: #171d3d;
    }

    .profile-handle {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    .profile-tags {
        margin-top: 12px;

        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .profile-side-actions {
        margin-left: auto;

        display: flex;
        flex-direction: column;
        gap: 10px;

        flex-shrink: 0;
    }

    .profile-side-actions .shortlist-btn,
    .profile-side-actions .btn,
    .profile-side-actions form {
        width: 180px;
    }

    .stat-strip {
        margin-top: 18px;

        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;

        padding: 26px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 22px;
        color: #171d3d;
    }

    .figure-label {
        margin-top: 3px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .profile-section {
        margin-top: 18px;
        padding: 26px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .profile-section-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 15px;
        color: #171d3d;
    }

    .profile-bio {
        margin-top: 12px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        line-height: 1.75;
        color: #3c4363;

        white-space: pre-wrap;
    }

    .collab-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; border-radius: 12px; background: #fbfbfe; border: 1px solid #f0f1f7; transition: .2s; }
    .collab-item:hover { border-color: #e0dcf8; transform: translateY(-1px); }

    .profile-info-grid { margin-top: 14px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 24px; }
    .profile-info-value-full { grid-column: span 2; }
    .profile-info-label { font-family: 'Inter', sans-serif; font-size: 10.5px; font-weight: 600; letter-spacing: .3px; text-transform: uppercase; color: #9096b3; }
    .profile-info-value { margin-top: 3px; font-family: 'Inter', sans-serif; font-size: 13px; color: #171d3d; word-break: break-word; }

    @@media(max-width: 480px) { .profile-info-grid { grid-template-columns: 1fr; } .profile-info-value-full { grid-column: span 1; } }

    @@media(max-width: 640px) {
        .profile-header { flex-direction: column; }
        .profile-side-actions { margin-left: 0; flex-direction: row; }
        .stat-strip { grid-template-columns: 1fr 1fr; }
    }

}

<div class="profile-shell">

    <a href="/Influencers" class="back-to-dashboard">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back
    </a>

    <section class="page-hero">
        @await Html.PartialAsync("_HeroWaves")
        <div class="page-hero-intro">
            <div class="detail-crumb"><a href="/Dashboard">Dashboard</a> / <a href="/Influencers">Find Influencers</a> / @creator.FullName</div>

            <div style="display:flex; align-items:center; gap:14px; margin-top:10px;">
                <div class="creator-avatar" style="width:56px;height:56px;font-size:18px;background: linear-gradient(135deg, hsl(@(hue)deg 75% 58%), hsl(@((hue + 45) % 360)deg 75% 48%));">
                    @FollowerFormat.InitialsOf(creator.FullName)
                </div>
                <div>
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                        <h1 class="page-hero-title" style="margin-top:0;">@creator.FullName</h1>
                        @if (creator.Verified)
                        {
                            <span class="verified-badge">Verified</span>
                        }
                    </div>
                    <p class="profile-handle" style="margin-top:2px;">@creator.PrimaryPlatform &middot; @creator.PlatformUsername</p>
                </div>
            </div>

            <div class="profile-tags">
                <span class="tag">@creator.ContentNiche</span>
                @if (!string.IsNullOrEmpty(creator.Location))
                {
                    <span class="tag">@creator.Location</span>
                }
                <span class="tag">@creator.AudienceSize audience</span>
            </div>

            <div class="hero-actions" style="margin-top: 18px; flex-wrap: wrap;">
                @if (Model.ExistingProposal is not null)
                {
                    var statusText = Model.ExistingProposal.Status == Brandora.Web.Models.Domain.ProposalStatus.Rejected ? "Not Selected" : Model.ExistingProposal.Status.ToString();
                    <a href="/Proposals/Detail/@Model.ExistingProposal.Id" class="btn btn-secondary">View Application &middot; @statusText</a>
                }
                else
                {
                    <a href="/Proposals/Invite?influencerId=@creator.Id" class="btn btn-primary">Invite to Campaign</a>
                }

                <button type="button" class="btn btn-outline-brand js-open-chat"
                        data-influencer-id="@creator.Id"
                        data-influencer-name="@creator.FullName"
                        data-hue="@hue">Message</button>

                <form method="post" action="/Influencers/ToggleShortlist">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="influencerId" value="@creator.Id" />
                    <input type="hidden" name="returnUrl" value="/Influencers/Profile/@creator.Id" />
                    <button type="submit" class="shortlist-btn @(Model.IsShortlisted ? "is-saved" : "")">
                        @(Model.IsShortlisted ? "Shortlisted" : "+ Add to Shortlist")
                    </button>
                </form>
            </div>
        </div>

        <div class="page-hero-art" aria-hidden="true">
            <div class="hero-glass hero-glass-back"></div>
            <div class="hero-glass hero-glass-front">
                <span class="hero-glass-copy">Discover<br />Connect<br />Collaborate<span></span></span>
            </div>
            <span class="hero-sparkle"></span>
        </div>

        <div class="page-hero-motto">Find the Right<br />Creative Voice.<span></span></div>
    </section>

    <div class="stat-strip">
        <div>
            <div class="figure-value">@FollowerFormat.Format(creator.Followers)</div>
            <div class="figure-label">Followers</div>
        </div>
        <div>
            <div class="figure-value">@creator.EngagementRate.ToString("0.0")%</div>
            <div class="figure-label">Engagement Rate</div>
        </div>
        <div>
            <div class="figure-value">@(string.IsNullOrEmpty(creator.RateNote) ? "Not listed" : creator.RateNote)</div>
            <div class="figure-label">Rate</div>
        </div>
    </div>

    <div class="profile-section">
        <div class="profile-section-title">Creator Details</div>
        <div class="profile-info-grid">
            <div><div class="profile-info-label">Primary Platform</div><div class="profile-info-value">@(creator.PrimaryPlatform ?? "Not specified")</div></div>
            <div><div class="profile-info-label">Handle</div><div class="profile-info-value">@(string.IsNullOrEmpty(creator.PlatformUsername) ? "Not specified" : creator.PlatformUsername)</div></div>
            <div><div class="profile-info-label">Content Niche</div><div class="profile-info-value">@(creator.ContentNiche ?? "Not specified")</div></div>
            <div><div class="profile-info-label">Audience Size</div><div class="profile-info-value">@(creator.AudienceSize ?? "Not specified")</div></div>
            <div><div class="profile-info-label">Location</div><div class="profile-info-value">@(string.IsNullOrEmpty(creator.Location) ? "Not specified" : creator.Location)</div></div>
            <div><div class="profile-info-label">Verification Status</div><div class="profile-info-value">@creator.VerificationStatus</div></div>
            @if (!string.IsNullOrEmpty(creator.WebsiteUrl))
            {
                <div class="profile-info-value-full"><div class="profile-info-label">Website</div><div class="profile-info-value"><a href="@creator.WebsiteUrl" target="_blank" rel="noopener" style="color:#7a2df3;">@creator.WebsiteUrl</a></div></div>
            }
        </div>
    </div>

    <div class="profile-section">
        <div class="profile-section-title">About</div>
        <p class="profile-bio">@(string.IsNullOrEmpty(creator.Bio) ? "This creator hasn't added a bio yet." : creator.Bio)</p>
    </div>

    <div class="profile-section">
        <div class="profile-section-title">Collaboration History</div>
        @if (Model.PastCollaborations.Count == 0)
        {
            <div class="empty-block">
                <div class="empty-title">No collaborations yet</div>
                <p class="empty-text">Past campaigns with this creator will appear here once a proposal is accepted.</p>
            </div>
        }
        else
        {
            <div style="margin-top: 14px; display:flex; flex-direction:column; gap:10px;">
                @foreach (var collab in Model.PastCollaborations)
                {
                    <a href="/Collaborations/Detail/@collab.Id" class="collab-item" style="text-decoration:none;">
                        <div>
                            <div style="font-family:'DM Sans',sans-serif;font-weight:700;font-size:13px;color:#171d3d;">@collab.Campaign.Title</div>
                            <div style="margin-top:2px;font-family:'Inter',sans-serif;font-size:11.5px;color:#9096b3;">Started @collab.CreatedAt.ToString("MMM d, yyyy")</div>
                        </div>
                        <span class="status-pill @collab.Status.ToString().ToLowerInvariant()">@collab.Status</span>
                    </a>
                }
            </div>
        }
    </div>

</div>
