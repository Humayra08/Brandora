@model Brandora.Web.Models.Discovery.InfluencerDirectoryViewModel
@{
    ViewData["Title"] = "For Influencers";
    ViewData["ActiveNav"] = "influencers";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-directory.css" asp-append-version="true" />

</head>
<body class="directory-page">


    <partial name="_BrandoraNavbar" />


    <!-- =========================================================
         HERO
    ========================================================== -->

    <section class="directory-hero">

        <img src="~/images/Influencer.png" alt="" class="directory-hero-banner directory-hero-banner--wide directory-hero-banner--img" aria-hidden="true" />

        <div class="directory-hero-inner">

            <div class="directory-hero-copy directory-hero-copy--with-rule">

                <h1 class="directory-hero-title">
                    Find Influencers.
                    <br />
                    Fuel Your
                    <span class="purple">Brand</span>
                    <span class="blue">Growth.</span>
                </h1>

                <p class="directory-hero-text">
                    Explore verified influencers across platforms and niches.
                    <br />
                    Connect with creators who align with your brand and audience.
                </p>

                <div class="directory-hero-rule"></div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         FILTER BAR (overlaps the hero's lower edge)
    ========================================================== -->

    <section class="directory-filter-section">

        <div class="directory-container">

            <form class="directory-filter-bar" method="get" action="/for-influencers">

                <div class="filter-search">

                    <label class="visually-hidden" for="influencerSearch">
                        Search influencers
                    </label>

                    <input type="search"
                           id="influencerSearch"
                           name="search"
                           class="filter-search-input"
                           placeholder="Search influencers by name or keyword..."
                           value="@Model.Search" />

                    <svg class="filter-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>

                </div>

                @foreach (var filter in Model.Filters)
                {
                    <div class="filter-field">

                        <label class="filter-field-label" for="filter-@filter.Name">
                            @filter.Label
                        </label>

                        <select class="filter-field-select" id="filter-@filter.Name" name="@filter.Name">
                            @foreach (var option in filter.Options)
                            {
                                <option value="@option" selected="@(option == filter.SelectedOrDefault)">
                                    @option
                                </option>
                            }
                        </select>

                    </div>
                }

                <button type="submit" class="filter-more-btn">

                    More Filters

                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="4" y1="6" x2="20" y2="6" />
                        <line x1="7" y1="12" x2="17" y2="12" />
                        <line x1="10" y1="18" x2="14" y2="18" />
                    </svg>

                </button>

            </form>

        </div>

    </section>


    <!-- =========================================================
         ALL INFLUENCERS
    ========================================================== -->

    <section class="directory-listing">

        <div class="directory-container">

            <header class="directory-section-head">

                <div class="directory-section-heading">

                    <h2 class="directory-section-title">
                        All Influencers
                    </h2>

                    <p class="directory-section-sub">
                        Explore @Model.TotalInfluencersDisplay verified influencers ready to collaborate.
                    </p>

                </div>

                <div class="directory-section-controls">

                    <div class="directory-sort">

                        <label class="directory-sort-label" for="influencerSort">
                            Sort by
                        </label>

                        <select class="directory-sort-select" id="influencerSort" name="sort">
                            @foreach (var option in Model.SortOptions)
                            {
                                <option value="@option" selected="@(option == Model.SortOrDefault)">
                                    @option
                                </option>
                            }
                        </select>

                    </div>

                    <div class="directory-view-toggle" role="group" aria-label="View mode">

                        <button type="button" class="view-toggle-btn is-active" aria-pressed="true" aria-label="Grid view">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="7" height="7" />
                                <rect x="14" y="3" width="7" height="7" />
                                <rect x="3" y="14" width="7" height="7" />
                                <rect x="14" y="14" width="7" height="7" />
                            </svg>
                        </button>

                        <button type="button" class="view-toggle-btn" aria-pressed="false" aria-label="List view">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="4" y1="7" x2="20" y2="7" />
                                <line x1="4" y1="12" x2="20" y2="12" />
                                <line x1="4" y1="17" x2="20" y2="17" />
                            </svg>
                        </button>

                    </div>

                </div>

            </header>


            <div class="influencer-grid">

                @foreach (var creator in Model.Influencers)
                {
                    <article class="influencer-card">

                        <div class="influencer-card-cover" style="background: @creator.CoverBackground;">

                            <span class="influencer-card-platform influencer-card-platform--@creator.Platform.ToLowerInvariant()"
                                  aria-label="@creator.Platform">

                                @switch (creator.Platform)
                                {
                                    case "Facebook":
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z" />
                                        </svg>
                                        break;

                                    case "TikTok":
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.86-2.49V9.77a5.7 5.7 0 1 0 4.95 5.64V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-3.24-1.48z" />
                                        </svg>
                                        break;

                                    case "Instagram":
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="2" y="2" width="20" height="20" rx="5" />
                                            <circle cx="12" cy="12" r="4" />
                                            <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
                                        </svg>
                                        break;
                                }

                            </span>

                            <div class="influencer-card-avatar">
                                @if (creator.HasAvatarImage)
                                {
                                    <img src="@creator.AvatarImageUrl" alt="@creator.FullName" class="influencer-card-avatar-img" />
                                }
                                else
                                {
                                    <span class="influencer-card-initials">@creator.Initials</span>
                                }
                            </div>

                        </div>

                        <div class="influencer-card-body">

                            <h3 class="influencer-card-name">

                                @creator.FullName

                                @if (creator.Verified)
                                {
                                    <span class="influencer-card-verified" aria-label="Verified">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <path d="M12 1.5l2.6 2.05 3.3-.32 1.06 3.15 2.79 1.79-1.2 3.1 1.2 3.1-2.79 1.79-1.06 3.15-3.3-.32L12 22.5l-2.6-2.05-3.3.32-1.06-3.15L2.25 15.8l1.2-3.1-1.2-3.1 2.79-1.79L6.1 4.66l3.3.32L12 1.5z" />
                                            <path d="M10.6 15.4l-2.9-2.9 1.3-1.3 1.6 1.6 4-4 1.3 1.3-5.3 5.3z" fill="#ffffff" />
                                        </svg>
                                    </span>
                                }

                            </h3>

                            <p class="influencer-card-niche">
                                @creator.Niche
                            </p>

                            <p class="influencer-card-location">

                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z" />
                                    <circle cx="12" cy="10" r="3" />
                                </svg>

                                @creator.Location

                            </p>

                            <div class="influencer-card-stats">

                                <div class="influencer-card-stat">

                                    <span class="influencer-card-stat-value">
                                        @creator.FollowersDisplay
                                    </span>

                                    <span class="influencer-card-stat-label">
                                        Followers
                                    </span>

                                </div>

                                <div class="influencer-card-stat">

                                    <span class="influencer-card-stat-value">
                                        @creator.EngagementDisplay
                                    </span>

                                    <span class="influencer-card-stat-label">
                                        Engagement
                                    </span>

                                </div>

                            </div>

                            <a href="@creator.ProfileUrl" class="influencer-card-btn">
                                View Profile
                            </a>

                        </div>

                    </article>
                }

            </div>

        </div>

    </section>


    <!-- =========================================================
         STATS
    ========================================================== -->

    <partial name="_DirectoryStatsBar" model="Model.Stats" />


    <partial name="_BrandoraFooter" />


</body>
</html>
