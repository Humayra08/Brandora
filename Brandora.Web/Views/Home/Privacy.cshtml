@{
    ViewData["Title"] = "Privacy Policy";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-privacy.css" asp-append-version="true" />

</head>
<body class="privacy-page">


    <partial name="_BrandoraNavbar" />


    <!-- =========================================================
         HERO
    ========================================================== -->

    <section class="pp-hero">

        <div class="pp-hero-inner">

            <div class="pp-hero-copy">

                <div class="pp-badge">
                    PRIVACY POLICY
                </div>

                <h1 class="pp-hero-title">
                    Your Privacy, <span class="purple">Protected</span>
                </h1>

                <p class="pp-hero-text">
                    Brandora connects brands and influencers, which means we handle
                    information you trust us with. This policy explains what we collect,
                    why we collect it, and the choices you have.
                </p>

                <div class="pp-meta">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                        <path d="M12 7.5V12l3 1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Last updated: 22 September 2026
                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <section class="pp-main">

        <div class="pp-grid">


            <!-- TABLE OF CONTENTS -->

            <aside class="pp-toc">

                <h2>On this page</h2>

                <ol>
                    <li><a href="#introduction">Introduction</a></li>
                    <li><a href="#information-we-collect">Information We Collect</a></li>
                    <li><a href="#how-we-use">How We Use Your Information</a></li>
                    <li><a href="#how-we-share">How We Share Information</a></li>
                    <li><a href="#storage-security">Data Storage and Security</a></li>
                    <li><a href="#cookies">Cookies and Similar Technologies</a></li>
                    <li><a href="#your-rights">Your Rights and Choices</a></li>
                    <li><a href="#retention">Data Retention</a></li>
                    <li><a href="#third-parties">Third-Party Services</a></li>
                    <li><a href="#children">Children&rsquo;s Privacy</a></li>
                    <li><a href="#changes">Changes to This Policy</a></li>
                    <li><a href="#contact">Contact Us</a></li>
                </ol>

            </aside>


            <!-- CONTENT -->

            <div class="pp-content">


                <!-- 1. INTRODUCTION -->

                <article class="pp-card" id="introduction">

                    <h2>Introduction</h2>

                    <p>
                        Brandora is an influencer marketing platform that helps brands find
                        influencers, agree on campaign work, and pay for it through tracked
                        milestones. This Privacy Policy describes how we handle information
                        about the people who use the platform &mdash; whether you sign up as a
                        brand, as an influencer, or simply get in touch through our contact form.
                    </p>

                    <p>
                        It applies to the Brandora website and the services offered through it.
                        By creating an account or using the platform, you agree to the practices
                        described here. If you do not agree with this policy, please do not use
                        the platform.
                    </p>

                    <p>
                        We have tried to keep this document plain and specific. If anything here
                        is unclear, you are welcome to
                        <a href="/contact">contact us</a> and ask.
                    </p>

                </article>


                <!-- 2. INFORMATION WE COLLECT -->

                <article class="pp-card" id="information-we-collect">

                    <h2>Information We Collect</h2>

                    <p>
                        We collect information that you provide directly, information generated
                        as you use the platform, and a limited amount of technical information
                        that our servers record automatically.
                    </p>

                    <h3>Account information</h3>
                    <p>
                        When you register, we collect your name, email address, and a password,
                        along with the account type you choose (brand or influencer). Your password
                        is stored only as a secure cryptographic hash &mdash; we never store it in a
                        readable form and cannot retrieve it for you. We also generate short
                        verification codes sent to your email address to confirm your account and,
                        if you ask for one, to reset your password.
                    </p>

                    <h3>Profile information</h3>
                    <p>
                        The details you add to your profile depend on your account type:
                    </p>
                    <ul>
                        <li>
                            <strong>Brands:</strong> company name, contact person&rsquo;s name,
                            industry, website address, an indicative monthly budget range, and an
                            optional profile image or logo.
                        </li>
                        <li>
                            <strong>Influencers:</strong> full name, primary social platform and
                            username, content niche, audience size and follower count, engagement
                            rate, and optional biography, location, website, and rate notes.
                        </li>
                    </ul>
                    <p>
                        Profiles are reviewed by our team before they appear in the public
                        directory, so profile information may also be associated with a
                        verification status and internal review notes.
                    </p>

                    <h3>Contact and support information</h3>
                    <p>
                        If you use our contact form, we collect your name, email address, the
                        account type and issue type you select, and the subject and description
                        you write, together with any file you choose to attach. We keep this so we
                        can respond to you and track the request through to resolution.
                    </p>

                    <h3>Collaboration content</h3>
                    <p>
                        As you use the platform, we store the content you create through it:
                        campaign briefs, proposals, shortlists, milestone plans, messages exchanged
                        with other users, and any files or proof of work you upload for review.
                    </p>

                    <h3>Payment information</h3>
                    <p>
                        Payments are processed by external mobile financial service providers.
                        Brandora does not collect or store your full payment credentials, card
                        numbers, PINs, or passwords for those services. We do store records of
                        transactions made through the platform &mdash; amounts, status, platform fees,
                        dates, and the reference identifiers returned by the payment provider &mdash;
                        and, for influencers, the payout method and account number you nominate so
                        that we can send your earnings to the right place.
                    </p>

                    <h3>Technical and usage information</h3>
                    <p>
                        Like most websites, our servers automatically record standard technical
                        information when you visit, such as your IP address, browser and device
                        type, and the pages you request. We use this for security, diagnosing
                        faults, and keeping the service running reliably.
                    </p>

                </article>


                <!-- 3. HOW WE USE YOUR INFORMATION -->

                <article class="pp-card" id="how-we-use">

                    <h2>How We Use Your Information</h2>

                    <p>
                        We use the information described above for the following purposes:
                    </p>

                    <ul>
                        <li>
                            <strong>Running your account:</strong> creating and maintaining your
                            account, signing you in, and keeping you signed in securely.
                        </li>
                        <li>
                            <strong>Verifying profiles:</strong> reviewing brand and influencer
                            profiles before they are published, so that the people you deal with on
                            the platform have been checked by our team.
                        </li>
                        <li>
                            <strong>Matching and discovery:</strong> showing approved profiles in
                            our directories and helping brands and influencers find suitable
                            partners.
                        </li>
                        <li>
                            <strong>Enabling collaboration:</strong> delivering campaigns,
                            proposals, messages, and milestone reviews between the parties involved.
                        </li>
                        <li>
                            <strong>Processing payments:</strong> handling campaign payments,
                            holding milestone funds until work is approved, calculating platform
                            fees, and paying out influencer earnings.
                        </li>
                        <li>
                            <strong>Communicating with you:</strong> sending account emails such as
                            verification codes, password resets, and notifications about activity
                            that concerns you.
                        </li>
                        <li>
                            <strong>Providing support:</strong> responding to the questions and
                            issues you raise with us.
                        </li>
                        <li>
                            <strong>Safety and security:</strong> detecting and preventing fraud,
                            abuse, and unauthorised access, and resolving disputes between users.
                        </li>
                        <li>
                            <strong>Improving the platform:</strong> understanding how the service
                            is used so we can fix problems and make it work better.
                        </li>
                        <li>
                            <strong>Meeting legal obligations:</strong> keeping records we are
                            required to keep and responding to lawful requests.
                        </li>
                    </ul>

                    <p>
                        We do not sell your personal information, and we do not share it with third
                        parties for their own advertising purposes.
                    </p>

                </article>


                <!-- 4. HOW WE SHARE INFORMATION -->

                <article class="pp-card" id="how-we-share">

                    <h2>How We Share Information</h2>

                    <p>
                        We share information only where it is necessary to operate the platform:
                    </p>

                    <ul>
                        <li>
                            <strong>With other users:</strong> once your profile has been approved,
                            the details you have chosen to publish &mdash; such as your company or
                            creator name, niche, audience figures, and profile image &mdash; are
                            visible to other users in the relevant directory. When you enter a
                            collaboration, the other party sees the information needed to work with
                            you, including your messages and the deliverables you submit.
                        </li>
                        <li>
                            <strong>With service providers:</strong> we use a small number of
                            external providers to deliver parts of the service, including media
                            hosting for uploaded images and files, mobile financial service
                            providers for payments, and an email delivery service for account
                            emails. They receive only what they need to perform that function.
                        </li>
                        <li>
                            <strong>With our administrators:</strong> authorised Brandora staff can
                            access account, profile, and transaction information to verify profiles,
                            review submitted work, and resolve disputes and support requests. These
                            actions are logged internally.
                        </li>
                        <li>
                            <strong>For legal reasons:</strong> we may disclose information where we
                            are required to do so by law, or where it is reasonably necessary to
                            protect the rights, property, or safety of Brandora, our users, or the
                            public.
                        </li>
                        <li>
                            <strong>In a business transfer:</strong> if Brandora is involved in a
                            merger, acquisition, or sale of assets, information may be transferred
                            as part of that transaction. We will tell you if this happens.
                        </li>
                    </ul>

                </article>


                <!-- 5. DATA STORAGE AND SECURITY -->

                <article class="pp-card" id="storage-security">

                    <h2>Data Storage and Security</h2>

                    <p>
                        Your information is stored in a secured, access-controlled database, and
                        uploaded files are held with our media hosting provider. We apply
                        safeguards appropriate to the kind of information we hold, including:
                    </p>

                    <ul>
                        <li>Passwords stored only as salted cryptographic hashes, never in readable form.</li>
                        <li>Encrypted connections (HTTPS) between your browser and the platform.</li>
                        <li>Session cookies marked HTTP-only, so they cannot be read by scripts in the browser.</li>
                        <li>Protection against cross-site request forgery on forms that change your data.</li>
                        <li>Minimum password strength requirements and temporary account lockout after repeated failed sign-in attempts.</li>
                        <li>Administrative access restricted to authorised staff and recorded in an internal audit log.</li>
                    </ul>

                    <p>
                        No website or online service can promise perfect security, and we do not
                        claim to. If you believe your account has been compromised, please change
                        your password and
                        <a href="/contact">contact us</a> as soon as possible.
                    </p>

                    <p>
                        You are also responsible for your part: choose a strong, unique password,
                        keep it private, and sign out on devices you share with others.
                    </p>

                </article>


                <!-- 6. COOKIES -->

                <article class="pp-card" id="cookies">

                    <h2>Cookies and Similar Technologies</h2>

                    <p>
                        Cookies are small files stored by your browser. Brandora uses cookies that
                        are necessary for the platform to function:
                    </p>

                    <ul>
                        <li>
                            <strong>Authentication cookies:</strong> these keep you signed in as you
                            move between pages and separate ordinary user sessions from
                            administrator sessions.
                        </li>
                        <li>
                            <strong>Security cookies:</strong> these protect forms against
                            cross-site request forgery.
                        </li>
                    </ul>

                    <p>
                        We do not use third-party advertising or tracking cookies, and we do not
                        run third-party analytics or advertising scripts on this site.
                    </p>

                    <p>
                        You can block or delete cookies through your browser settings. If you block
                        the cookies described above, you will not be able to sign in or use the
                        parts of the platform that require an account.
                    </p>

                </article>


                <!-- 7. YOUR RIGHTS AND CHOICES -->

                <article class="pp-card" id="your-rights">

                    <h2>Your Rights and Choices</h2>

                    <p>
                        You have control over the information you give us:
                    </p>

                    <ul>
                        <li>
                            <strong>Access and update:</strong> you can view and edit most of your
                            account and profile information at any time from your dashboard
                            settings.
                        </li>
                        <li>
                            <strong>Notification preferences:</strong> you can choose which
                            notifications you receive from the platform.
                        </li>
                        <li>
                            <strong>Deletion:</strong> you can ask us to delete your account. We
                            will remove or anonymise your personal information, except records we
                            need to keep for financial, legal, or dispute-resolution reasons &mdash;
                            for example, completed transaction records.
                        </li>
                        <li>
                            <strong>A copy of your information:</strong> you can ask us for a copy
                            of the personal information we hold about you.
                        </li>
                        <li>
                            <strong>Objection and correction:</strong> you can ask us to correct
                            information that is wrong, or raise a concern about how we are using it.
                        </li>
                    </ul>

                    <p>
                        To make any of these requests, email us at
                        <a href="mailto:care.brandora@gmail.com">care.brandora@gmail.com</a>
                        from the address registered to your account, or use our
                        <a href="/contact">contact form</a>. We may need to verify your identity
                        before acting on a request. Depending on where you live, local law may give
                        you additional rights over your personal information.
                    </p>

                </article>


                <!-- 8. DATA RETENTION -->

                <article class="pp-card" id="retention">

                    <h2>Data Retention</h2>

                    <p>
                        We keep your information for as long as your account is active and for as
                        long as we need it for the purposes described in this policy.
                    </p>

                    <ul>
                        <li>
                            <strong>Account and profile information</strong> is kept while your
                            account exists, and removed or anonymised after you close it.
                        </li>
                        <li>
                            <strong>Collaboration content</strong> such as campaigns, proposals,
                            messages, and submitted work is kept while it remains relevant to the
                            parties involved and to any open dispute.
                        </li>
                        <li>
                            <strong>Payment and transaction records</strong> are kept for longer,
                            because we need them for financial record-keeping and to resolve
                            questions about past payments.
                        </li>
                        <li>
                            <strong>Support requests</strong> are kept so that we have a history of
                            issues raised and how they were handled.
                        </li>
                    </ul>

                    <p>
                        When information is no longer needed, we delete it or anonymise it so it
                        can no longer be linked to you.
                    </p>

                </article>


                <!-- 9. THIRD-PARTY SERVICES -->

                <article class="pp-card" id="third-parties">

                    <h2>Third-Party Services</h2>

                    <p>
                        Brandora relies on a small number of external services to operate:
                    </p>

                    <ul>
                        <li>
                            <strong>Media hosting:</strong> profile images and files you upload are
                            stored with a cloud media provider rather than on our own servers.
                        </li>
                        <li>
                            <strong>Payment providers:</strong> campaign payments and payouts are
                            handled through mobile financial service providers. Your interactions
                            with them are governed by their own terms and privacy policies.
                        </li>
                        <li>
                            <strong>Email delivery:</strong> account emails such as verification
                            codes and notifications are sent through an email delivery service.
                        </li>
                    </ul>

                    <p>
                        These providers process information on our behalf and only for the purposes
                        we have asked them to perform. We are not responsible for the privacy
                        practices of websites or social platforms that you reach through links from
                        Brandora &mdash; we encourage you to read their policies.
                    </p>

                </article>


                <!-- 10. CHILDREN'S PRIVACY -->

                <article class="pp-card" id="children">

                    <h2>Children&rsquo;s Privacy</h2>

                    <p>
                        Brandora is a commercial platform involving agreements and payments, and it
                        is not intended for children. You must be at least 18 years old to create
                        an account and use the service.
                    </p>

                    <p>
                        We do not knowingly collect personal information from anyone under 18. If
                        you believe a child has provided us with personal information, please
                        contact us and we will take steps to delete the account and the information
                        associated with it.
                    </p>

                </article>


                <!-- 11. CHANGES TO THIS POLICY -->

                <article class="pp-card" id="changes">

                    <h2>Changes to This Privacy Policy</h2>

                    <p>
                        We may update this Privacy Policy from time to time &mdash; for example, if
                        we add a feature that handles information in a new way, or if the law
                        changes. When we do, we will post the revised policy on this page and
                        update the &ldquo;last updated&rdquo; date at the top.
                    </p>

                    <p>
                        If a change materially affects how we use your personal information, we
                        will make a reasonable effort to notify you directly, such as by email or a
                        notice on the platform. Continuing to use Brandora after a change takes
                        effect means you accept the updated policy.
                    </p>

                </article>


                <!-- 12. CONTACT US -->

                <article class="pp-card" id="contact">

                    <h2>Contact Us</h2>

                    <p>
                        If you have questions about this Privacy Policy, or about how your
                        information is handled, please get in touch. We aim to respond within
                        24 hours.
                    </p>

                    <div class="pp-contact-rows">

                        <div class="pp-contact-row">

                            <div class="pp-contact-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                    <rect x="3" y="5.5" width="18" height="13" rx="2.5" stroke="currentColor" stroke-width="1.6" />
                                    <path d="M4 7.5l8 5.2 8-5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div>
                                <span>Email</span>
                                <a href="mailto:care.brandora@gmail.com">care.brandora@gmail.com</a>
                            </div>

                        </div>

                        <div class="pp-contact-row">

                            <div class="pp-contact-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                    <path d="M6.5 4h3l1.5 3.7-2 1.4a12 12 0 005.9 5.9l1.4-2L20 14.5v3a2 2 0 01-2.2 2A15.6 15.6 0 014.5 6.2 2 2 0 016.5 4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div>
                                <span>Phone</span>
                                <a href="tel:+8801791890711">01791890711</a>
                            </div>

                        </div>

                        <div class="pp-contact-row">

                            <div class="pp-contact-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 21s6.5-5.4 6.5-10a6.5 6.5 0 10-13 0c0 4.6 6.5 10 6.5 10z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <circle cx="12" cy="11" r="2.4" stroke="currentColor" stroke-width="1.6" />
                                </svg>
                            </div>

                            <div>
                                <span>Address</span>
                                <p>Dhaka, Bangladesh</p>
                            </div>

                        </div>

                    </div>

                    <p>
                        You can also reach us through our
                        <a href="/contact">contact form</a>, which lets you describe the issue and
                        attach a file if needed.
                    </p>

                </article>


            </div>


        </div>

    </section>


    <partial name="_BrandoraFooter" />


</body>
</html>
