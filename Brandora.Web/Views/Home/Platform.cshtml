@{
    ViewData["Title"] = "Platform";
    ViewData["ActiveNav"] = "platform";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-platform.css" asp-append-version="true" />

</head>
<body class="platform-page">


    <partial name="_BrandoraNavbar" />


    <!-- =========================================================
         HERO
    ========================================================== -->

    <section class="pf-hero">

        <img src="~/images/Wave3.png" alt="" class="pf-hero-wave" aria-hidden="true" />

        <div class="pf-hero-inner">

            <div class="pf-hero-copy">

                <div class="pf-badge">
                    ABOUT BRANDORA
                </div>

                <h1 class="pf-hero-title">
                    Building Meaningful
                    <br />
                    Connections.
                    <br />
                    <span class="purple">Driving</span>
                    <span class="blue">Real Impact.</span>
                </h1>

                <p class="pf-hero-text">
                    Brandora is a modern influencer marketing platform that
                    connects brands with the right influencers across Bangladesh.
                    We make collaborations simpler, smarter, and more impactful
                    for everyone.
                </p>

            </div>

            <div class="pf-hero-mark">
                <img src="~/images/brandora-about-mark.png" alt="Brandora" class="pf-hero-mark-img" />
            </div>

        </div>

    </section>


    <main class="pf-main">


        <!-- =========================================================
             OUR MISSION
        ========================================================== -->

        <section class="pf-section">

            <div class="pf-section-header">

                <div class="pf-section-label">
                    OUR MISSION
                </div>

                <h2 class="pf-section-title">
                    Empowering Collaborations That Create <span class="blue">Value</span>
                </h2>

                <p class="pf-section-description">
                    We empower brands and influencers with the tools, trust, and technology
                    to create partnerships that drive growth and inspire audiences.
                </p>

            </div>


            <div class="pf-values">

                <article class="pf-value">

                    <h3>
                        Trust &amp; Transparency
                    </h3>

                    <div class="pf-value-rule pf-value-rule--purple"></div>

                    <p>
                        We ensure secure transactions
                        and honest partnerships.
                    </p>

                </article>


                <article class="pf-value">

                    <h3>
                        Innovation
                    </h3>

                    <div class="pf-value-rule pf-value-rule--blue"></div>

                    <p>
                        We continuously evolve our platform
                        to give you the best experience.
                    </p>

                </article>


                <article class="pf-value">

                    <h3>
                        Impact First
                    </h3>

                    <div class="pf-value-rule pf-value-rule--pink"></div>

                    <p>
                        Every campaign is designed
                        to create real impact.
                    </p>

                </article>

            </div>

        </section>


        <!-- =========================================================
             HOW IT WORKS
        ========================================================== -->

        <section class="pf-section">

            <div class="pf-section-header">

                <div class="pf-section-label">
                    HOW IT WORKS
                </div>

                <h2 class="pf-section-title">
                    Simple Process. Powerful Results.
                </h2>

                <p class="pf-section-description">
                    From campaign creation to payment &mdash;
                    Brandora makes influencer marketing seamless.
                </p>

            </div>


            <div class="pf-steps">

                <div class="pf-step">

                    <div class="pf-step-number">
                        01
                    </div>

                    <h3>
                        Post Campaign
                    </h3>

                    <p>
                        Brands create campaigns with goals,
                        budget, and requirements.
                    </p>

                </div>


                <div class="pf-step">

                    <div class="pf-step-number">
                        02
                    </div>

                    <h3>
                        Discover &amp; Connect
                    </h3>

                    <p>
                        Our AI matches you with the best
                        influencers. Review proposals and connect.
                    </p>

                </div>


                <div class="pf-step">

                    <div class="pf-step-number">
                        03
                    </div>

                    <h3>
                        Collaborate
                    </h3>

                    <p>
                        Communicate, align on deliverables,
                        and plan the campaign together.
                    </p>

                </div>


                <div class="pf-step">

                    <div class="pf-step-number">
                        04
                    </div>

                    <h3>
                        Post &amp; Submit Proof
                    </h3>

                    <p>
                        Influencers complete the work and
                        submit proof of post for review.
                    </p>

                </div>


                <div class="pf-step">

                    <div class="pf-step-number">
                        05
                    </div>

                    <h3>
                        Approve &amp; Pay
                    </h3>

                    <p>
                        Admins verify the proof and payments
                        are released securely.
                    </p>

                </div>

            </div>


            <!-- =====================================================
                 PLATFORM STATISTICS
            ====================================================== -->

            <div class="pf-stats">

                <div class="pf-stat pf-stat--purple">
                    <strong>10K+</strong>
                    <span>Influencers<br />Onboarded</span>
                </div>

                <div class="pf-stat pf-stat--blue">
                    <strong>2K+</strong>
                    <span>Brands<br />Trust Us</span>
                </div>

                <div class="pf-stat pf-stat--violet">
                    <strong>15K+</strong>
                    <span>Campaigns<br />Launched</span>
                </div>

                <div class="pf-stat pf-stat--indigo">
                    <strong>20+</strong>
                    <span>Countries<br />Reached</span>
                </div>

            </div>

        </section>


    </main>


    <partial name="_BrandoraFooter" />


</body>
</html>
