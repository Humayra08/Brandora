@model Brandora.Web.Models.Contact.ContactIssueViewModel
@{
    ViewData["Title"] = "Contact Us";
    Layout = null;

    var submitted = TempData["ContactSubmitted"] as bool? ?? false;

    var accountTypeClass = string.IsNullOrEmpty(Model.AccountType) ? "is-placeholder" : "";
    var issueTypeClass = string.IsNullOrEmpty(Model.IssueType) ? "is-placeholder" : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-contact.css" asp-append-version="true" />

</head>
<body class="contact-page">


    <partial name="_BrandoraNavbar" />


    <!-- =========================================================
         HERO
    ========================================================== -->

    <section class="ct-hero">

        <div class="ct-hero-inner">

            <div class="ct-hero-copy">

                <div class="ct-badge">
                    CONTACT US
                </div>

                <h1 class="ct-hero-title">
                    We&rsquo;re Here to <span class="purple">Help</span>
                </h1>

                <p class="ct-hero-text">
                    Have a question, need assistance, or want to report an issue?
                    <br />
                    Our team is ready to support you.
                </p>


                <div class="ct-assurances">

                    <div class="ct-assurance">

                        <div class="ct-assurance-icon">
                            <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                                <path d="M12 7.5V12l3 1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>

                        <div>
                            <h3>Quick Response</h3>
                            <p>We aim to reply within 24 hours</p>
                        </div>

                    </div>

                    <div class="ct-assurance">

                        <div class="ct-assurance-icon">
                            <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                                <path d="M12 3.2l6.8 2.6v5.4c0 4.2-2.9 7.6-6.8 8.8-3.9-1.2-6.8-4.6-6.8-8.8V5.8L12 3.2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            </svg>
                        </div>

                        <div>
                            <h3>Reliable Support</h3>
                            <p>Our team is here to assist you</p>
                        </div>

                    </div>

                    <div class="ct-assurance">

                        <div class="ct-assurance-icon">
                            <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                                <path d="M20 12.6c0 3.5-3.6 6.3-8 6.3-.9 0-1.8-.1-2.6-.3L4.6 20l1.2-3.1C4.6 15.8 4 14.3 4 12.6 4 9.1 7.6 6.3 12 6.3s8 2.8 8 6.3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                <circle cx="9.2" cy="12.6" r="1.05" fill="currentColor" />
                                <circle cx="12.8" cy="12.6" r="1.05" fill="currentColor" />
                            </svg>
                        </div>

                        <div>
                            <h3>Multiple Channels</h3>
                            <p>Reach out via the way that suits you best</p>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="ct-hero-wave-wrap" aria-hidden="true">
            <img src="~/images/Wave.png" alt="" class="ct-hero-wave" />
        </div>

    </section>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <main class="ct-main">

        <div class="ct-grid">


            <!-- =========================================================
                 REPORT AN ISSUE
            ========================================================== -->

            <section class="ct-card">

                <h2 class="ct-card-title">Report an Issue</h2>

                <p class="ct-card-subtitle">
                    Please fill out the form below and provide as much detail as possible.
                </p>

                @if (submitted)
                {
                    <div class="ct-alert ct-alert--success" role="status">
                        Thanks &mdash; your issue has been received. Our support team will get back to you within 24 hours.
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="ct-alert ct-alert--error" role="alert">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post" action="/contact" enctype="multipart/form-data" class="ct-form" id="contactForm">

                    @Html.AntiForgeryToken()

                    <div class="ct-field">
                        <label for="FullName">Full Name</label>
                        <input type="text" id="FullName" name="FullName"
                               placeholder="Enter your full name"
                               value="@Model.FullName" />
                    </div>

                    <div class="ct-field">
                        <label for="Email">Email Address</label>
                        <input type="email" id="Email" name="Email"
                               placeholder="Enter your email address"
                               value="@Model.Email" />
                    </div>

                    <div class="ct-field">
                        <label for="AccountType">Account Type</label>
                        <select id="AccountType" name="AccountType" class="@accountTypeClass">
                            <option value="">Select account type</option>
                            @foreach (var type in Brandora.Web.Models.Contact.ContactIssueViewModel.AccountTypes)
                            {
                                <option value="@type" selected="@(Model.AccountType == type)">@type</option>
                            }
                        </select>
                    </div>

                    <div class="ct-field">
                        <label for="IssueType">Issue Type</label>
                        <select id="IssueType" name="IssueType" class="@issueTypeClass">
                            <option value="">Select issue type</option>
                            @foreach (var type in Brandora.Web.Models.Contact.ContactIssueViewModel.IssueTypes)
                            {
                                <option value="@type" selected="@(Model.IssueType == type)">@type</option>
                            }
                        </select>
                    </div>

                    <div class="ct-field">
                        <label for="Subject">Subject</label>
                        <input type="text" id="Subject" name="Subject"
                               placeholder="Briefly describe the issue"
                               value="@Model.Subject" />
                    </div>

                    <div class="ct-field">
                        <label for="Description">Description</label>
                        <textarea id="Description" name="Description"
                                  placeholder="Please provide detailed information about the issue">@Model.Description</textarea>
                    </div>

                    <div class="ct-field">

                        <label for="Attachments">Attachments (Optional)</label>

                        <label class="ct-dropzone" id="contactDropzone" for="Attachments">

                            <span class="ct-dropzone-main">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M4 15v2.5A2.5 2.5 0 006.5 20h11a2.5 2.5 0 002.5-2.5V15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                </svg>
                                Drag &amp; drop files here or click to upload
                            </span>

                            <span class="ct-dropzone-hint">
                                Supported formats: JPG, PNG, PDF (Max 10MB)
                            </span>

                            <span class="ct-dropzone-files" id="contactDropzoneFiles"></span>

                            <input type="file" id="Attachments" name="Attachments"
                                   accept=".jpg,.jpeg,.png,.pdf" multiple hidden />

                        </label>

                    </div>

                    <button type="submit" class="ct-submit">
                        Submit Issue
                    </button>

                    <div class="ct-secure">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                            <rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="1.8" />
                            <path d="M8.2 10.5V7.8a3.8 3.8 0 017.6 0v2.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                        Your information is secure and will not be shared.
                    </div>

                </form>

            </section>


            <div class="ct-aside">


                <!-- =========================================================
                     OTHER WAYS TO REACH US
                ========================================================== -->

                <section class="ct-card">

                    <h2 class="ct-card-title">Other Ways to Reach Us</h2>

                    <div class="ct-channels">


                        <div class="ct-channel">

                            <div class="ct-channel-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <rect x="3" y="5.5" width="18" height="13" rx="2.5" stroke="currentColor" stroke-width="1.6" />
                                    <path d="M4 7.5l8 5.2 8-5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div class="ct-channel-body">
                                <div class="ct-channel-head">
                                    <h3>Email Support</h3>
                                </div>
                                <p>support@brandora.com</p>
                                <p>We usually respond within 24 hours</p>
                            </div>

                        </div>


                        <div class="ct-channel">

                            <div class="ct-channel-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <path d="M20 12.2c0 3.4-3.6 6.1-8 6.1-.9 0-1.8-.1-2.6-.3L4.6 19.5l1.2-3c-1.2-1.1-1.8-2.6-1.8-4.3 0-3.4 3.6-6.1 8-6.1s8 2.7 8 6.1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <circle cx="9.2" cy="12.2" r="1" fill="currentColor" />
                                    <circle cx="12.8" cy="12.2" r="1" fill="currentColor" />
                                </svg>
                            </div>

                            <div class="ct-channel-body">
                                <div class="ct-channel-head">
                                    <h3>Live Chat</h3>
                                    <span class="ct-channel-pill">Recommended</span>
                                </div>
                                <p>Chat with our support team</p>
                                <p>Available 9 AM &ndash; 9 PM (Daily)</p>
                            </div>

                        </div>


                        <a href="#" class="ct-channel">

                            <div class="ct-channel-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <path d="M4 5.2h5a3 3 0 013 3v10.4a2.4 2.4 0 00-2.4-2.2H4V5.2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <path d="M20 5.2h-5a3 3 0 00-3 3v10.4a2.4 2.4 0 012.4-2.2H20V5.2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div class="ct-channel-body">
                                <div class="ct-channel-head">
                                    <h3>Help Center</h3>
                                    <svg class="ct-channel-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                        <path d="M5 12h13m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                                <p>Browse articles and guides</p>
                                <p>Get instant answers</p>
                            </div>

                        </a>


                        <a href="#" class="ct-channel">

                            <div class="ct-channel-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <circle cx="9" cy="9.4" r="2.9" stroke="currentColor" stroke-width="1.6" />
                                    <path d="M3.6 18.6c0-2.7 2.4-4.5 5.4-4.5s5.4 1.8 5.4 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <path d="M16.2 6.9a2.6 2.6 0 010 5.1M17 14.4c2.1.4 3.5 1.9 3.5 4.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                </svg>
                            </div>

                            <div class="ct-channel-body">
                                <div class="ct-channel-head">
                                    <h3>Community</h3>
                                    <svg class="ct-channel-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                        <path d="M5 12h13m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                                <p>Ask questions and get help</p>
                                <p>From other users</p>
                            </div>

                        </a>


                    </div>

                </section>


                <!-- =========================================================
                     FAQ
                ========================================================== -->

                <section class="ct-card">

                    <h2 class="ct-card-title">Frequently Asked Questions</h2>

                    <div class="ct-faq-list">

                        <details class="ct-faq">
                            <summary>
                                How long does it take to get a response?
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 9.5l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </summary>
                            <div class="ct-faq-answer">
                                Most issues are answered within 24 hours. Live Chat is the fastest
                                route and is staffed daily between 9 AM and 9 PM.
                            </div>
                        </details>

                        <details class="ct-faq">
                            <summary>
                                How can I track my reported issue?
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 9.5l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </summary>
                            <div class="ct-faq-answer">
                                You will receive a confirmation email with a reference number. Reply
                                to that email at any time and it stays attached to the same report.
                            </div>
                        </details>

                        <details class="ct-faq">
                            <summary>
                                What information should I include?
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 9.5l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </summary>
                            <div class="ct-faq-answer">
                                Tell us what you expected, what happened instead, and the campaign or
                                collaboration involved. Screenshots help us resolve issues faster.
                            </div>
                        </details>

                        <details class="ct-faq">
                            <summary>
                                Can I attach screenshots or files?
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 9.5l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </summary>
                            <div class="ct-faq-answer">
                                Yes. Attach JPG, PNG or PDF files up to 10MB each using the
                                attachments field on the form.
                            </div>
                        </details>

                    </div>

                </section>


            </div>


        </div>


        <!-- =========================================================
             BOTTOM CTA
        ========================================================== -->

        <div class="ct-cta-wrap">

            <div class="ct-cta">

                <div class="ct-cta-copy">

                    <div class="ct-cta-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M4.5 14.5v-2.7a7.5 7.5 0 0115 0v2.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            <rect x="2.8" y="13.4" width="3.9" height="6" rx="1.9" stroke="currentColor" stroke-width="1.6" />
                            <rect x="17.3" y="13.4" width="3.9" height="6" rx="1.9" stroke="currentColor" stroke-width="1.6" />
                        </svg>
                    </div>

                    <div>
                        <h2>Can&rsquo;t find what you need?</h2>
                        <p>Our support team is always ready to help you out.</p>
                    </div>

                </div>

                <a href="#" class="ct-cta-btn">
                    Start Live Chat
                </a>

            </div>

        </div>

    </main>


    <partial name="_BrandoraFooter" />


    <script>
        (function () {
            // Keep the select text grey while it still shows its placeholder,
            // matching the grey the real input placeholders use.
            document.querySelectorAll('.ct-field select').forEach(function (select) {
                select.addEventListener('change', function () {
                    select.classList.toggle('is-placeholder', select.value === '');
                });
            });

            // Attachments: click-to-upload is handled by the wrapping <label>,
            // so only drag & drop and the file summary need wiring.
            var dropzone = document.getElementById('contactDropzone');
            var input = document.getElementById('Attachments');
            var summary = document.getElementById('contactDropzoneFiles');
            if (!dropzone || !input || !summary) return;

            function describe() {
                var count = input.files ? input.files.length : 0;
                if (count === 0) {
                    summary.textContent = '';
                } else if (count === 1) {
                    summary.textContent = input.files[0].name;
                } else {
                    summary.textContent = count + ' files selected';
                }
            }

            input.addEventListener('change', describe);

            ['dragenter', 'dragover'].forEach(function (name) {
                dropzone.addEventListener(name, function (e) {
                    e.preventDefault();
                    dropzone.classList.add('is-dragging');
                });
            });

            ['dragleave', 'drop'].forEach(function (name) {
                dropzone.addEventListener(name, function (e) {
                    e.preventDefault();
                    dropzone.classList.remove('is-dragging');
                });
            });

            dropzone.addEventListener('drop', function (e) {
                if (e.dataTransfer && e.dataTransfer.files.length) {
                    input.files = e.dataTransfer.files;
                    describe();
                }
            });
        })();
    </script>


</body>
</html>
