@model Brandora.Web.Models.Messages.InboxViewModel
@using Brandora.Web.Models.Influencers
@using Brandora.Web.Models.Domain
@inject Microsoft.AspNetCore.Identity.UserManager<Brandora.Web.Models.Domain.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Chat";
    ViewData["ActiveNav"] = "Chat";
    Layout = null;

    var currentUserId = UserManager.GetUserId(User);
    var selected = Model.Selected;
    var selectedMessages = selected?.VisibleMessages(false).OrderBy(m => m.SentAt).ThenBy(m => m.Id).ToList() ?? new List<Brandora.Web.Models.Domain.Message>();
    var influencerName = ViewData["CompanyName"] as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts (Inter included: the Brand side's chat UI is set in Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-button,
        ::-webkit-scrollbar-button:single-button,
        ::-webkit-scrollbar-button:vertical:start,
        ::-webkit-scrollbar-button:vertical:end,
        ::-webkit-scrollbar-button:horizontal:start,
        ::-webkit-scrollbar-button:horizontal:end,
        ::-webkit-scrollbar-button:increment,
        ::-webkit-scrollbar-button:decrement {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
            background: transparent !important;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #d3d9ec;
            border-radius: 10px;
            border: 2px solid transparent;
            background-clip: padding-box;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #b7c0e0;
            background-clip: padding-box;
        }

        html {
            scrollbar-width: thin;
            scrollbar-color: #d3d9ec transparent;
        }

        body {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            background: #ffffff;
            color: #20283a;
            overflow-x: hidden;
        }

        @@keyframes fade-up {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* =========================================================
           BRAND-SIDE SHARED PRIMITIVES — copied verbatim from
           Views/Shared/_AppLayout.cshtml so this page renders exactly
           like the Brand side's Messages page. Buttons are namespaced
           .bx-btn* because this page also loads Bootstrap's .btn.
        ========================================================= */

        /* =========================================================
           SHARED: PAGE HERO
           Reproduces the Influencer side's exact hero-card visual
           system (brandora-influencer-dashboard.css: .dashboard-hero /
           .dashboard-glass / .dashboard-hero-motto) so every Brand page
           that includes this markup automatically matches it, in one
           place, without per-page duplication.
        ========================================================= */

        .page-hero {
            position: relative;
            isolation: isolate;

            display: flex;
            align-items: center;
            min-height: 170px;

            margin: 0 0 26px;
            padding: 26px 40px;

            border-radius: 18px;
            overflow: hidden;

            background:
                radial-gradient(ellipse at 61% 0%, #a9c9ff99, transparent 58%),
                linear-gradient(110deg, #edf8ff55, #dcefff99 55%, #edf8ff55);
            border: 1px solid #d1e2ff;

            animation: fade-up .5s ease both;
        }

        .page-hero-waves {
            position: absolute;
            inset: auto 0 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .page-hero-intro {
            position: relative;
            z-index: 2;
            max-width: 52%;
        }

        .page-hero-eyebrow {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            color: #4b6398;
        }

        .page-hero-title {
            margin-top: 6px;

            font-family: 'Playfair Display', Georgia, serif;
            font-weight: 600;
            font-size: clamp(24px, 2.6vw, 34px);
            line-height: 1.2;
            letter-spacing: -.5px;
            color: #171d3d;
        }

        .page-hero-title span {
            background: linear-gradient(115deg, #7224ff, #3735ff 55%, #087fff);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
        }

        .page-hero-sub {
            margin-top: 8px;
            max-width: 480px;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            line-height: 1.55;
            color: #426098;
        }

        .page-hero-stats {
            display: flex;
            gap: 26px;
            margin-top: 14px;
        }

        .page-hero-stats > div + div {
            border-left: 1px solid #9ebce9;
            padding-left: 26px;
        }

        .page-hero-stats dd {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.1;
            color: #171d3d;
        }

        .page-hero-stats dt {
            margin: 2px 0 0;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 500;
            color: #2b467d;
        }

        .page-hero-art {
            position: absolute;
            z-index: 1;
            width: 230px;
            height: 200px;
            left: 48%;
            top: 22px;
            transform: rotate(10deg) skewX(-3deg);
        }

        .hero-glass {
            position: absolute;
            border: 1px solid #ffffffb8;
            border-radius: 18px;
            background: linear-gradient(125deg, #ffffff80, #d4ebff35 55%, #ffffff5c);
            box-shadow: inset 0 0 20px #ffffff44, 0 10px 30px #4488da0b;
        }

        .hero-glass-back {
            inset: 0;
        }

        .hero-glass-front {
            inset: 22px 18px -18px 16px;
            padding: 17px 19px;

            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            line-height: 1.4;
            color: #244988;

            backdrop-filter: blur(1px);
        }

        .hero-glass-copy {
            display: block;
            transform: skewX(3deg) rotate(-10deg);
            transform-origin: top left;
            padding-top: 3px;
        }

        .hero-glass-copy > span,
        .page-hero-motto span {
            display: block;
            width: 34px;
            height: 3px;
            margin-top: 11px;

            border-radius: 4px;
            background: linear-gradient(110deg, #6323ff, #0759ff);
        }

        .hero-sparkle {
            position: absolute;
            top: 20px;
            right: -6px;
            width: 16px;
            height: 16px;
            background: radial-gradient(ellipse, white, transparent 65%);
        }

        .hero-sparkle::before,
        .hero-sparkle::after {
            content: "";
            position: absolute;
            inset: 7px -4px;
            background: linear-gradient(90deg, transparent, white, transparent);
        }

        .hero-sparkle::after {
            transform: rotate(90deg);
        }

        .page-hero-motto {
            margin-left: auto;
            padding: 4px 4% 4px 32px;

            position: relative;
            z-index: 2;

            border-left: 1px solid #adcdec;

            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            line-height: 1.5;
            color: #1e427c;
        }

        @@media(max-width: 1100px) {
            .page-hero-art { left: auto; right: 26px; }
            .page-hero-intro { max-width: 60%; }
        }

        @@media(max-width: 900px) {
            .page-hero-motto { display: none; }
        }

        @@media(max-width: 760px) {
            .page-hero { padding: 22px 24px; flex-wrap: wrap; }
            .page-hero-art { display: none; }
            .page-hero-intro { max-width: 100%; }
        }

        .bx-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            height: 46px;
            padding: 0 22px;

            border-radius: 10px;
            border: none;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            font-weight: 600;

            cursor: pointer;
            transition: .2s;
            white-space: nowrap;
        }

        .bx-btn-primary {
            color: #ffffff;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            background-size: 160% 160%;
            background-position: 0% 50%;
        }

        .bx-btn-primary:hover {
            transform: translateY(-2px);
            background-position: 100% 50%;
            box-shadow: 0 10px 26px rgba(140,60,255,.35);
        }

        .bx-btn-primary:active {
            transform: translateY(0) scale(.98);
        }

        .bx-btn-secondary {
            color: #0641ff;
            background: #ffffffb8;
            border: 1px solid #b4caff;
        }

        .bx-btn-secondary:hover {
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow: 0 0 0 1.5px #9b2cff, 0 10px 22px rgba(140,60,255,.18);
        }

        .bx-btn-secondary:active {
            transform: translateY(0);
        }

        .bx-btn-ghost {
            color: #6b7290;
            background: transparent;
            border: 1px solid transparent;
        }

        .bx-btn-ghost:hover {
            color: #9b2cff;
            background: rgba(155,44,255,.06);
        }

        .bx-btn-outline-brand {
            color: #7a2df3;
            background: #ffffff;
            border: 1.5px solid rgba(163,38,255,.35);
        }

        .bx-btn-outline-brand:hover {
            border-color: #a326ff;
            background: rgba(155,44,255,.06);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(140,60,255,.15);
        }

        .bx-btn-outline-danger {
            color: #c22540;
            background: #ffffff;
            border: 1.5px solid #f6c3ca;
        }

        .bx-btn-outline-danger:hover {
            border-color: transparent;
            color: #ffffff;
            background: linear-gradient(105deg, #ff4d6b, #d6234a);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(214,35,74,.25);
        }

        .bx-btn-danger-solid {
            color: #ffffff;
            background: linear-gradient(105deg, #ff4d6b, #d6234a);
        }

        .bx-btn-danger-solid:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(214,35,74,.3);
        }

        /* =========================================================
           SHARED: CONFIRM MODAL
        ========================================================= */

        .confirm-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 200;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 20px;

            background: rgba(10,14,35,.45);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);

            opacity: 0;
            visibility: hidden;
            transition: opacity .2s ease, visibility .2s ease;
        }

        .confirm-modal-backdrop.is-open {
            opacity: 1;
            visibility: visible;
        }

        .confirm-modal {
            width: 100%;
            max-width: 380px;
            padding: 30px 28px 26px;

            border-radius: 20px;
            background: #ffffff;
            box-shadow: 0 30px 60px rgba(20,20,60,.25);

            text-align: center;

            transform: translateY(14px) scale(.96);
            transition: transform .25s cubic-bezier(.22,1,.36,1);
        }

        .confirm-modal-backdrop.is-open .confirm-modal {
            transform: translateY(0) scale(1);
        }

        .confirm-modal-icon {
            width: 46px;
            height: 46px;
            margin: 0 auto;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;

            font-family: 'DM Sans', sans-serif;
            font-weight: 800;
            font-size: 20px;
        }

        .confirm-modal-icon.is-danger {
            background: linear-gradient(105deg, #ff4d6b, #d6234a);
        }

        .confirm-modal-title {
            margin-top: 16px;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 16.5px;
            color: #171d3d;
        }

        .confirm-modal-text {
            margin-top: 8px;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            line-height: 1.6;
            color: #6b7290;
        }

        .confirm-modal-actions {
            margin-top: 22px;

            display: flex;
            gap: 10px;
        }

        .confirm-modal-actions .bx-btn {
            flex: 1;
            height: 44px;
        }

        /* =========================================================
           SHARED: BACK TO DASHBOARD
        ========================================================= */

        .back-to-dashboard {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            margin-bottom: 18px;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            color: #5877ac;

            transition: color .2s ease;
        }

        .back-to-dashboard svg {
            transition: transform .2s ease;
        }

        .back-to-dashboard:hover {
            color: #1451ff;
        }

        .back-to-dashboard:hover svg {
            transform: translateX(-3px);
        }

        .verified-badge {
            display: inline-flex;
            align-items: center;
            flex-shrink: 0;
            gap: 4px;

            padding: 2px 9px;

            border-radius: 20px;
            background: #e4f0ff;
            color: #1265d6;
            white-space: nowrap;

            font-family: 'Inter', sans-serif;
            font-size: 10.5px;
            font-weight: 700;
        }

        /* Social profile icon: the platform's real glyph on its own brand colour
           (Facebook blue, Instagram gradient, TikTok black...). Background is set
           inline from SocialPlatform.Background. */
        .social-icons { display: flex; flex-wrap: wrap; gap: 8px; }
        .social-chip { display: inline-grid; place-items: center; flex-shrink: 0; width: 38px; height: 38px; border-radius: 50%; color: #ffffff; font-size: 17px; line-height: 1; box-shadow: 0 6px 14px #10183a26, inset 0 0 0 1px #ffffff26; transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease, filter .2s ease; }
        .social-chip.sm { width: 30px; height: 30px; font-size: 14px; }
        .social-chip.xs { width: 26px; height: 26px; font-size: 12px; }
        a.social-chip:hover { transform: translateY(-2px); box-shadow: 0 10px 20px #10183a33; color: #ffffff; }

        .icon-chip { display: grid; place-items: center; flex-shrink: 0; width: 42px; height: 42px; border-radius: 50%; font-size: 19px; background: #ebe8ff; color: #6545ff; }
        .icon-chip.sm { width: 34px; height: 34px; font-size: 15px; }
        .icon-chip.lg { width: 52px; height: 52px; font-size: 23px; }
        .icon-chip.violet { background: #ebe8ff; color: #6545ff; }
        .icon-chip.blue { background: #e2efff; color: #176cff; }
        .icon-chip.cyan { background: #def7fc; color: #139fc1; }
        .icon-chip.mint { background: #e2f7ed; color: #0d9c6c; }
        .icon-chip.amber { background: #fdf0dc; color: #c07d16; }
        .icon-chip.pink { background: #f6ecfa; color: #b554b5; }
        .icon-chip.soft { background: linear-gradient(135deg, #e4eeff, #cce2ff); color: #135bff; }

        /* ---- Notices (inline feedback, theme-toned) ---- */
        .notice { display: flex; align-items: flex-start; gap: 10px; margin: 0 0 14px; padding: 12px 16px; border-radius: 10px; border: 1px solid #c8e2f8; background: #eef8ff; font-family: 'Inter', sans-serif; font-size: 13px; line-height: 1.5; color: #34527b; animation: fade-up .4s ease both; }
        .notice i { margin-top: 1px; color: #1451ff; }
        .notice.is-success { border-color: #bfe9d6; background: #effbf5; color: #1c6a4b; }
        .notice.is-success i { color: #0d9c6c; }
        .notice.is-error { border-color: #f4c6cd; background: #fdf0f2; color: #a82749; }
        .notice.is-error i { color: #c22540; }

        .detail-crumb {
            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 500;
            color: #8189a8;
        }

        .messages-shell {
            margin-top: 14px;

            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 20px;

            /* The inbox gets (almost) a full screen of its own below the hero:
               viewport minus the sticky topbar, never cramped, never absurdly tall. */
            height: clamp(640px, calc(100vh - 118px), 940px);

            animation: fade-up .4s ease both;
        }

        .messages-shell > .list-panel,
        .messages-shell > .thread-panel { min-height: 0; }

        @@media(max-width: 900px) {
            .messages-shell { grid-template-columns: 1fr; height: auto; }
            .messages-shell > .list-panel { max-height: 420px; }
            .messages-shell > .thread-panel { height: clamp(560px, calc(100vh - 110px), 820px); }
        }

        /* ---- List panel ---- */

        .list-panel {
            display: flex;
            flex-direction: column;

            border-radius: 22px;
            background: #ffffff;
            border: 1px solid #eaecf5;
            box-shadow: 0 24px 60px rgba(30,34,90,.06);

            overflow: hidden;
        }

        .list-head {
            padding: 20px 20px 16px;
            border-bottom: 1px solid #f0f1f7;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .list-head-title {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            font-size: 20px;
            color: #171d3d;
        }

        .list-head-sub {
            margin-top: 2px;

            font-family: 'Inter', sans-serif;
            font-size: 12px;
            color: #8189a8;
        }

        .list-filter-btn {
            flex-shrink: 0;

            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;
            border: 1px solid #e2e5f2;
            background: #ffffff;

            color: #545b7d;
            cursor: pointer;

            transition: .2s;
        }

        .list-filter-btn:hover,
        .list-filter-btn.is-active {
            border-color: #9b2cff;
            color: #9b2cff;
            background: linear-gradient(105deg, rgba(163,38,255,.08), rgba(35,110,234,.08));
        }

        .list-search-wrap {
            max-height: 0;
            overflow: hidden;

            transition: max-height .3s cubic-bezier(.22,1,.36,1);
        }

        .list-search-wrap.is-open {
            max-height: 70px;
        }

        .list-search {
            display: flex;
            align-items: center;
            gap: 8px;

            padding: 12px 20px;
            border-bottom: 1px solid #f0f1f7;
        }

        .list-search input {
            flex: 1;
            height: 38px;

            padding: 0 14px;

            border-radius: 10px;
            border: 1px solid #e2e5f2;
            background: #fbfbfe;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #2a3157;

            outline: none;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

        .list-search input:focus {
            border-color: #a978ff;
            box-shadow: 0 0 0 3px rgba(155,44,255,.1);
        }

        .list-rows {
            flex: 1;
            overflow-y: auto;

            padding: 8px;

            scroll-behavior: smooth;
        }

        .inbox-row {
            position: relative;

            display: flex;
            align-items: center;
            gap: 12px;

            padding: 12px 12px;
            margin-bottom: 4px;

            border-radius: 14px;

            transition: background .25s ease, transform .2s ease;

            opacity: 0;
            transform: translateY(14px);
        }

        .inbox-row.is-visible {
            opacity: 1;
            transform: translateY(0);
            transition: opacity .45s ease, transform .45s cubic-bezier(.22,1,.36,1), background .25s ease;
        }

        a.inbox-row:hover {
            background: #f7f5ff;
        }

        .inbox-row.is-selected {
            background: linear-gradient(105deg, rgba(163,38,255,.1), rgba(35,110,234,.08) 60%, rgba(24,169,255,.08));
        }

        .inbox-avatar {
            width: 44px;
            height: 44px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 14px;

            transition: transform .3s cubic-bezier(.22,1,.36,1);
        }

        a.inbox-row:hover .inbox-avatar {
            transform: scale(1.06) rotate(-3deg);
        }

        .inbox-body {
            flex: 1;
            min-width: 0;
        }

        .inbox-name-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 14px;
            color: #171d3d;
        }

        .inbox-name-left {
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 0;
        }

        .inbox-name-left span:first-child {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .inbox-time {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 500;
            color: #9096b3;
            flex-shrink: 0;
        }

        .inbox-snippet-row {
            margin-top: 2px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .inbox-snippet {
            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            color: #8189a8;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .inbox-snippet.is-unread {
            color: #2a3157;
            font-weight: 600;
        }

        .inbox-unread-dot {
            flex-shrink: 0;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 10px;
            color: #fff;
        }

        .list-empty {
            margin: auto;
            padding: 30px 20px;
            text-align: center;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #9096b3;
        }

        .start-convo-card {
            margin: 8px;
            padding: 22px 16px;

            border-radius: 16px;
            background: linear-gradient(165deg, #f6f1ff, #eef2ff);
            border: 1px solid #e6e1ff;

            text-align: center;
        }

        .start-convo-icon {
            width: 40px;
            height: 40px;
            margin: 0 auto 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
        }

        .start-convo-title {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 13.5px;
            color: #171d3d;
        }

        .start-convo-text {
            margin: 5px auto 0;
            max-width: 240px;

            font-family: 'Inter', sans-serif;
            font-size: 12px;
            line-height: 1.55;
            color: #6b7290;
        }

        .start-convo-card .bx-btn {
            margin-top: 14px;
            width: 100%;
            height: 40px;
            font-size: 12.5px;
        }

        /* ---- Thread panel ---- */

        .thread-panel {
            position: relative;
            overflow: hidden;

            display: flex;
            flex-direction: column;

            border-radius: 22px;
            background: #ffffff;
            border: 1px solid #eaecf5;
            box-shadow: 0 24px 60px rgba(30,34,90,.08);
        }

        .thread-header {
            padding: 18px 24px;

            background: linear-gradient(120deg, #fbf5ff, #f3f6ff);
            border-bottom: 1px solid #eaecf5;

            display: flex;
            align-items: center;
            gap: 14px;
        }

        .thread-name {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 15.5px;
            color: #171d3d;
        }

        .thread-sub {
            margin-top: 2px;

            font-family: 'Inter', sans-serif;
            font-size: 12px;
            color: #8189a8;
        }

        .thread-header > div:nth-child(2) { flex: 1; min-width: 0; }
        .thread-name, .thread-sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        @@media(max-width: 560px) {
            .thread-header { padding: 14px 16px; gap: 10px; }
            .thread-header-actions { gap: 6px; }
            .thread-icon-btn { width: 34px; height: 34px; }
            .thread-body { padding: 16px; }
            .msg-col { max-width: 82%; }
            .thread-composer { padding: 12px 14px; gap: 8px; }
        }

        .thread-header-actions {
            margin-left: auto;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            gap: 8px;
        }

        .thread-icon-btn {
            width: 38px;
            height: 38px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;
            border: 1px solid #e2e5f2;
            background: #ffffff;

            color: #545b7d;
            cursor: pointer;

            transition: .2s;
        }

        .thread-icon-btn:hover,
        .thread-icon-btn.is-active {
            border-color: #9b2cff;
            color: #9b2cff;
        }

        .thread-icon-btn:disabled {
            cursor: not-allowed;
            opacity: .5;
        }

        .thread-icon-btn:disabled:hover {
            border-color: #e2e5f2;
            color: #545b7d;
        }

        .thread-body {
            flex: 1;
            overflow-y: auto;
            scroll-behavior: smooth;

            padding: 24px;

            background: #fbfbfe;

            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .msg-row {
            display: flex;
            align-items: flex-end;
            gap: 8px;
        }

        .msg-row.is-mine {
            justify-content: flex-end;
        }

        .msg-avatar {
            width: 26px;
            height: 26px;
            flex-shrink: 0;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 10px;
            color: #fff;
        }

        .msg-col {
            display: flex;
            flex-direction: column;
            max-width: 68%;
            min-width: 0;
        }

        .msg-row.is-mine .msg-col {
            align-items: flex-end;
        }

        .msg-row:not(.is-mine) .msg-col {
            align-items: flex-start;
        }

        .msg-bubble {
            padding: 11px 16px;

            border-radius: 17px;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            line-height: 1.55;
            word-break: break-word;

            animation: fade-up .3s ease both;
        }

        .msg-row.is-mine .msg-bubble {
            background: linear-gradient(105deg, #a326ff, #236eff 60%, #18a9ff);
            color: #ffffff;
            border-bottom-right-radius: 5px;
            box-shadow: 0 10px 22px rgba(139,44,255,.18);
        }

        .msg-row:not(.is-mine) .msg-bubble {
            background: #ffffff;
            border: 1px solid #eaecf5;
            color: #2a3157;
            border-bottom-left-radius: 5px;
            box-shadow: 0 6px 16px rgba(30,34,90,.05);
        }

        .msg-time {
            margin-top: 4px;

            font-family: 'Inter', sans-serif;
            font-size: 10.5px;
            color: #9096b3;
        }

        .msg-row.is-mine .msg-time {
            text-align: right;
        }

        .msg-bubble-row {
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .msg-row.is-mine .msg-bubble-row {
            flex-direction: row-reverse;
        }

        .msg-bubble-wrap {
            min-width: 0;
        }

        .msg-menu-wrap {
            position: relative;
            flex-shrink: 0;
            align-self: center;

            opacity: 0;
            transition: opacity .15s ease;
        }

        .msg-row:hover .msg-menu-wrap,
        .msg-menu-wrap.is-open {
            opacity: 1;
        }

        .msg-menu-btn {
            width: 24px;
            height: 24px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border: none;
            border-radius: 50%;
            background: transparent;
            color: #9096b3;
            cursor: pointer;

            transition: background .15s ease, color .15s ease;
        }

        .msg-menu-btn:hover {
            background: rgba(30,34,90,.08);
            color: #4a5170;
        }

        .msg-menu {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 30;

            min-width: 130px;

            border-radius: 12px;
            border: 1px solid #eaecf5;
            background: #ffffff;
            box-shadow: 0 14px 32px rgba(30,34,90,.16);
            padding: 6px;

            opacity: 0;
            visibility: hidden;
            transform: translateY(-6px) scale(.97);
            transition: opacity .15s ease, transform .15s cubic-bezier(.22,1,.36,1), visibility .15s;
        }

        .msg-row.is-mine .msg-menu {
            left: auto;
            right: 0;
        }

        .msg-menu-wrap.is-open .msg-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .msg-menu-item {
            display: block;
            width: 100%;
            padding: 8px 10px;

            border: none;
            border-radius: 8px;
            background: transparent;
            text-align: left;
            cursor: pointer;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 500;
            color: #2a3157;

            transition: background .15s ease;
        }

        .msg-menu-item:hover {
            background: rgba(155,44,255,.08);
        }

        .msg-menu-item.msg-menu-danger {
            color: #c22540;
        }

        .msg-menu-item.msg-menu-danger:hover {
            background: rgba(220,50,70,.08);
        }

        .msg-menu-unsend-form {
            margin: 0;
        }

        .msg-edit-form {
            display: flex;
            flex-direction: column;
            gap: 6px;

            margin-top: 4px;
            padding: 10px 12px;

            border-radius: 14px;
            border: 1px solid #d9c6ff;
            background: #fbfaff;
        }

        .msg-edit-form[hidden] {
            display: none;
        }

        .msg-edit-input {
            resize: none;
            min-height: 44px;
            padding: 6px 2px;

            border: none;
            background: transparent;
            outline: none;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            color: #171d3d;
            line-height: 1.5;

            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .msg-edit-input::-webkit-scrollbar {
            display: none;
        }

        .msg-edit-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .msg-edit-cancel,
        .msg-edit-save {
            padding: 6px 14px;

            border: none;
            border-radius: 20px;
            cursor: pointer;

            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;

            transition: opacity .15s ease;
        }

        .msg-edit-cancel {
            background: #eef0f7;
            color: #4a5170;
        }

        .msg-edit-save {
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
        }

        .msg-edit-cancel:hover,
        .msg-edit-save:hover {
            opacity: .85;
        }

        .composer-error {
            margin: 0 20px;
            padding: 10px 16px;

            border-radius: 10px;
            background: #fff2f2;
            border: 1px solid #ffd4d4;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            color: #c22b4a;
        }

        .composer-preview {
            display: none;
            align-items: center;
            gap: 10px;

            margin: 12px 20px 0;
            padding: 8px 12px;

            border-radius: 12px;
            background: linear-gradient(120deg, rgba(163,38,255,.1), rgba(24,169,255,.08));
            border: 1px solid rgba(163,38,255,.28);
        }

        .composer-preview-name {
            flex: 1;
            min-width: 0;

            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            color: #3c4363;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .composer-preview-remove {
            width: 22px;
            height: 22px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            border: none;
            cursor: pointer;
            background: rgba(0,0,0,.06);
            color: #6b7290;
        }

        .composer-preview-media {
            position: relative;
            flex-shrink: 0;

            width: 56px;
            height: 56px;

            border-radius: 12px;
            overflow: hidden;
            background: #e9ecf7;
        }

        .composer-preview-media img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .composer-preview-media .composer-preview-remove {
            position: absolute;
            top: 4px;
            right: 4px;

            width: 18px;
            height: 18px;

            background: rgba(15,20,45,.65);
            color: #ffffff;
            font-size: 11px;
        }

        .composer-preview-file {
            display: flex;
            align-items: center;
            gap: 10px;

            flex: 1;
            min-width: 0;
        }

        .composer-preview-file[hidden],
        .composer-preview-media[hidden] {
            display: none;
        }

        .composer-preview-file-icon {
            flex-shrink: 0;
            color: #7a3fe0;
        }

        .msg-media {
            position: relative;
            overflow: hidden;
            border-radius: 14px;
            margin-bottom: 6px;
        }

        .msg-media-view {
            display: block;
            cursor: zoom-in;
        }

        .msg-media img,
        .msg-media video {
            display: block;
            width: 100%;
            max-width: 240px;
            max-height: 260px;
            object-fit: cover;
        }

        .msg-media-download {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 2;

            width: 28px;
            height: 28px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            border: none;
            background: rgba(15,20,45,.55);
            color: #ffffff;
            backdrop-filter: blur(3px);

            transition: background .15s ease;
        }

        .msg-media-download:hover {
            background: rgba(15,20,45,.8);
        }

        .msg-bubble.has-media {
            padding: 6px;
        }

        .msg-bubble.has-media.has-caption {
            padding-bottom: 10px;
        }

        .msg-bubble.has-media .msg-caption {
            padding: 4px 8px 2px;
        }

        .msg-row.is-mine .msg-bubble.has-media:not(.has-caption),
        .msg-row:not(.is-mine) .msg-bubble.has-media:not(.has-caption) {
            padding: 0;
            background: none;
            border: none;
            box-shadow: none;
            border-radius: 0;
        }

        .thread-composer {
            padding: 16px 20px;

            background: #ffffff;
            border-top: 1px solid #eaecf5;

            display: flex;
            align-items: center;
            gap: 10px;
        }

        .composer-attach {
            flex-shrink: 0;
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            border: 1px solid #e2e5f2;
            background: #fbfbfe;
            cursor: pointer;
            color: #8b2cff;

            transition: border-color .2s ease, background .2s ease, transform .2s ease;
        }

        .composer-attach:hover {
            border-color: #a978ff;
            background: linear-gradient(120deg, rgba(163,38,255,.1), rgba(24,169,255,.08));
            transform: translateY(-1px);
        }

        .thread-composer textarea {
            flex: 1;
            resize: none;
            height: 46px;
            padding: 12px 16px;

            border-radius: 24px;
            border: 1px solid #e2e5f2;
            background: #fbfbfe;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            color: #171d3d;

            outline: none;
            transition: border-color .2s ease, background .2s ease;

            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .thread-composer textarea::-webkit-scrollbar {
            display: none;
        }

        .thread-composer textarea:focus {
            border-color: #a978ff;
            background: #ffffff;
        }

        .composer-send {
            flex-shrink: 0;
            width: 46px;
            height: 46px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            border: none;
            cursor: pointer;

            background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);
            background-size: 220% 220%;

            box-shadow: 0 10px 24px rgba(139,44,255,.32);

            transition: background-position .35s ease, transform .2s ease;
        }

        .composer-send:hover {
            background-position: 100% 100%;
            transform: translateY(-2px) scale(1.04);
        }

        .thread-empty {
            margin: auto;
            text-align: center;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #9096b3;
        }

        /* ---- Profile drawer ---- */

        .profile-drawer {
            position: absolute;
            inset: 0;
            z-index: 20;

            display: flex;
            flex-direction: column;

            padding: 30px 24px 26px;

            background: linear-gradient(165deg, #15163f 0%, #0c0d2c 55%, #07081f 100%);
            color: #fff;

            overflow-y: auto;

            transform: translateX(100%);
            transition: transform .35s cubic-bezier(.22,1,.36,1);
        }

        .profile-drawer.is-open {
            transform: translateX(0);
        }

        .profile-drawer::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;

            background:
                radial-gradient(circle at 15% 0%, rgba(163,38,255,.4), transparent 46%),
                radial-gradient(circle at 100% 20%, rgba(35,110,234,.28), transparent 42%),
                radial-gradient(circle at 80% 100%, rgba(24,169,255,.22), transparent 48%);
        }

        .profile-drawer > * {
            position: relative;
            z-index: 1;
        }

        .profile-drawer-close {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 2;

            width: 32px;
            height: 32px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.2);
            background: rgba(255,255,255,.06);
            color: #fff;
            cursor: pointer;
        }

        .profile-avatar-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .profile-avatar-ring {
            width: 86px;
            height: 86px;
            padding: 3px;

            border-radius: 50%;
            background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);

            box-shadow: 0 14px 34px rgba(139,44,255,.35);
        }

        .profile-avatar-ring .inbox-avatar {
            width: 100%;
            height: 100%;
            font-size: 26px;
            border: 2px solid #0c0d2c;
        }

        .profile-name-row {
            margin-top: 14px;

            display: flex;
            align-items: center;
            gap: 6px;

            font-family: 'Playfair Display', serif;
            font-weight: 600;
            font-size: 20px;
        }

        .profile-handle {
            margin-top: 4px;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            color: rgba(255,255,255,.55);
        }

        .profile-section {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid rgba(255,255,255,.1);
        }

        .profile-label {
            font-family: 'Inter', sans-serif;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .6px;
            text-transform: uppercase;
            color: rgba(255,255,255,.4);
        }

        .profile-bio {
            margin-top: 8px;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            line-height: 1.65;
            color: rgba(255,255,255,.82);
        }

        .profile-tags {
            margin-top: 10px;

            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .profile-tag {
            padding: 4px 11px;

            border-radius: 20px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.14);

            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            color: rgba(255,255,255,.85);
        }

        .profile-rate-box {
            margin-top: 8px;
            padding: 12px 14px;

            border-radius: 12px;
            background: linear-gradient(120deg, rgba(163,38,255,.18), rgba(24,169,255,.12));
            border: 1px solid rgba(163,38,255,.3);

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            line-height: 1.6;
            color: rgba(255,255,255,.9);
        }

        .profile-figures {
            margin-top: 12px;

            display: flex;
            justify-content: space-between;
        }

        .profile-figure-value {
            font-family: 'DM Sans', sans-serif;
            font-weight: 800;
            font-size: 17px;
            color: #fff;
        }

        .profile-figure-label {
            margin-top: 2px;

            font-family: 'Inter', sans-serif;
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: .3px;
            text-transform: uppercase;
            color: rgba(255,255,255,.45);
        }

        .profile-cta {
            margin-top: 22px;

            display: block;
            text-align: center;

            padding: 12px 18px;
            border-radius: 12px;

            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            background-size: 220% 100%;

            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 13px;
            color: #fff;

            transition: background-position .35s ease, transform .2s ease;
        }

        .profile-cta:hover {
            background-position: 100% 0;
            transform: translateY(-2px);
        }

        .confirm-modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 20px;
            background: rgba(15,20,45,.45);
            backdrop-filter: blur(2px);

            animation: fade-up .18s ease both;
        }

        .confirm-modal-overlay[hidden] {
            display: none;
        }

        .confirm-modal {
            width: 100%;
            max-width: 340px;

            padding: 24px;

            border-radius: 20px;
            background: #ffffff;
            box-shadow: 0 24px 60px rgba(20,24,60,.28);

            text-align: center;
        }

        .confirm-modal-icon {
            width: 46px;
            height: 46px;
            margin: 0 auto 14px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;
            background: rgba(220,50,70,.1);
            color: #c22540;
        }

        .confirm-modal-title {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 16px;
            color: #171d3d;
        }

        .confirm-modal-body {
            margin: 8px 0 0;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            line-height: 1.5;
            color: #6b7290;
        }

        .confirm-modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .confirm-modal-cancel,
        .confirm-modal-danger {
            flex: 1;
            padding: 11px 0;

            border: none;
            border-radius: 12px;
            cursor: pointer;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            font-weight: 600;

            transition: opacity .15s ease, transform .15s ease;
        }

        .confirm-modal-cancel {
            background: #eef0f7;
            color: #3c4363;
        }

        .confirm-modal-danger {
            background: linear-gradient(105deg, #e63b5e, #c22540);
            color: #ffffff;
        }

        .confirm-modal-cancel:hover,
        .confirm-modal-danger:hover {
            opacity: .88;
        }

        .confirm-modal-cancel:active,
        .confirm-modal-danger:active {
            transform: scale(.97);
        }

        .copy-toast {
            position: fixed;
            left: 50%;
            bottom: 90px;
            z-index: 300;
            transform: translateX(-50%) translateY(8px);

            padding: 8px 16px;
            border-radius: 20px;
            background: rgba(20,24,60,.92);

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            color: #ffffff;

            opacity: 0;
            pointer-events: none;
            transition: opacity .18s ease, transform .18s ease;
        }

        .copy-toast.is-visible {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }


        /* =========================================================
           Chrome aligned with the shared glass system
           (surfaces, borders, Playfair titles, soft chips).
           Layout sizes and chat behaviour are unchanged.
        ========================================================= */

        .list-panel,
        .thread-panel {
            border-radius: 14px;
            border: 1px solid #cfe2ff;
            background: linear-gradient(135deg, #ffffffe0, #f5faffcc 55%, #fafdffe6);
            box-shadow: inset 0 1px 2px #ffffff, 0 12px 30px -12px #3b5bdb24;
        }

        .list-head { border-bottom-color: #e3edfc; }
        .list-head-title { font-family: 'Playfair Display', Georgia, serif; letter-spacing: -.4px; color: #0b084e; }
        .list-head-sub { color: #5877ac; }

        .list-filter-btn { border-color: #d7e8ff; background: #ffffffb8; color: #33477c; }
        .list-filter-btn:hover,
        .list-filter-btn.is-active { border-color: #1451ff; color: #1451ff; background: #eef4ff; }

        .list-search { border-bottom-color: #e3edfc; }
        .list-search input { border-color: #cfe0fb; background: #ffffffd9; color: #101d48; }
        .list-search input:focus { border-color: #6b8dff; box-shadow: 0 0 0 3px #3b4dff1f; }

        a.inbox-row:hover { background: #f1f7ffcc; }
        .inbox-row.is-selected { background: linear-gradient(110deg, #efeaffcc, #e6f1ffcc); box-shadow: inset 0 0 0 1px #cddfff; }
        .inbox-avatar { background: linear-gradient(135deg, #7224ff, #3735ff 55%, #087fff); }
        .inbox-name-row { color: #101d48; }
        .inbox-time { color: #8095c4; }
        .inbox-snippet { color: #5877ac; }
        .inbox-snippet.is-unread { color: #101d48; }
        .inbox-unread-dot { background: linear-gradient(110deg, #6425ff, #004dff 55%, #00a8f0); }

        .start-convo-card { border-radius: 12px; border: 1px solid #d6e6ff; background: radial-gradient(ellipse at 95% 100%, #c1ddff, transparent 65%), linear-gradient(120deg, #eff7ff, #e0eeff); }
        .start-convo-icon.icon-chip { width: 42px; height: 42px; margin: 0 auto 12px; background: linear-gradient(135deg, #e4eeff, #cce2ff); color: #135bff; }
        .start-convo-title { color: #101d48; }
        .start-convo-text { color: #52649b; }

        .thread-header { background: linear-gradient(120deg, #f3f8ffe6, #eef3ffd9); border-bottom-color: #e3edfc; }
        .thread-name { color: #101d48; }
        .thread-sub { color: #5877ac; }

        .thread-empty { color: #5877ac; }
        .thread-empty-state { display: flex; flex-direction: column; align-items: center; gap: 8px; max-width: 320px; padding: 20px; }
        .thread-empty-state .icon-chip { margin-bottom: 4px; }
        .thread-empty-title { font: 600 19px/1.3 'Playfair Display', Georgia, serif; color: #0b084e; }
        .thread-empty-state p { margin: 0; font-family: 'Inter', sans-serif; font-size: 12.5px; line-height: 1.6; color: #5877ac; }
        .thread-empty-state .bx-btn { margin-top: 8px; height: 40px; }

        /* ---- Conversation pin / delete (per-side) ---- */
        .inbox-row-wrap { position: relative; }
        .inbox-time { transition: opacity .18s ease; }
        .inbox-pin { flex-shrink: 0; font-size: 11px; color: #6545ff; }
        .inbox-row-wrap.is-pinned .inbox-row:not(.is-selected) { background: linear-gradient(110deg, #f6f3ffb3, #f1f7ffb3); }

        .list-section-label { display: flex; align-items: center; gap: 6px; padding: 10px 12px 6px; font-family: 'Inter', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase; color: #5877ac; }
        .list-section-label i { font-size: 11px; color: #6545ff; }

        .convo-menu-wrap { position: absolute; top: 10px; right: 10px; z-index: 6; opacity: 0; transition: opacity .18s ease; }
        .inbox-row-wrap:hover .convo-menu-wrap,
        .inbox-row-wrap:focus-within .convo-menu-wrap,
        .convo-menu-wrap.is-open { opacity: 1; }
        .inbox-row-wrap:hover .inbox-time,
        .inbox-row-wrap:focus-within .inbox-time,
        .inbox-row-wrap.menu-open .inbox-time { opacity: 0; }

        .convo-menu-btn { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border-radius: 50%; border: 1px solid #d7e8ff; background: #ffffffeb; color: #33477c; font-size: 14px; cursor: pointer; box-shadow: 0 4px 12px -6px #3b5bdb55; transition: border-color .18s ease, color .18s ease, background .18s ease, transform .18s ease; }
        .convo-menu-btn:hover,
        .convo-menu-wrap.is-open .convo-menu-btn { border-color: #1451ff; background: #eef4ff; color: #1451ff; transform: scale(1.05); }
        .convo-menu-btn:focus-visible { outline: 2px solid #1451ff; outline-offset: 2px; }

        .convo-menu { position: absolute; top: calc(100% + 6px); right: 0; min-width: 196px; padding: 6px; border-radius: 12px; border: 1px solid #d7e8ff; background: #ffffff; box-shadow: 0 18px 40px -12px rgba(30,34,90,.28); opacity: 0; visibility: hidden; transform: translateY(-6px) scale(.97); transform-origin: top right; transition: opacity .16s ease, transform .16s cubic-bezier(.22,1,.36,1), visibility .16s; }
        .convo-menu-wrap.is-up .convo-menu { top: auto; bottom: calc(100% + 6px); transform-origin: bottom right; }
        .convo-menu-wrap.is-open .convo-menu { opacity: 1; visibility: visible; transform: none; }
        .convo-menu form { margin: 0; }
        .convo-menu-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 10px; border: 0; border-radius: 8px; background: transparent; text-align: left; font-family: 'Inter', 'DM Sans', sans-serif; font-size: 12.5px; font-weight: 500; color: #20365f; cursor: pointer; transition: background .15s ease, color .15s ease; }
        .convo-menu-item i { width: 16px; font-size: 14px; text-align: center; color: #6545ff; }
        .convo-menu-item:hover { background: linear-gradient(110deg, #efeaff, #e8f2ff); }
        .convo-menu-item.is-danger, .convo-menu-item.is-danger i { color: #c22540; }
        .convo-menu-item.is-danger:hover { background: #fdecef; }
        .convo-menu-sep { height: 1px; margin: 4px 6px; background: #eef2fb; }

        @@media (hover: none) {
            .convo-menu-wrap { opacity: 1; }
            .inbox-time { opacity: 0; }
        }

        /* ---- Influencer shell adaptations ----
           The dashboard stylesheet colours every link inside .dashboard-page blue;
           on the Brand side links inherit their colour, so restore that here and
           re-assert the colours the Brand side sets on its link-styled elements. */
        .messages-page a { color: inherit; }
        .messages-page a.back-to-dashboard { color: #5877ac; }
        .messages-page a.back-to-dashboard:hover { color: #1451ff; }
        .messages-page a.bx-btn-primary,
        .messages-page a.profile-cta { color: #ffffff; }
        .messages-page a.bx-btn-secondary { color: #0641ff; }
        .messages-page .back-to-dashboard { margin-top: 4px; }

        /* The dashboard stylesheet zeroes h1/p/dl margins inside .dashboard-page; the
           Brand side's spacing for these elements is restored here. */
        .messages-page .page-hero-title { margin-top: 6px; }
        .messages-page .page-hero-sub { margin-top: 8px; }
        .messages-page .page-hero-stats { margin-top: 14px; }
        .messages-page .page-hero-stats dt { margin: 2px 0 0; }
        .messages-page .start-convo-text { margin: 5px auto 0; }
        .messages-page .profile-bio { margin-top: 8px; }
        .messages-page .thread-empty-state p { margin: 0; }

        /* Brand website + social profiles inside the company drawer */
        .profile-website {
            display: inline-block;
            margin-top: 8px;

            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            color: #7fb2ff !important;
            word-break: break-all;
        }

        .profile-website:hover {
            text-decoration: underline;
        }

        .profile-socials {
            margin-top: 10px;
        }

    </style>
</head>

<body>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- ================= SIDEBAR ================= -->

    @await Html.PartialAsync("_InfluencerSidebar")


    <!-- ================= MAIN ================= -->

    <main class="dashboard-page messages-page" id="dashboardMain">

        <!-- TOP BAR -->

        <header class="dashboard-topbar">
            <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
            <form class="dashboard-search" method="get" asp-controller="InfluencerCampaigns" asp-action="Index" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="search" placeholder="Search campaigns, brands..." aria-label="Search campaigns and brands" />
                <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>
            <details class="dashboard-notifications">
                <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
                <div class="dashboard-notification-panel">
                    <div class="dashboard-notification-panel-head">
                        <h2>Notifications</h2>
                        @if (Model.Notifications.Count > 0)
                        {
                            <form method="post" asp-controller="Notifications" asp-action="ClearAll">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="dashboard-notification-clear">Clear</button>
                            </form>
                        }
                    </div>
                    @foreach (var notification in Model.Notifications)
                    {
                        <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                    }
                    @if (Model.Notifications.Count == 0) { <p>No notifications yet.</p> }
                </div>
            </details>
            <a class="dashboard-account" href="/InfluencerSettings">
                <span class="dashboard-avatar">@if (!string.IsNullOrEmpty(ViewData["ProfilePictureUrl"] as string)) { <img src="@ViewData["ProfilePictureUrl"]" alt="" /> } else { @FollowerFormat.InitialsOf(Model.InfluencerName) }</span>
                <span><strong>@Model.InfluencerName</strong><small>Influencer</small></span>
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </a>
        </header>


        <!-- ================= CHAT ================= -->

        <a href="/InfluencerDashboard" class="back-to-dashboard">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Back
        </a>

        <section class="page-hero">
            @await Html.PartialAsync("_HeroWaves")
            <div class="page-hero-intro">
                <p class="page-hero-eyebrow">Chat</p>
                <h1 class="page-hero-title">Your <span>Brand Inbox</span></h1>
                <p class="page-hero-sub">Every brand conversation, brief and deliverable in one inbox.</p>
                <dl class="page-hero-stats">
                    <div><dd>@Model.TotalCount</dd><dt>Conversation@(Model.TotalCount == 1 ? "" : "s")</dt></div>
                    <div><dd>@Model.TotalUnread</dd><dt>Unread message@(Model.TotalUnread == 1 ? "" : "s")</dt></div>
                </dl>
            </div>

            <div class="page-hero-art" aria-hidden="true">
                <div class="hero-glass hero-glass-back"></div>
                <div class="hero-glass hero-glass-front">
                    <span class="hero-glass-copy">Chat.<br />Align.<br />Deliver.<span></span></span>
                </div>
                <span class="hero-sparkle"></span>
            </div>

            <div class="page-hero-motto">Real Brands.<br />Real Conversations.<span></span></div>
        </section>

        @if (TempData["InboxNotice"] is string inboxNotice)
        {
            <div class="notice is-success" role="status" style="margin-top:14px;"><i class="bi bi-check-circle-fill"></i><span>@inboxNotice</span></div>
        }

        <div class="messages-shell" id="messagesShell">

            <div class="list-panel">

                <div class="list-head">
                    <div>
                        <div class="list-head-title">Your Conversations</div>
                        <div class="list-head-sub">@Model.TotalCount conversation@(Model.TotalCount == 1 ? "" : "s")@(Model.TotalUnread > 0 ? $" · {Model.TotalUnread} new" : "")</div>
                    </div>
                    <button type="button" class="list-filter-btn" id="messagesFilterBtn" aria-label="Search conversations" title="Search">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>
                </div>

                <div class="list-search-wrap" id="messagesSearchWrap">
                    <form method="get" action="/InfluencerMessages" class="list-search">
                        <input type="text" name="search" placeholder="Search brands or campaigns..." value="@Model.Search" />
                        @if (selected is not null)
                        {
                            <input type="hidden" name="open" value="@selected.Id" />
                        }
                    </form>
                </div>

                <div class="list-rows">
                    @if (Model.TotalCount > 0)
                    {
                        var pinnedCount = Model.Conversations.Count(c => c.InfluencerPinnedAt.HasValue);
                        var shownAllLabel = false;
                        @if (pinnedCount > 0)
                        {
                            <div class="list-section-label"><i class="bi bi-pin-angle-fill"></i> Pinned</div>
                        }
                        @foreach (var conversation in Model.Conversations)
                        {
                            var lastMessage = conversation.VisibleMessages(false).OrderByDescending(m => m.SentAt).FirstOrDefault();
                            var isPinned = conversation.InfluencerPinnedAt.HasValue;
                            var unread = Model.UnreadFor(conversation.Id);
                            var isSelected = selected is not null && conversation.Id == selected.Id;
                            var snippet = lastMessage is null
                                ? "No messages yet — say hello."
                                : (!string.IsNullOrEmpty(lastMessage.MediaUrl) && string.IsNullOrEmpty(lastMessage.Body)
                                    ? (lastMessage.MediaType == "video" ? "Sent a video" : "Sent a photo")
                                    : lastMessage.Body);
                            @if (pinnedCount > 0 && !isPinned && !shownAllLabel)
                            {
                                shownAllLabel = true;
                                <div class="list-section-label">All conversations</div>
                            }
                            <div class="inbox-row-wrap @(isPinned ? "is-pinned" : "")">
                            <a href="/InfluencerMessages?open=@conversation.Id" class="inbox-row @(isSelected ? "is-selected" : "")" data-reveal>

                                <div class="inbox-avatar">
                                    @FollowerFormat.InitialsOf(conversation.BrandProfile.CompanyName)
                                </div>

                                <div class="inbox-body">
                                    <div class="inbox-name-row">
                                        <div class="inbox-name-left">
                                            <span>@conversation.BrandProfile.CompanyName</span>
                                            @if (isPinned)
                                            {
                                                <i class="bi bi-pin-angle-fill inbox-pin" title="Pinned" aria-label="Pinned"></i>
                                            }
                                            @if (conversation.BrandProfile.VerificationStatus == VerificationStatus.Verified)
                                            {
                                                <span class="verified-badge">Verified</span>
                                            }
                                        </div>
                                        <span class="inbox-time">@((lastMessage?.SentAt ?? conversation.CreatedAt).ToBangladeshTime().ToString("MMM d"))</span>
                                    </div>
                                    <div class="inbox-snippet-row">
                                        <div class="inbox-snippet @(unread > 0 ? "is-unread" : "")">@snippet</div>
                                        @if (unread > 0)
                                        {
                                            <span class="inbox-unread-dot">@unread</span>
                                        }
                                    </div>
                                </div>

                            </a>
                            <div class="convo-menu-wrap" data-convo-menu>
                                <button type="button" class="convo-menu-btn" data-convo-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-label="Options for conversation with @conversation.BrandProfile.CompanyName">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <div class="convo-menu" role="menu">
                                    <form method="post" action="/InfluencerMessages/TogglePin">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="conversationId" value="@conversation.Id" />
                                        @if (selected is not null)
                                        {
                                            <input type="hidden" name="open" value="@selected.Id" />
                                        }
                                        <button type="submit" class="convo-menu-item" role="menuitem">
                                            <i class="bi @(isPinned ? "bi-pin-angle" : "bi-pin-angle-fill")"></i>@(isPinned ? "Unpin conversation" : "Pin to top")
                                        </button>
                                    </form>
                                    <div class="convo-menu-sep" role="separator"></div>
                                    <form method="post" action="/InfluencerMessages/DeleteConversation">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="conversationId" value="@conversation.Id" />
                                        @if (selected is not null)
                                        {
                                            <input type="hidden" name="open" value="@selected.Id" />
                                        }
                                        <button type="button" class="convo-menu-item is-danger" role="menuitem" data-convo-delete data-convo-name="@conversation.BrandProfile.CompanyName">
                                            <i class="bi bi-trash3"></i>Delete conversation
                                        </button>
                                    </form>
                                </div>
                            </div>
                            </div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(Model.Search))
                    {
                        <div class="list-empty">No conversations match "@Model.Search".</div>
                    }

                    @if (string.IsNullOrEmpty(Model.Search))
                    {
                        <div class="start-convo-card">
                            <div class="start-convo-icon icon-chip soft">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
                            </div>
                            <div class="start-convo-title">@(Model.TotalCount > 0 ? "Start a new conversation" : "No conversations yet")</div>
                            <p class="start-convo-text">Message a brand to discuss a campaign, deliverable or collaboration opportunity.</p>
                            <a href="/Brands" class="bx-btn bx-btn-secondary">Browse Brands</a>
                        </div>
                    }
                </div>

            </div>

            <section class="thread-panel">

                @if (selected is not null)
                {
                    var brand = selected.BrandProfile;
                    var brandVerified = brand.VerificationStatus == VerificationStatus.Verified;
                    var brandSocials = brand.SocialLinks();
                    var safeWebsite = Uri.TryCreate(brand.WebsiteUrl, UriKind.Absolute, out var websiteUri) && (websiteUri.Scheme == "https" || websiteUri.Scheme == "http");
                    <div class="thread-header">
                        <div class="inbox-avatar" style="width:42px;height:42px;font-size:14px;">
                            @FollowerFormat.InitialsOf(brand.CompanyName)
                        </div>
                        <div>
                            <div class="thread-name">@brand.CompanyName</div>
                            <div class="thread-sub">@(selected.Campaign is not null ? selected.Campaign.Title : "General inquiry")</div>
                        </div>

                        <div class="thread-header-actions">
                            <button type="button" class="thread-icon-btn" disabled title="Voice calling isn't part of Brandora's messaging — use chat to coordinate" aria-label="Voice call unavailable">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1.5 1.5 0 0 1 1.5-.4 12 12 0 0 0 3.8.6 1.5 1.5 0 0 1 1.5 1.5V21a1.5 1.5 0 0 1-1.5 1.5A18.5 18.5 0 0 1 2.5 4.5 1.5 1.5 0 0 1 4 3h3.5A1.5 1.5 0 0 1 9 4.5a12 12 0 0 0 .6 3.8 1.5 1.5 0 0 1-.4 1.5L6.6 10.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                            </button>
                            <button type="button" class="thread-icon-btn" disabled title="Video calling isn't part of Brandora's messaging — use chat to coordinate" aria-label="Video call unavailable">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="6" width="13" height="12" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M18.5 10.4 22 8v8l-3.5-2.4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                            </button>
                            <button type="button" class="thread-icon-btn" id="profileInfoBtn" title="View brand profile" aria-label="View brand profile">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 11v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="8" r=".9" fill="currentColor"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="thread-body" id="threadBody">
                        @if (selectedMessages.Count > 0)
                        {
                            @foreach (var message in selectedMessages)
                            {
                                var isMine = message.SenderUserId == currentUserId;
                                var hasMedia = !string.IsNullOrEmpty(message.MediaUrl);
                                var hasCaption = !string.IsNullOrEmpty(message.Body);
                                var canEdit = isMine && hasCaption && !hasMedia;
                                var showMenu = isMine || hasCaption || hasMedia;
                                <div class="msg-row @(isMine ? "is-mine" : "")">
                                    @if (!isMine)
                                    {
                                        <div class="msg-avatar">@FollowerFormat.InitialsOf(brand.CompanyName)</div>
                                    }
                                    <div class="msg-col">
                                        <div class="msg-bubble-row">
                                            <div class="msg-bubble-wrap" id="msgBubbleWrap-@message.Id">
                                                <div class="msg-bubble @(hasMedia ? "has-media" : "") @(hasMedia && hasCaption ? "has-caption" : "")">
                                                    @if (hasMedia)
                                                    {
                                                        <div class="msg-media">
                                                            @if (message.MediaType == "video")
                                                            {
                                                                <video src="@message.MediaUrl" controls preload="metadata"></video>
                                                            }
                                                            else
                                                            {
                                                                <a href="@message.MediaUrl" target="_blank" rel="noopener noreferrer" class="msg-media-view" aria-label="View full-size attachment">
                                                                    <img src="@message.MediaUrl" alt="Shared attachment" />
                                                                </a>
                                                            }
                                                            <a href="@message.MediaUrl" download="@System.IO.Path.GetFileName(message.MediaUrl)" class="msg-media-download" title="Download attachment" aria-label="Download attachment">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 18.5h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                                            </a>
                                                        </div>
                                                    }
                                                    @if (hasCaption)
                                                    {
                                                        <span class="msg-caption">@message.Body</span>
                                                    }
                                                </div>
                                            </div>

                                            @if (showMenu)
                                            {
                                                <div class="msg-menu-wrap" id="msgMenuWrap-@message.Id">
                                                    <button type="button" class="msg-menu-btn" data-msg-menu-toggle="@message.Id" aria-label="Message options" aria-expanded="false">
                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="19" cy="12" r="1.9"/></svg>
                                                    </button>
                                                    <div class="msg-menu" id="msgMenu-@message.Id">
                                                        @if (canEdit)
                                                        {
                                                            <button type="button" class="msg-menu-item" data-msg-edit="@message.Id">Edit</button>
                                                        }
                                                        @if (hasCaption)
                                                        {
                                                            <button type="button" class="msg-menu-item" data-msg-copy="@message.Id" data-copy-text="@message.Body">Copy</button>
                                                        }
                                                        @if (hasMedia)
                                                        {
                                                            <button type="button" class="msg-menu-item" data-msg-copy="@(message.Id)-link" data-copy-text="@($"{Context.Request.Scheme}://{Context.Request.Host}{message.MediaUrl}")">Copy Link</button>
                                                        }
                                                        @if (isMine)
                                                        {
                                                            <button type="button" class="msg-menu-item msg-menu-danger" data-msg-unsend="@message.Id">Unsend</button>
                                                            <form method="post" action="/InfluencerMessages/DeleteMessage" class="msg-menu-unsend-form" id="msgUnsendForm-@message.Id" hidden>
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="messageId" value="@message.Id" />
                                                                <input type="hidden" name="conversationId" value="@selected.Id" />
                                                            </form>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        @if (canEdit)
                                        {
                                            <form method="post" action="/InfluencerMessages/EditMessage" class="msg-edit-form" id="msgEditForm-@message.Id" hidden>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="messageId" value="@message.Id" />
                                                <input type="hidden" name="conversationId" value="@selected.Id" />
                                                <textarea name="body" class="msg-edit-input">@message.Body</textarea>
                                                <div class="msg-edit-actions">
                                                    <button type="button" class="msg-edit-cancel" data-msg-edit-cancel="@message.Id">Cancel</button>
                                                    <button type="submit" class="msg-edit-save">Save</button>
                                                </div>
                                            </form>
                                        }

                                        <div class="msg-time">@message.SentAt.ToBangladeshTime().ToString("MMM d, h:mm tt")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="thread-empty">No messages yet &mdash; say hello to @brand.CompanyName.</div>
                        }
                    </div>

                    @if (TempData["MessageError"] is string messageError)
                    {
                        <div class="composer-error">@messageError</div>
                    }

                    <div class="composer-preview" id="chatMediaPreview">
                        <div class="composer-preview-media" id="chatMediaThumbWrap" hidden>
                            <img id="chatMediaThumb" alt="Selected attachment" />
                            <button type="button" class="composer-preview-remove" data-remove-attachment aria-label="Remove attachment">&times;</button>
                        </div>
                        <div class="composer-preview-file" id="chatMediaFileWrap" hidden>
                            <svg class="composer-preview-file-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v5h5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                            <span class="composer-preview-name" id="chatMediaName"></span>
                            <button type="button" class="composer-preview-remove" data-remove-attachment aria-label="Remove attachment">&times;</button>
                        </div>
                    </div>

                    <form class="thread-composer" method="post" action="/InfluencerMessages/Send" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="conversationId" value="@selected.Id" />
                        <input type="file" name="mediaFile" id="chatMediaInput" accept="image/*,video/*" hidden />
                        <button type="button" class="composer-attach" id="chatAttachBtn" aria-label="Attach image or video">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 11.5L12.5 20a5 5 0 0 1-7-7l8-8a3.5 3.5 0 0 1 5 5l-8 8a2 2 0 0 1-3-3l7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <textarea name="body" placeholder="Write a message..."></textarea>
                        <button type="submit" class="composer-send" aria-label="Send message">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 12L20 4L13 20L11 13L4 12Z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
                        </button>
                    </form>

                    <div class="profile-drawer" id="profileDrawer">
                        <button type="button" class="profile-drawer-close" id="profileDrawerClose" aria-label="Close profile">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        </button>

                        <div class="profile-avatar-wrap">
                            <div class="profile-avatar-ring">
                                <div class="inbox-avatar">@FollowerFormat.InitialsOf(brand.CompanyName)</div>
                            </div>
                            <div class="profile-name-row">
                                @brand.CompanyName
                                @if (brandVerified)
                                {
                                    <span class="verified-badge">Verified</span>
                                }
                            </div>
                            <div class="profile-handle">@brand.Industry &middot; @brand.ContactFullName</div>
                            @if (brandSocials.Count > 0)
                            {
                                <div class="social-icons profile-socials" aria-label="@brand.CompanyName on social media">
                                    @foreach (var link in brandSocials)
                                    {
                                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="social-chip sm" style="background: @link.Platform.Background;" title="@brand.CompanyName on @link.Platform.Name" aria-label="@brand.CompanyName on @link.Platform.Name"><i class="bi @link.Platform.Icon"></i></a>
                                    }
                                </div>
                            }
                        </div>

                        <div class="profile-section">
                            <div class="profile-label">Focus</div>
                            <div class="profile-tags">
                                <span class="profile-tag">@brand.Industry</span>
                                <span class="profile-tag">Member since @brand.CreatedAt.ToString("MMM yyyy")</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(brand.MonthlyBudget))
                        {
                            <div class="profile-section">
                                <div class="profile-label">Monthly Budget</div>
                                <div class="profile-rate-box">@brand.MonthlyBudget</div>
                            </div>
                        }

                        @if (safeWebsite)
                        {
                            <div class="profile-section">
                                <div class="profile-label">Website</div>
                                <a href="@brand.WebsiteUrl" target="_blank" rel="noopener noreferrer" class="profile-website">@brand.WebsiteUrl</a>
                            </div>
                        }

                        <a href="/Brands?search=@Uri.EscapeDataString(brand.CompanyName)" class="profile-cta">View in Browse Brands</a>

                    </div>
                }
                else
                {
                    <div class="thread-empty thread-empty-state">
                        <span class="icon-chip lg soft"><i class="bi bi-chat-square-text"></i></span>
                        <div class="thread-empty-title">@(Model.TotalCount > 0 ? "Select a conversation" : "Your inbox is ready")</div>
                        <p>@(Model.TotalCount > 0 ? "Pick a brand on the left to read and reply to your conversation." : "When you message a brand, your conversation appears here.")</p>
                        @if (Model.TotalCount == 0)
                        {
                            <a href="/Brands" class="bx-btn bx-btn-primary">Browse Brands</a>
                        }
                    </div>
                }

            </section>

        </div>

    </main>

    <div class="confirm-modal-overlay" id="unsendConfirmOverlay" hidden>
        <div class="confirm-modal" role="alertdialog" aria-labelledby="unsendConfirmTitle" aria-describedby="unsendConfirmBody">
            <div class="confirm-modal-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 9v4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="16.5" r="1" fill="currentColor"/><path d="M10.3 3.9 2.5 17.5A1.8 1.8 0 0 0 4.1 20.2h15.8a1.8 1.8 0 0 0 1.6-2.7L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            </div>
            <div class="confirm-modal-title" id="unsendConfirmTitle">Unsend this message?</div>
            <p class="confirm-modal-body" id="unsendConfirmBody">This removes it for everyone in the conversation. This action cannot be undone.</p>
            <div class="confirm-modal-actions">
                <button type="button" class="confirm-modal-cancel" id="unsendConfirmCancel">Cancel</button>
                <button type="button" class="confirm-modal-danger" id="unsendConfirmOk">Unsend</button>
            </div>
        </div>
    </div>

    <div class="copy-toast" id="copyToast">Copied</div>

    @* Same shared confirm dialog the Brand side uses (_AppLayout's #brandoraConfirmModal) —
       used here for "Delete conversation", exactly as on the Brand side. *@
    <div class="confirm-modal-backdrop" id="brandoraConfirmModal">
        <div class="confirm-modal" role="alertdialog" aria-modal="true">
            <div class="confirm-modal-icon">!</div>
            <div class="confirm-modal-title">Are you sure?</div>
            <p class="confirm-modal-text"></p>
            <div class="confirm-modal-actions">
                <button type="button" class="bx-btn bx-btn-secondary confirm-modal-cancel">Cancel</button>
                <button type="button" class="bx-btn bx-btn-primary confirm-modal-confirm">Confirm</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>

    <script>
        // Brand side's shared confirm dialog (Views/Shared/_AppLayout.cshtml), same behaviour.
        window.brandoraConfirm = function (triggerEl, opts) {
            opts = opts || {};
            var modal = document.getElementById('brandoraConfirmModal');
            if (!modal) { return; }

            var form = triggerEl && triggerEl.closest ? triggerEl.closest('form') : null;

            modal.querySelector('.confirm-modal-title').textContent = opts.title || 'Are you sure?';
            modal.querySelector('.confirm-modal-text').textContent = opts.text || '';

            var icon = modal.querySelector('.confirm-modal-icon');
            icon.classList.toggle('is-danger', !!opts.danger);

            var confirmBtn = modal.querySelector('.confirm-modal-confirm');
            confirmBtn.textContent = opts.confirmLabel || 'Confirm';
            confirmBtn.classList.toggle('bx-btn-primary', !opts.danger);
            confirmBtn.classList.toggle('bx-btn-danger-solid', !!opts.danger);

            function close() {
                modal.classList.remove('is-open');
                confirmBtn.onclick = null;
                document.removeEventListener('keydown', onKeydown);
            }

            function onKeydown(e) {
                if (e.key === 'Escape') { close(); }
            }

            confirmBtn.onclick = function () {
                close();
                if (form) { form.submit(); }
                else if (typeof opts.onConfirm === 'function') { opts.onConfirm(); }
            };

            modal.querySelector('.confirm-modal-cancel').onclick = close;
            modal.onclick = function (e) { if (e.target === modal) { close(); } };
            document.addEventListener('keydown', onKeydown);

            modal.classList.add('is-open');
        };

        // "Back" returns to wherever the creator came from, like the Brand side.
        document.addEventListener('click', function (e) {
            var backLink = e.target.closest('.back-to-dashboard');
            if (backLink && window.history.length > 1) {
                e.preventDefault();
                window.history.back();
            }
        });
    </script>

    <script>

        // Conversation options (pin / delete) — one menu open at a time.
        (function () {
            function closeAllConvoMenus(except) {
                document.querySelectorAll('[data-convo-menu].is-open').forEach(function (wrap) {
                    if (wrap === except) { return; }
                    wrap.classList.remove('is-open');
                    var rowWrap = wrap.closest('.inbox-row-wrap');
                    if (rowWrap) { rowWrap.classList.remove('menu-open'); }
                    var b = wrap.querySelector('[data-convo-menu-toggle]');
                    if (b) { b.setAttribute('aria-expanded', 'false'); }
                });
            }

            document.querySelectorAll('[data-convo-menu-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var wrap = btn.closest('[data-convo-menu]');
                    var willOpen = !wrap.classList.contains('is-open');
                    closeAllConvoMenus(wrap);
                    if (willOpen) {
                        // Open upwards when there isn't room below inside the scrolling list.
                        var list = wrap.closest('.list-rows');
                        var menu = wrap.querySelector('.convo-menu');
                        var spaceBelow = (list ? list.getBoundingClientRect().bottom : window.innerHeight) - btn.getBoundingClientRect().bottom;
                        wrap.classList.toggle('is-up', spaceBelow < (menu ? menu.offsetHeight : 110) + 12);
                    }
                    wrap.classList.toggle('is-open', willOpen);
                    var rowWrap = wrap.closest('.inbox-row-wrap');
                    if (rowWrap) { rowWrap.classList.toggle('menu-open', willOpen); }
                    btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
                });
            });

            document.addEventListener('click', function (e) {
                if (!e.target.closest('[data-convo-menu]')) { closeAllConvoMenus(null); }
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { closeAllConvoMenus(null); }
            });

            document.querySelectorAll('[data-convo-delete]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    closeAllConvoMenus(null);
                    var name = btn.getAttribute('data-convo-name') || 'They';
                    window.brandoraConfirm(btn, { title: 'Delete this conversation?', text: 'It will be removed from your inbox. ' + name + ' keeps their copy, and if they message you again it will reappear with only the new messages.', danger: true, confirmLabel: 'Delete' });
                });
            });
        })();
        (function () {
            var rows = document.querySelectorAll('.inbox-row[data-reveal]');
            if (rows.length) {
                if (!('IntersectionObserver' in window)) {
                    rows.forEach(function (r) { r.classList.add('is-visible'); });
                } else {
                    var observer = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                observer.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

                    rows.forEach(function (row, index) {
                        row.style.transitionDelay = Math.min(index % 12, 8) * 35 + 'ms';
                        observer.observe(row);
                    });
                }
            }

            var filterBtn = document.getElementById('messagesFilterBtn');
            var searchWrap = document.getElementById('messagesSearchWrap');
            if (filterBtn && searchWrap) {
                var hasSearch = @(!string.IsNullOrEmpty(Model.Search) ? "true" : "false");
                if (hasSearch) {
                    searchWrap.classList.add('is-open');
                    filterBtn.classList.add('is-active');
                }
                filterBtn.addEventListener('click', function () {
                    var open = searchWrap.classList.toggle('is-open');
                    filterBtn.classList.toggle('is-active', open);
                    if (open) {
                        var input = searchWrap.querySelector('input[name="search"]');
                        if (input) input.focus();
                    }
                });
            }

            var infoBtn = document.getElementById('profileInfoBtn');
            var drawer = document.getElementById('profileDrawer');
            var drawerClose = document.getElementById('profileDrawerClose');
            if (infoBtn && drawer && drawerClose) {
                infoBtn.addEventListener('click', function () {
                    drawer.classList.add('is-open');
                    infoBtn.classList.add('is-active');
                });
                drawerClose.addEventListener('click', function () {
                    drawer.classList.remove('is-open');
                    infoBtn.classList.remove('is-active');
                });
            }

            var input = document.getElementById('chatMediaInput');
            var attachBtn = document.getElementById('chatAttachBtn');
            var preview = document.getElementById('chatMediaPreview');
            var previewName = document.getElementById('chatMediaName');
            var thumbWrap = document.getElementById('chatMediaThumbWrap');
            var thumbImg = document.getElementById('chatMediaThumb');
            var fileWrap = document.getElementById('chatMediaFileWrap');
            var threadBody = document.getElementById('threadBody');

            if (input) {
                attachBtn.addEventListener('click', function () { input.click(); });

                function clearThumb() {
                    if (thumbImg.src) {
                        URL.revokeObjectURL(thumbImg.src);
                        thumbImg.src = '';
                    }
                }

                input.addEventListener('change', function () {
                    var file = input.files && input.files[0];
                    if (!file) {
                        preview.style.display = 'none';
                        thumbWrap.hidden = true;
                        fileWrap.hidden = true;
                        clearThumb();
                        return;
                    }

                    if (file.type && file.type.indexOf('image/') === 0) {
                        clearThumb();
                        thumbImg.src = URL.createObjectURL(file);
                        thumbWrap.hidden = false;
                        fileWrap.hidden = true;
                    } else {
                        clearThumb();
                        previewName.textContent = file.name;
                        fileWrap.hidden = false;
                        thumbWrap.hidden = true;
                    }

                    preview.style.display = 'flex';
                });

                document.querySelectorAll('[data-remove-attachment]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        input.value = '';
                        preview.style.display = 'none';
                        thumbWrap.hidden = true;
                        fileWrap.hidden = true;
                        clearThumb();
                    });
                });
            }

            if (threadBody) {
                threadBody.scrollTop = threadBody.scrollHeight;
            }

            // Opening a specific conversation (row click, chat widget, "Open Chat")
            // lands the page on the inbox itself rather than back on the hero.
            var shell = document.getElementById('messagesShell');
            if (shell && /[?&]open=/.test(window.location.search)) {
                requestAnimationFrame(function () {
                    var topbar = document.querySelector('.dashboard-topbar');
                    var offset = (topbar ? topbar.getBoundingClientRect().height : 0) + 16;
                    var target = shell.getBoundingClientRect().top + window.pageYOffset - offset;
                    window.scrollTo({ top: Math.max(0, target), behavior: 'smooth' });
                });
            }

            // Message actions: 3-dot menu (Edit / Copy / Unsend)
            function closeAllMsgMenus() {
                document.querySelectorAll('.msg-menu-wrap.is-open').forEach(function (wrap) {
                    wrap.classList.remove('is-open');
                    var btn = wrap.querySelector('.msg-menu-btn');
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                });
            }

            document.querySelectorAll('[data-msg-menu-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var wrap = btn.closest('.msg-menu-wrap');
                    var wasOpen = wrap.classList.contains('is-open');
                    closeAllMsgMenus();
                    if (!wasOpen) {
                        wrap.classList.add('is-open');
                        btn.setAttribute('aria-expanded', 'true');
                    }
                });
            });

            document.addEventListener('click', closeAllMsgMenus);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeAllMsgMenus();
            });

            var copyToast = document.getElementById('copyToast');
            var copyToastTimer;

            document.querySelectorAll('[data-msg-copy]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var text = btn.getAttribute('data-copy-text') || '';
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text);
                    }
                    if (copyToast) {
                        copyToast.classList.add('is-visible');
                        clearTimeout(copyToastTimer);
                        copyToastTimer = setTimeout(function () { copyToast.classList.remove('is-visible'); }, 1400);
                    }
                    closeAllMsgMenus();
                });
            });

            document.querySelectorAll('[data-msg-edit]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-msg-edit');
                    var bubbleWrap = document.getElementById('msgBubbleWrap-' + id);
                    var form = document.getElementById('msgEditForm-' + id);
                    if (bubbleWrap && form) {
                        bubbleWrap.hidden = true;
                        form.hidden = false;
                        var ta = form.querySelector('textarea');
                        if (ta) {
                            ta.focus();
                            ta.setSelectionRange(ta.value.length, ta.value.length);
                        }
                    }
                    closeAllMsgMenus();
                });
            });

            document.querySelectorAll('[data-msg-edit-cancel]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-msg-edit-cancel');
                    var bubbleWrap = document.getElementById('msgBubbleWrap-' + id);
                    var form = document.getElementById('msgEditForm-' + id);
                    if (bubbleWrap && form) {
                        form.hidden = true;
                        bubbleWrap.hidden = false;
                    }
                });
            });

            // Unsend warning box (replaces the native browser confirm())
            var unsendOverlay = document.getElementById('unsendConfirmOverlay');
            var unsendCancelBtn = document.getElementById('unsendConfirmCancel');
            var unsendOkBtn = document.getElementById('unsendConfirmOk');
            var pendingUnsendId = null;

            function closeUnsendConfirm() {
                if (unsendOverlay) unsendOverlay.hidden = true;
                pendingUnsendId = null;
            }

            if (unsendOverlay && unsendCancelBtn && unsendOkBtn) {
                document.querySelectorAll('[data-msg-unsend]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        pendingUnsendId = btn.getAttribute('data-msg-unsend');
                        unsendOverlay.hidden = false;
                        closeAllMsgMenus();
                    });
                });

                unsendCancelBtn.addEventListener('click', closeUnsendConfirm);

                unsendOverlay.addEventListener('click', function (e) {
                    if (e.target === unsendOverlay) closeUnsendConfirm();
                });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && !unsendOverlay.hidden) closeUnsendConfirm();
                });

                unsendOkBtn.addEventListener('click', function () {
                    if (pendingUnsendId) {
                        var form = document.getElementById('msgUnsendForm-' + pendingUnsendId);
                        if (form) form.submit();
                    }
                    closeUnsendConfirm();
                });
            }
        })();
    </script>

</body>
</html>
