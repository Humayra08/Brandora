@model Brandora.Web.Models.Dashboard.InfluencerEarningsViewModel
@{
    var initial = string.IsNullOrWhiteSpace(Model.InfluencerName) ? "I" : Model.InfluencerName[..1].ToUpperInvariant();
}
    <header class="earnings-topbar">
        <button type="button" class="earnings-icon-button" id="sidebarToggle" aria-label="Toggle sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
        <form method="get" asp-action="Index" class="earnings-search" role="search">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <input type="search" name="search" value="@Model.Search" placeholder="Search campaigns, brands..." aria-label="Search campaigns and brands" />
            <input type="hidden" name="campaignId" value="@Model.CampaignId" />
            <input type="hidden" name="tab" value="@Model.Tab" />
        </form>
        <details class="earnings-notifications">
            <summary class="earnings-icon-button" aria-label="Notifications">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9a6 6 0 0 1 12 0c0 4 1.5 5.5 1.5 5.5h-15S6 13 6 9ZM10 18a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                @if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="earnings-unread"></span> }
            </summary>
            <div class="earnings-notification-panel">
                <h2>Recent notifications</h2>
                @foreach (var notification in Model.Notifications)
                {
                    <div><strong>@notification.Title</strong><p>@notification.Body</p></div>
                }
                @if (Model.Notifications.Count == 0) { <p>You're all caught up.</p> }
            </div>
        </details>
        <a href="/InfluencerSettings" class="earnings-profile" aria-label="Your profile settings">
            <span class="earnings-avatar">@initial</span>
            <span><strong>@Model.InfluencerName</strong><small>Influencer</small></span>
            <span aria-hidden="true">⌄</span>
        </a>
    </header>
