@model Brandora.Web.Models.Dashboard.WithdrawalViewModel
@using System.Globalization
@using Brandora.Web.Models.Domain
@{
    ViewData["Title"] = "Withdraw Earnings";
    ViewData["ActiveNav"] = "Earnings";
    Layout = null;
    string Money(decimal value) => "৳" + value.ToString("N0", CultureInfo.InvariantCulture);
    string Kind(PayoutMethodKind kind) => kind switch { PayoutMethodKind.Bkash => "bkash", PayoutMethodKind.Nagad => "nagad", _ => "bank" };
    string WithdrawalStatusLabel(WithdrawalStatus status) => status switch {
        WithdrawalStatus.Paid => "Completed", WithdrawalStatus.Approved => "Processing",
        WithdrawalStatus.Rejected => "Rejected", _ => "Pending"
    };
    string WithdrawalStatusClass(WithdrawalStatus status) => status switch {
        WithdrawalStatus.Paid => "is-success", WithdrawalStatus.Approved or WithdrawalStatus.Pending => "is-pending", _ => "is-revision"
    };
    var canWithdraw = Model.PayoutMethods.Count > 0 && Model.AvailableBalance > 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Withdraw Earnings - Brandora</title>
    <link rel="icon" href="~/images/brandora-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-earnings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-withdrawal.css" asp-append-version="true" />
</head>
<body>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
@await Html.PartialAsync("_InfluencerSidebar")
<main class="earnings-page withdrawal-page" id="dashboardMain">
    @await Html.PartialAsync("~/Views/InfluencerEarnings/_Topbar.cshtml", Model.Header)
    <section class="earnings-hero" aria-labelledby="earnings-title">
        <div class="earnings-hero-copy">
            <nav aria-label="Breadcrumb"><a href="/InfluencerDashboard">Home</a><span aria-hidden="true"> / </span><a asp-action="Index">Earnings</a><span aria-hidden="true"> / </span><span aria-current="page">Withdraw</span></nav>
            <h1 id="earnings-title">Withdraw <span>Earnings</span></h1>
            <p>Get your hard-earned money, securely and easily.</p>
        </div>
        <div class="dashboard-hero-motto">Earn<br />Collaborate<br />Grow<br />Get Rewarded.<span></span></div>
        @await Html.PartialAsync("~/Views/InfluencerDashboard/_Waves.cshtml", "hero")
    </section>
    <div class="withdrawal-content">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="withdrawal-notice" role="status"><p><strong>Success.</strong> @Model.Message</p></div>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="withdrawal-notice" role="alert"><p><strong>Couldn't submit that.</strong> @Model.Error</p></div>
        }
        @if (Model.PayoutMethods.Count == 0)
        {
            <div class="withdrawal-notice" role="note">
                <p>Add a verified bKash, Nagad, or bank account before requesting a withdrawal.</p>
                <a asp-action="Index" asp-route-tab="payout-methods">Add a payout method</a>
            </div>
        }
        <div class="withdrawal-grid">
            <section class="withdrawal-form-panel" aria-labelledby="withdrawal-form-title">
                <header><h2 id="withdrawal-form-title">Withdraw to Your Account</h2><p>Choose your preferred payment method and enter the amount.</p></header>
                <div class="withdrawal-balance">
                    <div><span>Available Balance</span><div class="withdrawal-balance-value"><strong>@Money(Model.AvailableBalance)</strong></div></div>
                    <div class="withdrawal-minimum"><span>Minimum withdrawal amount</span><strong>@Money(Model.MinimumWithdrawal)</strong></div>
                </div>
                <form id="withdrawal-form" method="post" asp-action="Withdraw" data-balance="@Model.AvailableBalance.ToString(CultureInfo.InvariantCulture)" data-fee="@Model.FeePercent.ToString(CultureInfo.InvariantCulture)" data-fee-tranches="@System.Text.Json.JsonSerializer.Serialize(Model.Ledger.Tranches.Select(t => new[] { t.Amount, t.RatePercent }))" data-fee-withdrawn="@Model.Ledger.Withdrawn.ToString(CultureInfo.InvariantCulture)" data-fee-charged="@Model.Ledger.FeesCharged.ToString(CultureInfo.InvariantCulture)">
                    @Html.AntiForgeryToken()
                    <fieldset class="withdrawal-methods">
                        <legend>Payment Method</legend>
                        <div class="withdrawal-method-grid">
                            @foreach (var method in Model.PayoutMethods)
                            {
                                <label class="withdrawal-method">
                                    <span class="earnings-provider @Kind(method.Kind)">
                                        @if (method.Kind is PayoutMethodKind.Bkash or PayoutMethodKind.Nagad)
                                        {
                                            <img src="~/images/payment-methods/@(Kind(method.Kind)).svg" alt="@method.Name" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-bank" aria-hidden="true"></i>
                                        }
                                    </span>
                                    <span><strong>@method.Name</strong><small>@method.AccountNumber</small></span>
                                    <input type="radio" name="payoutMethodId" value="@method.Id" checked="@method.IsPrimary" required />
                                </label>
                            }
                        </div>
                        <a class="withdrawal-add-method" asp-action="Index" asp-route-tab="payout-methods"><span aria-hidden="true">+</span> Add New Payment Method</a>
                    </fieldset>
                    <div class="withdrawal-amount-group">
                        <label for="withdrawal-amount">Amount to Withdraw</label>
                        <div class="withdrawal-amount-input">
                            <span aria-hidden="true">৳</span>
                            <input id="withdrawal-amount" name="amount" type="number" inputmode="decimal" min="@Model.MinimumWithdrawal.ToString(CultureInfo.InvariantCulture)" max="@Model.AvailableBalance.ToString(CultureInfo.InvariantCulture)" step="0.01" placeholder="Enter amount" disabled="@(!canWithdraw)" required aria-describedby="withdrawal-available withdrawal-error" />
                            <button id="withdrawal-max" type="button" disabled="@(!canWithdraw)">Max</button>
                        </div>
                        <p id="withdrawal-available">@(canWithdraw ? "Available: " + Money(Model.AvailableBalance) : "No balance available to withdraw yet")</p>
                        <p class="withdrawal-error" id="withdrawal-error" aria-live="polite"></p>
                    </div>
                    <div class="withdrawal-summary" aria-live="polite" aria-atomic="true">
                        <div><span>Withdrawal Amount</span><output id="withdrawal-gross">—</output></div>
                        <div><span>Platform Fee@(Model.FeePercent > 0 ? $" ({Model.FeePercent:0.##}%)" : "")</span><output id="withdrawal-fee">—</output></div>
                        <div class="withdrawal-net"><strong>You will receive</strong><output id="withdrawal-net">—</output></div>
                    </div>
                    @if (Model.FeePercent > 0)
                    {
                        <p class="withdrawal-security">@await Html.PartialAsync("~/Views/InfluencerEarnings/_Icon.cshtml", "shield") The platform fee (@Model.FeePercent.ToString("0.##", CultureInfo.InvariantCulture)% today) is locked on each payment when it's earned, worked out across all your withdrawals and rounded down &mdash; splitting a withdrawal never costs you more.</p>
                    }
                    <div class="withdrawal-actions">
                        <a class="withdrawal-cancel" asp-action="Index">Cancel</a>
                        <button class="withdrawal-confirm" id="withdrawal-confirm" type="submit" disabled="@(!canWithdraw)">Confirm Withdrawal</button>
                    </div>
                    <p class="withdrawal-security">@await Html.PartialAsync("~/Views/InfluencerEarnings/_Icon.cshtml", "lock") Withdrawal requests are reviewed before funds are sent.</p>
                    <noscript><p class="withdrawal-security">Enable JavaScript to see the amount calculator.</p></noscript>
                </form>
            </section>
            <aside class="withdrawal-rail" aria-label="Withdrawal information">
                <section class="withdrawal-information">
                    <h2>Important Information</h2>
                    <div class="withdrawal-info-row"><span class="withdrawal-info-icon">@await Html.PartialAsync("~/Views/InfluencerEarnings/_Icon.cshtml", "shield")</span><div><h3>Secure Transactions</h3><p>Withdrawal requests are reviewed by our team before payout.</p></div></div>
                    <div class="withdrawal-info-row"><span class="withdrawal-info-icon">@await Html.PartialAsync("~/Views/InfluencerEarnings/_Icon.cshtml", "person")</span><div><h3>Verified Accounts Only</h3><p>Withdrawals require a verified bKash, Nagad, or bank account.</p></div></div>
                    <div class="withdrawal-info-row"><span class="withdrawal-info-icon">@await Html.PartialAsync("~/Views/InfluencerEarnings/_Icon.cshtml", "clock")</span><div><h3>Processing Time</h3><p>Typical processing takes 1–3 business days once approved.</p></div></div>
                    <div class="withdrawal-info-row"><span class="withdrawal-info-icon">@await Html.PartialAsync("~/Views/InfluencerEarnings/_Icon.cshtml", "chat")</span><div><h3>Need Help?</h3><p><a asp-controller="Home" asp-action="Contact">Contact our support team</a> if you have any issues.</p></div></div>
                </section>
                <section class="withdrawal-history">
                    <header><h2>Recent Withdrawals</h2></header>
                    @foreach (var item in Model.History.Take(5))
                    {
                        <article class="withdrawal-history-row">
                            <span class="earnings-provider @Kind(item.Method)">
                                @if (item.Method is PayoutMethodKind.Bkash or PayoutMethodKind.Nagad)
                                {
                                    <img src="~/images/payment-methods/@(Kind(item.Method)).svg" alt="@item.Method" />
                                }
                                else
                                {
                                    <i class="bi bi-bank" aria-hidden="true"></i>
                                }
                            </span>
                            <div><strong>@Money(item.Amount)</strong><time datetime="@item.RequestedAt.ToString("yyyy-MM-dd")">@item.RequestedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)@(item.FeeAmount > 0 ? $" · {Money(item.FeeAmount)} fee" : "")</time></div>
                            <span class="earnings-badge @WithdrawalStatusClass(item.Status)">@WithdrawalStatusLabel(item.Status)</span>
                        </article>
                    }
                    @if (Model.History.Count == 0) { <div class="withdrawal-history-empty">@await Html.PartialAsync("~/Views/InfluencerEarnings/_Icon.cshtml", "wallet")<h3>No withdrawals yet</h3><p>Your withdrawal history will appear here.</p></div> }
                </section>
            </aside>
        </div>
    </div>
</main>
<script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>
<script src="~/js/brandora-withdrawal.js" asp-append-version="true"></script>
</body>
</html>
