@model Brandora.Web.Models.Campaigns.CampaignListViewModel
@using Brandora.Web.Models.Domain
@{
    ViewData["Title"] = "Campaigns";
    ViewData["ActiveNav"] = "Campaigns";
    Layout = "_AppLayout";
}

@section Styles {

    .page-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;

        animation: fade-up .4s ease both;
    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 28px;
    }

    .page-sub {
        margin-top: 6px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    .filter-bar {
        margin-top: 26px;
        padding: 12px;

        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;

        border-radius: 20px;
        border: 1px solid #d1e2ff;
        background: linear-gradient(120deg, #eef6ffcc, #f7fbffcc);

        animation: fade-up .45s ease both;
    }

    .status-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 10px 18px;

        border-radius: 14px;
        border: 1px solid transparent;
        background: transparent;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #2a3157;

        transition: .2s;
    }

    .status-tab:hover {
        background: #ffffffa8;
    }

    .status-tab.is-active {
        color: #ffffff;
        background: linear-gradient(105deg, #a326ff, #236eff);
        box-shadow: 0 6px 16px rgba(114,36,255,.22);
    }

    .status-tab .count {
        opacity: .75;
        font-weight: 700;
        font-size: 11.5px;
    }

    .filter-spacer {
        flex: 1;
    }

    .filter-input-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .filter-input-wrap svg {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #a9c9ff;
        pointer-events: none;
    }

    .filter-input,
    .filter-select {
        height: 42px;

        padding: 0 14px;

        border-radius: 14px;
        border: 1px solid #d1e2ff;
        background: #ffffff;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #2a3157;

        outline: none;
        transition: .2s;
    }

    .filter-input {
        padding-left: 38px;
    }

    .filter-input:focus,
    .filter-select:focus {
        border-color: #a978ff;
        box-shadow: 0 0 0 3px rgba(155,44,255,.1);
    }

    .filter-input {
        width: 220px;
    }

    .sr-only-submit {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
    }

    /* Campaign rows — matches the Influencer side's Discover Campaigns
       row layout exactly, adapted with Brand-appropriate actions. */

    .campaign-list {
        margin-top: 24px;

        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .campaign-row {
        display: flex;
        align-items: center;
        gap: 20px;

        padding: 20px;

        border-radius: 16px;
        background: linear-gradient(135deg, #ffffffbd, #f5faff8c 55%, #fafdffd9);
        border: 1px solid #cfe2ff;

        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;

        animation: fade-up .5s ease both;
    }

    .campaign-row:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 34px rgba(30,34,90,.08);
        border-color: #a9c9ff;
    }

    .campaign-row-thumb {
        position: relative;
        flex-shrink: 0;
        overflow: hidden;

        width: 88px;
        height: 88px;

        border-radius: 14px;
        background: linear-gradient(135deg, #7224ff, #3735ff 55%, #087fff);

        display: flex;
        align-items: center;
        justify-content: center;

        color: #ffffff;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 26px;
    }

    .campaign-row-thumb img,
    .campaign-row-thumb video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .campaign-row-body {
        flex: 1;
        min-width: 0;
    }

    .campaign-row-title-line {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .campaign-row-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 19px;
        color: #171d3d;
        text-decoration: none;
    }

    .campaign-row-title:hover {
        text-decoration: underline;
    }

    .campaign-row-meta {
        margin-top: 4px;
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #56617f;
    }

    .campaign-row-meta strong {
        color: #171d3d;
        font-weight: 600;
    }

    .campaign-row-desc {
        margin-top: 6px;
        max-width: 520px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #6b7290;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .campaign-row-tags {
        margin-top: 10px;

        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .tag {
        padding: 3px 10px;

        border-radius: 20px;
        background: #eaf2ff;

        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
        color: #2b467d;
    }

    .campaign-row-figures {
        flex-shrink: 0;

        display: flex;
        gap: 28px;
    }

    .figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 16px;
        color: #171d3d;
        white-space: nowrap;
    }

    .figure-label {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #6681af;
    }

    .campaign-row-actions {
        flex-shrink: 0;

        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 8px;

        min-width: 140px;
    }

    .campaign-row-actions .btn {
        min-height: 38px;
        padding: 0 16px;
        font-size: 12.5px;
        justify-content: center;
    }

    .campaign-row-applied {
        text-align: center;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #6681af;
    }

    .campaign-row-delete {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;

        min-height: 38px;
        padding: 0 16px;

        border-radius: 10px;
        border: 1.5px solid #f6c3ca;
        background: #fff;
        color: #c22540;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 600;

        cursor: pointer;
        transition: .2s;
    }

    .campaign-row-delete:hover {
        border-color: transparent;
        color: #ffffff;
        background: linear-gradient(105deg, #ff4d6b, #d6234a);
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(214,35,74,.25);
    }

    @@media(max-width: 900px) {
        .campaign-row { flex-wrap: wrap; }
        .campaign-row-figures { order: 3; width: 100%; justify-content: space-between; padding-top: 12px; border-top: 1px solid #e3edff; }
        .campaign-row-actions { order: 4; width: 100%; flex-direction: row; }
    }

    @@media(max-width: 560px) {
        .page-head { flex-direction: column; }
        .filter-input, .filter-input-wrap { width: 100%; }
        .campaign-row-thumb { width: 64px; height: 64px; font-size: 20px; }
        .campaign-row-desc { max-width: 100%; }
    }

}

<a href="/Dashboard" class="back-to-dashboard">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Back
</a>

<section class="page-hero">
    @await Html.PartialAsync("_HeroWaves")
    <div class="page-hero-intro">
        <p class="page-hero-eyebrow">Campaigns</p>
        <h1 class="page-hero-title">Your <span>Campaigns</span></h1>
        <p class="page-hero-sub">Create, manage and track every creator campaign from one place.</p>
        <div class="hero-actions" style="margin-top: 16px;">
            <a href="/Campaigns/Create" class="btn btn-primary">Create a Campaign</a>
        </div>
    </div>

    <div class="page-hero-art" aria-hidden="true">
        <div class="hero-glass hero-glass-back"></div>
        <div class="hero-glass hero-glass-front">
            <span class="hero-glass-copy">Create<br />Collaborate<br />Get Rewarded<span></span></span>
        </div>
        <span class="hero-sparkle"></span>
    </div>

    <div class="page-hero-motto">Real Brands.<br />Real Opportunities.<span></span></div>
</section>

@if (TempData["CampaignError"] is string campaignError)
{
    <div class="form-errors" style="margin-top: 18px;">@campaignError</div>
}
@if (TempData["CampaignSuccess"] is string campaignSuccess)
{
    <div class="form-errors" style="margin-top: 18px; border-color: rgba(13,156,108,.25); background: rgba(13,156,108,.08); color: #0d9c6c;">@campaignSuccess</div>
}

<form method="get" action="/Campaigns" class="filter-bar">

    <a href="/Campaigns" class="status-tab @(Model.Status == null ? "is-active" : "")">
        All <span class="count">@Model.TotalCount</span>
    </a>
    <a href="/Campaigns?status=Draft" class="status-tab @(Model.Status == CampaignStatus.Draft ? "is-active" : "")">
        Drafts <span class="count">@Model.DraftCount</span>
    </a>
    <a href="/Campaigns?status=Published" class="status-tab @(Model.Status == CampaignStatus.Published ? "is-active" : "")">
        Published <span class="count">@Model.PublishedCount</span>
    </a>
    <a href="/Campaigns?status=Active" class="status-tab @(Model.Status == CampaignStatus.Active ? "is-active" : "")">
        Active <span class="count">@Model.ActiveCount</span>
    </a>
    <a href="/Campaigns?status=Completed" class="status-tab @(Model.Status == CampaignStatus.Completed ? "is-active" : "")">
        Completed <span class="count">@Model.CompletedCount</span>
    </a>

    <div class="filter-spacer"></div>

    <div class="filter-input-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="text" name="search" class="filter-input" placeholder="Search campaigns.." value="@Model.Search" />
    </div>

    <select name="category" class="filter-select" onchange="this.form.submit()">
        <option value="" selected="@(string.IsNullOrEmpty(Model.Category))">Category</option>
        @foreach (var niche in new[] { "Fashion & Style", "Beauty & Skincare", "Food & Cooking", "Travel & Lifestyle", "Fitness & Health", "Gaming", "Tech & Gadgets", "Education", "Comedy & Entertainment", "Home & Lifestyle", "Finance", "Other" })
        {
            <option value="@niche" selected="@(Model.Category == niche)">@niche</option>
        }
    </select>

    <select name="platform" class="filter-select" onchange="this.form.submit()">
        <option value="" selected="@(string.IsNullOrEmpty(Model.Platform))">Platform</option>
        @foreach (var platform in new[] { "Instagram", "TikTok", "YouTube", "Facebook", "X", "LinkedIn", "Multi-Platform" })
        {
            <option value="@platform" selected="@(Model.Platform == platform)">@platform</option>
        }
    </select>

    <select name="sort" class="filter-select" onchange="this.form.submit()">
        <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Sort By</option>
        <option value="oldest" selected="@(Model.Sort == "oldest")">Oldest first</option>
        <option value="budget" selected="@(Model.Sort == "budget")">Highest budget</option>
    </select>

    @if (Model.Status.HasValue)
    {
        <input type="hidden" name="status" value="@Model.Status" />
    }

    <button type="submit" class="sr-only-submit" aria-label="Search">Search</button>

</form>

@if (Model.Campaigns.Count > 0)
{
    <div class="campaign-list">
        @foreach (var campaign in Model.Campaigns)
        {
            var milestoneCount = Model.MilestonesFor(campaign.Id);
            <div class="campaign-row">

                <div class="campaign-row-thumb">
                    @if (!string.IsNullOrEmpty(campaign.MediaUrl))
                    {
                        @if (campaign.MediaType == "video")
                        {
                            <video src="@campaign.MediaUrl" muted loop playsinline preload="metadata"></video>
                        }
                        else
                        {
                            <img src="@campaign.MediaUrl" alt="@campaign.Title" />
                        }
                    }
                    else
                    {
                        @(campaign.Title.Length > 0 ? campaign.Title[..1].ToUpperInvariant() : "C")
                    }
                </div>

                <div class="campaign-row-body">
                    <div class="campaign-row-title-line">
                        <a href="/Campaigns/Detail/@campaign.Id" class="campaign-row-title">@campaign.Title</a>
                        <span class="status-pill @campaign.Status.ToString().ToLowerInvariant()">@campaign.Status</span>
                    </div>
                    <div class="campaign-row-meta">
                        @{
                            var metaParts = new List<string>();
                            if (!string.IsNullOrEmpty(campaign.Platform)) { metaParts.Add(campaign.Platform); }
                            if (!string.IsNullOrEmpty(campaign.Niche)) { metaParts.Add(campaign.Niche); }
                            metaParts.Add("Posted " + campaign.CreatedAt.ToString("MMM d, yyyy"));
                        }
                        @string.Join(" · ", metaParts)
                    </div>
                    <div class="campaign-row-desc">@campaign.Description</div>
                    <div class="campaign-row-tags">
                        @foreach (var p in (campaign.Platform ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="tag">@p</span>
                        }
                        @if (!string.IsNullOrEmpty(campaign.Niche))
                        {
                            <span class="tag">@campaign.Niche</span>
                        }
                    </div>
                </div>

                <div class="campaign-row-figures">
                    <div>
                        <div class="figure-value">৳@campaign.Budget.ToString("N0")</div>
                        <div class="figure-label">Budget</div>
                    </div>
                    <div>
                        <div class="figure-value">@(milestoneCount > 0 ? milestoneCount.ToString() : "Not set")</div>
                        <div class="figure-label">Milestones</div>
                    </div>
                    <div>
                        <div class="figure-value">@(campaign.Deadline?.ToString("MMM d, yyyy") ?? "No deadline")</div>
                        <div class="figure-label">Deadline</div>
                    </div>
                </div>

                <div class="campaign-row-actions">
                    <a href="/Campaigns/Detail/@campaign.Id" class="btn btn-secondary">View Details</a>
                    <a href="/Campaigns/Edit/@campaign.Id" class="btn btn-primary">Edit</a>
                    @{
                        var applicantCount = Model.ApplicantsFor(campaign.Id);
                        var deleteWarning = campaign.Status == CampaignStatus.Draft
                            ? $"Are you sure you want to delete \"{campaign.Title}\"? This cannot be undone."
                            : $"Are you sure you want to delete \"{campaign.Title}\"? This is a {campaign.Status.ToString().ToLowerInvariant()} campaign" +
                              (applicantCount > 0 ? $" with {applicantCount} applicant{(applicantCount == 1 ? "" : "s")}" : "") +
                              " — deleting it will permanently remove its applicants and any collaborations. This cannot be undone.";
                    }
                    <form method="post" action="/Campaigns/Delete/@campaign.Id">
                        @Html.AntiForgeryToken()
                        <button type="button" class="campaign-row-delete js-confirm" aria-label="Delete campaign"
                                data-confirm-title="Delete this campaign?"
                                data-confirm-text="@deleteWarning"
                                data-confirm-label="Delete"
                                data-confirm-danger="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            Delete
                        </button>
                    </form>
                    <div class="campaign-row-applied">@applicantCount applied</div>
                </div>

            </div>
        }
    </div>
}
else if (Model.TotalCount == 0)
{
    <div class="panel empty-block" style="margin-top: 24px;">
        <div class="empty-title">Your next campaign starts here</div>
        <p class="empty-text">You haven't launched a campaign yet. Define your goals, set your milestones and discover creators who can bring your campaign to life.</p>
        <a href="/Campaigns/Create" class="btn btn-primary" style="margin-top: 16px;">Create Your First Campaign</a>
    </div>
}
else
{
    <div class="panel empty-block" style="margin-top: 24px;">
        <div class="empty-title">No campaigns match these filters</div>
        <p class="empty-text">Try a different search term or clear your filters.</p>
        <a href="/Campaigns" class="btn btn-secondary" style="margin-top: 16px;">Clear Filters</a>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.campaign-row-thumb video').forEach(function (video) {
            var row = video.closest('.campaign-row');
            row.addEventListener('mouseenter', function () { video.play().catch(function () {}); });
            row.addEventListener('mouseleave', function () { video.pause(); video.currentTime = 0; });
        });
    </script>
}
