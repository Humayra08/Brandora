@model Brandora.Web.Models.Campaigns.CampaignDetailViewModel
@{
    var campaign = Model.Campaign;
    ViewData["Title"] = campaign.Title;
    ViewData["ActiveNav"] = "Campaigns";
    Layout = "_AppLayout";
}

@section Styles {

    .detail-shell {
        max-width: 880px;
        margin: 0 auto;

        animation: fade-up .4s ease both;
    }

    .detail-crumb {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #8189a8;
    }

    .detail-crumb a:hover {
        color: #545b7d;
    }

    .detail-head {
        margin-top: 14px;

        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .detail-media {
        flex-shrink: 0;
        width: 84px;
        height: 112px;

        border-radius: 14px;
        overflow: hidden;

        box-shadow: 0 10px 24px rgba(30,34,90,.16);
    }

    .detail-media img,
    .detail-media video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .detail-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 28px;
        color: #171d3d;
    }

    .detail-tags {
        margin-top: 12px;

        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }

    .tag {
        padding: 3px 10px;

        border-radius: 20px;
        background: #f2f3fa;

        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
        color: #545b7d;
    }

    .detail-card {
        margin-top: 24px;
        padding: 28px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .detail-figures {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 21px;
        color: #171d3d;
    }

    .figure-label {
        margin-top: 3px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .detail-description {
        margin-top: 22px;
        padding-top: 22px;
        border-top: 1px solid #f0f1f7;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        line-height: 1.75;
        color: #3c4363;

        white-space: pre-wrap;
    }

    .action-row {
        margin-top: 22px;

        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .soon-grid {
        margin-top: 18px;

        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .soon-panel {
        padding: 24px;

        border-radius: 16px;
        background: #fafbfe;
        border: 1px dashed #dde1f0;

        text-align: center;
    }

    .soon-panel .panel-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .info-section {
        margin-top: 20px;
        padding: 26px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .info-section-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 15.5px;
        color: #171d3d;
    }

    .info-section-sub {
        margin-top: 4px;
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #8189a8;
    }

    .info-section-body {
        margin-top: 16px;
        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        line-height: 1.75;
        color: #3c4363;
        white-space: pre-wrap;
    }

    .info-grid {
        margin-top: 16px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px 24px;
    }

    .info-grid-label {
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .info-grid-value {
        margin-top: 3px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #171d3d;
    }

    .progress-mini-track {
        margin-top: 10px;
        height: 8px;
        border-radius: 8px;
        background: #e8eaf5;
        overflow: hidden;
    }

    .progress-mini-fill {
        height: 100%;
        border-radius: 8px;
        background: linear-gradient(90deg, #a326ff, #236eff);
    }

    @@media(max-width: 760px) {
        .detail-figures { grid-template-columns: repeat(3, 1fr); gap: 12px; }
        .soon-grid { grid-template-columns: 1fr; }
        .info-grid { grid-template-columns: 1fr; }
        .info-section { padding: 20px 18px; }
    }

}

<div class="detail-shell">

    <a href="/Campaigns" class="back-to-dashboard">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back
    </a>

    <section class="page-hero">
        @await Html.PartialAsync("_HeroWaves")
        <div class="page-hero-intro">
            <div class="detail-crumb"><a href="/Campaigns">Campaigns</a> / @campaign.Title</div>

            <div style="display:flex; align-items:center; gap:14px; margin-top:10px;">
                @if (!string.IsNullOrEmpty(campaign.MediaUrl))
                {
                    <div class="detail-media" style="width:52px; height:52px; border-radius:12px;">
                        @if (campaign.MediaType == "video")
                        {
                            <video src="@campaign.MediaUrl" muted loop playsinline autoplay preload="metadata"></video>
                        }
                        else
                        {
                            <img src="@campaign.MediaUrl" alt="@campaign.Title" />
                        }
                    </div>
                }
                <h1 class="page-hero-title" style="margin-top:0;">@campaign.Title</h1>
            </div>

            <p class="page-hero-sub">@campaign.Description</p>

            <div class="detail-tags" style="margin-top: 14px;">
                <span class="status-pill @campaign.Status.ToString().ToLowerInvariant()">@campaign.Status</span>
                @foreach (var p in (campaign.Platform ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <span class="tag">@p</span>
                }
                @if (!string.IsNullOrEmpty(campaign.Niche))
                {
                    <span class="tag">@campaign.Niche</span>
                }
            </div>

            <div class="hero-actions" style="margin-top: 16px;">
                <a href="/Campaigns/Edit/@campaign.Id" class="btn btn-secondary">Edit Campaign</a>
            </div>
        </div>

        <div class="page-hero-art" aria-hidden="true">
            <div class="hero-glass hero-glass-back"></div>
            <div class="hero-glass hero-glass-front">
                <span class="hero-glass-copy">Track<br />Manage<br />Grow<span></span></span>
            </div>
            <span class="hero-sparkle"></span>
        </div>

        <div class="page-hero-motto">Every Detail,<br />One Workspace.<span></span></div>
    </section>

    <div class="detail-card">

        <div class="detail-figures">
            <div>
                <div class="figure-value">৳@campaign.Budget.ToString("N0")</div>
                <div class="figure-label">Budget</div>
            </div>
            <div>
                <div class="figure-value">@Model.ApplicantCount</div>
                <div class="figure-label">Applicants</div>
            </div>
            <div>
                <div class="figure-value">@(campaign.Deadline?.ToString("MMM d, yyyy") ?? "None")</div>
                <div class="figure-label">Deadline</div>
            </div>
        </div>

        <p class="detail-description">@campaign.Description</p>

        <div class="action-row">
            @if (campaign.Status == Brandora.Web.Models.Domain.CampaignStatus.Draft)
            {
                <a href="/Campaigns/Preview/@campaign.Id" class="btn btn-primary">Continue Setup</a>
            }
            @if (campaign.Status != Brandora.Web.Models.Domain.CampaignStatus.Cancelled)
            {
                <a href="/Influencers/SmartMatch?campaignId=@campaign.Id" class="btn btn-secondary">Find Creators with Smart Match</a>
            }
            @if (campaign.Status == Brandora.Web.Models.Domain.CampaignStatus.Published)
            {
                <form method="post" action="/Campaigns/UpdateStatus/@campaign.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="status" value="Active" />
                    <button type="submit" class="btn btn-primary">Mark as Active</button>
                </form>
            }
            @if (campaign.Status == Brandora.Web.Models.Domain.CampaignStatus.Active)
            {
                <form method="post" action="/Campaigns/UpdateStatus/@campaign.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="status" value="Completed" />
                    <button type="submit" class="btn btn-primary">Mark as Completed</button>
                </form>
            }
            @if (campaign.Status != Brandora.Web.Models.Domain.CampaignStatus.Completed && campaign.Status != Brandora.Web.Models.Domain.CampaignStatus.Cancelled)
            {
                <form method="post" action="/Campaigns/UpdateStatus/@campaign.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="status" value="Cancelled" />
                    <button type="button" class="btn btn-outline-danger js-confirm"
                            data-confirm-title="Cancel this campaign?"
                            data-confirm-text="Are you sure you want to cancel &quot;@campaign.Title&quot;? Creators will no longer be able to apply."
                            data-confirm-label="Cancel Campaign"
                            data-confirm-danger="true">Cancel Campaign</button>
                </form>
            }
        </div>

    </div>

    <div class="soon-grid">

        <div class="soon-panel">
            <div class="panel-title">Proposals</div>
            <div class="figure-value" style="margin-top:8px;">@Model.ApplicantCount</div>
            <p class="empty-text">@(Model.ApplicantCount > 0 ? "Proposals sent for this campaign." : "Invite a creator to send your first proposal.")</p>
            <a href="/Proposals?campaignId=@campaign.Id" class="btn btn-secondary" style="margin-top: 14px;">View Proposals</a>
        </div>

        <div class="soon-panel">
            <div class="panel-title">Collaborations</div>
            <div class="figure-value" style="margin-top:8px;">@Model.CollaborationCount</div>
            <p class="empty-text">@(Model.CollaborationCount > 0 ? "Creators actively collaborating on this campaign." : "Confirm an accepted proposal to start one.")</p>
            <a href="/Collaborations?campaignId=@campaign.Id" class="btn btn-secondary" style="margin-top: 14px;">View Collaborations</a>
        </div>

        <div class="soon-panel">
            <div class="panel-title">Messages</div>
            <div class="figure-value" style="margin-top:8px;">@Model.ConversationCount</div>
            <p class="empty-text">@(Model.ConversationCount > 0 ? "Conversations tied to this campaign." : "Message a creator to start a conversation here.")</p>
            <a href="/Messages?campaignId=@campaign.Id" class="btn btn-secondary" style="margin-top: 14px;">View Messages</a>
        </div>

    </div>

    @if (!string.IsNullOrEmpty(campaign.ContentGuidelines))
    {
        <div class="info-section">
            <div class="info-section-title">Content Guidelines</div>
            <p class="info-section-sub">The tone, visual direction, messaging requirements and content expectations shared with creators.</p>
            <p class="info-section-body">@campaign.ContentGuidelines</p>
        </div>
    }

    @{
        var hasTargeting = !string.IsNullOrWhiteSpace(campaign.TargetLocation)
            || campaign.TargetFollowersMin.HasValue || campaign.TargetFollowersMax.HasValue
            || campaign.TargetEngagementRateMin.HasValue || campaign.TargetVerifiedOnly;
    }

    <div class="info-section">
        <div class="info-section-title">Targeting</div>
        <p class="info-section-sub">The audience, platform and creator characteristics selected for this campaign.</p>

        @if (!hasTargeting)
        {
            <p class="info-section-body" style="color:#9096b3;">Open to all creators — no targeting criteria set for this campaign.</p>
        }
        else
        {
            <div class="info-grid">
                @if (!string.IsNullOrEmpty(campaign.Platform))
                {
                    <div><div class="info-grid-label">Platform</div><div class="info-grid-value">@campaign.Platform</div></div>
                }
                @if (!string.IsNullOrEmpty(campaign.TargetLocation))
                {
                    <div><div class="info-grid-label">Location</div><div class="info-grid-value">@campaign.TargetLocation</div></div>
                }
                @if (campaign.TargetFollowersMin.HasValue || campaign.TargetFollowersMax.HasValue)
                {
                    <div><div class="info-grid-label">Follower Range</div><div class="info-grid-value">@(campaign.TargetFollowersMin?.ToString("N0") ?? "Any") – @(campaign.TargetFollowersMax?.ToString("N0") ?? "Any")</div></div>
                }
                @if (campaign.TargetEngagementRateMin.HasValue)
                {
                    <div><div class="info-grid-label">Engagement Rate</div><div class="info-grid-value">@campaign.TargetEngagementRateMin.Value.ToString("0.0")%+</div></div>
                }
                @if (campaign.TargetVerifiedOnly)
                {
                    <div><div class="info-grid-label">Verification</div><div class="info-grid-value">Verified creators preferred</div></div>
                }
            </div>
        }
        <a href="/Influencers?campaignId=@campaign.Id" class="btn btn-secondary" style="margin-top: 16px;">Discover Matching Creators</a>
    </div>

    @if (Model.MilestonePlans.Count > 0 || Model.TotalMilestoneCount > 0)
    {
        <div class="info-section">
            <div class="info-section-title">Milestone Progress</div>
            <p class="info-section-sub">Deliverables planned for this campaign and how far real collaborations have progressed.</p>

            @if (Model.TotalMilestoneCount > 0)
            {
                var pct = (int)Math.Round(Model.PaidMilestoneCount * 100.0 / Model.TotalMilestoneCount);
                <div class="info-grid">
                    <div><div class="info-grid-label">Milestones Paid</div><div class="info-grid-value">@Model.PaidMilestoneCount of @Model.TotalMilestoneCount</div></div>
                    <div><div class="info-grid-label">Progress</div><div class="info-grid-value">@pct%</div></div>
                </div>
                <div class="progress-mini-track"><div class="progress-mini-fill" style="width: @pct%;"></div></div>
            }
            else
            {
                <p class="info-section-body" style="color:#9096b3;">@Model.MilestonePlans.Count milestone@(Model.MilestonePlans.Count == 1 ? "" : "s") planned — these become real, trackable deliverables once a creator's proposal is accepted.</p>
            }
        </div>
    }

    @if (Model.PendingPaymentsAmount > 0 || campaign.SpentAmount > 0)
    {
        <div class="info-section">
            <div class="info-section-title">Payment Overview</div>
            <p class="info-section-sub">Funding committed and released across this campaign's collaborations.</p>

            <div class="info-grid">
                <div><div class="info-grid-label">Spent</div><div class="info-grid-value">৳@campaign.SpentAmount.ToString("N0")</div></div>
                <div><div class="info-grid-label">Pending</div><div class="info-grid-value">৳@Model.PendingPaymentsAmount.ToString("N0")</div></div>
            </div>
            <a href="/Payments" class="btn btn-secondary" style="margin-top: 16px;">View Payments</a>
        </div>
    }

</div>
