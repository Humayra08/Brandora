@model Brandora.Web.Models.Campaigns.CampaignTargetingFormViewModel
@{
    ViewData["Title"] = "Targeting & Audience";
    ViewData["ActiveNav"] = "Campaigns";
    Layout = "_AppLayout";
}

@section Styles {

    .form-shell {
        max-width: 720px;
        margin: 0 auto;

        animation: fade-up .4s ease both;
    }

    .form-head {
        text-align: center;
    }

    .form-eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9b2cff;
    }

    .form-title {
        margin-top: 10px;

        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 30px;
    }

    .form-sub {
        margin-top: 8px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    .form-progress {
        margin-top: 26px;

        display: flex;
        gap: 6px;
    }

    .form-progress span {
        flex: 1;
        height: 4px;
        border-radius: 4px;
        background: #e8eaf5;
    }

    .form-progress span.is-filled {
        background: linear-gradient(90deg, #a326ff, #236eff);
    }

    .form-section {
        margin-top: 30px;
        padding: 28px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .section-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        width: 30px;
        height: 30px;

        border-radius: 50%;
        border: 1px solid #d9bfff;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #8b2cff;
    }

    .section-heading {
        margin-top: 14px;

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 17px;
        color: #171d3d;
    }

    .section-desc {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #8189a8;
    }

    .form-fields {
        margin-top: 22px;

        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 16px;
    }

    .form-fields.single {
        grid-template-columns: 1fr;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .form-field.span-2 {
        grid-column: span 2;
    }

    .form-field label {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 600;
        color: #2a3157;
    }

    .form-field input {
        padding: 12px 14px;

        border-radius: 10px;
        border: 1px solid #e2e5f2;
        background: #fbfbfe;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #171d3d;

        outline: none;
        transition: .2s;
    }

    .form-field input:focus {
        border-color: #a978ff;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(155,44,255,.1);
    }

    .form-actions {
        margin-top: 28px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .form-errors {
        margin-top: 18px;
        padding: 12px 16px;

        border-radius: 12px;
        background: #fdeef0;
        border: 1px solid #f4c6cd;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #b3273f;
    }

    .form-errors ul { margin: 0; padding-left: 18px; }

    .check-row {
        display: flex;
        align-items: center;
        gap: 10px;

        padding: 14px 16px;

        border-radius: 12px;
        border: 1px solid #e2e5f2;
        background: #fbfbfe;
    }

    .check-row input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #9b2cff;
    }

    .check-row label {
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #2a3157;
    }

    .targeting-hint {
        margin-top: 22px;
        padding: 14px 16px;

        border-radius: 12px;
        background: linear-gradient(105deg, rgba(163,38,255,.06), rgba(24,169,255,.05));
        border: 1px solid #e3d9ff;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #56617f;
        line-height: 1.6;
    }

    @@media(max-width: 600px) {
        .form-fields { grid-template-columns: 1fr; }
        .form-field.span-2 { grid-column: span 1; }
        .form-section { padding: 22px 18px; }
    }

}

<div class="form-shell">

    <div class="form-head">
        <div class="form-eyebrow">Step 3 of 4 · Targeting</div>
        <h1 class="form-title">Find the right creators</h1>
        <p class="form-sub">Optional — narrow who this campaign is best suited for. Leave anything blank to keep it open to everyone.</p>

        <div class="form-progress">
            <span class="is-filled"></span>
            <span class="is-filled"></span>
            <span class="is-filled"></span>
            <span></span>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="form-errors">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" action="/Campaigns/Targeting">

        @Html.AntiForgeryToken()
        <input type="hidden" name="CampaignId" value="@Model.CampaignId" />

        <section class="form-section">
            <div class="section-num">01</div>
            <div class="section-heading">Audience Criteria</div>
            <p class="section-desc">Compared against each creator's real profile — never a fabricated match.</p>

            <div class="form-fields">
                <div class="form-field span-2">
                    <label for="TargetLocation">Location (optional)</label>
                    <input type="text" id="TargetLocation" name="TargetLocation" placeholder="e.g. Dhaka" value="@Model.TargetLocation" />
                </div>

                <div class="form-field">
                    <label for="TargetFollowersMin">Minimum Followers</label>
                    <input type="number" id="TargetFollowersMin" name="TargetFollowersMin" min="1" placeholder="10000" value="@Model.TargetFollowersMin" />
                </div>

                <div class="form-field">
                    <label for="TargetFollowersMax">Maximum Followers</label>
                    <input type="number" id="TargetFollowersMax" name="TargetFollowersMax" min="1" placeholder="500000" value="@Model.TargetFollowersMax" />
                </div>

                <div class="form-field">
                    <label for="TargetEngagementRateMin">Minimum Engagement Rate (%)</label>
                    <input type="number" id="TargetEngagementRateMin" name="TargetEngagementRateMin" min="0.1" max="100" step="0.1" placeholder="3.0" value="@Model.TargetEngagementRateMin" />
                </div>
            </div>

            <div class="form-fields single" style="margin-top: 16px;">
                <div class="check-row">
                    <input type="checkbox" id="TargetVerifiedOnly" name="TargetVerifiedOnly" value="true" checked="@Model.TargetVerifiedOnly" />
                    <label for="TargetVerifiedOnly">Only show this campaign as a strong fit for verified creators</label>
                </div>
            </div>

            <div class="targeting-hint">
                These criteria don't block anyone from applying — they help Discovery and Smart Match surface creators who genuinely fit, and Review &amp; Publish will show how many current creators match.
            </div>
        </section>

        <div class="form-actions">
            <a href="/Campaigns/Milestones/@Model.CampaignId" class="btn btn-ghost">Back to Milestones</a>
            <button type="submit" class="btn btn-primary">Continue to Review</button>
        </div>

    </form>

</div>
