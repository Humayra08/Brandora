@model Brandora.Web.Models.Milestones.ProofSubmissionViewModel
@using Brandora.Web.Models.Domain
@{
    var milestone = ViewData["Milestone"] as Milestone;
    ViewData["Title"] = "Log Submission";
    ViewData["ActiveNav"] = "Campaigns";
    Layout = "_AppLayout";
}

@section Styles {

    .form-shell {
        max-width: 600px;
        margin: 0 auto;

        animation: fade-up .4s ease both;
    }

    .detail-crumb {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #8189a8;
    }

    .form-head {
        margin-top: 14px;
        text-align: center;
    }

    .form-eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #9b2cff;
    }

    .form-title {
        margin-top: 10px;

        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 27px;
    }

    .form-sub {
        margin-top: 8px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    .form-section {
        margin-top: 24px;
        padding: 28px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 7px;

        margin-bottom: 18px;
    }

    .form-field:last-child {
        margin-bottom: 0;
    }

    .form-field label {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 600;
        color: #2a3157;
    }

    .form-field input,
    .form-field textarea {
        padding: 12px 14px;

        border-radius: 10px;
        border: 1px solid #e2e5f2;
        background: #fbfbfe;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #171d3d;

        outline: none;
        transition: .2s;
    }

    .form-field textarea {
        min-height: 90px;
        resize: vertical;
    }

    .form-field input:focus,
    .form-field textarea:focus {
        border-color: #a978ff;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(155,44,255,.1);
    }

    .form-actions {
        margin-top: 24px;

        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

}

<div class="form-shell">

    <div class="detail-crumb"><a href="/Milestones/Detail/@Model.MilestoneId">@milestone?.Title</a> / Log Submission</div>

    <div class="form-head">
        <div class="form-eyebrow">Proof of Work</div>
        <h1 class="form-title">Log @milestone?.Collaboration.InfluencerProfile.FullName's submission</h1>
        <p class="form-sub">Record the link and details they shared for this milestone.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="form-errors" style="margin-top: 20px;">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" action="/Milestones/LogSubmission">

        @Html.AntiForgeryToken()
        <input type="hidden" name="MilestoneId" value="@Model.MilestoneId" />

        <div class="form-section">

            <div class="form-field">
                <label for="ProofUrl">Post / Content URL</label>
                <input type="url" id="ProofUrl" name="ProofUrl" placeholder="https://instagram.com/p/..." value="@Model.ProofUrl" required />
            </div>

            <div class="form-field">
                <label for="ProofNotes">Notes (optional)</label>
                <textarea id="ProofNotes" name="ProofNotes" placeholder="Anything worth noting about this submission.">@Model.ProofNotes</textarea>
            </div>

        </div>

        <div class="form-actions">
            <a href="/Milestones/Detail/@Model.MilestoneId" class="btn btn-ghost">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Submission</button>
        </div>

    </form>

</div>
