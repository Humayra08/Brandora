@model Brandora.Web.Models.Messages.InboxViewModel
@using Brandora.Web.Models.Influencers
@inject Microsoft.AspNetCore.Identity.UserManager<Brandora.Web.Models.Domain.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Messages";
    ViewData["ActiveNav"] = "Messages";
    Layout = "_AppLayout";
    var currentUserId = UserManager.GetUserId(User);
    var selected = Model.Selected;
    var selectedMessages = selected?.Messages.OrderBy(m => m.SentAt).ThenBy(m => m.Id).ToList() ?? new List<Brandora.Web.Models.Domain.Message>();
}

@section Styles {

    .detail-crumb {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #8189a8;
    }

    .messages-shell {
        margin-top: 14px;

        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 20px;

        /* 346px of chrome + 37px for the hero stats row */
        height: calc(100vh - 383px);

        animation: fade-up .4s ease both;
    }

    @@media(max-width: 900px) {
        .messages-shell { grid-template-columns: 1fr; height: auto; }
    }

    /* ---- List panel ---- */

    .list-panel {
        display: flex;
        flex-direction: column;

        border-radius: 22px;
        background: #ffffff;
        border: 1px solid #eaecf5;
        box-shadow: 0 24px 60px rgba(30,34,90,.06);

        overflow: hidden;
    }

    .list-head {
        padding: 20px 20px 16px;
        border-bottom: 1px solid #f0f1f7;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .list-head-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 20px;
        color: #171d3d;
    }

    .list-head-sub {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #8189a8;
    }

    .list-filter-btn {
        flex-shrink: 0;

        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;
        border: 1px solid #e2e5f2;
        background: #ffffff;

        color: #545b7d;
        cursor: pointer;

        transition: .2s;
    }

    .list-filter-btn:hover,
    .list-filter-btn.is-active {
        border-color: #9b2cff;
        color: #9b2cff;
        background: linear-gradient(105deg, rgba(163,38,255,.08), rgba(35,110,234,.08));
    }

    .list-search-wrap {
        max-height: 0;
        overflow: hidden;

        transition: max-height .3s cubic-bezier(.22,1,.36,1);
    }

    .list-search-wrap.is-open {
        max-height: 70px;
    }

    .list-search {
        display: flex;
        align-items: center;
        gap: 8px;

        padding: 12px 20px;
        border-bottom: 1px solid #f0f1f7;
    }

    .list-search input {
        flex: 1;
        height: 38px;

        padding: 0 14px;

        border-radius: 10px;
        border: 1px solid #e2e5f2;
        background: #fbfbfe;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #2a3157;

        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .list-search input:focus {
        border-color: #a978ff;
        box-shadow: 0 0 0 3px rgba(155,44,255,.1);
    }

    .list-rows {
        flex: 1;
        overflow-y: auto;

        padding: 8px;

        scroll-behavior: smooth;
    }

    .inbox-row {
        position: relative;

        display: flex;
        align-items: center;
        gap: 12px;

        padding: 12px 12px;
        margin-bottom: 4px;

        border-radius: 14px;

        transition: background .25s ease, transform .2s ease;

        opacity: 0;
        transform: translateY(14px);
    }

    .inbox-row.is-visible {
        opacity: 1;
        transform: translateY(0);
        transition: opacity .45s ease, transform .45s cubic-bezier(.22,1,.36,1), background .25s ease;
    }

    a.inbox-row:hover {
        background: #f7f5ff;
    }

    .inbox-row.is-selected {
        background: linear-gradient(105deg, rgba(163,38,255,.1), rgba(35,110,234,.08) 60%, rgba(24,169,255,.08));
    }

    .inbox-avatar {
        width: 44px;
        height: 44px;
        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);
        color: #ffffff;

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 14px;

        transition: transform .3s cubic-bezier(.22,1,.36,1);
    }

    a.inbox-row:hover .inbox-avatar {
        transform: scale(1.06) rotate(-3deg);
    }

    .inbox-body {
        flex: 1;
        min-width: 0;
    }

    .inbox-name-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #171d3d;
    }

    .inbox-name-left {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }

    .inbox-name-left span:first-child {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .inbox-time {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 500;
        color: #9096b3;
        flex-shrink: 0;
    }

    .inbox-snippet-row {
        margin-top: 2px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .inbox-snippet {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #8189a8;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .inbox-snippet.is-unread {
        color: #2a3157;
        font-weight: 600;
    }

    .inbox-unread-dot {
        flex-shrink: 0;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;
        background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 10px;
        color: #fff;
    }

    .list-empty {
        margin: auto;
        padding: 30px 20px;
        text-align: center;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #9096b3;
    }

    .start-convo-card {
        margin: 8px;
        padding: 22px 16px;

        border-radius: 16px;
        background: linear-gradient(165deg, #f6f1ff, #eef2ff);
        border: 1px solid #e6e1ff;

        text-align: center;
    }

    .start-convo-icon {
        width: 40px;
        height: 40px;
        margin: 0 auto 12px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);
        color: #ffffff;
    }

    .start-convo-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13.5px;
        color: #171d3d;
    }

    .start-convo-text {
        margin: 5px auto 0;
        max-width: 240px;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 1.55;
        color: #6b7290;
    }

    .start-convo-card .btn {
        margin-top: 14px;
        width: 100%;
        height: 40px;
        font-size: 12.5px;
    }

    /* ---- Thread panel ---- */

    .thread-panel {
        position: relative;
        overflow: hidden;

        display: flex;
        flex-direction: column;

        border-radius: 22px;
        background: #ffffff;
        border: 1px solid #eaecf5;
        box-shadow: 0 24px 60px rgba(30,34,90,.08);
    }

    .thread-header {
        padding: 18px 24px;

        background: linear-gradient(120deg, #fbf5ff, #f3f6ff);
        border-bottom: 1px solid #eaecf5;

        display: flex;
        align-items: center;
        gap: 14px;
    }

    .thread-name {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 15.5px;
        color: #171d3d;
    }

    .thread-sub {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #8189a8;
    }

    .thread-header-actions {
        margin-left: auto;
        flex-shrink: 0;

        display: flex;
        align-items: center;
        gap: 8px;
    }

    .thread-icon-btn {
        width: 38px;
        height: 38px;
        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;
        border: 1px solid #e2e5f2;
        background: #ffffff;

        color: #545b7d;
        cursor: pointer;

        transition: .2s;
    }

    .thread-icon-btn:hover,
    .thread-icon-btn.is-active {
        border-color: #9b2cff;
        color: #9b2cff;
    }

    .thread-icon-btn:disabled {
        cursor: not-allowed;
        opacity: .5;
    }

    .thread-icon-btn:disabled:hover {
        border-color: #e2e5f2;
        color: #545b7d;
    }

    .thread-body {
        flex: 1;
        overflow-y: auto;
        scroll-behavior: smooth;

        padding: 24px;

        background: #fbfbfe;

        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .msg-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
    }

    .msg-row.is-mine {
        justify-content: flex-end;
    }

    .msg-avatar {
        width: 26px;
        height: 26px;
        flex-shrink: 0;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 10px;
        color: #fff;
    }

    .msg-col {
        display: flex;
        flex-direction: column;
        max-width: 68%;
        min-width: 0;
    }

    .msg-row.is-mine .msg-col {
        align-items: flex-end;
    }

    .msg-row:not(.is-mine) .msg-col {
        align-items: flex-start;
    }

    .msg-bubble {
        padding: 11px 16px;

        border-radius: 17px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        line-height: 1.55;
        word-break: break-word;

        animation: fade-up .3s ease both;
    }

    .msg-row.is-mine .msg-bubble {
        background: linear-gradient(105deg, #a326ff, #236eff 60%, #18a9ff);
        color: #ffffff;
        border-bottom-right-radius: 5px;
        box-shadow: 0 10px 22px rgba(139,44,255,.18);
    }

    .msg-row:not(.is-mine) .msg-bubble {
        background: #ffffff;
        border: 1px solid #eaecf5;
        color: #2a3157;
        border-bottom-left-radius: 5px;
        box-shadow: 0 6px 16px rgba(30,34,90,.05);
    }

    .msg-time {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        color: #9096b3;
    }

    .msg-row.is-mine .msg-time {
        text-align: right;
    }

    .msg-bubble-row {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .msg-row.is-mine .msg-bubble-row {
        flex-direction: row-reverse;
    }

    .msg-bubble-wrap {
        min-width: 0;
    }

    .msg-menu-wrap {
        position: relative;
        flex-shrink: 0;
        align-self: center;

        opacity: 0;
        transition: opacity .15s ease;
    }

    .msg-row:hover .msg-menu-wrap,
    .msg-menu-wrap.is-open {
        opacity: 1;
    }

    .msg-menu-btn {
        width: 24px;
        height: 24px;
        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border: none;
        border-radius: 50%;
        background: transparent;
        color: #9096b3;
        cursor: pointer;

        transition: background .15s ease, color .15s ease;
    }

    .msg-menu-btn:hover {
        background: rgba(30,34,90,.08);
        color: #4a5170;
    }

    .msg-menu {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 30;

        min-width: 130px;

        border-radius: 12px;
        border: 1px solid #eaecf5;
        background: #ffffff;
        box-shadow: 0 14px 32px rgba(30,34,90,.16);
        padding: 6px;

        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px) scale(.97);
        transition: opacity .15s ease, transform .15s cubic-bezier(.22,1,.36,1), visibility .15s;
    }

    .msg-row.is-mine .msg-menu {
        left: auto;
        right: 0;
    }

    .msg-menu-wrap.is-open .msg-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .msg-menu-item {
        display: block;
        width: 100%;
        padding: 8px 10px;

        border: none;
        border-radius: 8px;
        background: transparent;
        text-align: left;
        cursor: pointer;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #2a3157;

        transition: background .15s ease;
    }

    .msg-menu-item:hover {
        background: rgba(155,44,255,.08);
    }

    .msg-menu-item.msg-menu-danger {
        color: #c22540;
    }

    .msg-menu-item.msg-menu-danger:hover {
        background: rgba(220,50,70,.08);
    }

    .msg-menu-unsend-form {
        margin: 0;
    }

    .msg-edit-form {
        display: flex;
        flex-direction: column;
        gap: 6px;

        margin-top: 4px;
        padding: 10px 12px;

        border-radius: 14px;
        border: 1px solid #d9c6ff;
        background: #fbfaff;
    }

    .msg-edit-form[hidden] {
        display: none;
    }

    .msg-edit-input {
        resize: none;
        min-height: 44px;
        padding: 6px 2px;

        border: none;
        background: transparent;
        outline: none;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #171d3d;
        line-height: 1.5;

        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .msg-edit-input::-webkit-scrollbar {
        display: none;
    }

    .msg-edit-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .msg-edit-cancel,
    .msg-edit-save {
        padding: 6px 14px;

        border: none;
        border-radius: 20px;
        cursor: pointer;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;

        transition: opacity .15s ease;
    }

    .msg-edit-cancel {
        background: #eef0f7;
        color: #4a5170;
    }

    .msg-edit-save {
        background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
        color: #ffffff;
    }

    .msg-edit-cancel:hover,
    .msg-edit-save:hover {
        opacity: .85;
    }

    .composer-error {
        margin: 0 20px;
        padding: 10px 16px;

        border-radius: 10px;
        background: #fff2f2;
        border: 1px solid #ffd4d4;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #c22b4a;
    }

    .composer-preview {
        display: none;
        align-items: center;
        gap: 10px;

        margin: 12px 20px 0;
        padding: 8px 12px;

        border-radius: 12px;
        background: linear-gradient(120deg, rgba(163,38,255,.1), rgba(24,169,255,.08));
        border: 1px solid rgba(163,38,255,.28);
    }

    .composer-preview-name {
        flex: 1;
        min-width: 0;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        color: #3c4363;

        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .composer-preview-remove {
        width: 22px;
        height: 22px;
        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        border: none;
        cursor: pointer;
        background: rgba(0,0,0,.06);
        color: #6b7290;
    }

    .composer-preview-media {
        position: relative;
        flex-shrink: 0;

        width: 56px;
        height: 56px;

        border-radius: 12px;
        overflow: hidden;
        background: #e9ecf7;
    }

    .composer-preview-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .composer-preview-media .composer-preview-remove {
        position: absolute;
        top: 4px;
        right: 4px;

        width: 18px;
        height: 18px;

        background: rgba(15,20,45,.65);
        color: #ffffff;
        font-size: 11px;
    }

    .composer-preview-file {
        display: flex;
        align-items: center;
        gap: 10px;

        flex: 1;
        min-width: 0;
    }

    .composer-preview-file[hidden],
    .composer-preview-media[hidden] {
        display: none;
    }

    .composer-preview-file-icon {
        flex-shrink: 0;
        color: #7a3fe0;
    }

    .msg-media {
        position: relative;
        overflow: hidden;
        border-radius: 14px;
        margin-bottom: 6px;
    }

    .msg-media-view {
        display: block;
        cursor: zoom-in;
    }

    .msg-media img,
    .msg-media video {
        display: block;
        width: 100%;
        max-width: 240px;
        max-height: 260px;
        object-fit: cover;
    }

    .msg-media-download {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 2;

        width: 28px;
        height: 28px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        border: none;
        background: rgba(15,20,45,.55);
        color: #ffffff;
        backdrop-filter: blur(3px);

        transition: background .15s ease;
    }

    .msg-media-download:hover {
        background: rgba(15,20,45,.8);
    }

    .msg-bubble.has-media {
        padding: 6px;
    }

    .msg-bubble.has-media.has-caption {
        padding-bottom: 10px;
    }

    .msg-bubble.has-media .msg-caption {
        padding: 4px 8px 2px;
    }

    .msg-row.is-mine .msg-bubble.has-media:not(.has-caption),
    .msg-row:not(.is-mine) .msg-bubble.has-media:not(.has-caption) {
        padding: 0;
        background: none;
        border: none;
        box-shadow: none;
        border-radius: 0;
    }

    .thread-composer {
        padding: 16px 20px;

        background: #ffffff;
        border-top: 1px solid #eaecf5;

        display: flex;
        align-items: center;
        gap: 10px;
    }

    .composer-attach {
        flex-shrink: 0;
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        border: 1px solid #e2e5f2;
        background: #fbfbfe;
        cursor: pointer;
        color: #8b2cff;

        transition: border-color .2s ease, background .2s ease, transform .2s ease;
    }

    .composer-attach:hover {
        border-color: #a978ff;
        background: linear-gradient(120deg, rgba(163,38,255,.1), rgba(24,169,255,.08));
        transform: translateY(-1px);
    }

    .thread-composer textarea {
        flex: 1;
        resize: none;
        height: 46px;
        padding: 12px 16px;

        border-radius: 24px;
        border: 1px solid #e2e5f2;
        background: #fbfbfe;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #171d3d;

        outline: none;
        transition: border-color .2s ease, background .2s ease;

        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .thread-composer textarea::-webkit-scrollbar {
        display: none;
    }

    .thread-composer textarea:focus {
        border-color: #a978ff;
        background: #ffffff;
    }

    .composer-send {
        flex-shrink: 0;
        width: 46px;
        height: 46px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        border: none;
        cursor: pointer;

        background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);
        background-size: 220% 220%;

        box-shadow: 0 10px 24px rgba(139,44,255,.32);

        transition: background-position .35s ease, transform .2s ease;
    }

    .composer-send:hover {
        background-position: 100% 100%;
        transform: translateY(-2px) scale(1.04);
    }

    .thread-empty {
        margin: auto;
        text-align: center;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #9096b3;
    }

    /* ---- Profile drawer ---- */

    .profile-drawer {
        position: absolute;
        inset: 0;
        z-index: 20;

        display: flex;
        flex-direction: column;

        padding: 30px 24px 26px;

        background: linear-gradient(165deg, #15163f 0%, #0c0d2c 55%, #07081f 100%);
        color: #fff;

        overflow-y: auto;

        transform: translateX(100%);
        transition: transform .35s cubic-bezier(.22,1,.36,1);
    }

    .profile-drawer.is-open {
        transform: translateX(0);
    }

    .profile-drawer::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;

        background:
            radial-gradient(circle at 15% 0%, rgba(163,38,255,.4), transparent 46%),
            radial-gradient(circle at 100% 20%, rgba(35,110,234,.28), transparent 42%),
            radial-gradient(circle at 80% 100%, rgba(24,169,255,.22), transparent 48%);
    }

    .profile-drawer > * {
        position: relative;
        z-index: 1;
    }

    .profile-drawer-close {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 2;

        width: 32px;
        height: 32px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.2);
        background: rgba(255,255,255,.06);
        color: #fff;
        cursor: pointer;
    }

    .profile-avatar-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .profile-avatar-ring {
        width: 86px;
        height: 86px;
        padding: 3px;

        border-radius: 50%;
        background: linear-gradient(135deg, #a326ff, #236eff, #18a9ff);

        box-shadow: 0 14px 34px rgba(139,44,255,.35);
    }

    .profile-avatar-ring .inbox-avatar {
        width: 100%;
        height: 100%;
        font-size: 26px;
        border: 2px solid #0c0d2c;
    }

    .profile-name-row {
        margin-top: 14px;

        display: flex;
        align-items: center;
        gap: 6px;

        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 20px;
    }

    .profile-handle {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: rgba(255,255,255,.55);
    }

    .profile-section {
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid rgba(255,255,255,.1);
    }

    .profile-label {
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: rgba(255,255,255,.4);
    }

    .profile-bio {
        margin-top: 8px;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        line-height: 1.65;
        color: rgba(255,255,255,.82);
    }

    .profile-tags {
        margin-top: 10px;

        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .profile-tag {
        padding: 4px 11px;

        border-radius: 20px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.14);

        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
        color: rgba(255,255,255,.85);
    }

    .profile-rate-box {
        margin-top: 8px;
        padding: 12px 14px;

        border-radius: 12px;
        background: linear-gradient(120deg, rgba(163,38,255,.18), rgba(24,169,255,.12));
        border: 1px solid rgba(163,38,255,.3);

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        line-height: 1.6;
        color: rgba(255,255,255,.9);
    }

    .profile-figures {
        margin-top: 12px;

        display: flex;
        justify-content: space-between;
    }

    .profile-figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 17px;
        color: #fff;
    }

    .profile-figure-label {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: rgba(255,255,255,.45);
    }

    .profile-cta {
        margin-top: 22px;

        display: block;
        text-align: center;

        padding: 12px 18px;
        border-radius: 12px;

        background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
        background-size: 220% 100%;

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13px;
        color: #fff;

        transition: background-position .35s ease, transform .2s ease;
    }

    .profile-cta:hover {
        background-position: 100% 0;
        transform: translateY(-2px);
    }

    .confirm-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 20px;
        background: rgba(15,20,45,.45);
        backdrop-filter: blur(2px);

        animation: fade-up .18s ease both;
    }

    .confirm-modal-overlay[hidden] {
        display: none;
    }

    .confirm-modal {
        width: 100%;
        max-width: 340px;

        padding: 24px;

        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(20,24,60,.28);

        text-align: center;
    }

    .confirm-modal-icon {
        width: 46px;
        height: 46px;
        margin: 0 auto 14px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        background: rgba(220,50,70,.1);
        color: #c22540;
    }

    .confirm-modal-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 16px;
        color: #171d3d;
    }

    .confirm-modal-body {
        margin: 8px 0 0;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        line-height: 1.5;
        color: #6b7290;
    }

    .confirm-modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .confirm-modal-cancel,
    .confirm-modal-danger {
        flex: 1;
        padding: 11px 0;

        border: none;
        border-radius: 12px;
        cursor: pointer;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        font-weight: 600;

        transition: opacity .15s ease, transform .15s ease;
    }

    .confirm-modal-cancel {
        background: #eef0f7;
        color: #3c4363;
    }

    .confirm-modal-danger {
        background: linear-gradient(105deg, #e63b5e, #c22540);
        color: #ffffff;
    }

    .confirm-modal-cancel:hover,
    .confirm-modal-danger:hover {
        opacity: .88;
    }

    .confirm-modal-cancel:active,
    .confirm-modal-danger:active {
        transform: scale(.97);
    }

    .copy-toast {
        position: fixed;
        left: 50%;
        bottom: 90px;
        z-index: 300;
        transform: translateX(-50%) translateY(8px);

        padding: 8px 16px;
        border-radius: 20px;
        background: rgba(20,24,60,.92);

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 600;
        color: #ffffff;

        opacity: 0;
        pointer-events: none;
        transition: opacity .18s ease, transform .18s ease;
    }

    .copy-toast.is-visible {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }


    /* =========================================================
       Chrome aligned with the shared glass system
       (surfaces, borders, Playfair titles, soft chips).
       Layout sizes and chat behaviour are unchanged.
    ========================================================= */

    .list-panel,
    .thread-panel {
        border-radius: 14px;
        border: 1px solid #cfe2ff;
        background: linear-gradient(135deg, #ffffffe0, #f5faffcc 55%, #fafdffe6);
        box-shadow: inset 0 1px 2px #ffffff, 0 12px 30px -12px #3b5bdb24;
    }

    .list-head { border-bottom-color: #e3edfc; }
    .list-head-title { font-family: 'Playfair Display', Georgia, serif; letter-spacing: -.4px; color: #0b084e; }
    .list-head-sub { color: #5877ac; }

    .list-filter-btn { border-color: #d7e8ff; background: #ffffffb8; color: #33477c; }
    .list-filter-btn:hover,
    .list-filter-btn.is-active { border-color: #1451ff; color: #1451ff; background: #eef4ff; }

    .list-search { border-bottom-color: #e3edfc; }
    .list-search input { border-color: #cfe0fb; background: #ffffffd9; color: #101d48; }
    .list-search input:focus { border-color: #6b8dff; box-shadow: 0 0 0 3px #3b4dff1f; }

    a.inbox-row:hover { background: #f1f7ffcc; }
    .inbox-row.is-selected { background: linear-gradient(110deg, #efeaffcc, #e6f1ffcc); box-shadow: inset 0 0 0 1px #cddfff; }
    .inbox-avatar { background: linear-gradient(135deg, #7224ff, #3735ff 55%, #087fff); }
    .inbox-name-row { color: #101d48; }
    .inbox-time { color: #8095c4; }
    .inbox-snippet { color: #5877ac; }
    .inbox-snippet.is-unread { color: #101d48; }
    .inbox-unread-dot { background: linear-gradient(110deg, #6425ff, #004dff 55%, #00a8f0); }

    .start-convo-card { border-radius: 12px; border: 1px solid #d6e6ff; background: radial-gradient(ellipse at 95% 100%, #c1ddff, transparent 65%), linear-gradient(120deg, #eff7ff, #e0eeff); }
    .start-convo-icon.icon-chip { width: 42px; height: 42px; margin: 0 auto 12px; background: linear-gradient(135deg, #e4eeff, #cce2ff); color: #135bff; }
    .start-convo-title { color: #101d48; }
    .start-convo-text { color: #52649b; }

    .thread-header { background: linear-gradient(120deg, #f3f8ffe6, #eef3ffd9); border-bottom-color: #e3edfc; }
    .thread-name { color: #101d48; }
    .thread-sub { color: #5877ac; }

    .thread-empty { color: #5877ac; }
    .thread-empty-state { display: flex; flex-direction: column; align-items: center; gap: 8px; max-width: 320px; padding: 20px; }
    .thread-empty-state .icon-chip { margin-bottom: 4px; }
    .thread-empty-title { font: 600 19px/1.3 'Playfair Display', Georgia, serif; color: #0b084e; }
    .thread-empty-state p { margin: 0; font-family: 'Inter', sans-serif; font-size: 12.5px; line-height: 1.6; color: #5877ac; }
    .thread-empty-state .btn { margin-top: 8px; height: 40px; }

}

<a href="/Dashboard" class="back-to-dashboard">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Back
</a>

<section class="page-hero">
    @await Html.PartialAsync("_HeroWaves")
    <div class="page-hero-intro">
        <p class="page-hero-eyebrow">Messages</p>
        <h1 class="page-hero-title">Your <span>Creator Inbox</span></h1>
        <p class="page-hero-sub">Every creator conversation, brief and deliverable in one inbox.</p>
        <dl class="page-hero-stats">
            <div><dd>@Model.TotalCount</dd><dt>Conversation@(Model.TotalCount == 1 ? "" : "s")</dt></div>
            <div><dd>@Model.TotalUnread</dd><dt>Unread message@(Model.TotalUnread == 1 ? "" : "s")</dt></div>
        </dl>
    </div>

    <div class="page-hero-art" aria-hidden="true">
        <div class="hero-glass hero-glass-back"></div>
        <div class="hero-glass hero-glass-front">
            <span class="hero-glass-copy">Chat.<br />Align.<br />Deliver.<span></span></span>
        </div>
        <span class="hero-sparkle"></span>
    </div>

    <div class="page-hero-motto">Real Creators.<br />Real Conversations.<span></span></div>
</section>

<div class="messages-shell">

    <div class="list-panel">

        <div class="list-head">
            <div>
                <div class="list-head-title">Your Conversations</div>
                <div class="list-head-sub">@Model.TotalCount conversation@(Model.TotalCount == 1 ? "" : "s")@(Model.TotalUnread > 0 ? $" · {Model.TotalUnread} new" : "")</div>
            </div>
            <button type="button" class="list-filter-btn" id="messagesFilterBtn" aria-label="Search conversations" title="Search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
        </div>

        <div class="list-search-wrap" id="messagesSearchWrap">
            <form method="get" action="/Messages" class="list-search">
                <input type="text" name="search" placeholder="Search creators or campaigns..." value="@Model.Search" />
                @if (selected is not null)
                {
                    <input type="hidden" name="open" value="@selected.Id" />
                }
            </form>
        </div>

        <div class="list-rows">
            @if (Model.TotalCount > 0)
            {
                @foreach (var conversation in Model.Conversations)
                {
                    var lastMessage = conversation.Messages.OrderByDescending(m => m.SentAt).FirstOrDefault();
                    var unread = Model.UnreadFor(conversation.Id);
                    var isSelected = selected is not null && conversation.Id == selected.Id;
                    var snippet = lastMessage is null
                        ? "No messages yet — say hello."
                        : (!string.IsNullOrEmpty(lastMessage.MediaUrl) && string.IsNullOrEmpty(lastMessage.Body)
                            ? (lastMessage.MediaType == "video" ? "Sent a video" : "Sent a photo")
                            : lastMessage.Body);
                    <a href="/Messages?open=@conversation.Id" class="inbox-row @(isSelected ? "is-selected" : "")" data-reveal>

                        <div class="inbox-avatar">
                            @FollowerFormat.InitialsOf(conversation.InfluencerProfile.FullName)
                        </div>

                        <div class="inbox-body">
                            <div class="inbox-name-row">
                                <div class="inbox-name-left">
                                    <span>@conversation.InfluencerProfile.FullName</span>
                                    @if (conversation.InfluencerProfile.Verified)
                                    {
                                        <span class="verified-badge">Verified</span>
                                    }
                                </div>
                                <span class="inbox-time">@((lastMessage?.SentAt ?? conversation.CreatedAt).ToBangladeshTime().ToString("MMM d"))</span>
                            </div>
                            <div class="inbox-snippet-row">
                                <div class="inbox-snippet @(unread > 0 ? "is-unread" : "")">@snippet</div>
                                @if (unread > 0)
                                {
                                    <span class="inbox-unread-dot">@unread</span>
                                }
                            </div>
                        </div>

                    </a>
                }
            }
            else if (!string.IsNullOrEmpty(Model.Search))
            {
                <div class="list-empty">No conversations match "@Model.Search".</div>
            }

            @if (string.IsNullOrEmpty(Model.Search))
            {
                <div class="start-convo-card">
                    <div class="start-convo-icon icon-chip soft">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
                    </div>
                    <div class="start-convo-title">@(Model.TotalCount > 0 ? "Start a new conversation" : "No conversations yet")</div>
                    <p class="start-convo-text">Message a creator to discuss a campaign, deliverable or collaboration opportunity.</p>
                    <a href="/Influencers" class="btn btn-secondary">Discover Influencers</a>
                </div>
            }
        </div>

    </div>

    <section class="thread-panel">

        @if (selected is not null)
        {
            var creator = selected.InfluencerProfile;
            <div class="thread-header">
                <div class="inbox-avatar" style="width:42px;height:42px;font-size:14px;">
                    @FollowerFormat.InitialsOf(creator.FullName)
                </div>
                <div>
                    <div class="thread-name">@creator.FullName</div>
                    <div class="thread-sub">@(selected.Campaign is not null ? selected.Campaign.Title : "General inquiry")</div>
                </div>

                <div class="thread-header-actions">
                    <button type="button" class="thread-icon-btn" disabled title="Voice calling isn't part of Brandora's messaging — use chat to coordinate" aria-label="Voice call unavailable">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8a15.6 15.6 0 0 0 6.6 6.6l2.2-2.2a1.5 1.5 0 0 1 1.5-.4 12 12 0 0 0 3.8.6 1.5 1.5 0 0 1 1.5 1.5V21a1.5 1.5 0 0 1-1.5 1.5A18.5 18.5 0 0 1 2.5 4.5 1.5 1.5 0 0 1 4 3h3.5A1.5 1.5 0 0 1 9 4.5a12 12 0 0 0 .6 3.8 1.5 1.5 0 0 1-.4 1.5L6.6 10.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    </button>
                    <button type="button" class="thread-icon-btn" disabled title="Video calling isn't part of Brandora's messaging — use chat to coordinate" aria-label="Video call unavailable">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="6" width="13" height="12" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M18.5 10.4 22 8v8l-3.5-2.4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    </button>
                    <button type="button" class="thread-icon-btn" id="profileInfoBtn" title="View profile" aria-label="View profile">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 11v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="8" r=".9" fill="currentColor"/></svg>
                    </button>
                </div>
            </div>

            <div class="thread-body" id="threadBody">
                @if (selectedMessages.Count > 0)
                {
                    @foreach (var message in selectedMessages)
                    {
                        var isMine = message.SenderUserId == currentUserId;
                        var hasMedia = !string.IsNullOrEmpty(message.MediaUrl);
                        var hasCaption = !string.IsNullOrEmpty(message.Body);
                        var canEdit = isMine && hasCaption && !hasMedia;
                        var showMenu = isMine || hasCaption || hasMedia;
                        <div class="msg-row @(isMine ? "is-mine" : "")">
                            @if (!isMine)
                            {
                                <div class="msg-avatar">@FollowerFormat.InitialsOf(creator.FullName)</div>
                            }
                            <div class="msg-col">
                                <div class="msg-bubble-row">
                                    <div class="msg-bubble-wrap" id="msgBubbleWrap-@message.Id">
                                        <div class="msg-bubble @(hasMedia ? "has-media" : "") @(hasMedia && hasCaption ? "has-caption" : "")">
                                            @if (hasMedia)
                                            {
                                                <div class="msg-media">
                                                    @if (message.MediaType == "video")
                                                    {
                                                        <video src="@message.MediaUrl" controls preload="metadata"></video>
                                                    }
                                                    else
                                                    {
                                                        <a href="@message.MediaUrl" target="_blank" rel="noopener noreferrer" class="msg-media-view" aria-label="View full-size attachment">
                                                            <img src="@message.MediaUrl" alt="Shared attachment" />
                                                        </a>
                                                    }
                                                    <a href="@message.MediaUrl" download="@System.IO.Path.GetFileName(message.MediaUrl)" class="msg-media-download" title="Download attachment" aria-label="Download attachment">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 18.5h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                                    </a>
                                                </div>
                                            }
                                            @if (hasCaption)
                                            {
                                                <span class="msg-caption">@message.Body</span>
                                            }
                                        </div>
                                    </div>

                                    @if (showMenu)
                                    {
                                        <div class="msg-menu-wrap" id="msgMenuWrap-@message.Id">
                                            <button type="button" class="msg-menu-btn" data-msg-menu-toggle="@message.Id" aria-label="Message options" aria-expanded="false">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="19" cy="12" r="1.9"/></svg>
                                            </button>
                                            <div class="msg-menu" id="msgMenu-@message.Id">
                                                @if (canEdit)
                                                {
                                                    <button type="button" class="msg-menu-item" data-msg-edit="@message.Id">Edit</button>
                                                }
                                                @if (hasCaption)
                                                {
                                                    <button type="button" class="msg-menu-item" data-msg-copy="@message.Id" data-copy-text="@message.Body">Copy</button>
                                                }
                                                @if (hasMedia)
                                                {
                                                    <button type="button" class="msg-menu-item" data-msg-copy="@(message.Id)-link" data-copy-text="@($"{Context.Request.Scheme}://{Context.Request.Host}{message.MediaUrl}")">Copy Link</button>
                                                }
                                                @if (isMine)
                                                {
                                                    <button type="button" class="msg-menu-item msg-menu-danger" data-msg-unsend="@message.Id">Unsend</button>
                                                    <form method="post" action="/Messages/DeleteMessage" class="msg-menu-unsend-form" id="msgUnsendForm-@message.Id" hidden>
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="messageId" value="@message.Id" />
                                                        <input type="hidden" name="conversationId" value="@selected.Id" />
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (canEdit)
                                {
                                    <form method="post" action="/Messages/EditMessage" class="msg-edit-form" id="msgEditForm-@message.Id" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="messageId" value="@message.Id" />
                                        <input type="hidden" name="conversationId" value="@selected.Id" />
                                        <textarea name="body" class="msg-edit-input">@message.Body</textarea>
                                        <div class="msg-edit-actions">
                                            <button type="button" class="msg-edit-cancel" data-msg-edit-cancel="@message.Id">Cancel</button>
                                            <button type="submit" class="msg-edit-save">Save</button>
                                        </div>
                                    </form>
                                }

                                <div class="msg-time">@message.SentAt.ToBangladeshTime().ToString("MMM d, h:mm tt")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="thread-empty">No messages yet &mdash; say hello to @creator.FullName.</div>
                }
            </div>

            @if (TempData["MessageError"] is string messageError)
            {
                <div class="composer-error">@messageError</div>
            }

            <div class="composer-preview" id="chatMediaPreview">
                <div class="composer-preview-media" id="chatMediaThumbWrap" hidden>
                    <img id="chatMediaThumb" alt="Selected attachment" />
                    <button type="button" class="composer-preview-remove" data-remove-attachment aria-label="Remove attachment">&times;</button>
                </div>
                <div class="composer-preview-file" id="chatMediaFileWrap" hidden>
                    <svg class="composer-preview-file-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v5h5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    <span class="composer-preview-name" id="chatMediaName"></span>
                    <button type="button" class="composer-preview-remove" data-remove-attachment aria-label="Remove attachment">&times;</button>
                </div>
            </div>

            <form class="thread-composer" method="post" action="/Messages/Send" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="conversationId" value="@selected.Id" />
                <input type="file" name="mediaFile" id="chatMediaInput" accept="image/*,video/*" hidden />
                <button type="button" class="composer-attach" id="chatAttachBtn" aria-label="Attach image or video">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 11.5L12.5 20a5 5 0 0 1-7-7l8-8a3.5 3.5 0 0 1 5 5l-8 8a2 2 0 0 1-3-3l7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <textarea name="body" placeholder="Write a message..."></textarea>
                <button type="submit" class="composer-send" aria-label="Send message">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 12L20 4L13 20L11 13L4 12Z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
                </button>
            </form>

            <div class="profile-drawer" id="profileDrawer">
                <button type="button" class="profile-drawer-close" id="profileDrawerClose" aria-label="Close profile">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>

                <div class="profile-avatar-wrap">
                    <div class="profile-avatar-ring">
                        <div class="inbox-avatar">@FollowerFormat.InitialsOf(creator.FullName)</div>
                    </div>
                    <div class="profile-name-row">
                        @creator.FullName
                        @if (creator.Verified)
                        {
                            <span class="verified-badge">Verified</span>
                        }
                    </div>
                    <div class="profile-handle">@creator.PrimaryPlatform &middot; @creator.PlatformUsername</div>
                </div>

                @if (!string.IsNullOrEmpty(creator.Bio))
                {
                    <div class="profile-section">
                        <div class="profile-label">Biography</div>
                        <p class="profile-bio">@creator.Bio</p>
                    </div>
                }

                <div class="profile-section">
                    <div class="profile-label">Focus</div>
                    <div class="profile-tags">
                        <span class="profile-tag">@creator.ContentNiche</span>
                        @if (!string.IsNullOrEmpty(creator.Location))
                        {
                            <span class="profile-tag">@creator.Location</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(creator.RateNote))
                {
                    <div class="profile-section">
                        <div class="profile-label">Rates</div>
                        <div class="profile-rate-box">@creator.RateNote</div>
                    </div>
                }

                <div class="profile-section">
                    <div class="profile-label">Reach</div>
                    <div class="profile-figures">
                        <div>
                            <div class="profile-figure-value">@FollowerFormat.Format(creator.Followers)</div>
                            <div class="profile-figure-label">Followers</div>
                        </div>
                        <div>
                            <div class="profile-figure-value">@creator.EngagementRate.ToString("0.0")%</div>
                            <div class="profile-figure-label">Engagement</div>
                        </div>
                    </div>
                </div>

                <a href="/Influencers/Profile/@creator.Id" class="profile-cta">View Full Profile</a>

            </div>
        }
        else
        {
            <div class="thread-empty thread-empty-state">
                <span class="icon-chip lg soft"><i class="bi bi-chat-square-text"></i></span>
                <div class="thread-empty-title">@(Model.TotalCount > 0 ? "Select a conversation" : "Your inbox is ready")</div>
                <p>@(Model.TotalCount > 0 ? "Pick a creator on the left to read and reply to your conversation." : "When you message a creator, your conversation appears here.")</p>
                @if (Model.TotalCount == 0)
                {
                    <a href="/Influencers" class="btn btn-primary">Discover Influencers</a>
                }
            </div>
        }

    </section>

</div>

<div class="confirm-modal-overlay" id="unsendConfirmOverlay" hidden>
    <div class="confirm-modal" role="alertdialog" aria-labelledby="unsendConfirmTitle" aria-describedby="unsendConfirmBody">
        <div class="confirm-modal-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 9v4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="16.5" r="1" fill="currentColor"/><path d="M10.3 3.9 2.5 17.5A1.8 1.8 0 0 0 4.1 20.2h15.8a1.8 1.8 0 0 0 1.6-2.7L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </div>
        <div class="confirm-modal-title" id="unsendConfirmTitle">Unsend this message?</div>
        <p class="confirm-modal-body" id="unsendConfirmBody">This removes it for everyone in the conversation. This action cannot be undone.</p>
        <div class="confirm-modal-actions">
            <button type="button" class="confirm-modal-cancel" id="unsendConfirmCancel">Cancel</button>
            <button type="button" class="confirm-modal-danger" id="unsendConfirmOk">Unsend</button>
        </div>
    </div>
</div>

<div class="copy-toast" id="copyToast">Copied</div>

@section Scripts {
    <script>
        (function () {
            var rows = document.querySelectorAll('.inbox-row[data-reveal]');
            if (rows.length) {
                if (!('IntersectionObserver' in window)) {
                    rows.forEach(function (r) { r.classList.add('is-visible'); });
                } else {
                    var observer = new IntersectionObserver(function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                observer.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

                    rows.forEach(function (row, index) {
                        row.style.transitionDelay = Math.min(index % 12, 8) * 35 + 'ms';
                        observer.observe(row);
                    });
                }
            }

            var filterBtn = document.getElementById('messagesFilterBtn');
            var searchWrap = document.getElementById('messagesSearchWrap');
            if (filterBtn && searchWrap) {
                var hasSearch = @(!string.IsNullOrEmpty(Model.Search) ? "true" : "false");
                if (hasSearch) {
                    searchWrap.classList.add('is-open');
                    filterBtn.classList.add('is-active');
                }
                filterBtn.addEventListener('click', function () {
                    var open = searchWrap.classList.toggle('is-open');
                    filterBtn.classList.toggle('is-active', open);
                    if (open) {
                        var input = searchWrap.querySelector('input[name="search"]');
                        if (input) input.focus();
                    }
                });
            }

            var infoBtn = document.getElementById('profileInfoBtn');
            var drawer = document.getElementById('profileDrawer');
            var drawerClose = document.getElementById('profileDrawerClose');
            if (infoBtn && drawer && drawerClose) {
                infoBtn.addEventListener('click', function () {
                    drawer.classList.add('is-open');
                    infoBtn.classList.add('is-active');
                });
                drawerClose.addEventListener('click', function () {
                    drawer.classList.remove('is-open');
                    infoBtn.classList.remove('is-active');
                });
            }

            var input = document.getElementById('chatMediaInput');
            var attachBtn = document.getElementById('chatAttachBtn');
            var preview = document.getElementById('chatMediaPreview');
            var previewName = document.getElementById('chatMediaName');
            var thumbWrap = document.getElementById('chatMediaThumbWrap');
            var thumbImg = document.getElementById('chatMediaThumb');
            var fileWrap = document.getElementById('chatMediaFileWrap');
            var threadBody = document.getElementById('threadBody');

            if (input) {
                attachBtn.addEventListener('click', function () { input.click(); });

                function clearThumb() {
                    if (thumbImg.src) {
                        URL.revokeObjectURL(thumbImg.src);
                        thumbImg.src = '';
                    }
                }

                input.addEventListener('change', function () {
                    var file = input.files && input.files[0];
                    if (!file) {
                        preview.style.display = 'none';
                        thumbWrap.hidden = true;
                        fileWrap.hidden = true;
                        clearThumb();
                        return;
                    }

                    if (file.type && file.type.indexOf('image/') === 0) {
                        clearThumb();
                        thumbImg.src = URL.createObjectURL(file);
                        thumbWrap.hidden = false;
                        fileWrap.hidden = true;
                    } else {
                        clearThumb();
                        previewName.textContent = file.name;
                        fileWrap.hidden = false;
                        thumbWrap.hidden = true;
                    }

                    preview.style.display = 'flex';
                });

                document.querySelectorAll('[data-remove-attachment]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        input.value = '';
                        preview.style.display = 'none';
                        thumbWrap.hidden = true;
                        fileWrap.hidden = true;
                        clearThumb();
                    });
                });
            }

            if (threadBody) {
                threadBody.scrollTop = threadBody.scrollHeight;
            }

            // Message actions: 3-dot menu (Edit / Copy / Unsend)
            function closeAllMsgMenus() {
                document.querySelectorAll('.msg-menu-wrap.is-open').forEach(function (wrap) {
                    wrap.classList.remove('is-open');
                    var btn = wrap.querySelector('.msg-menu-btn');
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                });
            }

            document.querySelectorAll('[data-msg-menu-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var wrap = btn.closest('.msg-menu-wrap');
                    var wasOpen = wrap.classList.contains('is-open');
                    closeAllMsgMenus();
                    if (!wasOpen) {
                        wrap.classList.add('is-open');
                        btn.setAttribute('aria-expanded', 'true');
                    }
                });
            });

            document.addEventListener('click', closeAllMsgMenus);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeAllMsgMenus();
            });

            var copyToast = document.getElementById('copyToast');
            var copyToastTimer;

            document.querySelectorAll('[data-msg-copy]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var text = btn.getAttribute('data-copy-text') || '';
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text);
                    }
                    if (copyToast) {
                        copyToast.classList.add('is-visible');
                        clearTimeout(copyToastTimer);
                        copyToastTimer = setTimeout(function () { copyToast.classList.remove('is-visible'); }, 1400);
                    }
                    closeAllMsgMenus();
                });
            });

            document.querySelectorAll('[data-msg-edit]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-msg-edit');
                    var bubbleWrap = document.getElementById('msgBubbleWrap-' + id);
                    var form = document.getElementById('msgEditForm-' + id);
                    if (bubbleWrap && form) {
                        bubbleWrap.hidden = true;
                        form.hidden = false;
                        var ta = form.querySelector('textarea');
                        if (ta) {
                            ta.focus();
                            ta.setSelectionRange(ta.value.length, ta.value.length);
                        }
                    }
                    closeAllMsgMenus();
                });
            });

            document.querySelectorAll('[data-msg-edit-cancel]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-msg-edit-cancel');
                    var bubbleWrap = document.getElementById('msgBubbleWrap-' + id);
                    var form = document.getElementById('msgEditForm-' + id);
                    if (bubbleWrap && form) {
                        form.hidden = true;
                        bubbleWrap.hidden = false;
                    }
                });
            });

            // Unsend warning box (replaces the native browser confirm())
            var unsendOverlay = document.getElementById('unsendConfirmOverlay');
            var unsendCancelBtn = document.getElementById('unsendConfirmCancel');
            var unsendOkBtn = document.getElementById('unsendConfirmOk');
            var pendingUnsendId = null;

            function closeUnsendConfirm() {
                if (unsendOverlay) unsendOverlay.hidden = true;
                pendingUnsendId = null;
            }

            if (unsendOverlay && unsendCancelBtn && unsendOkBtn) {
                document.querySelectorAll('[data-msg-unsend]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        pendingUnsendId = btn.getAttribute('data-msg-unsend');
                        unsendOverlay.hidden = false;
                        closeAllMsgMenus();
                    });
                });

                unsendCancelBtn.addEventListener('click', closeUnsendConfirm);

                unsendOverlay.addEventListener('click', function (e) {
                    if (e.target === unsendOverlay) closeUnsendConfirm();
                });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && !unsendOverlay.hidden) closeUnsendConfirm();
                });

                unsendOkBtn.addEventListener('click', function () {
                    if (pendingUnsendId) {
                        var form = document.getElementById('msgUnsendForm-' + pendingUnsendId);
                        if (form) form.submit();
                    }
                    closeUnsendConfirm();
                });
            }
        })();
    </script>
}
