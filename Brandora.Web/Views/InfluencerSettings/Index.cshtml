@model Brandora.Web.Models.Dashboard.InfluencerSettingsViewModel
@using Brandora.Web.Models.Domain
@using Brandora.Web.Models.Influencers
@{
    ViewData["Title"] = "Profile Settings";
    ViewData["ActiveNav"] = "Settings";
    Layout = null;

    var bio = Model.Form.Bio ?? string.Empty;
    var profileErrors = (TempData["ProfileErrors"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
    <style>
        * {
            box-sizing: border-box;
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-button,
        ::-webkit-scrollbar-button:single-button,
        ::-webkit-scrollbar-button:vertical:start,
        ::-webkit-scrollbar-button:vertical:end,
        ::-webkit-scrollbar-button:horizontal:start,
        ::-webkit-scrollbar-button:horizontal:end,
        ::-webkit-scrollbar-button:increment,
        ::-webkit-scrollbar-button:decrement {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
            background: transparent !important;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #d3d9ec;
            border-radius: 10px;
            border: 2px solid transparent;
            background-clip: padding-box;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #b7c0e0;
            background-clip: padding-box;
        }

        html {
            scrollbar-width: thin;
            scrollbar-color: #d3d9ec transparent;
        }

        body {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            background: #ffffff;
            color: #20283a;
            overflow-x: hidden;
        }

        /* ==============================
           SIDEBAR (shared with dashboard)
        ============================== */

        .sidebar {
            position: fixed;
            width: 230px;
            height: 100vh;
            left: 0;
            top: 0;
            padding: 16px 12px;
            background:
                radial-gradient(circle at 0% 30%, rgba(139, 34, 255, .18), transparent 30%),
                linear-gradient(180deg, #070c22 0%, #0a1028 100%);
            color: white;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,.06);
            z-index: 1000;

            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.15) transparent;

            transition: transform .25s ease;
        }

        .sidebar.is-hidden {
            transform: translateX(-100%);
        }

        .brand {
            display: flex;
            align-items: center;
            padding: 0 12px 6px;
        }

        .sidebar-wave-img {
            position: absolute;
            left: 0;
            bottom: 60px;
            width: 100%;
            height: auto;
            pointer-events: none;
            z-index: -1;
            opacity: .9;
        }

        .brand-logo-img {
            height: 44px;
            width: auto;
            display: block;
        }

        .sidebar-nav-wrap {
            position: relative;
            flex: 1;
            min-height: 0;
            margin-top: 14px;
        }

        .sidebar-nav-wrap::before {
            content: "";
            position: absolute;
            top: -34px;
            left: -34px;
            right: -34px;
            bottom: 0;
            z-index: -1;
            pointer-events: none;

            background:
                radial-gradient(circle at 12% 5%, rgba(35,110,234,.2), transparent 30%),
                radial-gradient(circle at 88% 14%, rgba(163,38,255,.18), transparent 32%),
                radial-gradient(circle at 18% 50%, rgba(24,169,255,.16), transparent 30%),
                radial-gradient(circle at 85% 62%, rgba(163,38,255,.14), transparent 32%),
                radial-gradient(circle at 30% 90%, rgba(35,110,234,.16), transparent 34%);

            filter: blur(14px);
        }

        .sidebar-nav-glass {
            position: relative;

            padding: 0;

            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.12);

            background: rgba(255,255,255,.03);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);

            box-shadow: 0 8px 30px rgba(0,0,0,.18);
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar-menu li {
            margin-bottom: 2px;
        }

        .sidebar-menu a {
            color: #d9dce8;
            text-decoration: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 400;
            transition: background .2s ease, color .2s ease, transform .1s ease;
        }

        .sidebar-menu a:hover {
            background: rgba(255,255,255,.06);
            color: white;
        }

        .sidebar-menu a:active {
            transform: scale(.98);
            background: rgba(255,255,255,.1);
        }

        .sidebar-menu .active:hover,
        .sidebar-menu .active:active {
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
        }

        .nav-chevron {
            font-size: 15px;
            opacity: 0;
            transition: .2s ease;
        }

        .sidebar-menu .active {
            color: white;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.35),
                inset 0 0 0 1px rgba(255,255,255,.18),
                0 8px 25px rgba(106, 37, 213, .25);
        }

        .sidebar-menu .active .nav-chevron {
            opacity: 1;
        }

        .sidebar-bottom {
            margin-top: auto;
            padding: 12px 8px 0;
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 10px;
            min-width: 0;
        }

        .sidebar-user > div {
            min-width: 0;
        }

        .avatar-circle {
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            flex-shrink: 0;
            background: linear-gradient(145deg, #c93cff, #4e38ff 55%, #159cff);
            color: #ffffff;
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
        }

        .avatar-circle.small {
            width: 36px;
            height: 36px;
            font-size: 12px;
            border: 2px solid rgba(255,255,255,.12);
        }

        .sidebar-user h6 {
            margin: 0 0 4px;
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-user span {
            color: #afb4c6;
            font-size: 13px;
        }

        .logout-btn {
            width: 100%;
            padding: 10px;
            border: 0;
            border-top: 1px solid rgba(255,255,255,.08);
            background: transparent;
            color: #dce0ea;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            cursor: pointer;
        }

        .logout-btn i {
            margin-right: 10px;
            font-size: 16px;
        }

        .logout-btn:hover {
            color: white;
        }

        /* ==============================
           MAIN CONTENT
        ============================== */

        .main-content {
            margin-left: 230px;
            min-height: 100vh;
            padding: 24px 26px;
            background: #ffffff;

            transition: margin-left .25s ease;
        }

        .main-content.sidebar-hidden {
            margin-left: 0;
        }

        /* .main-content pads 24px 26px but the dashboard pads 12px 20px; pull the shared
           topbar back to the dashboard's inset so both bars sit identically. */
        .settings-page .dashboard-topbar {
            margin: -12px -6px 12px;
        }

        /* ==============================
           PAGE HEADER
        ============================== */

        .ps-page-title {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 700;
            color: #101a42;
        }

        .ps-page-sub {
            margin-top: 5px;
            color: #56617f;
            font-size: 13.5px;
            margin-bottom: 24px;
        }

        /* ==============================
           LAYOUT
        ============================== */

        .ps-grid {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 20px;
            align-items: start;
        }

        .ps-card {
            background: #ffffff;
            border: 1px solid #e7e9f5;
            border-radius: 16px;
        }

        /* Settings nav */

        .ps-nav {
            padding: 10px;
        }

        .ps-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 12px;
            text-decoration: none;
            color: inherit;
            cursor: pointer;
            margin-bottom: 2px;
            transition: background .15s ease;
        }

        .ps-nav-item:hover {
            background: #f6f7fc;
        }

        .ps-nav-item.is-active {
            background: linear-gradient(105deg, rgba(163,38,255,.1), rgba(24,169,255,.08));
            border: 1px solid #e3d9ff;
        }

        .ps-nav-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 15px;
            background: #f1f2f8;
            color: #56617f;
        }

        .ps-nav-item.is-active .ps-nav-icon {
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
        }

        .ps-nav-title {
            font-size: 13.5px;
            font-weight: 400;
            color: #101a42;
        }

        .ps-nav-item.is-active .ps-nav-title {
            color: #6322d4;
        }

        .ps-nav-desc {
            font-size: 12px;
            color: #8a93ad;
            margin-top: 2px;
        }

        .ps-nav-item.is-active .ps-nav-desc {
            color: #7a4fd6;
        }

        .ps-help-card {
            margin-top: 16px;
            padding: 22px;
        }

        .ps-help-top {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 14px;
        }

        .ps-help-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: linear-gradient(135deg, #a326ff, #6a3cff 55%, #18a9ff);
            color: #ffffff;
            font-size: 18px;
            font-weight: 700;
        }

        .ps-help-title {
            font-size: 16px;
            font-weight: 700;
            color: #101a42;
        }

        .ps-help-desc {
            font-size: 13px;
            color: #7c8ab0;
            line-height: 1.6;
            text-align: center;
            margin: 0 0 18px;
        }

        .ps-support-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            margin: 0;
            border: 1px solid #d7dae5;
            background: #ffffff;
            color: #3a1fb5;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 13.5px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }

        .ps-support-btn:hover {
            border-color: #9b2cff;
            color: #6322d4;
        }

        /* Profile information panel */

        .ps-panel {
            padding: 26px 28px;
        }

        .ps-panel-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        .ps-panel-title {
            font-size: 17px;
            font-weight: 700;
            color: #101a42;
        }

        .ps-panel-sub {
            font-size: 13px;
            color: #7c8ab0;
            margin-top: 4px;
        }

        .ps-photo-row {
            display: flex;
            align-items: center;
            gap: 18px;
            padding-bottom: 22px;
            margin-bottom: 22px;
            border-bottom: 1px solid #eef0f8;
        }

        .ps-photo-avatar-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .avatar-circle.large {
            width: 76px;
            height: 76px;
            font-size: 24px;
        }

        .ps-photo-camera {
            position: absolute;
            right: -2px;
            bottom: -2px;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            border: 2px solid #ffffff;
        }

        .ps-photo-name {
            font-size: 14.5px;
            font-weight: 700;
            color: #101a42;
        }

        .ps-photo-hint {
            font-size: 12px;
            color: #8a93ad;
            margin: 3px 0 10px;
        }

        .ps-change-photo-btn {
            display: inline-block;
            border: 1px solid #dce7ff;
            background: #ffffff;
            color: #0759ff;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .ps-change-photo-btn:hover {
            border-color: #176cff;
        }

        .ps-change-photo-btn.is-remove {
            border-color: #f1ccd3;
            color: #c22540;
        }

        .ps-change-photo-btn.is-remove:hover {
            border-color: #c22540;
        }

        #picturePreview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }

        .ps-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px 20px;
            margin-bottom: 18px;
        }

        .ps-form-group {
            display: flex;
            flex-direction: column;
        }

        .ps-form-group.full {
            grid-column: 1 / -1;
        }

        .ps-form-group label {
            font-size: 12.5px;
            font-weight: 700;
            color: #3a4360;
            margin-bottom: 8px;
        }

        .ps-form-group input,
        .ps-form-group select,
        .ps-form-group textarea {
            border: 1px solid #dce7ff;
            border-radius: 10px;
            padding: 11px 13px;
            font-size: 13.5px;
            font-family: 'DM Sans', sans-serif;
            color: #20283a;
            outline: 0;
            width: 100%;
            transition: border-color .2s ease;
        }

        .ps-form-group input:focus,
        .ps-form-group select:focus,
        .ps-form-group textarea:focus {
            border-color: #9b2cff;
        }

        .ps-form-hint {
            font-size: 11.5px;
            color: #8a93ad;
            margin-top: 6px;
        }

        .ps-input-icon-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .ps-input-icon-wrap i,
        .ps-input-icon-wrap .ps-flag {
            position: absolute;
            left: 13px;
            color: #8a93ad;
            font-size: 14px;
            pointer-events: none;
        }

        .ps-input-icon-wrap input {
            padding-left: 36px;
        }

        .ps-form-group select {
            appearance: none;
            -webkit-appearance: none;
            background-image: none;
            cursor: pointer;
        }

        .ps-select-wrap {
            position: relative;
        }

        .ps-select-wrap i {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #8a93ad;
            font-size: 12px;
            pointer-events: none;
        }

        /* Custom dropdown (category / niche) */

        .ps-dropdown {
            position: relative;
        }

        .ps-dropdown-trigger {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            border: 1px solid #dce7ff;
            border-radius: 10px;
            padding: 11px 13px;
            font-size: 13.5px;
            font-family: 'DM Sans', sans-serif;
            color: #20283a;
            background: #ffffff;
            cursor: pointer;
            text-align: left;
            transition: border-color .2s ease;
        }

        .ps-dropdown-trigger:hover {
            border-color: #b7c0e0;
        }

        .ps-dropdown.is-open .ps-dropdown-trigger {
            border-color: #9b2cff;
        }

        .ps-dropdown-trigger span.is-placeholder {
            color: #8a93ad;
        }

        .ps-dropdown-trigger i {
            color: #8a93ad;
            font-size: 12px;
            flex-shrink: 0;
            transition: transform .2s ease;
        }

        .ps-dropdown.is-open .ps-dropdown-trigger i {
            transform: rotate(180deg);
            color: #6322d4;
        }

        .ps-dropdown-panel {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: 0;
            z-index: 20;
            max-height: 260px;
            overflow-y: auto;
            background: #ffffff;
            border: 1px solid #e7e9f5;
            border-radius: 12px;
            padding: 6px;
            box-shadow: 0 16px 36px rgba(35,72,160,.14);
        }

        .ps-dropdown.is-open .ps-dropdown-panel {
            display: block;
        }

        .ps-dropdown-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 13.5px;
            color: #3a4360;
            cursor: pointer;
            transition: background .15s ease;
        }

        .ps-dropdown-option:hover {
            background: #f6f7fc;
        }

        .ps-dropdown-option i {
            font-size: 13px;
            color: #6322d4;
            opacity: 0;
        }

        .ps-dropdown-option.is-selected {
            background: linear-gradient(105deg, rgba(163,38,255,.08), rgba(24,169,255,.06));
            color: #6322d4;
            font-weight: 600;
        }

        .ps-dropdown-option.is-selected i {
            opacity: 1;
        }

        .ps-textarea-wrap {
            position: relative;
        }

        .ps-textarea-wrap textarea {
            resize: vertical;
            min-height: 90px;
        }

        .ps-char-count {
            position: absolute;
            right: 13px;
            bottom: 10px;
            font-size: 11px;
            color: #b7c0e0;
            background: #ffffff;
            padding-left: 4px;
        }

        .ps-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 22px;
        }

        .ps-cancel-btn {
            border: 1px solid #dce7ff;
            background: #f6f7fc;
            color: #56617f;
            padding: 11px 22px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .ps-save-btn {
            border: 0;
            color: white;
            padding: 11px 24px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            cursor: pointer;
            transition: .2s;
        }

        .ps-save-btn:hover {
            transform: translateY(-2px);
        }

        .ps-saved-note {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #e2faf1;
            color: #0d9c6c;
            border: 1px solid #c7f2e2;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 18px;
        }

        /* ==============================
           RESPONSIVE
        ============================== */

        @@media(max-width: 1100px) {
            .sidebar {
                width: 220px;
            }

            .main-content {
                margin-left: 220px;
            }
        }

        @@media(max-width: 980px) {
            .ps-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width: 900px) {
            .sidebar {
                transform: translateX(-100%);
                box-shadow: 0 0 40px rgba(0,0,0,.35);
            }

            .sidebar.is-open {
                transform: translateX(0);
            }

            .sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(5,6,20,.5);
                z-index: 999;
            }

            .sidebar-backdrop.is-visible {
                display: block;
            }

            .main-content {
                margin-left: 0;
            }
        }

        @@media(max-width: 640px) {
            .main-content {
                padding: 18px 14px;
            }

            .ps-panel {
                padding: 18px;
            }

            .ps-form-grid {
                grid-template-columns: 1fr;
            }

            .ps-panel-head {
                flex-direction: column;
                gap: 12px;
            }

            .ps-photo-row {
                flex-wrap: wrap;
            }
        }

        .main-content { background: radial-gradient(ellipse at 66% 2%,#dceeff88,transparent 50%),linear-gradient(130deg,#f3faff,#f7fbff 65%,#edf6ff); color: #101d48; }
        .ps-page-title { background: linear-gradient(115deg,#7224ff,#3735ff 55%,#087fff); background-clip: text; -webkit-background-clip: text; color: transparent; }
        .ps-card { border-color: #d6e4f9; box-shadow: 0 4px 18px #28477c08; }
        .ps-panel-sub, .ps-page-sub, .ps-form-hint { color: #5871a8; }
        .ps-save-btn, .browse-btn, .ps-nav-item.is-active .ps-nav-icon { background: linear-gradient(110deg,#6323ff,#0759ff); }
        .ps-save-btn { text-decoration: none; display: inline-flex; align-items: center; }
        .ps-nav-icon svg { width: 19px; height: 19px; }
        .ps-nav-item { border: 1px solid transparent; }
        [data-settings-panel] { margin-bottom: 18px; min-width: 0; }
        [data-settings-panel][hidden] { display: none; }
        .ps-setting-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; padding: 18px 0; border-bottom: 1px solid #e6edf8; margin-bottom: 18px; font-size: 14px; overflow-wrap: anywhere; }
        .ps-setting-row p { color: #5871a8; margin: 6px 0 0; font-size: 13px; }
        .ps-status { background: #edf2ff; color: #4937c5; padding: 6px 10px; border-radius: 20px; font-size: 12px; }
        .ps-grid > * { min-width: 0; }
        .ps-actions { flex-wrap: wrap; }
        :is(a,button,input,textarea):focus-visible { outline: 3px solid #7862ef; outline-offset: 3px; }
    </style>
</head>

<body>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- ================= SIDEBAR ================= -->

    @await Html.PartialAsync("_InfluencerSidebar")


    <!-- ================= MAIN ================= -->

    <main class="main-content settings-page" id="dashboardMain">

        <!-- TOP BAR -->

        <header class="dashboard-topbar">
            <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
            <form class="dashboard-search" method="get" asp-controller="InfluencerCampaigns" asp-action="Index" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" name="search" placeholder="Search campaigns, brands..." aria-label="Search campaigns and brands" />
                <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
            </form>
            <details class="dashboard-notifications">
                <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
                <div class="dashboard-notification-panel">
                    <div class="dashboard-notification-panel-head">
                        <h2>Notifications</h2>
                        @if (Model.Notifications.Count > 0)
                        {
                            <form method="post" asp-controller="Notifications" asp-action="ClearAll">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="dashboard-notification-clear">Clear</button>
                            </form>
                        }
                    </div>
                    @foreach (var notification in Model.Notifications)
                    {
                        <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                    }
                    @if (Model.Notifications.Count == 0) { <p>No notifications yet.</p> }
                </div>
            </details>
            <a class="dashboard-account" href="/InfluencerSettings">
                <span class="dashboard-avatar">@if (!string.IsNullOrEmpty(Model.Profile.ProfilePictureUrl)) { <img src="@Model.Profile.ProfilePictureUrl" alt="" /> } else { @FollowerFormat.InitialsOf(Model.Profile.FullName) }</span>
                <span><strong>@Model.Profile.FullName</strong><small>Influencer</small></span>
                <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </a>
        </header>



        <!-- ================= PAGE HEADER ================= -->

        <div class="ps-page-title">Profile Settings</div>
        <div class="ps-page-sub">Manage your profile information and account preferences</div>


        <!-- ================= LAYOUT ================= -->

        <div class="ps-grid">

            <!-- SETTINGS NAV -->

            <div>
                <div class="ps-card ps-nav">

                    <a href="#profile" class="ps-nav-item is-active" data-settings-nav aria-controls="profile">
<span class="ps-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></span>
<span class="ps-nav-title">Profile Information</span>
</a>

                    <a href="#security" class="ps-nav-item" data-settings-nav aria-controls="security">
<span class="ps-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
<span class="ps-nav-title">Account &amp; Security</span>
</a>

                    <a href="#notifications" class="ps-nav-item" data-settings-nav aria-controls="notifications">
<span class="ps-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 13 6 9Z"/><path d="M10 18a2 2 0 0 0 4 0"/></svg></span>
<span class="ps-nav-title">Notification Settings</span>
</a>

                    <a href="#privacy" class="ps-nav-item" data-settings-nav aria-controls="privacy">
<span class="ps-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg></span>
<span class="ps-nav-title">Privacy Settings</span>
</a>

                    <a href="#payments" class="ps-nav-item" data-settings-nav aria-controls="payments">
<span class="ps-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg></span>
<span class="ps-nav-title">Payment Information</span>
</a>

                    <a href="#connections" class="ps-nav-item" data-settings-nav aria-controls="connections">
<span class="ps-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 13 4-4M8 16l-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0M16 8l1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0"/></svg></span>
<span class="ps-nav-title">Connected Accounts</span>
</a>

                </div>

                <div class="ps-card ps-help-card">
                    <div class="ps-help-top">
                        <div class="ps-help-icon">?</div>
                        <div class="ps-help-title">Need Help?</div>
                    </div>
                    <div class="ps-help-desc">If you need any assistance, our support team is here to help.</div>
                    <a href="#" class="ps-support-btn">Contact Support <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>


            <!-- PROFILE INFORMATION PANEL -->

            <div>
<div class="ps-card ps-panel" id="profile" data-settings-panel>

                <div class="ps-panel-head">
                    <div>
                        <div class="ps-panel-title">Profile Information</div>
                        <div class="ps-panel-sub">Update your personal information and how others see you on Brandora.</div>
                    </div>
                </div>

                @if (ViewData["ProfileSaved"] is not null)
                {
                    <div class="ps-saved-note"><i class="bi bi-check-circle-fill"></i> Profile updated successfully.</div>
                }
                @if (profileErrors.Length > 0)
                {
                    <div class="ps-saved-note" style="background:#fdecef;color:#c22540;">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@string.Join(" ", profileErrors)</span>
                    </div>
                }

                <form method="post" action="/InfluencerSettings/Update" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="ps-photo-row">
                        <div class="ps-photo-avatar-wrap">
                            <div class="avatar-circle large" id="picturePreview">
                                @if (!string.IsNullOrEmpty(Model.Profile.ProfilePictureUrl))
                                {
                                    <img src="@Model.Profile.ProfilePictureUrl" alt="Profile picture" id="picturePreviewImg" />
                                }
                                else
                                {
                                    <span id="picturePreviewInitial">@FollowerFormat.InitialsOf(Model.Profile.FullName)</span>
                                }
                            </div>
                            <span class="ps-photo-camera"><i class="bi bi-camera-fill"></i></span>
                        </div>

                        <div>
                            <div class="ps-photo-name">@Model.Profile.FullName</div>
                            <div class="ps-photo-hint">JPG, PNG or WebP &middot; up to 5MB</div>
                            <div class="ps-photo-actions" style="display:flex;flex-wrap:wrap;gap:8px;">
                                <label for="ProfilePictureFile" class="ps-change-photo-btn" tabindex="0">
                                    @(string.IsNullOrEmpty(Model.Profile.ProfilePictureUrl) ? "Upload Photo" : "Change Photo")
                                </label>
                                <input type="file" id="ProfilePictureFile" name="ProfilePictureFile" accept="image/jpeg,image/png,image/webp" hidden />
                                @if (!string.IsNullOrEmpty(Model.Profile.ProfilePictureUrl))
                                {
                                    <button type="submit" name="RemoveProfilePicture" value="true" class="ps-change-photo-btn is-remove">Remove Photo</button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="ps-form-grid">

                        <div class="ps-form-group">
                            <label for="fullName">Full Name</label>
                            <input type="text" id="fullName" name="FullName" value="@Model.Form.FullName" />
                        </div>

                        <div class="ps-form-group">
                            <label for="userName">Username</label>
                            <input type="text" id="userName" name="UserName" value="@Model.Form.UserName" disabled />
                            <div class="ps-form-hint">This is how others will see you.</div>
                        </div>

                        <div class="ps-form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="Email" value="@Model.Form.Email" disabled />
                        </div>

                        <div class="ps-form-group">
                            <label for="phone">Phone Number</label>
                            <div class="ps-input-icon-wrap">
                                <i class="bi bi-telephone-fill"></i>
                                <input type="text" id="phone" name="PhoneNumber" value="@Model.Form.PhoneNumber" placeholder="+880 1XXX XXXXXX" />
                            </div>
                        </div>

                        <div class="ps-form-group">
                            <label for="location">Location</label>
                            <div class="ps-input-icon-wrap">
                                <i class="bi bi-geo-alt-fill"></i>
                                <input type="text" id="location" name="Location" value="@Model.Form.Location" placeholder="City, Country" />
                            </div>
                        </div>

                        <div class="ps-form-group">
                            <label for="nicheTrigger">Category / Niche</label>
                            <div class="ps-dropdown" id="nicheDropdown">
                                <input type="hidden" name="ContentNiche" id="nicheValue" value="@Model.Form.ContentNiche" />

                                <button type="button" class="ps-dropdown-trigger" id="nicheTrigger">
                                    <span id="nicheTriggerLabel" class="@(string.IsNullOrEmpty(Model.Form.ContentNiche) ? "is-placeholder" : "")">@(string.IsNullOrEmpty(Model.Form.ContentNiche) ? "Select a category" : Model.Form.ContentNiche)</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>

                                <div class="ps-dropdown-panel" id="nicheOptions">
                                    @foreach (var niche in new[] { "Fashion & Style", "Beauty & Skincare", "Food & Cooking", "Travel & Lifestyle", "Fitness & Health", "Gaming", "Tech & Gadgets", "Education", "Comedy & Entertainment", "Home & Lifestyle", "Finance", "Other" })
                                    {
                                        <div class="ps-dropdown-option @(Model.Form.ContentNiche == niche ? "is-selected" : "")" data-value="@niche">
                                            @niche
                                            <i class="bi bi-check-lg"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="ps-form-group full">
                            <label for="bio">Bio</label>
                            <div class="ps-textarea-wrap">
                                <textarea id="bio" name="Bio" maxlength="200" oninput="document.getElementById('bioCount').textContent = this.value.length">@bio</textarea>
                                <span class="ps-char-count"><span id="bioCount">@bio.Length</span>/200</span>
                            </div>
                        </div>

                        <div class="ps-form-group full">
                            <label for="website">Website (Optional)</label>
                            <div class="ps-input-icon-wrap">
                                <i class="bi bi-link-45deg"></i>
                                <input type="url" id="website" name="WebsiteUrl" value="@Model.Form.WebsiteUrl" placeholder="https://yourwebsite.com" />
                            </div>
                        </div>

                    </div>

                    <div class="ps-actions">
                        <a href="/InfluencerSettings" class="ps-cancel-btn">Cancel</a>
                        <button type="submit" class="ps-save-btn">Save Changes</button>
                    </div>

                </form>

            </div>


            <section class="ps-card ps-panel" id="security" data-settings-panel aria-labelledby="security-title">
                <h2 class="ps-panel-title" id="security-title">Account &amp; Security</h2>
                <p class="ps-panel-sub">Manage the password you use to sign in to Brandora.</p>
                <div class="ps-setting-row"><span>Email address</span><strong>@Model.Form.Email</strong></div>
                @if (TempData["PasswordMessage"] is string passwordMessage)
                {
                    <div class="alert alert-info" role="status">@passwordMessage</div>
                }
                <form method="post" action="/InfluencerSettings/ChangePassword">
                    @Html.AntiForgeryToken()
                    <div class="ps-form-grid">
                        <div class="ps-form-group full"><label for="currentPassword">Current password</label><input id="currentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required /></div>
                        <div class="ps-form-group"><label for="newPassword">New password</label><input id="newPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="8" required /></div>
                        <div class="ps-form-group"><label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="ConfirmNewPassword" type="password" autocomplete="new-password" minlength="8" required /></div>
                    </div>
                    <div class="ps-actions"><button class="ps-save-btn" type="submit">Update Password</button></div>
                </form>
            </section>
            <section class="ps-card ps-panel" id="notifications" data-settings-panel aria-labelledby="notifications-title">
                <h2 class="ps-panel-title" id="notifications-title">Notification Settings</h2>
                <p class="ps-panel-sub">Stay up to date with your activity on Brandora.</p>
                <div class="ps-setting-row"><div><strong>In-app notifications</strong><p>View your latest account updates on the dashboard.</p></div><span class="ps-status">@ViewData["UnreadNotifications"] unread</span></div>
                <div class="ps-setting-row"><div><strong>Email and push preferences</strong><p>Custom notification preferences are not available yet.</p></div></div>
                <a href="/InfluencerDashboard" class="ps-cancel-btn">View Dashboard</a>
            </section>
            <section class="ps-card ps-panel" id="privacy" data-settings-panel aria-labelledby="privacy-title">
                <h2 class="ps-panel-title" id="privacy-title">Privacy Settings</h2>
                <p class="ps-panel-sub">Review the information you share on your creator profile.</p>
                <div class="ps-setting-row"><div><strong>Profile information</strong><p>Manage your bio, location, niche, and website in Profile Information.</p></div></div>
                <div class="ps-setting-row"><div><strong>Profile visibility</strong><p>Custom profile visibility controls are not available yet.</p></div></div>
                <a href="/Home/Privacy" class="ps-cancel-btn">Read Privacy Policy</a>
            </section>
            <section class="ps-card ps-panel" id="payments" data-settings-panel aria-labelledby="payments-title">
                <h2 class="ps-panel-title" id="payments-title">Payment Information</h2>
                <p class="ps-panel-sub">Keep track of your campaign earnings and payments.</p>
                <div class="ps-setting-row"><div><strong>Payout methods</strong><p>Adding or changing bank and mobile wallet details is not available here yet.</p></div></div>
                <div class="ps-actions"><a href="/InfluencerPayments" class="ps-cancel-btn">Payment History</a><a href="/InfluencerEarnings" class="ps-save-btn">View Earnings</a></div>
            </section>
            <section class="ps-card ps-panel" id="connections" data-settings-panel aria-labelledby="connections-title">
                <h2 class="ps-panel-title" id="connections-title">Connected Accounts</h2>
                <p class="ps-panel-sub">Your social profile information supplied during registration.</p>
                <div class="ps-setting-row"><div><strong>@(string.IsNullOrWhiteSpace(Model.Profile.PrimaryPlatform) ? "No platform added" : Model.Profile.PrimaryPlatform)</strong><p>@Model.Profile.PlatformUsername</p></div><span class="ps-status">Profile details</span></div>
                <p class="ps-panel-sub">Social account authorization and connecting additional platforms are not available yet.</p>
            </section>
            </div>

        </div>

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>

    <script>

        (function () {
            var fileInput = document.getElementById('ProfilePictureFile');
            var label = document.querySelector('label[for="ProfilePictureFile"]');
            var preview = document.getElementById('picturePreview');

            if (!fileInput || !preview) return;

            var MAX_BYTES = 5 * 1024 * 1024;
            var ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp'];

            if (label) {
                label.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        fileInput.click();
                    }
                });
            }

            fileInput.addEventListener('change', function () {
                var file = fileInput.files && fileInput.files[0];
                if (!file) return;

                if (ALLOWED_TYPES.indexOf(file.type) === -1) {
                    alert('Please choose a JPG, PNG, or WEBP image.');
                    fileInput.value = '';
                    return;
                }

                if (file.size > MAX_BYTES) {
                    alert('That image is larger than 5MB. Please choose a smaller file.');
                    fileInput.value = '';
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="Selected profile picture" />';
                };
                reader.readAsDataURL(file);
            });
        })();

        (function () {
            var links = document.querySelectorAll('[data-settings-nav]');
            var panels = document.querySelectorAll('[data-settings-panel]');
            function showSection() {
                var id = window.location.hash.slice(1);
                if (!Array.from(panels).some(function (panel) { return panel.id === id; })) id = 'profile';
                panels.forEach(function (panel) { panel.hidden = panel.id !== id; });
                links.forEach(function (link) {
                    var active = link.getAttribute('href') === '#' + id;
                    link.classList.toggle('is-active', active);
                    if (active) link.setAttribute('aria-current', 'page');
                    else link.removeAttribute('aria-current');
                });
            }
            window.addEventListener('hashchange', showSection);
            showSection();
        })();

        (function () {
            var dropdown = document.getElementById('nicheDropdown');
            if (!dropdown) return;

            var trigger = document.getElementById('nicheTrigger');
            var label = document.getElementById('nicheTriggerLabel');
            var hiddenInput = document.getElementById('nicheValue');
            var options = dropdown.querySelectorAll('.ps-dropdown-option');

            function close() {
                dropdown.classList.remove('is-open');
            }

            trigger.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('is-open');
            });

            options.forEach(function (opt) {
                opt.addEventListener('click', function () {
                    var value = opt.dataset.value;
                    hiddenInput.value = value;
                    label.textContent = value;
                    label.classList.remove('is-placeholder');

                    options.forEach(function (o) { o.classList.remove('is-selected'); });
                    opt.classList.add('is-selected');

                    close();
                });
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target)) close();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') close();
            });
        })();
    </script>

</body>
</html>
