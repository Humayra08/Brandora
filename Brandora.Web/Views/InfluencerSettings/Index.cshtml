@model Brandora.Web.Models.Dashboard.InfluencerSettingsViewModel
@using Brandora.Web.Models.Domain
@using Brandora.Web.Models.Influencers
@{
    ViewData["Title"] = "Profile Settings";
    Layout = null;

    var bio = Model.Form.Bio ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="icon" type="image/png" href="~/images/brandora-icon.png" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-button,
        ::-webkit-scrollbar-button:single-button,
        ::-webkit-scrollbar-button:vertical:start,
        ::-webkit-scrollbar-button:vertical:end,
        ::-webkit-scrollbar-button:horizontal:start,
        ::-webkit-scrollbar-button:horizontal:end,
        ::-webkit-scrollbar-button:increment,
        ::-webkit-scrollbar-button:decrement {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
            background: transparent !important;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #d3d9ec;
            border-radius: 10px;
            border: 2px solid transparent;
            background-clip: padding-box;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #b7c0e0;
            background-clip: padding-box;
        }

        html {
            scrollbar-width: thin;
            scrollbar-color: #d3d9ec transparent;
        }

        body {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            background: #ffffff;
            color: #20283a;
            overflow-x: hidden;
        }

        /* ==============================
           SIDEBAR (shared with dashboard)
        ============================== */

        .sidebar {
            position: fixed;
            width: 230px;
            height: 100vh;
            left: 0;
            top: 0;
            padding: 16px 12px;
            background:
                radial-gradient(circle at 0% 30%, rgba(139, 34, 255, .18), transparent 30%),
                linear-gradient(180deg, #070c22 0%, #0a1028 100%);
            color: white;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,.06);
            z-index: 1000;

            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.15) transparent;

            transition: transform .25s ease;
        }

        .sidebar.is-hidden {
            transform: translateX(-100%);
        }

        .brand {
            display: flex;
            align-items: center;
            padding: 0 12px 6px;
        }

        .sidebar-wave-img {
            position: absolute;
            left: 0;
            bottom: 60px;
            width: 100%;
            height: auto;
            pointer-events: none;
            z-index: -1;
            opacity: .9;
        }

        .brand-logo-img {
            height: 44px;
            width: auto;
            display: block;
        }

        .sidebar-nav-wrap {
            position: relative;
            flex: 1;
            min-height: 0;
            margin-top: 14px;
        }

        .sidebar-nav-wrap::before {
            content: "";
            position: absolute;
            top: -34px;
            left: -34px;
            right: -34px;
            bottom: 0;
            z-index: -1;
            pointer-events: none;

            background:
                radial-gradient(circle at 12% 5%, rgba(35,110,234,.2), transparent 30%),
                radial-gradient(circle at 88% 14%, rgba(163,38,255,.18), transparent 32%),
                radial-gradient(circle at 18% 50%, rgba(24,169,255,.16), transparent 30%),
                radial-gradient(circle at 85% 62%, rgba(163,38,255,.14), transparent 32%),
                radial-gradient(circle at 30% 90%, rgba(35,110,234,.16), transparent 34%);

            filter: blur(14px);
        }

        .sidebar-nav-glass {
            position: relative;

            padding: 0;

            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.12);

            background: rgba(255,255,255,.03);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);

            box-shadow: 0 8px 30px rgba(0,0,0,.18);
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar-menu li {
            margin-bottom: 2px;
        }

        .sidebar-menu a {
            color: #d9dce8;
            text-decoration: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 400;
            transition: background .2s ease, color .2s ease, transform .1s ease;
        }

        .sidebar-menu a:hover {
            background: rgba(255,255,255,.06);
            color: white;
        }

        .sidebar-menu a:active {
            transform: scale(.98);
            background: rgba(255,255,255,.1);
        }

        .sidebar-menu .active:hover,
        .sidebar-menu .active:active {
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
        }

        .nav-chevron {
            font-size: 15px;
            opacity: 0;
            transition: .2s ease;
        }

        .sidebar-menu .active {
            color: white;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.35),
                inset 0 0 0 1px rgba(255,255,255,.18),
                0 8px 25px rgba(106, 37, 213, .25);
        }

        .sidebar-menu .active .nav-chevron {
            opacity: 1;
        }

        .sidebar-bottom {
            margin-top: auto;
            padding: 12px 8px 0;
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 10px;
            min-width: 0;
        }

        .sidebar-user > div {
            min-width: 0;
        }

        .avatar-circle {
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            flex-shrink: 0;
            background: linear-gradient(145deg, #c93cff, #4e38ff 55%, #159cff);
            color: #ffffff;
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
        }

        .avatar-circle.small {
            width: 36px;
            height: 36px;
            font-size: 12px;
            border: 2px solid rgba(255,255,255,.12);
        }

        .sidebar-user h6 {
            margin: 0 0 4px;
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-user span {
            color: #afb4c6;
            font-size: 13px;
        }

        .logout-btn {
            width: 100%;
            padding: 10px;
            border: 0;
            border-top: 1px solid rgba(255,255,255,.08);
            background: transparent;
            color: #dce0ea;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            cursor: pointer;
        }

        .logout-btn i {
            margin-right: 10px;
            font-size: 16px;
        }

        .logout-btn:hover {
            color: white;
        }

        /* ==============================
           MAIN CONTENT
        ============================== */

        .main-content {
            margin-left: 230px;
            min-height: 100vh;
            padding: 24px 26px;
            background: #ffffff;

            transition: margin-left .25s ease;
        }

        .main-content.sidebar-hidden {
            margin-left: 0;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .menu-btn {
            border: 0;
            background: transparent;
            font-size: 26px;
            color: #20283a;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .bell {
            position: relative;
            font-size: 23px;
            color: #20283a;
        }

        .browse-btn {
            border: 0;
            color: white;
            padding: 9px 16px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 600;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            transition: .25s;
        }

        .browse-btn:hover {
            transform: translateY(-2px);
        }

        .browse-btn i {
            margin-left: 10px;
        }

        /* ==============================
           PAGE HEADER
        ============================== */

        .ps-page-title {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 700;
            color: #101a42;
        }

        .ps-page-sub {
            margin-top: 5px;
            color: #56617f;
            font-size: 13.5px;
            margin-bottom: 24px;
        }

        /* ==============================
           LAYOUT
        ============================== */

        .ps-grid {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 20px;
            align-items: start;
        }

        .ps-card {
            background: #ffffff;
            border: 1px solid #e7e9f5;
            border-radius: 16px;
        }

        /* Settings nav */

        .ps-nav {
            padding: 10px;
        }

        .ps-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 12px;
            text-decoration: none;
            color: inherit;
            cursor: pointer;
            margin-bottom: 2px;
            transition: background .15s ease;
        }

        .ps-nav-item:hover {
            background: #f6f7fc;
        }

        .ps-nav-item.is-active {
            background: linear-gradient(105deg, rgba(163,38,255,.1), rgba(24,169,255,.08));
            border: 1px solid #e3d9ff;
        }

        .ps-nav-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 15px;
            background: #f1f2f8;
            color: #56617f;
        }

        .ps-nav-item.is-active .ps-nav-icon {
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: #ffffff;
        }

        .ps-nav-title {
            font-size: 13.5px;
            font-weight: 400;
            color: #101a42;
        }

        .ps-nav-item.is-active .ps-nav-title {
            color: #6322d4;
        }

        .ps-nav-desc {
            font-size: 12px;
            color: #8a93ad;
            margin-top: 2px;
        }

        .ps-nav-item.is-active .ps-nav-desc {
            color: #7a4fd6;
        }

        .ps-help-card {
            margin-top: 16px;
            padding: 22px;
        }

        .ps-help-top {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 14px;
        }

        .ps-help-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: linear-gradient(135deg, #a326ff, #6a3cff 55%, #18a9ff);
            color: #ffffff;
            font-size: 18px;
            font-weight: 700;
        }

        .ps-help-title {
            font-size: 16px;
            font-weight: 700;
            color: #101a42;
        }

        .ps-help-desc {
            font-size: 13px;
            color: #7c8ab0;
            line-height: 1.6;
            text-align: center;
            margin: 0 0 18px;
        }

        .ps-support-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            margin: 0;
            border: 1px solid #d7dae5;
            background: #ffffff;
            color: #3a1fb5;
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 13.5px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
        }

        .ps-support-btn:hover {
            border-color: #9b2cff;
            color: #6322d4;
        }

        /* Profile information panel */

        .ps-panel {
            padding: 26px 28px;
        }

        .ps-panel-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        .ps-panel-title {
            font-size: 17px;
            font-weight: 700;
            color: #101a42;
        }

        .ps-panel-sub {
            font-size: 13px;
            color: #7c8ab0;
            margin-top: 4px;
        }

        .ps-photo-row {
            display: flex;
            align-items: center;
            gap: 18px;
            padding-bottom: 22px;
            margin-bottom: 22px;
            border-bottom: 1px solid #eef0f8;
        }

        .ps-photo-avatar-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .avatar-circle.large {
            width: 76px;
            height: 76px;
            font-size: 24px;
        }

        .ps-photo-camera {
            position: absolute;
            right: -2px;
            bottom: -2px;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            border: 2px solid #ffffff;
        }

        .ps-photo-name {
            font-size: 14.5px;
            font-weight: 700;
            color: #101a42;
        }

        .ps-photo-hint {
            font-size: 12px;
            color: #8a93ad;
            margin: 3px 0 10px;
        }

        .ps-change-photo-btn {
            border: 1px solid #dce7ff;
            background: #ffffff;
            color: #6322d4;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .ps-change-photo-btn:hover {
            border-color: #9b2cff;
        }

        .ps-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px 20px;
            margin-bottom: 18px;
        }

        .ps-form-group {
            display: flex;
            flex-direction: column;
        }

        .ps-form-group.full {
            grid-column: 1 / -1;
        }

        .ps-form-group label {
            font-size: 12.5px;
            font-weight: 700;
            color: #3a4360;
            margin-bottom: 8px;
        }

        .ps-form-group input,
        .ps-form-group select,
        .ps-form-group textarea {
            border: 1px solid #dce7ff;
            border-radius: 10px;
            padding: 11px 13px;
            font-size: 13.5px;
            font-family: 'DM Sans', sans-serif;
            color: #20283a;
            outline: 0;
            width: 100%;
            transition: border-color .2s ease;
        }

        .ps-form-group input:focus,
        .ps-form-group select:focus,
        .ps-form-group textarea:focus {
            border-color: #9b2cff;
        }

        .ps-form-hint {
            font-size: 11.5px;
            color: #8a93ad;
            margin-top: 6px;
        }

        .ps-input-icon-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .ps-input-icon-wrap i,
        .ps-input-icon-wrap .ps-flag {
            position: absolute;
            left: 13px;
            color: #8a93ad;
            font-size: 14px;
            pointer-events: none;
        }

        .ps-input-icon-wrap input {
            padding-left: 36px;
        }

        .ps-form-group select {
            appearance: none;
            -webkit-appearance: none;
            background-image: none;
            cursor: pointer;
        }

        .ps-select-wrap {
            position: relative;
        }

        .ps-select-wrap i {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #8a93ad;
            font-size: 12px;
            pointer-events: none;
        }

        /* Custom dropdown (category / niche) */

        .ps-dropdown {
            position: relative;
        }

        .ps-dropdown-trigger {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            border: 1px solid #dce7ff;
            border-radius: 10px;
            padding: 11px 13px;
            font-size: 13.5px;
            font-family: 'DM Sans', sans-serif;
            color: #20283a;
            background: #ffffff;
            cursor: pointer;
            text-align: left;
            transition: border-color .2s ease;
        }

        .ps-dropdown-trigger:hover {
            border-color: #b7c0e0;
        }

        .ps-dropdown.is-open .ps-dropdown-trigger {
            border-color: #9b2cff;
        }

        .ps-dropdown-trigger span.is-placeholder {
            color: #8a93ad;
        }

        .ps-dropdown-trigger i {
            color: #8a93ad;
            font-size: 12px;
            flex-shrink: 0;
            transition: transform .2s ease;
        }

        .ps-dropdown.is-open .ps-dropdown-trigger i {
            transform: rotate(180deg);
            color: #6322d4;
        }

        .ps-dropdown-panel {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: 0;
            z-index: 20;
            max-height: 260px;
            overflow-y: auto;
            background: #ffffff;
            border: 1px solid #e7e9f5;
            border-radius: 12px;
            padding: 6px;
            box-shadow: 0 16px 36px rgba(35,72,160,.14);
        }

        .ps-dropdown.is-open .ps-dropdown-panel {
            display: block;
        }

        .ps-dropdown-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 12px;
            border-radius: 8px;
            font-size: 13.5px;
            color: #3a4360;
            cursor: pointer;
            transition: background .15s ease;
        }

        .ps-dropdown-option:hover {
            background: #f6f7fc;
        }

        .ps-dropdown-option i {
            font-size: 13px;
            color: #6322d4;
            opacity: 0;
        }

        .ps-dropdown-option.is-selected {
            background: linear-gradient(105deg, rgba(163,38,255,.08), rgba(24,169,255,.06));
            color: #6322d4;
            font-weight: 600;
        }

        .ps-dropdown-option.is-selected i {
            opacity: 1;
        }

        .ps-textarea-wrap {
            position: relative;
        }

        .ps-textarea-wrap textarea {
            resize: vertical;
            min-height: 90px;
        }

        .ps-char-count {
            position: absolute;
            right: 13px;
            bottom: 10px;
            font-size: 11px;
            color: #b7c0e0;
            background: #ffffff;
            padding-left: 4px;
        }

        .ps-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 22px;
        }

        .ps-cancel-btn {
            border: 1px solid #dce7ff;
            background: #f6f7fc;
            color: #56617f;
            padding: 11px 22px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .ps-save-btn {
            border: 0;
            color: white;
            padding: 11px 24px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
            cursor: pointer;
            transition: .2s;
        }

        .ps-save-btn:hover {
            transform: translateY(-2px);
        }

        .ps-saved-note {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #e2faf1;
            color: #0d9c6c;
            border: 1px solid #c7f2e2;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 18px;
        }

        /* ==============================
           RESPONSIVE
        ============================== */

        @@media(max-width: 1100px) {
            .sidebar {
                width: 220px;
            }

            .main-content {
                margin-left: 220px;
            }
        }

        @@media(max-width: 980px) {
            .ps-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width: 900px) {
            .sidebar {
                transform: translateX(-100%);
                box-shadow: 0 0 40px rgba(0,0,0,.35);
            }

            .sidebar.is-open {
                transform: translateX(0);
            }

            .sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(5,6,20,.5);
                z-index: 999;
            }

            .sidebar-backdrop.is-visible {
                display: block;
            }

            .main-content {
                margin-left: 0;
            }
        }

        @@media(max-width: 640px) {
            .main-content {
                padding: 18px 14px;
            }

            .ps-panel {
                padding: 18px;
            }

            .ps-form-grid {
                grid-template-columns: 1fr;
            }

            .ps-panel-head {
                flex-direction: column;
                gap: 12px;
            }

            .ps-photo-row {
                flex-wrap: wrap;
            }
        }
    </style>
</head>

<body>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar" id="dashboardSidebar">

        <img src="~/images/Sidebar Wave.png" alt="" class="sidebar-wave-img" />

        <div class="brand">
            <img src="~/images/Brandora.png" alt="Brandora" class="brand-logo-img" />
        </div>

        <div class="sidebar-nav-wrap">
        <div class="sidebar-nav-glass">
        <ul class="sidebar-menu">

            <li>
                <a href="/InfluencerDashboard">
                    <span>Dashboard</span>
                </a>
            </li>

            <li>
                <a href="/InfluencerCampaigns">
                    <span>Campaigns</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span>My Proposals</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span>Chat</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span>Earnings</span>
                </a>
            </li>

            <li>
                <a href="/SocialAccounts">
                    <span>Social Accounts</span>
                </a>
            </li>

            <li>
                <a href="/UploadProof">
                    <span>Upload Proof</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <span>Payments</span>
                </a>
            </li>

            <li>
                <a href="/InfluencerSettings" class="active">
                    <span>Profile Settings</span>
                    <i class="bi bi-chevron-right nav-chevron"></i>
                </a>
            </li>

        </ul>
        </div>
        </div>


        <!-- Bottom User Profile -->

        <div class="sidebar-bottom">

            <div class="sidebar-user">
                <div class="avatar-circle small">@FollowerFormat.InitialsOf(Model.Profile.FullName)</div>

                <div>
                    <h6>@Model.Profile.FullName</h6>
                    <span>Influencer</span>
                </div>
            </div>

            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </button>
            </form>

        </div>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="main-content" id="dashboardMain">

        <!-- TOP BAR -->

        <div class="topbar">

            <button class="menu-btn" id="menuToggleBtn" aria-label="Toggle sidebar" type="button">
                <i class="bi bi-list"></i>
            </button>

            <div class="top-actions">

                <div class="bell">
                    <i class="bi bi-bell"></i>
                </div>

                <a href="/InfluencerCampaigns">
                    <button class="browse-btn">
                        Browse Campaigns
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </a>

            </div>

        </div>


        <!-- ================= PAGE HEADER ================= -->

        <div class="ps-page-title">Profile Settings</div>
        <div class="ps-page-sub">Manage your profile information and account preferences</div>


        <!-- ================= LAYOUT ================= -->

        <div class="ps-grid">

            <!-- SETTINGS NAV -->

            <div>
                <div class="ps-card ps-nav">

                    <a href="/InfluencerSettings" class="ps-nav-item is-active">
                        <span class="ps-nav-icon"><i class="bi bi-person-fill"></i></span>
                        <span class="ps-nav-title">Profile Information</span>
                    </a>

                    <a href="#" class="ps-nav-item">
                        <span class="ps-nav-icon"><i class="bi bi-lock-fill"></i></span>
                        <span class="ps-nav-title">Account &amp; Security</span>
                    </a>

                    <a href="/SocialAccounts" class="ps-nav-item">
                        <span class="ps-nav-icon"><i class="bi bi-link-45deg"></i></span>
                        <span class="ps-nav-title">Social Accounts</span>
                    </a>

                    <a href="#" class="ps-nav-item">
                        <span class="ps-nav-icon"><i class="bi bi-bell-fill"></i></span>
                        <span class="ps-nav-title">Notification Settings</span>
                    </a>

                    <a href="#" class="ps-nav-item">
                        <span class="ps-nav-icon"><i class="bi bi-shield-fill"></i></span>
                        <span class="ps-nav-title">Privacy Settings</span>
                    </a>

                    <a href="#" class="ps-nav-item">
                        <span class="ps-nav-icon"><i class="bi bi-credit-card-fill"></i></span>
                        <span class="ps-nav-title">Payment Information</span>
                    </a>

                    <a href="#" class="ps-nav-item">
                        <span class="ps-nav-icon"><i class="bi bi-link-45deg"></i></span>
                        <span class="ps-nav-title">Connected Accounts</span>
                    </a>

                </div>

                <div class="ps-card ps-help-card">
                    <div class="ps-help-top">
                        <div class="ps-help-icon">?</div>
                        <div class="ps-help-title">Need Help?</div>
                    </div>
                    <div class="ps-help-desc">If you need any assistance, our support team is here to help.</div>
                    <a href="#" class="ps-support-btn">Contact Support <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>


            <!-- PROFILE INFORMATION PANEL -->

            <div class="ps-card ps-panel">

                <div class="ps-panel-head">
                    <div>
                        <div class="ps-panel-title">Profile Information</div>
                        <div class="ps-panel-sub">Update your personal information and how others see you on Brandora.</div>
                    </div>
                </div>

                @if (ViewData["ProfileSaved"] is not null)
                {
                    <div class="ps-saved-note"><i class="bi bi-check-circle-fill"></i> Profile updated successfully.</div>
                }

                <form method="post" action="/InfluencerSettings/Update">
                    @Html.AntiForgeryToken()

                    <div class="ps-photo-row">
                        <div class="ps-photo-avatar-wrap">
                            <div class="avatar-circle large">@FollowerFormat.InitialsOf(Model.Profile.FullName)</div>
                            <span class="ps-photo-camera"><i class="bi bi-camera-fill"></i></span>
                        </div>

                        <div>
                            <div class="ps-photo-name">@Model.Profile.FullName</div>
                            <div class="ps-photo-hint">JPG, PNG or WebP. Max size of 2MB.</div>
                            <button type="button" class="ps-change-photo-btn">Change Photo</button>
                        </div>
                    </div>

                    <div class="ps-form-grid">

                        <div class="ps-form-group">
                            <label for="fullName">Full Name</label>
                            <input type="text" id="fullName" name="FullName" value="@Model.Form.FullName" />
                        </div>

                        <div class="ps-form-group">
                            <label for="userName">Username</label>
                            <input type="text" id="userName" name="UserName" value="@Model.Form.UserName" disabled />
                            <div class="ps-form-hint">This is how others will see you.</div>
                        </div>

                        <div class="ps-form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="Email" value="@Model.Form.Email" disabled />
                        </div>

                        <div class="ps-form-group">
                            <label for="phone">Phone Number</label>
                            <div class="ps-input-icon-wrap">
                                <i class="bi bi-telephone-fill"></i>
                                <input type="text" id="phone" name="PhoneNumber" value="@Model.Form.PhoneNumber" placeholder="+880 1XXX XXXXXX" />
                            </div>
                        </div>

                        <div class="ps-form-group">
                            <label for="location">Location</label>
                            <div class="ps-input-icon-wrap">
                                <i class="bi bi-geo-alt-fill"></i>
                                <input type="text" id="location" name="Location" value="@Model.Form.Location" placeholder="City, Country" />
                            </div>
                        </div>

                        <div class="ps-form-group">
                            <label for="nicheTrigger">Category / Niche</label>
                            <div class="ps-dropdown" id="nicheDropdown">
                                <input type="hidden" name="ContentNiche" id="nicheValue" value="@Model.Form.ContentNiche" />

                                <button type="button" class="ps-dropdown-trigger" id="nicheTrigger">
                                    <span id="nicheTriggerLabel" class="@(string.IsNullOrEmpty(Model.Form.ContentNiche) ? "is-placeholder" : "")">@(string.IsNullOrEmpty(Model.Form.ContentNiche) ? "Select a category" : Model.Form.ContentNiche)</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>

                                <div class="ps-dropdown-panel" id="nicheOptions">
                                    @foreach (var niche in new[] { "Fashion & Style", "Beauty & Skincare", "Food & Cooking", "Travel & Lifestyle", "Fitness & Health", "Gaming", "Tech & Gadgets", "Education", "Comedy & Entertainment", "Home & Lifestyle", "Finance", "Other" })
                                    {
                                        <div class="ps-dropdown-option @(Model.Form.ContentNiche == niche ? "is-selected" : "")" data-value="@niche">
                                            @niche
                                            <i class="bi bi-check-lg"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="ps-form-group full">
                            <label for="bio">Bio</label>
                            <div class="ps-textarea-wrap">
                                <textarea id="bio" name="Bio" maxlength="200" oninput="document.getElementById('bioCount').textContent = this.value.length">@bio</textarea>
                                <span class="ps-char-count"><span id="bioCount">@bio.Length</span>/200</span>
                            </div>
                        </div>

                        <div class="ps-form-group full">
                            <label for="website">Website (Optional)</label>
                            <div class="ps-input-icon-wrap">
                                <i class="bi bi-link-45deg"></i>
                                <input type="url" id="website" name="WebsiteUrl" value="@Model.Form.WebsiteUrl" placeholder="https://yourwebsite.com" />
                            </div>
                        </div>

                    </div>

                    <div class="ps-actions">
                        <a href="/InfluencerSettings" class="ps-cancel-btn">Cancel</a>
                        <button type="submit" class="ps-save-btn">Save Changes</button>
                    </div>

                </form>

            </div>

        </div>

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            var menuBtn = document.getElementById('menuToggleBtn');
            var sidebar = document.getElementById('dashboardSidebar');
            var main = document.getElementById('dashboardMain');
            var backdrop = document.getElementById('sidebarBackdrop');
            var mobileQuery = window.matchMedia('(max-width: 900px)');

            if (!menuBtn || !sidebar || !main) return;

            function closeMobile() {
                sidebar.classList.remove('is-open');
                if (backdrop) backdrop.classList.remove('is-visible');
            }

            menuBtn.addEventListener('click', function () {
                if (mobileQuery.matches) {
                    sidebar.classList.toggle('is-open');
                    if (backdrop) backdrop.classList.toggle('is-visible');
                } else {
                    sidebar.classList.toggle('is-hidden');
                    main.classList.toggle('sidebar-hidden');
                }
            });

            if (backdrop) backdrop.addEventListener('click', closeMobile);
        })();

        (function () {
            var dropdown = document.getElementById('nicheDropdown');
            if (!dropdown) return;

            var trigger = document.getElementById('nicheTrigger');
            var label = document.getElementById('nicheTriggerLabel');
            var hiddenInput = document.getElementById('nicheValue');
            var options = dropdown.querySelectorAll('.ps-dropdown-option');

            function close() {
                dropdown.classList.remove('is-open');
            }

            trigger.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('is-open');
            });

            options.forEach(function (opt) {
                opt.addEventListener('click', function () {
                    var value = opt.dataset.value;
                    hiddenInput.value = value;
                    label.textContent = value;
                    label.classList.remove('is-placeholder');

                    options.forEach(function (o) { o.classList.remove('is-selected'); });
                    opt.classList.add('is-selected');

                    close();
                });
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target)) close();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') close();
            });
        })();
    </script>

</body>
</html>
