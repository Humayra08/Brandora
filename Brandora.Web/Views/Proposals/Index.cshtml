            </div>
        </section>

        <section class="help-card">
            <h3>Need Help?</h3>
            <p>Unsure about an application or a creator's offer? Our support team can step in.</p>
            <a href="/Home/Contact">Contact Support <i class="bi bi-arrow-right"></i></a>
            <svg viewBox="0 0 400 170" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="ap-help-wave" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#0955ca" stop-opacity="0"/><stop offset=".65" stop-color="#168cff" stop-opacity=".5"/><stop offset="1" stop-color="#783dff" stop-opacity=".15"/></linearGradient></defs><path d="M-20 160 C100 50 140 220 260 105 S350 85 420 20 L420 190 H-20Z" fill="url(#ap-help-wave)"/><path d="M-20 164 C110 90 140 230 270 120 S360 70 420 40" fill="none" stroke="#2799ff" stroke-opacity=".4"/></svg>
        </section>

    </aside>

</div>
