@model Brandora.Web.Models.Proposals.ProposalDetailViewModel
@using Brandora.Web.Models.Influencers
@using Brandora.Web.Models.Domain
@{
    var proposal = Model.Proposal;
    ViewData["Title"] = "Application Details";
    ViewData["ActiveNav"] = "Applications";
    Layout = "_AppLayout";
    var hue = (proposal.InfluencerProfile.Id * 47) % 360;
    var statusLabel = proposal.Status == ProposalStatus.Rejected ? "Not Selected" : proposal.Status == ProposalStatus.Pending ? "Pending Review" : proposal.Status.ToString();

    var creator = proposal.InfluencerProfile;
    var campaign = proposal.Campaign;
    var collaboration = proposal.Collaboration;
    var avatarGradient = $"linear-gradient(135deg, hsl({hue}deg 75% 58%), hsl({(hue + 45) % 360}deg 75% 48%))";
    var firstName = creator.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? creator.FullName;
    var isInvite = proposal.InitiatedBy == ProposalInitiator.Brand;
    var isPending = proposal.Status == ProposalStatus.Pending;
    var isAccepted = proposal.Status == ProposalStatus.Accepted;
    var isRejected = proposal.Status == ProposalStatus.Rejected;
    var planCount = Model.CampaignMilestonePlanCount;
    var statusBadge = isPending ? "is-pending" : isAccepted ? "is-success" : "is-neutral";

    // Four-step journey from application to paid milestones.
    var steps = new[]
    {
        (Done: true, Title: isInvite ? "Invite Sent" : "Application Received", Sub: proposal.CreatedAt.ToBangladeshTime().ToString("MMM d, yyyy")),
        (Done: !isPending, Title: isRejected ? "Not Selected" : "Your Decision", Sub: proposal.DecidedAt.HasValue ? proposal.DecidedAt.Value.ToBangladeshTime().ToString("MMM d, yyyy") : "Accept or decline"),
        (Done: isAccepted && collaboration is not null, Title: "Collaboration Active", Sub: "Milestones created"),
        (Done: collaboration?.Status == CollaborationStatus.Completed, Title: "Completed", Sub: "Paid via bKash or Nagad")
    };
    var currentIndex = isRejected ? -1 : Array.FindIndex(steps, s => !s.Done);

    (string Label, string Badge) CollabBadge(CollaborationStatus status) => status switch
    {
        CollaborationStatus.Active => ("Active", "is-info"),
        CollaborationStatus.Completed => ("Completed", "is-success"),
        CollaborationStatus.Cancelled => ("Cancelled", "is-neutral"),
        _ => (status.ToString(), "is-neutral")
    };

    var faqs = new[]
    {
        ("What happens when I accept?", $"You'll be asked to create and sign a Campaign Collaboration Agreement. Once {creator.FullName} signs it too, the collaboration starts and the {planCount} milestone{(planCount == 1 ? "" : "s")} in your campaign plan are created for them."),
        ("Is the proposed rate charged now?", "No. Nothing is charged when you accept. You pay per milestone, through bKash or Nagad, only after the work is delivered and approved."),
        ("Why do both I and Brandora approve?", "You confirm the proof of post matches your brief; Brandora confirms the post is genuine and live. A milestone can only be paid once both sign-offs are in."),
        ("What does Not Selected do?", "It closes this application and records your decision. You can still message the creator or send them a new invite later.")
    };
}

@section Styles {

    .pd-flow { margin: 0 0 16px; }
    .pd-body { align-items: start; }

    .pd-decision-note { display: flex; align-items: flex-start; gap: 8px; margin-top: 14px; padding: 10px 12px; border-radius: 9px; background: #ffffffa6; border: 1px solid #dfebff; font-family: 'Inter', sans-serif; font-size: 11.5px; line-height: 1.55; color: #33477c; }
    .pd-decision-note i { margin-top: 1px; color: #1451ff; }
    .decision-card-actions .btn i { margin-right: 8px; }

    /* ---- Tabs ---- */
    .tabs-card { padding: 0; overflow: hidden; }
    .tabs-nav { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px 10px 0; border-bottom: 1px solid #e3edfc; }
    .tab-btn { display: inline-flex; align-items: center; gap: 7px; padding: 11px 14px; border: 0; border-bottom: 2px solid transparent; background: none; font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; color: #5877ac; cursor: pointer; transition: color .2s ease, border-color .2s ease; }
    .tab-btn:hover { color: #1451ff; }
    .tab-btn.is-active { color: #1451ff; border-bottom-color: #3735ff; }
    .tab-panel { display: none; padding: 8px 20px 18px; animation: fade-up .3s ease both; }
    .tab-panel.is-active { display: block; }
    .tab-panel .proof-quote { margin-top: 4px; }

    .collab-list { display: grid; gap: 10px; padding-top: 10px; }
    .collab-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 10px; border: 1px solid #e3edfc; background: #ffffff8c; box-shadow: 0 3px 9px #9bbfe90b; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
    .collab-row:hover { transform: translateY(-2px); border-color: #b9d3ff; box-shadow: 0 12px 24px #5b83c41a; }
    .collab-row strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 700; color: #101d48; }
    .collab-row small { display: block; margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #5877ac; }
    .collab-row > i { color: #8095c4; transition: transform .2s ease, color .2s ease; }
    .collab-row:hover > i { transform: translateX(3px); color: #1451ff; }
    .pd-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; margin-top: 10px; padding: 24px 16px; border: 1px dashed #cfdcf5; border-radius: 12px; background: #f7faffb3; text-align: center; font-family: 'Inter', sans-serif; font-size: 12px; color: #6b7fb1; }
    .pd-empty strong { font-family: 'DM Sans', sans-serif; font-size: 13.5px; color: #142652; }

    .pd-link { color: #1451ff; font-weight: 600; }
    .pd-link:hover { text-decoration: underline; }

    .pd-bio { margin-top: 12px; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.6; color: #52649b; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .pd-total dd { font-size: 15px; color: #0b124e; }

}

<nav class="crumb-trail" aria-label="Breadcrumb">
    <a href="/Dashboard">Dashboard</a><i class="bi bi-chevron-right"></i>
    <a href="/Proposals">Applications</a><i class="bi bi-chevron-right"></i>
    <strong>@creator.FullName</strong>
</nav>

<section class="page-hero detail-hero">
    @await Html.PartialAsync("_HeroWaves")
    <div class="detail-hero-top">
        <div class="detail-hero-avatar is-person" style="background: @avatarGradient;">@FollowerFormat.InitialsOf(creator.FullName)</div>
        <div class="detail-hero-copy">
            <div class="detail-hero-tags">
                <span><i class="bi @(isInvite ? "bi-send" : "bi-file-earmark-text")"></i> @(isInvite ? "Brand Invite" : "Application")</span>
                @if (!string.IsNullOrWhiteSpace(campaign.Platform))
                {
                    <span><i class="bi bi-broadcast"></i> @campaign.Platform</span>
                }
                @if (!string.IsNullOrWhiteSpace(campaign.Niche))
                {
                    <span><i class="bi bi-tags"></i> @campaign.Niche</span>
                }
            </div>
            <h1>@(isInvite ? "Your invite to " : "")<span>@creator.FullName</span>@(isInvite ? "" : "'s application")</h1>
            <p>For <a href="/Campaigns/Detail/@proposal.CampaignId">@campaign.Title</a> &middot; @(isInvite ? "sent" : "submitted") @proposal.CreatedAt.ToBangladeshTime().ToString("MMM d, yyyy, h:mm tt")</p>
        </div>
        <div class="detail-hero-side">
            <span class="ui-badge @statusBadge">@statusLabel</span>
            <div class="page-hero-motto" style="margin-left:0;">Every Applicant,<br />Clearly Reviewed.<span></span></div>
        </div>
    </div>
    <dl class="detail-hero-stats">
        <div><dt>Proposed Rate</dt><dd>৳@proposal.ProposedAmount.ToString("N0")</dd></div>
        <div><dt>Campaign Budget</dt><dd>৳@campaign.Budget.ToString("N0")</dd></div>
        <div><dt>Milestones Planned</dt><dd>@planCount</dd></div>
        <div><dt>Followers</dt><dd>@FollowerFormat.Format(creator.Followers) <small>@creator.EngagementRate.ToString("0.0")% eng.</small></dd></div>
    </dl>
</section>

<ol class="flow-steps pd-flow" aria-label="Application progress">
    @for (var i = 0; i < steps.Length; i++)
    {
        var step = steps[i];
        var cls = step.Done ? "is-done" : i == currentIndex ? "is-current" : "";
        <li class="@cls" aria-current="@(i == currentIndex ? "step" : null)">
            <span class="flow-step-num">@if (step.Done) { <i class="bi bi-check-lg"></i> } else { @(i + 1) }</span>
            <div><strong>@step.Title</strong><small>@step.Sub</small></div>
        </li>
    }
</ol>

<div class="page-grid pd-body">

    <div class="page-main">

        @* ---------- What to do next ---------- *@
        @if (isPending)
        {
            <section class="decision-card">
                <div class="decision-card-head">
                    <span class="icon-chip violet"><i class="bi bi-person-check"></i></span>
                    <div>
                        <div class="decision-card-eyebrow">Your decision &middot; Step 2 of 4</div>
                        <div class="decision-card-title">@(isInvite ? $"Start the collaboration with {creator.FullName}?" : $"Accept or decline {firstName}'s application")</div>
                        <p class="decision-card-text">
                            @if (isInvite)
                            {
                                <text>You invited @creator.FullName to &ldquo;@campaign.Title&rdquo;. Once you've agreed the terms (use Message to check in), confirm here to start the collaboration.</text>
                            }
                            else
                            {
                                <text>Review the offer and deliverables below. Accepting starts a collaboration right away; Not Selected closes the application.</text>
                            }
                        </p>
                    </div>
                </div>
                <dl class="decision-breakdown">
                    <div><dt>Proposed rate</dt><dd>৳@proposal.ProposedAmount.ToString("N0")</dd></div>
                    <div><dt>Campaign budget</dt><dd>৳@campaign.Budget.ToString("N0")</dd></div>
                    <div><dt>Milestones in plan</dt><dd>@planCount</dd></div>
                </dl>
                <div class="decision-card-actions">
                    <form method="post" action="/Proposals/ConfirmAccept/@proposal.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i>@(isInvite ? "Confirm & Start Collaboration" : "Accept Application")</button>
                    </form>
                    <form method="post" action="/Proposals/Reject/@proposal.Id">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-outline-danger js-confirm"
                                data-confirm-title="@(isInvite ? "Withdraw this invite?" : "Reject this application?")"
                                data-confirm-text="Are you sure you want to mark @creator.FullName as Not Selected? They will be notified."
                                data-confirm-label="Not Selected"
                                data-confirm-danger="true"><i class="bi bi-x-circle"></i>Not Selected</button>
                    </form>
                    <button type="button" class="btn btn-ghost js-open-chat"
                            data-influencer-id="@proposal.InfluencerProfileId"
                            data-influencer-name="@creator.FullName"
                            data-hue="@hue"><i class="bi bi-chat-dots"></i>Message Influencer</button>
                </div>
                <p class="pd-decision-note">
                    <i class="bi bi-info-circle"></i>
                    <span>
                        @if (planCount > 0)
                        {
                            <text>Accepting creates the collaboration with the @planCount milestone@(planCount == 1 ? "" : "s") from your campaign plan. Nothing is charged now &mdash; each milestone is paid via bKash or Nagad after you and Brandora approve the proof of post.</text>
                        }
                        else
                        {
                            <text>This campaign has no milestone plan yet, so the collaboration will start without milestones &mdash; you can add them from the collaboration page. Nothing is charged now.</text>
                        }
                    </span>
                </p>
            </section>
        }
        else if (isAccepted && Model.Agreement is null)
        {
            <section class="decision-card">
                <div class="decision-card-head">
                    <span class="icon-chip mint"><i class="bi bi-check2-circle"></i></span>
                    <div>
                        <div class="decision-card-eyebrow">Application Accepted</div>
                        <div class="decision-card-title">Agreement Required</div>
                        <p class="decision-card-text">@firstName's application has been accepted. Review and sign the Campaign Collaboration Agreement to begin the collaboration.</p>
                    </div>
                </div>
                <div class="decision-card-actions">
                    <form method="post" action="/Agreements/Create">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="proposalId" value="@proposal.Id" />
                        <button type="submit" class="btn btn-primary"><i class="bi bi-file-earmark-text"></i>Create Agreement</button>
                    </form>
                    <button type="button" class="btn btn-secondary js-open-chat"
                            data-influencer-id="@proposal.InfluencerProfileId"
                            data-influencer-name="@creator.FullName"
                            data-hue="@hue"><i class="bi bi-chat-dots"></i>Message Influencer</button>
                </div>
            </section>
        }
        else if (isAccepted && Model.Agreement is { Status: not AgreementStatus.FullySigned } pendingAgreement)
        {
            <section class="decision-card">
                <div class="decision-card-head">
                    <span class="icon-chip violet"><i class="bi bi-pen"></i></span>
                    <div>
                        <div class="decision-card-eyebrow">Agreement @pendingAgreement.Code</div>
                        <div class="decision-card-title">@(pendingAgreement.Status == AgreementStatus.AwaitingBrandSignature ? "Awaiting your signature" : "Awaiting the influencer's signature")</div>
                        <p class="decision-card-text">The collaboration starts as soon as both sides have signed the agreement.</p>
                    </div>
                </div>
                <div class="decision-card-actions">
                    <a href="/Agreements/Detail/@pendingAgreement.Id" class="btn btn-primary"><i class="bi bi-file-earmark-text"></i>@(pendingAgreement.Status == AgreementStatus.AwaitingBrandSignature ? "Review & Sign Agreement" : "View Agreement")</a>
                    <button type="button" class="btn btn-secondary js-open-chat"
                            data-influencer-id="@proposal.InfluencerProfileId"
                            data-influencer-name="@creator.FullName"
                            data-hue="@hue"><i class="bi bi-chat-dots"></i>Message Influencer</button>
                </div>
            </section>
        }
        else if (isAccepted)
        {
            <section class="decision-card">
                <div class="decision-card-head">
                    <span class="icon-chip mint"><i class="bi bi-check2-circle"></i></span>
                    <div>
                        <div class="decision-card-eyebrow">Accepted@(proposal.DecidedAt.HasValue ? $" · {proposal.DecidedAt.Value.ToBangladeshTime():MMM d, yyyy}" : "")</div>
                        <div class="decision-card-title">Your collaboration with @firstName is @(collaboration is null ? "set up" : collaboration.Status == CollaborationStatus.Active ? "active" : collaboration.Status.ToString().ToLowerInvariant())</div>
                        <p class="decision-card-text">Track milestones, review proof of post and release payments from the collaboration page.</p>
                    </div>
                </div>
                <div class="decision-card-actions">
                    @if (collaboration is not null)
                    {
                        <a href="/Collaborations/Detail/@collaboration.Id" class="btn btn-primary"><i class="bi bi-kanban"></i>Manage Collaboration</a>
                    }
                    @if (Model.Agreement is not null)
                    {
                        <a href="/Agreements/Detail/@Model.Agreement.Id" class="btn btn-outline"><i class="bi bi-file-earmark-text"></i>View Agreement</a>
                    }
                    <button type="button" class="btn btn-secondary js-open-chat"
                            data-influencer-id="@proposal.InfluencerProfileId"
                            data-influencer-name="@creator.FullName"
                            data-hue="@hue"><i class="bi bi-chat-dots"></i>Message Influencer</button>
                </div>
            </section>
        }
        else
        {
            <section class="decision-card">
                <div class="decision-card-head">
                    <span class="icon-chip soft"><i class="bi bi-x-circle"></i></span>
                    <div>
                        <div class="decision-card-eyebrow">Closed@(proposal.DecidedAt.HasValue ? $" · {proposal.DecidedAt.Value.ToBangladeshTime():MMM d, yyyy}" : "")</div>
                        <div class="decision-card-title">This @(isInvite ? "invite" : "application") was not selected</div>
                        <p class="decision-card-text">You can still reach out to @firstName, or send a fresh invite with new terms for this campaign.</p>
                    </div>
                </div>
                <div class="decision-card-actions">
                    <a href="/Proposals/Invite?influencerId=@proposal.InfluencerProfileId&campaignId=@proposal.CampaignId" class="btn btn-primary"><i class="bi bi-send"></i>Send New Invite</a>
                    <button type="button" class="btn btn-secondary js-open-chat"
                            data-influencer-id="@proposal.InfluencerProfileId"
                            data-influencer-name="@creator.FullName"
                            data-hue="@hue"><i class="bi bi-chat-dots"></i>Message Influencer</button>
                </div>
            </section>
        }

        @* ---------- Application tabs ---------- *@
        <section class="ui-card tabs-card">
            <div class="tabs-nav">
                <button type="button" class="tab-btn is-active" data-tab="details"><i class="bi bi-file-earmark-text"></i>Application Details</button>
                <button type="button" class="tab-btn" data-tab="social"><i class="bi bi-broadcast"></i>Social Account</button>
                <button type="button" class="tab-btn" data-tab="history"><i class="bi bi-clock-history"></i>Past Collaborations @(Model.PastCollaborations.Count > 0 ? $"({Model.PastCollaborations.Count})" : "")</button>
                <button type="button" class="tab-btn" data-tab="more"><i class="bi bi-info-circle"></i>Additional Information</button>
            </div>

            <div class="tab-panel is-active" data-panel="details">
                <dl class="detail-rows">
                    <div><dt><span class="icon-chip"><i class="bi bi-list-check"></i></span>Proposed Deliverables</dt><dd>@proposal.Deliverables</dd></div>
                    <div><dt><span class="icon-chip"><i class="bi bi-calendar4-week"></i></span>Timeline</dt><dd>@(proposal.Timeline ?? "Not specified")</dd></div>
                    <div><dt><span class="icon-chip"><i class="bi bi-cash-coin"></i></span>Proposed Rate</dt><dd>৳@proposal.ProposedAmount.ToString("N0")<small>Paid per milestone via bKash or Nagad after approval</small></dd></div>
                    <div><dt><span class="icon-chip"><i class="bi bi-person-up"></i></span>Initiated By</dt><dd>@proposal.InitiatedBy<small>@(isInvite ? "You sent this invite from the creator's profile" : "The creator applied to your campaign")</small></dd></div>
                </dl>
                @if (!string.IsNullOrEmpty(proposal.Message))
                {
                    <div class="proof-quote"><i class="bi bi-chat-quote-fill"></i><span>@proposal.Message</span></div>
                }
            </div>

            <div class="tab-panel" data-panel="social">
                <dl class="detail-rows">
                    <div><dt><span class="icon-chip"><i class="bi bi-broadcast"></i></span>Primary Platform</dt><dd>@(creator.PrimaryPlatform ?? "Not specified")</dd></div>
                    @if (!string.IsNullOrEmpty(creator.PlatformUsername))
                    {
                        <div><dt><span class="icon-chip"><i class="bi bi-at"></i></span>Handle</dt><dd>@creator.PlatformUsername</dd></div>
                    }
                    <div><dt><span class="icon-chip"><i class="bi bi-people"></i></span>Followers &amp; Engagement</dt><dd>@FollowerFormat.Format(creator.Followers) followers &middot; @creator.EngagementRate.ToString("0.0")% engagement rate</dd></div>
                    <div><dt><span class="icon-chip"><i class="bi bi-bar-chart"></i></span>Audience Size</dt><dd>@(string.IsNullOrWhiteSpace(creator.AudienceSize) ? "Not specified" : creator.AudienceSize)</dd></div>
                </dl>
            </div>

            <div class="tab-panel" data-panel="history">
                @if (Model.PastCollaborations.Count == 0)
                {
                    <div class="pd-empty">
                        <span class="icon-chip soft"><i class="bi bi-people"></i></span>
                        <strong>No past collaborations</strong>
                        <span>You haven't worked with @firstName on another campaign yet.</span>
                    </div>
                }
                else
                {
                    <div class="collab-list">
                        @foreach (var collab in Model.PastCollaborations)
                        {
                            var cb = CollabBadge(collab.Status);
                            <a href="/Collaborations/Detail/@collab.Id" class="collab-row">
                                <span class="icon-chip sm blue"><i class="bi bi-megaphone"></i></span>
                                <div style="min-width:0;">
                                    <strong>@collab.Campaign.Title</strong>
                                    <small>Started @collab.CreatedAt.ToString("MMM d, yyyy")</small>
                                </div>
                                <span class="ui-badge @cb.Badge">@cb.Label</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="tab-panel" data-panel="more">
                <dl class="detail-rows">
                    @if (!string.IsNullOrEmpty(creator.WebsiteUrl))
                    {
                        <div><dt><span class="icon-chip"><i class="bi bi-globe2"></i></span>Website</dt><dd><a href="@creator.WebsiteUrl" target="_blank" rel="noopener" class="pd-link">@creator.WebsiteUrl</a></dd></div>
                    }
                    @if (!string.IsNullOrEmpty(creator.RateNote))
                    {
                        <div><dt><span class="icon-chip"><i class="bi bi-cash-coin"></i></span>Rate Note</dt><dd>@creator.RateNote</dd></div>
                    }
                    @if (!string.IsNullOrEmpty(creator.Location))
                    {
                        <div><dt><span class="icon-chip"><i class="bi bi-geo-alt"></i></span>Location</dt><dd>@creator.Location</dd></div>
                    }
                    <div><dt><span class="icon-chip"><i class="bi bi-shield-check"></i></span>Verification Status</dt><dd>@creator.VerificationStatus</dd></div>
                </dl>
            </div>
        </section>

        @* ---------- Campaign ---------- *@
        <section class="ui-card">
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Application for Campaign</div>
                    <p class="ui-card-sub">What @firstName would be working on.</p>
                </div>
                <a href="/Campaigns/Detail/@proposal.CampaignId" class="ui-card-link">View Campaign <i class="bi bi-arrow-right"></i></a>
            </div>
            <dl class="detail-rows">
                <div><dt><span class="icon-chip"><i class="bi bi-megaphone"></i></span>Campaign</dt><dd><a href="/Campaigns/Detail/@proposal.CampaignId" class="pd-link">@campaign.Title</a><small>@campaign.Status</small></dd></div>
                @if (campaign.StartDate.HasValue || campaign.Deadline.HasValue)
                {
                    <div><dt><span class="icon-chip"><i class="bi bi-calendar-range"></i></span>Schedule</dt><dd>@(campaign.StartDate?.ToString("MMM d") ?? "No start") &ndash; @(campaign.Deadline?.ToString("MMM d, yyyy") ?? "No end date")</dd></div>
                }
                @if (!string.IsNullOrEmpty(campaign.Platform))
                {
                    <div><dt><span class="icon-chip"><i class="bi bi-broadcast"></i></span>Platform</dt><dd>@campaign.Platform</dd></div>
                }
                <div><dt><span class="icon-chip"><i class="bi bi-flag"></i></span>Milestones</dt><dd>@planCount Milestone@(planCount == 1 ? "" : "s")<small>From your campaign plan</small></dd></div>
                <div><dt><span class="icon-chip"><i class="bi bi-wallet2"></i></span>Total Budget</dt><dd>৳@campaign.Budget.ToString("N0")</dd></div>
            </dl>
        </section>

    </div>

    <aside class="page-rail">

        <section class="ui-card">
            <div class="person-card-top">
                <span class="person-avatar" style="background: @avatarGradient;">@FollowerFormat.InitialsOf(creator.FullName)</span>
                <div style="min-width:0;">
                    <div class="person-name">@creator.FullName @if (creator.Verified) { <i class="bi bi-patch-check-fill" title="Verified"></i> }</div>
                    <div class="person-handle">@(string.IsNullOrEmpty(creator.Location) ? creator.PrimaryPlatform : $"{creator.PrimaryPlatform} · {creator.Location}")</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(creator.Bio))
            {
                <p class="pd-bio">@creator.Bio</p>
            }
            <div class="person-stats">
                <div><strong>@FollowerFormat.Format(creator.Followers)</strong><span>Followers</span></div>
                <div><strong>@creator.EngagementRate.ToString("0.0")%</strong><span>Engagement</span></div>
                <div><strong>@(string.IsNullOrWhiteSpace(creator.ContentNiche) ? "—" : creator.ContentNiche)</strong><span>Niche</span></div>
            </div>
            <div class="person-actions">
                <a href="/Influencers/Profile/@proposal.InfluencerProfileId"><i class="bi bi-person"></i> Full Profile</a>
                <button type="button" class="js-open-chat" data-influencer-id="@proposal.InfluencerProfileId" data-influencer-name="@creator.FullName" data-hue="@hue"><i class="bi bi-chat-dots"></i> Message</button>
            </div>
        </section>

        <section class="ui-card">
            <div class="ui-card-head" style="margin-bottom:6px;">
                <div class="ui-card-title" style="font-size:17px;">Application Summary</div>
                <span class="ui-badge @statusBadge">@statusLabel</span>
            </div>
            <dl class="fact-list">
                <div><dt>Type</dt><dd>@(isInvite ? "Brand invite" : "Creator application")</dd></div>
                <div><dt>@(isInvite ? "Sent" : "Submitted")</dt><dd>@proposal.CreatedAt.ToBangladeshTime().ToString("MMM d, h:mm tt")</dd></div>
                <div><dt>Decided</dt><dd>@(proposal.DecidedAt.HasValue ? proposal.DecidedAt.Value.ToBangladeshTime().ToString("MMM d, h:mm tt") : "Not yet")</dd></div>
                <div><dt>Milestones in plan</dt><dd>@planCount</dd></div>
                <div class="pd-total"><dt>Proposed rate</dt><dd>৳@proposal.ProposedAmount.ToString("N0")</dd></div>
            </dl>
        </section>

        <section class="info-card">
            <div class="info-card-head">
                <span class="icon-chip soft"><i class="bi bi-signpost-2"></i></span>
                <div class="info-card-title">What's Next?</div>
            </div>
            <ol class="next-steps">
                <li class="is-done"><h4>@(isInvite ? "Invite sent" : "Application received")</h4><p>@proposal.CreatedAt.ToBangladeshTime().ToString("MMM d, yyyy, h:mm tt")</p></li>
                <li class="@(isPending ? "is-current" : "is-done")"><h4>@(isRejected ? "Not selected" : "You accept")</h4><p>@(proposal.DecidedAt.HasValue ? proposal.DecidedAt.Value.ToBangladeshTime().ToString("MMM d, yyyy, h:mm tt") : "Accepting creates the collaboration and its milestones.")</p></li>
                @if (!isRejected)
                {
                    <li class="@(isAccepted ? "is-current" : "")"><h4>Creator delivers</h4><p>@firstName submits proof of post for each milestone.</p></li>
                    <li><h4>Two-stage approval</h4><p>You check the proof against your brief, then Brandora verifies the post is genuine and live.</p></li>
                    <li><h4>Paid via bKash or Nagad</h4><p>You release each approved milestone and pay it through bKash or Nagad and the creator is credited.</p></li>
                }
            </ol>
        </section>

        <section class="ui-card">
            <div class="ui-card-head" style="margin-bottom:2px;">
                <div class="ui-card-title" style="font-size:17px;">Frequently Asked Questions</div>
            </div>
            <div class="faq-list">
                @foreach (var faq in faqs)
                {
                    <details>
                        <summary>@faq.Item1<i class="bi bi-chevron-right"></i></summary>
                        <p>@faq.Item2</p>
                    </details>
                }
            </div>
        </section>

        <section class="help-card">
            <h3>Need Help?</h3>
            <p>Unsure about an offer or how collaborations work? Our support team can step in.</p>
            <a href="/contact?accountType=Brand#contactForm">Contact Support <i class="bi bi-arrow-right"></i></a>
            <svg viewBox="0 0 400 170" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="pd-help-wave" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#0955ca" stop-opacity="0"/><stop offset=".65" stop-color="#168cff" stop-opacity=".5"/><stop offset="1" stop-color="#783dff" stop-opacity=".15"/></linearGradient></defs><path d="M-20 160 C100 50 140 220 260 105 S350 85 420 20 L420 190 H-20Z" fill="url(#pd-help-wave)"/><path d="M-20 164 C110 90 140 230 270 120 S360 70 420 40" fill="none" stroke="#2799ff" stroke-opacity=".4"/></svg>
        </section>

    </aside>

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.tab-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('is-active'); });
                document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('is-active'); });
                btn.classList.add('is-active');
                document.querySelector('.tab-panel[data-panel="' + btn.dataset.tab + '"]').classList.add('is-active');
            });
        });
    </script>
}
