@model Brandora.Web.Models.Domain.Proposal
@using Brandora.Web.Models.Influencers
@{
    ViewData["Title"] = "Proposal";
    ViewData["ActiveNav"] = "Campaigns";
    Layout = "_AppLayout";
    var hue = (Model.InfluencerProfile.Id * 47) % 360;
}

@section Styles {

    .detail-shell {
        max-width: 720px;
        margin: 0 auto;

        animation: fade-up .4s ease both;
    }

    .detail-crumb {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #8189a8;
    }

    .proposal-header {
        margin-top: 14px;
        padding: 28px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        display: flex;
        align-items: flex-start;
        gap: 18px;
    }

    .proposal-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 22px;
        color: #171d3d;
    }

    .proposal-sub {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #6b7290;
    }

    .proposal-card {
        margin-top: 18px;
        padding: 28px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .proposal-figures {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 20px;
        color: #171d3d;
    }

    .figure-label {
        margin-top: 3px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .proposal-block {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #f0f1f7;
    }

    .proposal-block-label {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .proposal-block-text {
        margin-top: 8px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        line-height: 1.7;
        color: #3c4363;

        white-space: pre-wrap;
    }

    .decision-panel {
        margin-top: 18px;
        padding: 26px 30px;

        border-radius: 18px;
        border: 1px solid #eaecf5;
        background:
            radial-gradient(circle at 100% 0%, rgba(155,44,255,.06), transparent 50%),
            #ffffff;
    }

    .decision-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 15px;
        color: #171d3d;
    }

    .decision-sub {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #8189a8;
    }

    .decision-actions {
        margin-top: 18px;

        display: flex;
        gap: 12px;
    }

    .decision-actions form {
        flex: 1;
    }

    .decision-actions .btn {
        width: 100%;
        height: 50px;
    }

    .outcome-banner {
        margin-top: 18px;
        padding: 20px 24px;

        border-radius: 16px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .outcome-banner.accepted {
        background: #e2faf1;
        border: 1px solid #b9f1dd;
    }

    .outcome-banner.rejected {
        background: #fde8ea;
        border: 1px solid #f6c3ca;
    }

    .outcome-text {
        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        color: #2a3157;
    }

}

<div class="detail-shell">

    <div class="detail-crumb"><a href="/Proposals">Proposals</a> / @Model.InfluencerProfile.FullName</div>

    <div class="proposal-header">
        <div class="creator-avatar" style="background: linear-gradient(135deg, hsl(@(hue)deg 75% 58%), hsl(@((hue + 45) % 360)deg 75% 48%));">
            @FollowerFormat.InitialsOf(Model.InfluencerProfile.FullName)
        </div>
        <div>
            <div class="proposal-title">@Model.InfluencerProfile.FullName</div>
            <div class="proposal-sub">Proposal for <a href="/Campaigns/Detail/@Model.CampaignId">@Model.Campaign.Title</a> &middot; sent @Model.CreatedAt.ToString("MMM d, yyyy")</div>
        </div>
        <span class="status-pill @Model.Status.ToString().ToLowerInvariant()" style="margin-left:auto;">@Model.Status</span>
    </div>

    <div class="proposal-card">

        <div class="proposal-figures">
            <div>
                <div class="figure-value">৳@Model.ProposedAmount.ToString("N0")</div>
                <div class="figure-label">Proposed Amount</div>
            </div>
            <div>
                <div class="figure-value">@(Model.Timeline ?? "Not specified")</div>
                <div class="figure-label">Timeline</div>
            </div>
            <div>
                <div class="figure-value">@Model.InitiatedBy</div>
                <div class="figure-label">Initiated By</div>
            </div>
        </div>

        <div class="proposal-block">
            <div class="proposal-block-label">Deliverables</div>
            <p class="proposal-block-text">@Model.Deliverables</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="proposal-block">
                <div class="proposal-block-label">Message</div>
                <p class="proposal-block-text">@Model.Message</p>
            </div>
        }

    </div>

    @if (Model.Status == Brandora.Web.Models.Domain.ProposalStatus.Pending)
    {
        <div class="decision-panel">
            <div class="decision-title">Awaiting response</div>
            <p class="decision-sub">Once @Model.InfluencerProfile.FullName confirms outside Brandora, record the outcome here to move this into a collaboration.</p>

            <div class="decision-actions">
                <form method="post" action="/Proposals/ConfirmAccept/@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Confirm Acceptance</button>
                </form>
                <form method="post" action="/Proposals/Reject/@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost">Withdraw Invite</button>
                </form>
            </div>
        </div>
    }
    else if (Model.Status == Brandora.Web.Models.Domain.ProposalStatus.Accepted)
    {
        <div class="outcome-banner accepted">
            <span class="outcome-text">Accepted &mdash; a collaboration has been started.</span>
            @if (Model.Collaboration is not null)
            {
                <a href="/Collaborations/Detail/@Model.Collaboration.Id" class="btn btn-secondary">Manage Collaboration</a>
            }
        </div>
    }
    else if (Model.Status == Brandora.Web.Models.Domain.ProposalStatus.Rejected)
    {
        <div class="outcome-banner rejected">
            <span class="outcome-text">This invite was withdrawn.</span>
            <a href="/Proposals/Invite?influencerId=@Model.InfluencerProfileId&campaignId=@Model.CampaignId" class="btn btn-secondary">Send New Invite</a>
        </div>
    }

</div>
