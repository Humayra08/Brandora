@model Brandora.Web.Models.Payments.PaymentListViewModel
@{
    ViewData["Title"] = "Finance";
    ViewData["ActiveNav"] = "Finance";
    Layout = "_AppLayout";
}

@section Styles {

    .page-head {
        animation: fade-up .4s ease both;
    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 28px;
    }

    .page-sub {
        margin-top: 6px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    .finance-columns {
        margin-top: 22px;
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 20px;
        align-items: start;
    }

    .finance-side {
        display: flex;
        flex-direction: column;
        gap: 16px;
        position: sticky;
        top: 20px;
    }

    .finance-side-card {
        padding: 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, #ffffffbd, #f5faff8c 55%, #fafdffd9);
        border: 1px solid #cfe2ff;
    }

    .finance-side-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13.5px;
        color: #171d3d;
    }

    .spend-bar-track {
        margin-top: 12px;
        height: 8px;
        border-radius: 8px;
        background: #e2eaff;
        overflow: hidden;
    }

    .spend-bar-fill {
        height: 100%;
        border-radius: 8px;
        background: linear-gradient(90deg, #7224ff, #087fff);
    }

    .spend-figures {
        margin-top: 10px;
        display: flex;
        justify-content: space-between;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: #56617f;
    }

    .spend-figures strong {
        color: #171d3d;
    }

    .method-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #e3edff;
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #2a3157;
    }

    .method-row:last-child { border-bottom: none; }

    .method-row-chip {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .method-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7224ff, #087fff);
    }

    .method-count {
        font-weight: 700;
        color: #171d3d;
    }

    .txn-panel {
        padding: 26px 28px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #cfe2ff;

        animation: fade-up .5s ease both;
    }

    @@media(max-width: 900px) {
        .finance-columns { grid-template-columns: 1fr; }
        .finance-side { position: static; }
    }

    .txn-table {
        margin-top: 18px;

        width: 100%;
        border-collapse: collapse;
    }

    .txn-table th {
        padding: 10px 14px;

        text-align: left;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;

        border-bottom: 1px solid #f0f1f7;
    }

    .txn-table td {
        padding: 14px;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #2a3157;

        border-bottom: 1px solid #f5f6fb;
    }

    .txn-table tr:last-child td {
        border-bottom: none;
    }

    .txn-amount {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        color: #171d3d;
    }

    .txn-scroll {
        overflow-x: auto;
    }

}

<a href="/Dashboard" class="back-to-dashboard">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Back to Dashboard
</a>

<section class="page-hero">
    @await Html.PartialAsync("_HeroWaves")
    <div class="page-hero-intro">
        <p class="page-hero-eyebrow">Finance</p>
        <h1 class="page-hero-title">Your Work <span>Creates Value</span></h1>
        <p class="page-hero-sub">Keep your campaign spending, milestone funding and creator payments organized in one place.</p>
    </div>

    <div class="page-hero-art" aria-hidden="true">
        <div class="hero-glass hero-glass-back"></div>
        <div class="hero-glass hero-glass-front">
            <span class="hero-glass-copy">Create.<br />Collaborate.<br />Get Rewarded.<span></span></span>
        </div>
        <span class="hero-sparkle"></span>
    </div>

    <div class="page-hero-motto">Turning Campaigns<br />into Opportunities.<span></span></div>
</section>

<section class="metric-band">

    <div class="metric-block tone-a is-visible">
        <div class="metric-main">
            <span class="metric-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 21c-4.4-2.6-8-6.2-8-10.5A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 8 4.5c0 4.3-3.6 7.9-8 10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            </span>
            <div>
                <div class="metric-label">Total Paid</div>
                <strong class="metric-value">৳@Model.TotalPaid.ToString("N0")</strong>
                <p class="metric-context">@Model.CompletedCount transaction@(Model.CompletedCount == 1 ? "" : "s")</p>
            </div>
        </div>
        <div class="metric-footer"><span class="metric-accent"></span><span class="metric-footer-link">All time</span></div>
    </div>

    <div class="metric-block tone-b is-visible">
        <div class="metric-main">
            <span class="metric-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div>
                <div class="metric-label">Pending Confirmation</div>
                <strong class="metric-value">৳@Model.TotalPending.ToString("N0")</strong>
                <p class="metric-context">@Model.PendingCount transaction@(Model.PendingCount == 1 ? "" : "s")</p>
            </div>
        </div>
        <div class="metric-footer"><span class="metric-accent"></span><span class="metric-footer-link">Awaiting confirmation</span></div>
    </div>

    <div class="metric-block tone-e is-visible">
        <div class="metric-main">
            <span class="metric-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.8"/></svg>
            </span>
            <div>
                <div class="metric-label">Campaign Spend</div>
                <strong class="metric-value">৳@Model.TotalCampaignSpend.ToString("N0")</strong>
                <p class="metric-context">of ৳@Model.TotalCampaignBudget.ToString("N0") total budget</p>
            </div>
        </div>
        <div class="metric-footer"><span class="metric-accent"></span><span class="metric-footer-link">Across all campaigns</span></div>
    </div>

</section>

<div class="finance-columns">

    <div class="txn-panel">
        <div class="panel-title">Transaction History</div>

        @if (Model.Payments.Count > 0)
        {
            <div class="txn-scroll">
                <table class="txn-table">
                    <thead>
                        <tr>
                            <th>Campaign</th>
                            <th>Creator</th>
                            <th>Milestone</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td><a href="/Campaigns/Detail/@payment.Collaboration.CampaignId">@payment.Collaboration.Campaign.Title</a></td>
                                <td><a href="/Influencers/Profile/@payment.Collaboration.InfluencerProfileId">@payment.Collaboration.InfluencerProfile.FullName</a></td>
                                <td>@(payment.Milestone?.Title ?? "—")</td>
                                <td class="txn-amount">৳@payment.Amount.ToString("N0")</td>
                                <td><span class="status-pill @payment.Status.ToString().ToLowerInvariant()">@payment.Status</span></td>
                                <td>@(payment.PaidAt?.ToString("MMM d, yyyy") ?? payment.CreatedAt.ToString("MMM d, yyyy"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-block">
                <div class="empty-title">No transactions yet</div>
                <p class="empty-text">Once you release payment on an approved milestone, it will show up here.</p>
            </div>
        }
    </div>

    <aside class="finance-side">

        <div class="finance-side-card">
            <div class="finance-side-title">Campaign Budget Usage</div>
            <div class="spend-bar-track">
                <div class="spend-bar-fill" style="width: @(Model.TotalCampaignBudget > 0 ? Math.Min(100, (double)(Model.TotalCampaignSpend / Model.TotalCampaignBudget * 100)) : 0)%;"></div>
            </div>
            <div class="spend-figures">
                <span>Spent <strong>৳@Model.TotalCampaignSpend.ToString("N0")</strong></span>
                <span>Budget <strong>৳@Model.TotalCampaignBudget.ToString("N0")</strong></span>
            </div>
        </div>

        <div class="finance-side-card">
            <div class="finance-side-title">Payment Methods Used</div>
            @if (Model.MethodCounts.Count == 0)
            {
                <p class="empty-text" style="margin-top: 10px;">No payments have recorded a method yet — this fills in as milestone payments are released.</p>
            }
            else
            {
                <div style="margin-top: 8px;">
                    @foreach (var kv in Model.MethodCounts)
                    {
                        <div class="method-row">
                            <span class="method-row-chip"><span class="method-dot"></span>@kv.Key</span>
                            <span class="method-count">@kv.Value</span>
                        </div>
                    }
                </div>
            }
        </div>

    </aside>

</div>
