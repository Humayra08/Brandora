@model Brandora.Web.Models.Payments.PaymentListViewModel
@using Brandora.Web.Models.Domain
@{
    ViewData["Title"] = "Finance";
    ViewData["ActiveNav"] = "Finance";
    Layout = "_AppLayout";

    var budgetPercent = Model.TotalCampaignBudget > 0
        ? (int)Math.Round(Math.Min(100, (double)(Model.TotalCampaignSpend / Model.TotalCampaignBudget * 100)))
        : 0;
    var totalFees = Model.Payments.Where(p => p.Status == PaymentStatus.Completed).Sum(p => p.PlatformFeeAmount);

    // Where a not-yet-paid milestone sits in the approve -> release -> bKash pipeline.
    // Colours stay inside the same soft chip palette the Influencer side uses.
    (string Label, string Badge, string Chip, string Icon, string Detail, string Action) Stage(Milestone m)
    {
        if (m.Payment is { Status: PaymentStatus.Pending })
            return ("Awaiting bKash Payment", "is-pending", "amber", "bi-wallet2", "Released — complete checkout on bKash to pay the creator.", "Pay now");
        if (m.Status == MilestoneStatus.Approved && m.BrandApprovedAt is not null)
            return ("Ready to Release", "is-violet", "violet", "bi-unlock", "Approved by you and Brandora — release the payment.", "Release");
        if (m.Status == MilestoneStatus.Approved)
            return ("Needs Your Approval", "is-info", "blue", "bi-patch-check", "Brandora verified the proof — your sign-off is the last step.", "Review");
        if (m.BrandApprovedAt is not null)
            return ("Brandora Verifying", "is-info", "cyan", "bi-shield-check", "You approved it — our team is doing the final proof check.", "View");
        if (m.Status == MilestoneStatus.Submitted)
            return ("Needs Your Review", "is-info", "blue", "bi-eye", "Proof of post submitted — review it and approve or request changes.", "Review");
        if (m.Status == MilestoneStatus.RevisionRequested)
            return ("Revision Requested", "is-pending", "pink", "bi-arrow-repeat", "Waiting for the creator to resubmit their proof.", "View");
        return ("Awaiting Content", "is-neutral", "soft", "bi-hourglass-split", "The creator hasn't submitted proof of post yet.", "View");
    }

    string MethodName(PaymentMethod? method) => method switch
    {
        PaymentMethod.Bkash => "bKash",
        PaymentMethod.Nagad => "Nagad",
        PaymentMethod.BankTransfer => "Bank Transfer",
        _ => "—"
    };

    var faqs = new[]
    {
        ("When can I release a milestone payment?", "As soon as both you and Brandora's review team have approved the creator's proof of post. The milestone then shows as Ready to Release here and on its own page."),
        ("How is the payment actually made?", "Releasing opens a secure bKash checkout. Nothing is charged until you confirm on bKash's own page, and a payment is only marked Paid after bKash confirms the transaction to our server."),
        ("What if a bKash payment fails or I cancel it?", "Nothing is charged. The payment stays in Awaiting bKash Payment so you can retry Pay with bKash from the milestone whenever you're ready."),
        ($"What is the {Model.PlatformFeePercent:0.#}% platform fee?", $"Brandora keeps {Model.PlatformFeePercent:0.#}% of each milestone payment. The rest is credited straight to the creator's wallet — you always pay the milestone amount you agreed."),
        ("Can I pay a creator before they deliver?", "No. Payments are tied to milestones, so money only moves once the agreed content has been delivered, checked and approved."),
    };
}

@section Styles {

    .metric-band.four { grid-template-columns: repeat(4, 1fr); }
    @@media(max-width: 1250px) { .metric-band.four { grid-template-columns: repeat(2, 1fr); } }
    @@media(max-width: 640px) { .metric-band.four { grid-template-columns: 1fr; } }

    .finance-flow { margin-top: 16px; }

    .finance-body { margin-top: 16px; }

    /* ---- Ongoing milestones ---- */
    .pipeline-list { display: grid; gap: 10px; }

    .pipeline-row {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto auto;
        align-items: center;
        gap: 14px;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid #e3edfc;
        background: #ffffff8c;
        box-shadow: 0 3px 9px #9bbfe90b;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .pipeline-row:hover {
        transform: translateY(-2px);
        border-color: #b9d3ff;
        box-shadow: 0 12px 24px #5b83c41a;
    }

    .pipeline-row-title { font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 700; color: #101d48; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pipeline-row-meta { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #5877ac; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pipeline-row-detail { margin-top: 6px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #6680ad; }
    .pipeline-row-amount { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700; color: #0b124e; white-space: nowrap; padding-left: 14px; border-left: 1px solid #e9f1fd; }

    .pipeline-row-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 8px;
        border: 1px solid #d7e8ff;
        background: #ffffffb8;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        color: #1451ff;
        white-space: nowrap;
        transition: .2s ease;
    }

    .pipeline-row:hover .pipeline-row-action { border-color: #1451ff; }

    .pipeline-row-action.is-primary {
        border-color: transparent;
        background: linear-gradient(110deg, #6425ff, #004dff 55%, #00a8f0);
        color: #ffffff;
    }

    .pipeline-row:hover .pipeline-row-action.is-primary { box-shadow: 0 8px 18px #3b4dff40; }

    .pipeline-more { margin-top: 12px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #6680ad; }

    /* ---- Payment history table ---- */
    .txn-scroll { overflow-x: auto; }
    .txn-table { width: 100%; border-collapse: collapse; font-family: 'Inter', sans-serif; font-size: 12px; }
    .txn-table th { padding: 0 14px 10px 0; border-bottom: 1px solid #e1ecfa; text-align: left; font-size: 11px; font-weight: 500; color: #5877ac; white-space: nowrap; }
    .txn-table td { padding: 13px 14px 13px 0; border-bottom: 1px solid #eef4fd; color: #33477c; vertical-align: middle; }
    .txn-table tr:last-child td { border-bottom: 0; }
    .txn-table tbody tr { transition: background .2s ease; }
    .txn-table tbody tr:hover { background: #f3f8ff99; }
    .txn-table td strong { display: block; font-size: 12px; font-weight: 600; color: #172a5c; }
    .txn-table td small { display: block; margin-top: 2px; font-size: 11px; color: #8095c4; }
    .txn-table td a { color: inherit; }
    .txn-table td a:hover strong { color: #1451ff; }
    .txn-amount { font-family: 'DM Sans', sans-serif; font-weight: 700; color: #142652; white-space: nowrap; }
    .txn-ref { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: #5877ac; }

    /* ---- Rail ---- */
    .budget-figure { font-family: 'DM Sans', sans-serif; font-size: 26px; font-weight: 700; color: #101d48; }
    .budget-figure small { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; color: #5877ac; }
    .budget-track { margin-top: 12px; height: 7px; border-radius: 7px; background: #e3edfc; overflow: hidden; }
    .budget-fill { height: 100%; border-radius: 7px; background: linear-gradient(110deg, #6323ff, #0759ff); transition: width 1s cubic-bezier(.22,1,.36,1); }

    .method-card { display: flex; align-items: center; gap: 12px; padding: 11px 0; border-top: 1px solid #eef4fd; }
    .method-card:first-of-type { border-top: 0; }
    .method-logo { display: grid; place-items: center; flex-shrink: 0; width: 40px; height: 40px; padding: 5px; border-radius: 10px; border: 1px solid #eef1fa; background: #ffffff; }
    .method-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .method-card strong { display: block; font-family: 'DM Sans', sans-serif; font-size: 13px; color: #142652; }
    .method-card small { display: block; margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11px; color: #8095c4; }
    .method-card .ui-badge { margin-left: auto; }

    .fee-note { margin-top: 12px; padding: 10px 12px; border-radius: 9px; background: #eef4ffbd; border: 1px solid #dfe9ff; font-family: 'Inter', sans-serif; font-size: 11.5px; line-height: 1.5; color: #33477c; }

    @@media(max-width: 760px) {
        .pipeline-row { grid-template-columns: auto minmax(0, 1fr); }
        .pipeline-row-amount { padding-left: 0; border-left: 0; }
    }

}

<a href="/Dashboard" class="back-to-dashboard">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Back
</a>

<section class="page-hero">
    @await Html.PartialAsync("_HeroWaves")
    <div class="page-hero-intro">
        <p class="page-hero-eyebrow">Finance</p>
        <h1 class="page-hero-title">Invest in Creators. <span>Pay with Confidence.</span></h1>
        <p class="page-hero-sub">Track every milestone from proof of post to payout, and release payments securely through bKash.</p>
        <ul class="hero-highlights">
            <li>Milestone-based payouts</li>
            <li>Two-step proof approval</li>
            <li>Secure bKash checkout</li>
        </ul>
    </div>

    <div class="page-hero-art" aria-hidden="true">
        <div class="hero-glass hero-glass-back"></div>
        <div class="hero-glass hero-glass-front">
            <span class="hero-glass-copy">Approve.<br />Release.<br />Get Results.<span></span></span>
        </div>
        <span class="hero-sparkle"></span>
    </div>

    <div class="page-hero-motto">Turning Campaigns<br />into Real Impact.<span></span></div>
</section>

<section class="metric-band four">

    <div class="metric-block tone-d is-visible">
        <div class="metric-main">
            <span class="metric-icon" aria-hidden="true"><i class="bi bi-check-circle-fill" style="font-size:20px;"></i></span>
            <div>
                <div class="metric-label">Total Paid</div>
                <strong class="metric-value">৳@Model.TotalPaid.ToString("N0")</strong>
                <p class="metric-context">@Model.CompletedCount completed payment@(Model.CompletedCount == 1 ? "" : "s")</p>
            </div>
        </div>
        <div class="metric-footer"><span class="metric-accent"></span><span class="metric-footer-link">All time</span></div>
    </div>

    <div class="metric-block tone-a is-visible">
        <div class="metric-main">
            <span class="metric-icon" aria-hidden="true"><i class="bi bi-unlock-fill" style="font-size:20px;"></i></span>
            <div>
                <div class="metric-label">Ready to Release</div>
                <strong class="metric-value">৳@Model.ReadyToReleaseAmount.ToString("N0")</strong>
                <p class="metric-context">@Model.ReadyToReleaseCount approved milestone@(Model.ReadyToReleaseCount == 1 ? "" : "s")</p>
            </div>
        </div>
        <div class="metric-footer"><span class="metric-accent"></span><span class="metric-footer-link">Approved by both sides</span></div>
    </div>

    <div class="metric-block tone-e is-visible">
        <div class="metric-main">
            <span class="metric-icon" aria-hidden="true"><i class="bi bi-hourglass-split" style="font-size:20px;"></i></span>
            <div>
                <div class="metric-label">Awaiting bKash Payment</div>
                <strong class="metric-value">৳@Model.TotalPending.ToString("N0")</strong>
                <p class="metric-context">@Model.PendingCount released payment@(Model.PendingCount == 1 ? "" : "s")</p>
            </div>
        </div>
        <div class="metric-footer"><span class="metric-accent"></span><span class="metric-footer-link">Complete checkout to pay</span></div>
    </div>

    <div class="metric-block tone-b is-visible">
        <div class="metric-main">
            <span class="metric-icon" aria-hidden="true"><i class="bi bi-pie-chart-fill" style="font-size:20px;"></i></span>
            <div>
                <div class="metric-label">Campaign Spend</div>
                <strong class="metric-value">৳@Model.TotalCampaignSpend.ToString("N0")</strong>
                <p class="metric-context">@budgetPercent% of ৳@Model.TotalCampaignBudget.ToString("N0") budget</p>
            </div>
        </div>
        <div class="metric-footer"><span class="metric-accent"></span><span class="metric-footer-link">Across all campaigns</span></div>
    </div>

</section>

<ol class="flow-steps finance-flow" aria-label="How milestone payments work">
    <li class="is-done"><span class="flow-step-num">1</span><div><strong>Creator Submits Proof</strong><small>Proof of post for a milestone</small></div></li>
    <li class="is-done"><span class="flow-step-num">2</span><div><strong>You Approve</strong><small>Check it matches the brief</small></div></li>
    <li class="is-done"><span class="flow-step-num">3</span><div><strong>Brandora Verifies</strong><small>Independent final check</small></div></li>
    <li class="is-current"><span class="flow-step-num">4</span><div><strong>Release &amp; Pay</strong><small>Secure bKash checkout</small></div></li>
</ol>

<div class="page-grid finance-body">

    <div class="page-main">

        <section class="ui-card">
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Ongoing Milestones</div>
                    <p class="ui-card-sub">
                        @if (Model.AwaitingReviewCount > 0)
                        {
                            <text>@Model.AwaitingReviewCount milestone@(Model.AwaitingReviewCount == 1 ? " is" : "s are") waiting on your review.</text>
                        }
                        else
                        {
                            <text>Where each unpaid milestone stands, from proof review to payout.</text>
                        }
                    </p>
                </div>
                <a href="/Collaborations" class="ui-card-link">Manage Collaborations <i class="bi bi-arrow-right"></i></a>
            </div>

            @if (Model.OngoingMilestones.Count > 0)
            {
                <div class="pipeline-list">
                    @foreach (var milestone in Model.OngoingMilestones)
                    {
                        var stage = Stage(milestone);
                        var isPrimary = stage.Action is "Pay now" or "Release" or "Review";
                        <a href="/Milestones/Detail/@milestone.Id" class="pipeline-row">
                            <span class="icon-chip @stage.Chip"><i class="bi @stage.Icon"></i></span>
                            <div style="min-width:0;">
                                <div class="pipeline-row-title">@milestone.Title</div>
                                <div class="pipeline-row-meta">@milestone.Collaboration.Campaign.Title &middot; @milestone.Collaboration.InfluencerProfile.FullName</div>
                                <div class="pipeline-row-detail"><span class="ui-badge @stage.Badge">@stage.Label</span> &nbsp;@stage.Detail</div>
                            </div>
                            <span class="pipeline-row-amount">৳@milestone.Amount.ToString("N0")</span>
                            <span class="pipeline-row-action @(isPrimary ? "is-primary" : "")">@stage.Action <i class="bi bi-arrow-right"></i></span>
                        </a>
                    }
                </div>
                @if (Model.OngoingTotalCount > Model.OngoingMilestones.Count)
                {
                    <p class="pipeline-more">Showing the @Model.OngoingMilestones.Count most urgent of @Model.OngoingTotalCount open milestones &mdash; see every one from Manage Collaborations.</p>
                }
            }
            else
            {
                <div class="empty-block">
                    <span class="icon-chip soft" style="margin:0 auto 10px;"><i class="bi bi-flag"></i></span>
                    <div class="empty-title">No milestones in progress</div>
                    <p class="empty-text">Once a creator submits proof of post for a milestone, it appears here with exactly what's needed to get it paid.</p>
                </div>
            }
        </section>

        <section class="ui-card">
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Payment History</div>
                    <p class="ui-card-sub">Every payment you've released, with fees and bKash transaction references.</p>
                </div>
            </div>

            @if (Model.Payments.Count > 0)
            {
                <div class="txn-scroll">
                    <table class="txn-table">
                        <thead>
                            <tr>
                                <th scope="col">Date</th>
                                <th scope="col">Campaign &amp; Creator</th>
                                <th scope="col">Milestone</th>
                                <th scope="col">Amount</th>
                                <th scope="col">Creator Receives</th>
                                <th scope="col">Status</th>
                                <th scope="col">Method</th>
                                <th scope="col">Transaction ID</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td>@((payment.PaidAt ?? payment.CreatedAt).ToString("MMM d, yyyy"))</td>
                                    <td>
                                        <a href="/Collaborations/Detail/@payment.CollaborationId">
                                            <strong>@payment.Collaboration.Campaign.Title</strong>
                                            <small>@payment.Collaboration.InfluencerProfile.FullName</small>
                                        </a>
                                    </td>
                                    <td>
                                        @if (payment.MilestoneId is not null)
                                        {
                                            <a href="/Milestones/Detail/@payment.MilestoneId"><strong>@(payment.Milestone?.Title ?? "Milestone")</strong></a>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="txn-amount">৳@payment.Amount.ToString("N0")</td>
                                    <td>
                                        @if (payment.Status == PaymentStatus.Completed)
                                        {
                                            <strong>৳@payment.NetAmount.ToString("N0")</strong>
                                            <small>৳@payment.PlatformFeeAmount.ToString("N0") platform fee</small>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (payment.Status == PaymentStatus.Completed)
                                        {
                                            <span class="ui-badge is-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                        }
                                        else if (payment.Status == PaymentStatus.Pending)
                                        {
                                            <span class="ui-badge is-pending"><i class="bi bi-arrow-repeat"></i> Awaiting payment</span>
                                        }
                                        else
                                        {
                                            <span class="ui-badge is-danger"><i class="bi bi-exclamation-circle-fill"></i> Failed</span>
                                        }
                                    </td>
                                    <td>@MethodName(payment.Method)</td>
                                    <td class="txn-ref">@(payment.TransactionReference ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-block">
                    <span class="icon-chip soft" style="margin:0 auto 10px;"><i class="bi bi-wallet2"></i></span>
                    <div class="empty-title">No payments yet</div>
                    <p class="empty-text">Payments appear here once you release funds for an approved milestone.</p>
                    <a href="/Collaborations" class="btn btn-primary" style="margin-top: 16px; height: 40px;">View Collaborations</a>
                </div>
            }
        </section>

    </div>

    <aside class="page-rail">

        <section class="ui-card">
            <div class="ui-card-head" style="margin-bottom:6px;">
                <div class="ui-card-title" style="font-size:17px;">Budget Usage</div>
                <span class="ui-badge is-violet">@budgetPercent% used</span>
            </div>
            <div class="budget-figure">৳@Model.TotalCampaignSpend.ToString("N0") <small>of ৳@Model.TotalCampaignBudget.ToString("N0")</small></div>
            <div class="budget-track"><div class="budget-fill" style="width: @budgetPercent%;"></div></div>
            <dl class="fact-list" style="margin-top:12px;">
                <div><dt>Remaining budget</dt><dd>৳@Math.Max(0, Model.TotalCampaignBudget - Model.TotalCampaignSpend).ToString("N0")</dd></div>
                <div><dt>Platform fees paid</dt><dd>৳@totalFees.ToString("N0")</dd></div>
                <div><dt>Current fee rate</dt><dd>@Model.PlatformFeePercent.ToString("0.#")%</dd></div>
            </dl>
        </section>

        <section class="ui-card">
            <div class="ui-card-head" style="margin-bottom:4px;">
                <div>
                    <div class="ui-card-title" style="font-size:17px;">Payment Method</div>
                    <p class="ui-card-sub">How milestone payments are collected.</p>
                </div>
            </div>
            <div class="method-card">
                <span class="method-logo"><img src="~/images/payment-methods/bkash.svg" alt="bKash" /></span>
                <div>
                    <strong>bKash Checkout</strong>
                    <small>@(Model.MethodCounts.TryGetValue(PaymentMethod.Bkash, out var bkashCount) ? $"{bkashCount} payment{(bkashCount == 1 ? "" : "s")} completed" : "Used for every milestone payment")</small>
                </div>
                <span class="ui-badge is-success"><i class="bi bi-check-circle-fill"></i> Active</span>
            </div>
            <p class="fee-note"><i class="bi bi-info-circle"></i> You pay the agreed milestone amount. The @Model.PlatformFeePercent.ToString("0.#")% fee is deducted before the creator is credited.</p>
        </section>

        <section class="info-card">
            <div class="info-card-head">
                <span class="icon-chip soft"><i class="bi bi-shield-check"></i></span>
                <div class="info-card-title">Your Payments Are Secure</div>
            </div>
            <p>Checkout happens on bKash's own secure page. A payment is only marked paid once bKash confirms the transaction to our server &mdash; never from a browser redirect alone.</p>
        </section>

        <section class="ui-card">
            <div class="ui-card-head" style="margin-bottom:2px;">
                <div class="ui-card-title" style="font-size:17px;">Frequently Asked Questions</div>
            </div>
            <div class="faq-list">
                @foreach (var faq in faqs)
                {
                    <details>
                        <summary>@faq.Item1<i class="bi bi-chevron-right"></i></summary>
                        <p>@faq.Item2</p>
                    </details>
                }
            </div>
        </section>

        <section class="help-card">
            <h3>Need Help?</h3>
            <p>Questions about a payment, a fee or a failed checkout? Our support team can help.</p>
            <a href="/Home/Contact">Contact Support <i class="bi bi-arrow-right"></i></a>
            <svg viewBox="0 0 400 170" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="finance-help-wave" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#0955ca" stop-opacity="0"/><stop offset=".65" stop-color="#168cff" stop-opacity=".5"/><stop offset="1" stop-color="#783dff" stop-opacity=".15"/></linearGradient></defs><path d="M-20 160 C100 50 140 220 260 105 S350 85 420 20 L420 190 H-20Z" fill="url(#finance-help-wave)"/><path d="M-20 164 C110 90 140 230 270 120 S360 70 420 40" fill="none" stroke="#2799ff" stroke-opacity=".4"/></svg>
        </section>

    </aside>

</div>
