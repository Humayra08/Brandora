@model Brandora.Web.Models.Proposals.InfluencerProposalsViewModel
@using Brandora.Web.Models.Domain
@using System.Globalization
@{
    ViewData["Title"] = "My Proposals";
    ViewData["ActiveNav"] = "Proposals";
    Layout = null;
    var filters = new (ProposalStatus? Status, string Label)[] {
        (null, "All Proposals"), (ProposalStatus.Pending, "Pending"),
        (ProposalStatus.Accepted, "Accepted"), (ProposalStatus.Rejected, "Not Selected")
    };
    string PageUrl(int page, ProposalStatus? status) => Url.Action("Index", new { page, status, search = Model.Search, sort = Model.Sort })!;
    var initial = string.IsNullOrWhiteSpace(Model.InfluencerName) ? "I" : Model.InfluencerName[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Proposals - Brandora</title>
    <link rel="icon" href="~/images/brandora-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/dashboard-assets/dashboard-fonts.css" />
    <link rel="stylesheet" href="~/css/brandora-influencer-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-influencer-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brandora-proposals.css" asp-append-version="true" />
</head>
<body>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
@await Html.PartialAsync("_InfluencerSidebar")
<main class="proposals-page" id="dashboardMain">
    <header class="dashboard-topbar">
        <button class="dashboard-menu" id="menuToggleBtn" type="button" aria-label="Toggle sidebar" aria-controls="dashboardSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
        <form class="dashboard-search" method="get" asp-action="Index" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="search" value="@Model.Search" placeholder="Search campaigns, brands..." aria-label="Search campaigns and brands" />
            <input type="hidden" name="status" value="@Model.Status" />
            <input type="hidden" name="sort" value="@Model.Sort" />
            <button type="submit" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
        </form>
        <details class="dashboard-notifications">
            <summary aria-label="Notifications"><i class="bi bi-bell" aria-hidden="true"></i>@if ((ViewData["UnreadNotifications"] as int? ?? 0) > 0) { <span class="dashboard-unread"></span> }</summary>
            <div class="dashboard-notification-panel">
                <h2>Recent notifications</h2>
                @foreach (var notification in Model.Notifications)
                {
                    <article><strong>@notification.Title</strong><p>@notification.Body</p></article>
                }
                @if (Model.Notifications.Count == 0) { <p>You're all caught up.</p> }
            </div>
        </details>
        <a class="dashboard-account" href="/InfluencerSettings" aria-label="Your profile settings">
            <span class="dashboard-avatar">@initial</span>
            <span><strong>@Model.InfluencerName</strong><small>Influencer</small></span>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
        </a>
    </header>
    <section class="proposals-hero" aria-labelledby="proposals-title">
        <div class="proposals-hero-copy">
            <nav aria-label="Breadcrumb"><a href="/InfluencerDashboard">Home</a><span aria-hidden="true"> / </span><span aria-current="page">My Proposals</span></nav>
            <h1 id="proposals-title">My <span>Proposals</span></h1>
            <p>Track your proposals and see how they're progressing.</p>
        </div>
        <div class="dashboard-hero-art" aria-hidden="true">
            <div class="dashboard-glass dashboard-glass-back"></div>
            <div class="dashboard-glass dashboard-glass-front"><div class="dashboard-glass-copy">Ideas<br />Collaborations<br />Real Impact<span></span></div></div>
            <span class="dashboard-sparkle"></span>
        </div>
        <div class="dashboard-hero-motto">Consistent<br />Effort<br />Creates<br />Greater Opportunities.<span></span></div>
        @await Html.PartialAsync("~/Views/InfluencerDashboard/_Waves.cshtml", "hero")
    </section>
    <div class="proposals-content">
        <div class="proposal-toolbar">
            <nav class="proposal-filters" aria-label="Filter proposals">
                @foreach (var filter in filters)
                {
                    <a href="@PageUrl(1, filter.Status)" class="@(Model.Status == filter.Status ? "is-active" : "")" aria-current="@(Model.Status == filter.Status ? "page" : null)">@filter.Label</a>
                }
            </nav>
            <form method="get" asp-action="Index" class="proposals-sort">
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="status" value="@Model.Status" />
                <label for="proposal-sort" class="proposals-sr-only">Sort proposals</label>
                <select id="proposal-sort" name="sort">
                    <option value="newest" selected="@(Model.Sort == "newest")">Newest First</option>
                    <option value="oldest" selected="@(Model.Sort == "oldest")">Oldest First</option>
                </select>
                <button type="submit">Apply</button>
            </form>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <p class="proposals-search-result">Results for “@Model.Search” <a asp-action="Index" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort">Clear search</a></p>
        }
        <div class="proposal-list">
            @foreach (var proposal in Model.Proposals)
            {
                var campaign = proposal.Campaign;
                var statusClass = proposal.Status switch { ProposalStatus.Accepted => "status-accepted", ProposalStatus.Rejected => "status-rejected", _ => "status-pending" };
                var statusLabel = proposal.Status == ProposalStatus.Rejected ? "Not Selected" : proposal.Status.ToString();
                var statusMessage = proposal.Status switch { ProposalStatus.Accepted => "Campaign in progress", ProposalStatus.Rejected => "Keep going!", _ => "Awaiting response" };
                <article class="proposal-card" aria-labelledby="proposal-title-@proposal.Id">
                    <div class="proposal-campaign">
                        <div class="proposal-thumbnail">
                            @if (!string.IsNullOrWhiteSpace(campaign.MediaUrl) && campaign.MediaType != "video")
                            {
                                <img src="@campaign.MediaUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span aria-hidden="true">@(string.IsNullOrWhiteSpace(campaign.Title) ? "B" : campaign.Title[..1])</span>
                            }
                        </div>
                        <div class="proposal-campaign-copy">
                            <h2 id="proposal-title-@proposal.Id">@campaign.Title</h2>
                            <p class="proposal-brand">@campaign.BrandProfile.CompanyName</p>
                            <div class="proposal-tags">
                                @if (!string.IsNullOrWhiteSpace(campaign.Niche)) { <span>@campaign.Niche</span> }
                                @if (!string.IsNullOrWhiteSpace(campaign.Platform)) { <span>@campaign.Platform</span> }
                            </div>
                        </div>
                    </div>
                    <div class="proposal-meta"><span>Proposed Rate</span><strong>৳@proposal.ProposedAmount.ToString("N0", CultureInfo.InvariantCulture)</strong></div>
                    <div class="proposal-meta"><span>Deliverables</span><p>@proposal.Deliverables</p></div>
                    <div class="proposal-meta"><span>Date Submitted</span><time datetime="@proposal.CreatedAt.ToString("yyyy-MM-dd")">@proposal.CreatedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</time></div>
                    <div class="proposal-status"><span class="@statusClass">@statusLabel</span><small>@statusMessage</small></div>
                    <div class="proposal-action"><a asp-action="Detail" asp-route-id="@proposal.Id">@(proposal.Status == ProposalStatus.Accepted ? "View Details" : "View Proposal")<span class="proposals-sr-only">: @campaign.Title</span></a></div>
                </article>
            }
            @if (Model.Proposals.Count == 0)
            {
                <div class="proposals-empty">
                    <h2>@(Model.Status.HasValue || !string.IsNullOrWhiteSpace(Model.Search) ? "No matching proposals" : "Your next collaboration starts here")</h2>
                    <p>@(Model.Status.HasValue || !string.IsNullOrWhiteSpace(Model.Search) ? "Try another filter or search to find your proposals." : "Once you apply to a campaign or receive an invitation, your proposals will appear here.")</p>
                    <a href="@(Model.Status.HasValue || !string.IsNullOrWhiteSpace(Model.Search) ? Url.Action("Index") : "/InfluencerCampaigns")">@(Model.Status.HasValue || !string.IsNullOrWhiteSpace(Model.Search) ? "View all proposals" : "Explore campaigns")</a>
                </div>
            }
        </div>
        <footer class="proposals-footer">
            <p>Showing @(Model.TotalCount == 0 ? "0" : $"{(Model.Page - 1) * Model.PageSize + 1}–{(Model.Page - 1) * Model.PageSize + Model.Proposals.Count}") of @Model.TotalCount proposals</p>
            @if (Model.TotalPages > 1)
            {
                <nav class="proposals-pagination" aria-label="Proposal pages">
                    @if (Model.Page > 1) { <a href="@PageUrl(Model.Page - 1, Model.Status)" aria-label="Previous page">‹</a> }
                    else { <span aria-disabled="true" aria-label="Previous page">‹</span> }
                    @for (var pageNumber = Math.Max(1, Model.Page - 2); pageNumber <= Math.Min(Model.TotalPages, Model.Page + 2); pageNumber++)
                    {
                        <a href="@PageUrl(pageNumber, Model.Status)" class="@(pageNumber == Model.Page ? "is-active" : "")" aria-current="@(pageNumber == Model.Page ? "page" : null)" aria-label="Page @pageNumber">@pageNumber</a>
                    }
                    @if (Model.Page < Model.TotalPages) { <a href="@PageUrl(Model.Page + 1, Model.Status)" aria-label="Next page">›</a> }
                    else { <span aria-disabled="true" aria-label="Next page">›</span> }
                </nav>
            }
        </footer>
    </div>
</main>
<script src="~/js/brandora-influencer-dashboard.js" asp-append-version="true"></script>
<script src="~/js/brandora-proposals.js" asp-append-version="true"></script>
</body>
</html>