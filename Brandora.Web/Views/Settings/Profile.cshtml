@model Brandora.Web.Models.Domain.BrandProfile
@using Brandora.Web.Models.Domain
@{
    ViewData["Title"] = "Profile";
    ViewData["ActiveNav"] = "Profile";
    Layout = "_AppLayout";

    var hue = (Model.Id * 47) % 360;

    var completenessChecks = new[]
    {
        !string.IsNullOrWhiteSpace(Model.CompanyName),
        !string.IsNullOrWhiteSpace(Model.ContactFullName),
        !string.IsNullOrWhiteSpace(Model.Industry),
        !string.IsNullOrWhiteSpace(Model.MonthlyBudget),
        !string.IsNullOrWhiteSpace(Model.WebsiteUrl),
        !string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)
    };
    var completenessPercent = (int)Math.Round(completenessChecks.Count(c => c) * 100.0 / completenessChecks.Length);
}

@section Styles {

    .profile-shell {
        max-width: 780px;
        margin: 0 auto;

        animation: fade-up .4s ease both;
    }

    .detail-crumb {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #8189a8;
    }

    .profile-avatar {
        position: relative;
        overflow: hidden;
        flex-shrink: 0;

        width: 56px;
        height: 56px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        background: linear-gradient(135deg, hsl(@(hue)deg 75% 58%), hsl(@((hue + 45) % 360)deg 75% 48%));

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 18px;
        line-height: 1;
        color: #ffffff;

        box-shadow: 0 0 0 4px #ffffffb0;
    }

    .profile-avatar img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-handle {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    .profile-tags {
        margin-top: 14px;

        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .rejection-banner {
        margin-top: 18px;
        padding: 14px 18px;

        border-radius: 14px;
        background: #fde8ea;
        border: 1px solid #f4c6cd;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        line-height: 1.6;
        color: #c22540;
    }

    .stat-strip {
        margin-top: 18px;

        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;

        padding: 26px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        animation: fade-up .5s ease both;
    }

    .figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 22px;
        color: #171d3d;
    }

    .figure-label {
        margin-top: 3px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .profile-section {
        margin-top: 18px;
        padding: 26px 30px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        animation: fade-up .55s ease both;
    }

    .profile-section-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 15px;
        color: #171d3d;
    }

    .profile-info-grid {
        margin-top: 14px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px 24px;
    }

    .profile-info-value-full {
        grid-column: span 2;
    }

    .profile-info-label {
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .profile-info-value {
        margin-top: 4px;
        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #171d3d;
        word-break: break-word;
    }

    .profile-info-value a {
        color: #7a2df3;
        font-weight: 600;
    }

    .completeness-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .completeness-bar {
        margin-top: 12px;
        height: 6px;
        border-radius: 6px;
        background: #e8eaf5;
        overflow: hidden;
    }

    .completeness-bar-fill {
        height: 100%;
        border-radius: 6px;
        background: linear-gradient(90deg, #a326ff, #236eff);
        transition: width .4s ease;
    }

    .completeness-hint {
        margin-top: 10px;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #9096b3;
    }

    @@media(max-width: 480px) {
        .profile-info-grid { grid-template-columns: 1fr; }
        .profile-info-value-full { grid-column: span 1; }
    }

    @@media(max-width: 640px) {
        .stat-strip { grid-template-columns: 1fr 1fr; }
    }

}

<div class="profile-shell">

    <a href="/Dashboard" class="back-to-dashboard">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back
    </a>

    <section class="page-hero">
        @await Html.PartialAsync("_HeroWaves")
        <div class="page-hero-intro">
            <div class="detail-crumb"><a href="/Dashboard">Dashboard</a> / Brand Profile</div>

            <div style="display:flex; align-items:center; gap:14px; margin-top:10px;">
                <div class="profile-avatar">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.CompanyName" />
                    }
                    else
                    {
                        @(string.IsNullOrEmpty(Model.CompanyName) ? "B" : Model.CompanyName[..1].ToUpperInvariant())
                    }
                </div>
                <div>
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                        <h1 class="page-hero-title" style="margin-top:0;">@Model.CompanyName</h1>
                        <span class="status-pill @Model.VerificationStatus.ToString().ToLowerInvariant()">@Model.VerificationStatus</span>
                    </div>
                    <p class="profile-handle">@Model.ContactFullName &middot; @(string.IsNullOrEmpty(Model.Industry) ? "Industry not set" : Model.Industry)</p>
                </div>
            </div>

            <div class="profile-tags">
                @if (!string.IsNullOrEmpty(Model.Industry))
                {
                    <span class="tag">@Model.Industry</span>
                }
                @if (!string.IsNullOrEmpty(Model.MonthlyBudget))
                {
                    <span class="tag">Budget: @Model.MonthlyBudget</span>
                }
                <span class="tag">Member since @Model.CreatedAt.ToString("MMM yyyy")</span>
            </div>

            <div class="hero-actions" style="margin-top: 18px; flex-wrap: wrap;">
                <a href="/Settings" class="btn btn-primary">Edit Profile</a>
                @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                {
                    <a href="@Model.WebsiteUrl" target="_blank" rel="noopener" class="btn btn-outline-brand">Visit Website</a>
                }
            </div>
        </div>

        <div class="page-hero-art" aria-hidden="true">
            <div class="hero-glass hero-glass-back"></div>
            <div class="hero-glass hero-glass-front">
                <span class="hero-glass-copy">Your Brand<br />Your Story<br />Your Campaigns<span></span></span>
            </div>
            <span class="hero-sparkle"></span>
        </div>

        <div class="page-hero-motto">Build Trust.<br />Grow Reach.<span></span></div>
    </section>

    @if (Model.VerificationStatus == VerificationStatus.Rejected && !string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="rejection-banner">
            <strong>Verification was rejected:</strong> @Model.RejectionReason
        </div>
    }

    <div class="stat-strip">
        <div>
            <div class="figure-value">@ViewData["CampaignCount"]</div>
            <div class="figure-label">Campaigns</div>
        </div>
        <div>
            <div class="figure-value">@Model.CreatedAt.ToString("MMM yyyy")</div>
            <div class="figure-label">Member Since</div>
        </div>
        <div>
            <div class="figure-value">@completenessPercent%</div>
            <div class="figure-label">Profile Complete</div>
        </div>
    </div>

    <div class="profile-section">
        <div class="profile-section-title">Company Details</div>
        <div class="profile-info-grid">
            <div>
                <div class="profile-info-label">Contact Name</div>
                <div class="profile-info-value">@Model.ContactFullName</div>
            </div>
            <div>
                <div class="profile-info-label">Email</div>
                <div class="profile-info-value">@ViewData["Email"]</div>
            </div>
            <div>
                <div class="profile-info-label">Industry</div>
                <div class="profile-info-value">@(string.IsNullOrEmpty(Model.Industry) ? "Not specified" : Model.Industry)</div>
            </div>
            <div>
                <div class="profile-info-label">Monthly Budget</div>
                <div class="profile-info-value">@(string.IsNullOrEmpty(Model.MonthlyBudget) ? "Not specified" : Model.MonthlyBudget)</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
            {
                <div class="profile-info-value-full">
                    <div class="profile-info-label">Website</div>
                    <div class="profile-info-value"><a href="@Model.WebsiteUrl" target="_blank" rel="noopener">@Model.WebsiteUrl</a></div>
                </div>
            }
        </div>
    </div>

    <div class="profile-section">
        <div class="profile-section-title">Profile Completeness</div>
        <div class="completeness-row" style="margin-top: 12px;">
            <span class="profile-info-label">Overall</span>
            <span style="font-family:'DM Sans',sans-serif; font-weight:700; font-size:13px; color:#171d3d;">@completenessPercent%</span>
        </div>
        <div class="completeness-bar">
            <div class="completeness-bar-fill" style="width: @completenessPercent%;"></div>
        </div>
        @if (completenessPercent < 100)
        {
            <p class="completeness-hint">
                Add @(string.IsNullOrWhiteSpace(Model.WebsiteUrl) && string.IsNullOrWhiteSpace(Model.ProfilePictureUrl) ? "a website and a logo" : string.IsNullOrWhiteSpace(Model.WebsiteUrl) ? "a website" : "a logo") to complete your profile.
            </p>
        }
    </div>

</div>
