@model Brandora.Web.Models.Settings.BrandSettingsViewModel
@{
    ViewData["Title"] = "Settings";
    ViewData["ActiveNav"] = "Settings";
    Layout = "_AppLayout";

    var profileErrors = (TempData["ProfileErrors"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
    var passwordErrors = (TempData["PasswordErrors"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
    var profileSaved = TempData["ProfileSaved"] as string == "true";
    var passwordChanged = TempData["PasswordChanged"] as string == "true";
}

@section Styles {
 
    .page-head {
        animation: fade-up .4s ease both;
    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 28px;
    }

    .page-sub {
        margin-top: 6px;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        color: #6b7290;
    }

    /* ==============================
       SETTINGS LAYOUT (matches the
       Influencer Settings page design)
    ============================== */

    .ps-grid {
        margin-top: 24px;

        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 20px;
        align-items: start;
    }

    .ps-card {
        background: #ffffff;
        border: 1px solid #eaecf5;
        border-radius: 16px;

        animation: fade-up .5s ease both;
    }

    /* Settings nav */

    .ps-nav {
        padding: 10px;
    }

    .ps-nav-item {
        display: flex;
        align-items: center;
        gap: 12px;

        padding: 12px;

        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        cursor: pointer;

        margin-bottom: 2px;

        transition: background .15s ease;
    }

    .ps-nav-item:hover {
        background: #f6f7fc;
    }

    .ps-nav-item.is-active {
        background: linear-gradient(105deg, rgba(163,38,255,.1), rgba(24,169,255,.08));
        border: 1px solid #e3d9ff;
    }

    .ps-nav-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;
        background: #f1f2f8;
        color: #56617f;
    }

    .ps-nav-icon svg {
        width: 16px;
        height: 16px;
    }

    .ps-nav-item.is-active .ps-nav-icon {
        background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
        color: #ffffff;
    }

    .ps-nav-title {
        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        font-weight: 400;
        color: #171d3d;
    }

    .ps-nav-item.is-active .ps-nav-title {
        color: #6322d4;
        font-weight: 600;
    }

    .ps-help-card {
        margin-top: 16px;
        padding: 22px;
    }

    .ps-help-top {
        display: flex;
        align-items: center;
        gap: 14px;

        margin-bottom: 14px;
    }

    .ps-help-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        background: linear-gradient(135deg, #a326ff, #6a3cff 55%, #18a9ff);
        color: #ffffff;

        font-family: 'DM Sans', sans-serif;
        font-size: 18px;
        font-weight: 700;
    }

    .ps-help-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        color: #171d3d;
    }

    .ps-help-desc {
        margin: 0 0 18px;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        line-height: 1.6;
        color: #8189a8;
        text-align: center;
    }

    .ps-support-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        width: 100%;

        padding: 12px 20px;

        border: 1px solid #dde1f0;
        border-radius: 12px;
        background: #ffffff;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        font-weight: 700;
        color: #6322d4;

        cursor: pointer;
        text-decoration: none;
    }

    .ps-support-btn:hover {
        border-color: #9b2cff;
    }

    /* Panels (right column) */

    .ps-panels {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .ps-panel {
        padding: 26px 28px;
        scroll-margin-top: 92px;
    }

    .ps-panel-head {
        margin-bottom: 22px;
    }

    .ps-panel-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 17px;
        font-weight: 700;
        color: #171d3d;
    }

    .ps-panel-sub {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #8189a8;
    }

    /* Photo row */

    .ps-photo-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 18px;

        padding-bottom: 22px;
        margin-bottom: 22px;

        border-bottom: 1px solid #eef0f8;
    }

    .ps-photo-avatar-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .avatar-circle {
        position: relative;
        overflow: hidden;
        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        background: linear-gradient(135deg, #a326ff, #236eff);

        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        line-height: 1;
        color: #ffffff;

        box-shadow: 0 0 0 4px #f3e8ff;
    }

    .avatar-circle.large {
        width: 76px;
        height: 76px;
        font-size: 24px;
    }

    .avatar-circle img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .ps-photo-camera {
        position: absolute;
        right: -2px;
        bottom: -2px;

        width: 26px;
        height: 26px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        border: 2px solid #ffffff;
        background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
        color: #ffffff;
    }

    .ps-photo-camera svg {
        width: 12px;
        height: 12px;
    }

    .ps-photo-name {
        font-family: 'DM Sans', sans-serif;
        font-size: 14.5px;
        font-weight: 700;
        color: #171d3d;
    }

    .ps-photo-hint {
        margin: 3px 0 10px;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #8a93ad;
    }

    .ps-photo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ps-change-photo-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #dce7ff;
        background: #ffffff;
        color: #6322d4;

        padding: 7px 14px;

        border-radius: 8px;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;

        cursor: pointer;
    }

    .ps-change-photo-btn:hover {
        border-color: #9b2cff;
    }

    .ps-change-photo-btn.is-remove {
        color: #c22540;
        border-color: #f3d3da;
    }

    .ps-change-photo-btn.is-remove:hover {
        border-color: #e0507a;
    }

    /* Form */

    .ps-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 20px;

        margin-bottom: 4px;
    }

    .ps-form-group {
        display: flex;
        flex-direction: column;
    }

    .ps-form-group.full {
        grid-column: 1 / -1;
    }

    .ps-form-group label {
        margin-bottom: 8px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 700;
        color: #3a4360;
    }

    .ps-form-group input,
    .ps-form-group select {
        width: 100%;

        padding: 11px 13px;

        border: 1px solid #dce7ff;
        border-radius: 10px;
        background: #ffffff;

        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px;
        color: #20283a;

        outline: 0;
        transition: border-color .2s ease;
    }

    .ps-form-group input:focus,
    .ps-form-group select:focus {
        border-color: #9b2cff;
    }

    .ps-form-group input:disabled {
        color: #9096b3;
        background: #f5f6fb;
    }

    .ps-form-hint {
        margin-top: 6px;

        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: #8a93ad;
    }

    .ps-input-icon-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .ps-input-icon-wrap svg {
        position: absolute;
        left: 13px;

        width: 14px;
        height: 14px;

        color: #8a93ad;
        pointer-events: none;
    }

    .ps-input-icon-wrap input {
        padding-left: 36px;
    }

    .ps-select-wrap {
        position: relative;
    }

    .ps-select-wrap select {
        appearance: none;
        -webkit-appearance: none;
        background-image: none;
        cursor: pointer;
        padding-right: 34px;
    }

    .ps-select-wrap svg {
        position: absolute;
        right: 13px;
        top: 50%;

        width: 10px;
        height: 10px;

        transform: translateY(-50%);
        color: #8a93ad;
        pointer-events: none;
    }

    .ps-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;

        margin-top: 22px;
    }

    .ps-cancel-btn {
        display: inline-flex;
        align-items: center;

        border: 1px solid #dce7ff;
        background: #f6f7fc;
        color: #56617f;

        padding: 11px 22px;

        border-radius: 10px;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;

        cursor: pointer;
        text-decoration: none;
    }

    .ps-save-btn {
        border: 0;
        color: #ffffff;

        padding: 11px 24px;

        border-radius: 10px;
        background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;

        cursor: pointer;
        transition: .2s;
    }

    .ps-save-btn:hover {
        transform: translateY(-2px);
    }

    .ps-saved-note,
    .ps-error-note {
        display: flex;
        align-items: flex-start;
        gap: 8px;

        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 18px;

        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
    }

    .ps-saved-note svg,
    .ps-error-note svg {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .ps-saved-note {
        background: #e2faf1;
        color: #0d9c6c;
        border: 1px solid #c7f2e2;
    }

    .ps-error-note {
        background: rgba(220,50,70,.06);
        color: #a71b34;
        border: 1px solid rgba(220,50,70,.25);
    }

    .ps-error-note ul {
        margin: 2px 0 0;
        padding-left: 16px;
        font-weight: 500;
    }

    @@media(max-width: 980px) {
        .ps-grid { grid-template-columns: 1fr; }
    }

    @@media(max-width: 560px) {
        .ps-form-grid { grid-template-columns: 1fr; }
        .ps-form-group.full { grid-column: span 1; }
        .ps-panel { padding: 18px; }
        .ps-panel-head { flex-direction: column; gap: 12px; }
        .ps-photo-row { flex-wrap: wrap; }
    }

}

<a href="/Dashboard" class="back-to-dashboard">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Back to Dashboard
</a>

<div class="page-head">
    <h1 class="page-title">Settings</h1>
    <p class="page-sub">Manage your brand profile and account security.</p>
</div>

<div class="ps-grid">

    <!-- SETTINGS NAV -->

    <div>
        <div class="ps-card ps-nav">

            <a href="#brand-profile" class="ps-nav-item is-active" data-ps-nav>
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                </span>
                <span class="ps-nav-title">Brand Profile</span>
            </a>

            <a href="#password" class="ps-nav-item" data-ps-nav>
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </span>
                <span class="ps-nav-title">Password &amp; Security</span>
            </a>

            <a href="#" class="ps-nav-item">
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 13 6 9Z"/><path d="M10 18a2 2 0 0 0 4 0"/></svg>
                </span>
                <span class="ps-nav-title">Notification Settings</span>
            </a>

            <a href="#" class="ps-nav-item">
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
                </span>
                <span class="ps-nav-title">Billing &amp; Payments</span>
            </a>

            <a href="#" class="ps-nav-item">
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 19c0-3.3 2.9-5.8 6.5-5.8s6.5 2.5 6.5 5.8"/><path d="M16 8.2a3 3 0 1 1 3.5 5.9"/><path d="M17 13.6c2.6.5 4.5 2.4 4.5 5.4"/></svg>
                </span>
                <span class="ps-nav-title">Team Members</span>
            </a>

        </div>

        <div class="ps-card ps-help-card">
            <div class="ps-help-top">
                <div class="ps-help-icon">?</div>
                <div class="ps-help-title">Need Help?</div>
            </div>
            <p class="ps-help-desc">If you need any assistance, our support team is here to help.</p>
            <a href="#" class="ps-support-btn">
                Contact Support
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
        </div>
    </div>


    <!-- PANELS -->

    <div class="ps-panels">

        <div class="ps-card ps-panel" id="brand-profile">

            <div class="ps-panel-head">
                <div class="ps-panel-title">Brand Profile</div>
                <div class="ps-panel-sub">This is what creators and your team see across Brandora.</div>
            </div>

            @if (profileSaved)
            {
                <div class="ps-saved-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 5-5"/></svg>
                    Profile updated.
                </div>
            }
            @if (profileErrors.Length > 0)
            {
                <div class="ps-error-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                    <ul>
                        @foreach (var error in profileErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="/Settings/Update" enctype="multipart/form-data" id="brandProfileForm">
                @Html.AntiForgeryToken()

                <div class="ps-photo-row">
                    <div class="ps-photo-avatar-wrap">
                        <div class="avatar-circle large" id="picturePreview">
                            @if (!string.IsNullOrEmpty(Model.ExistingProfilePictureUrl))
                            {
                                <img src="@Model.ExistingProfilePictureUrl" alt="Profile picture" id="picturePreviewImg" />
                            }
                            else
                            {
                                <span id="picturePreviewInitial">@(string.IsNullOrEmpty(Model.CompanyName) ? "B" : Model.CompanyName[..1].ToUpperInvariant())</span>
                            }
                        </div>
                        <span class="ps-photo-camera">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-2h6l2 2h3v11H4z"/><circle cx="12" cy="13.5" r="3.2"/></svg>
                        </span>
                    </div>

                    <div>
                        <div class="ps-photo-name">@Model.CompanyName</div>
                        <div class="ps-photo-hint">JPG, PNG, or WEBP &middot; up to 5MB</div>
                        <div class="ps-photo-actions">
                            <label for="ProfilePictureFile" class="ps-change-photo-btn" tabindex="0">
                                @(string.IsNullOrEmpty(Model.ExistingProfilePictureUrl) ? "Upload Profile Picture" : "Change Picture")
                            </label>
                            <input type="file" id="ProfilePictureFile" name="ProfilePictureFile" accept="image/jpeg,image/png,image/webp" hidden />

                            @if (!string.IsNullOrEmpty(Model.ExistingProfilePictureUrl))
                            {
                                <button type="submit" name="RemoveProfilePicture" value="true" class="ps-change-photo-btn is-remove">Remove Picture</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="ps-form-grid">

                    <div class="ps-form-group">
                        <label for="Email">Email Address</label>
                        <input type="email" id="Email" value="@ViewData["Email"]" disabled />
                    </div>

                    <div class="ps-form-group">
                        <label for="ContactFullName">Contact Full Name</label>
                        <input type="text" id="ContactFullName" name="ContactFullName" value="@Model.ContactFullName" required />
                    </div>

                    <div class="ps-form-group full">
                        <label for="CompanyName">Company Name</label>
                        <input type="text" id="CompanyName" name="CompanyName" value="@Model.CompanyName" required />
                    </div>

                    <div class="ps-form-group full">
                        <label for="WebsiteUrl">Website URL</label>
                        <div class="ps-input-icon-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.8 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.8-3.8-9S9.5 5.5 12 3Z"/></svg>
                            <input type="url" id="WebsiteUrl" name="WebsiteUrl" value="@Model.WebsiteUrl" placeholder="https://" />
                        </div>
                    </div>

                    <div class="ps-form-group">
                        <label for="Industry">Industry</label>
                        <div class="ps-select-wrap">
                            <select id="Industry" name="Industry" required>
                                @foreach (var industry in new[] { "Fashion & Apparel", "Beauty & Cosmetics", "Food & Beverage", "Technology", "Health & Fitness", "Travel & Tourism", "Finance", "Education", "Home & Lifestyle", "Other" })
                                {
                                    <option selected="@(Model.Industry == industry)">@industry</option>
                                }
                            </select>
                            <svg viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>

                    <div class="ps-form-group">
                        <label for="MonthlyBudget">Estimated Monthly Budget</label>
                        <div class="ps-select-wrap">
                            <select id="MonthlyBudget" name="MonthlyBudget" required>
                                @foreach (var budget in new[] { "Under ৳50,000", "৳50,000 – ৳150,000", "৳150,000 – ৳500,000", "৳500,000 – ৳1,000,000", "Above ৳1,000,000" })
                                {
                                    <option selected="@(Model.MonthlyBudget == budget)">@budget</option>
                                }
                            </select>
                            <svg viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>

                </div>

                <div class="ps-actions">
                    <button type="submit" class="ps-save-btn">Save Changes</button>
                </div>
            </form>
        </div>

        <div class="ps-card ps-panel" id="password">

            <div class="ps-panel-head">
                <div class="ps-panel-title">Password &amp; Security</div>
                <div class="ps-panel-sub">Change the password used to sign in to Brandora.</div>
            </div>

            @if (passwordChanged)
            {
                <div class="ps-saved-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 5-5"/></svg>
                    Password changed.
                </div>
            }
            @if (passwordErrors.Length > 0)
            {
                <div class="ps-error-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                    <ul>
                        @foreach (var error in passwordErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="/Settings/ChangePassword">
                @Html.AntiForgeryToken()

                <div class="ps-form-grid">
                    <div class="ps-form-group full">
                        <label for="CurrentPassword">Current Password</label>
                        <input type="password" id="CurrentPassword" name="CurrentPassword" required />
                    </div>
                    <div class="ps-form-group">
                        <label for="NewPassword">New Password</label>
                        <input type="password" id="NewPassword" name="NewPassword" required />
                    </div>
                    <div class="ps-form-group">
                        <label for="ConfirmNewPassword">Confirm New Password</label>
                        <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" required />
                    </div>
                </div>

                <div class="ps-actions">
                    <button type="submit" class="ps-save-btn">Change Password</button>
                </div>
            </form>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        (function () {
            var fileInput = document.getElementById('ProfilePictureFile');
            var label = document.querySelector('label[for="ProfilePictureFile"]');
            var preview = document.getElementById('picturePreview');

            if (!fileInput || !preview) return;

            var MAX_BYTES = 5 * 1024 * 1024;
            var ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp'];

            if (label) {
                label.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        fileInput.click();
                    }
                });
            }

            fileInput.addEventListener('change', function () {
                var file = fileInput.files && fileInput.files[0];
                if (!file) return;

                if (ALLOWED_TYPES.indexOf(file.type) === -1) {
                    alert('Please choose a JPG, PNG, or WEBP image.');
                    fileInput.value = '';
                    return;
                }

                if (file.size > MAX_BYTES) {
                    alert('That image is larger than 5MB. Please choose a smaller file.');
                    fileInput.value = '';
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="Selected profile picture" />';
                };
                reader.readAsDataURL(file);
            });
        })();

        (function () {
            var navItems = document.querySelectorAll('[data-ps-nav]');
            if (!navItems.length) return;

            navItems.forEach(function (item) {
                item.addEventListener('click', function () {
                    navItems.forEach(function (i) { i.classList.remove('is-active'); });
                    item.classList.add('is-active');
                });
            });
        })();
    </script>
}
