@model Brandora.Web.Models.Settings.BrandSettingsViewModel
@using Brandora.Web.Models.Domain
@{
    ViewData["Title"] = "Settings";
    ViewData["ActiveNav"] = "Settings";
    Layout = "_AppLayout";

    var profileErrors = (TempData["ProfileErrors"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
    var passwordErrors = (TempData["PasswordErrors"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
    var profileSaved = TempData["ProfileSaved"] as string == "true";
    var passwordChanged = TempData["PasswordChanged"] as string == "true";
    var notificationPrefsSaved = TempData["NotificationPrefsSaved"] as string == "true";
    var socialSaved = TempData["SocialSaved"] as string == "true";
    var socialErrors = (TempData["SocialErrors"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
    // After a failed save, show exactly what the brand typed so only the wrong field needs fixing.
    var socialDraft = TempData["SocialDraft"] is string draftJson
        ? System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string?>>(draftJson) ?? new Dictionary<string, string?>()
        : null;
    var socialCount = Model.SocialLinks.Count(l => !string.IsNullOrWhiteSpace(l.Value));
    var rejectionReason = TempData["RejectionReason"] as string;

    var prefs = Model.NotificationPreferences;
    var prefsOn = new[] { prefs.NewProposals, prefs.ProposalUpdates, prefs.Messages, prefs.MilestoneUpdates, prefs.PaymentUpdates, prefs.CampaignDeadlines }.Count(p => p);

    (string Badge, string Icon, string Label) Verification() => Model.VerificationStatus switch
    {
        VerificationStatus.Verified => ("is-success", "bi-patch-check-fill", "Verified"),
        VerificationStatus.Rejected => ("is-danger", "bi-x-circle-fill", "Not approved"),
        _ => ("is-pending", "bi-hourglass-split", "Under review")
    };
    var verification = Verification();

    var faqs = new[]
    {
        ("Who can see my brand profile?", "Creators see your company name, logo, industry and any social profiles you add on your campaigns, proposals, messages and in Browse Brands. Your contact details and budget range are only used by Brandora's review team."),
        ("My verification wasn't approved — what now?", "Update the details in Brand Profile (a real company name, website and logo help most) and save. Our admin team re-reviews updated profiles."),
        ("Can I change my sign-in email?", "Not from Settings. Contact support and we'll help you move your account to a new email safely."),
        ("What happens if I turn a notification type off?", "Those notifications simply aren't created for you. You'll still see the underlying activity on your Dashboard, Applications and Finance pages."),
        ("How do I pay creators?", "Payments are released per milestone after you and Brandora approve the proof of post, then paid through bKash or Nagad from Finance."),
    };
}

@section Styles {

    /* ==============================
       SETTINGS — shared glass system
    ============================== */

    .ps-grid {
        margin-top: 16px;
        display: grid;
        grid-template-columns: 290px minmax(0, 1fr);
        grid-template-rows: auto 1fr;
        grid-template-areas: "nav panels" "extra panels";
        gap: 16px;
        align-items: start;
    }
    .ps-side { grid-area: nav; display: grid; gap: 16px; min-width: 0; }
    .ps-side-extra { grid-area: extra; display: grid; gap: 16px; align-content: start; min-width: 0; }
    .ps-panels { grid-area: panels; display: grid; gap: 16px; min-width: 0; }

    .ui-card { transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }

    /* Settings nav */
    .ps-nav { padding: 10px; }
    .ps-nav-label { padding: 6px 10px 8px; font-family: 'Inter', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #5877ac; }
    .ps-nav-item {
        display: flex; align-items: center; gap: 12px;
        margin-bottom: 2px; padding: 9px 10px;
        border-radius: 10px; border: 1px solid transparent;
        color: inherit; text-decoration: none; cursor: pointer;
        transition: background .2s ease, border-color .2s ease, transform .2s ease;
    }
    .ps-nav-item:hover { background: #f3f8ffcc; transform: translateX(2px); }
    .ps-nav-item.is-active { border-color: #cddfff; background: linear-gradient(110deg, #efeaffcc, #e6f1ffcc); box-shadow: 0 6px 14px #5b83c414; }
    .ps-nav-icon { display: grid; place-items: center; flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #e4eeff, #cce2ff); color: #135bff; transition: .2s ease; }
    .ps-nav-icon svg { width: 16px; height: 16px; }
    .ps-nav-item.is-active .ps-nav-icon { background: linear-gradient(130deg, #7224ff, #3735ff 55%, #087fff); color: #ffffff; box-shadow: 0 6px 14px #3b4dff33; }
    .ps-nav-title { flex: 1; font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600; color: #33477c; }
    .ps-nav-item.is-active .ps-nav-title { color: #101d48; }
    .ps-nav-num { font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 700; color: #a2b3d6; }
    .ps-nav-item.is-active .ps-nav-num { color: #5b3df0; }

    /* Panels */
    .ps-panel { padding: 22px 24px; scroll-margin-top: 90px; }
    .ps-panel:hover { border-color: #b9d3ff; box-shadow: 0 14px 30px #5b83c414; }
    .ps-panel-head { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 18px; padding-bottom: 16px; border-bottom: 1px solid #e3edfc; }
    .ps-step { display: grid; place-items: center; flex-shrink: 0; width: 30px; height: 30px; margin-top: 2px; border-radius: 50%; background: linear-gradient(130deg, #7224ff, #3735ff 55%, #087fff); box-shadow: 0 6px 14px #3b4dff33; font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 700; color: #ffffff; }
    .ps-panel-copy { flex: 1; min-width: 0; }
    .ps-panel-title { font: 600 20px/1.3 'Playfair Display', Georgia, serif; letter-spacing: -.4px; color: #0b084e; }
    .ps-panel-sub { margin-top: 3px; font-family: 'Inter', sans-serif; font-size: 12.5px; line-height: 1.5; color: #5877ac; }
    .ps-panel-chip { margin-left: auto; }

    .ps-subhead { display: flex; flex-direction: column; gap: 2px; margin: 4px 0 14px; }
    .ps-subhead span { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 700; color: #101d48; }
    .ps-subhead small { font-family: 'Inter', sans-serif; font-size: 11.5px; color: #6680ad; }

    /* Photo row */
    .ps-photo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-bottom: 22px; padding: 16px; border-radius: 12px; border: 1px solid #e3edfc; background: #ffffff8c; }
    .ps-photo-avatar-wrap { position: relative; flex-shrink: 0; }
    .avatar-circle { position: relative; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(135deg, #7224ff, #3735ff 55%, #087fff); font-family: 'DM Sans', sans-serif; font-weight: 700; line-height: 1; color: #ffffff; box-shadow: 0 0 0 4px #ffffff, 0 10px 22px #3b4dff26; }
    .avatar-circle.large { width: 76px; height: 76px; font-size: 24px; }
    .avatar-circle img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .ps-photo-camera { position: absolute; right: -2px; bottom: -2px; display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; border: 2px solid #ffffff; background: linear-gradient(110deg, #6425ff, #004dff 55%, #00a8f0); color: #ffffff; }
    .ps-photo-camera svg { width: 12px; height: 12px; }
    .ps-photo-name { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700; color: #101d48; }
    .ps-photo-hint { margin: 3px 0 10px; font-family: 'Inter', sans-serif; font-size: 12px; color: #6680ad; }
    .ps-photo-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .ps-change-photo-btn {
        display: inline-flex; align-items: center; height: 34px; padding: 0 14px;
        border-radius: 9px; border: 1px solid #b7d3ff; background: #ffffffcc;
        font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #1451ff;
        cursor: pointer; transition: .2s ease;
    }
    .ps-change-photo-btn:hover { border-color: #1451ff; transform: translateY(-1px); box-shadow: 0 6px 14px #5b83c41f; }
    .ps-change-photo-btn.is-remove { border-color: #f1ccd3; color: #c22540; }
    .ps-change-photo-btn.is-remove:hover { border-color: #c22540; }

    /* Form */
    .ps-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 18px; }
    .ps-form-group { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
    .ps-form-group.full { grid-column: span 2; }
    .ps-form-group label { font-family: 'DM Sans', sans-serif; font-size: 12.5px; font-weight: 700; color: #1f3264; }
    .ps-form-group input,
    .ps-form-group select {
        width: 100%; height: 44px; padding: 0 14px;
        border-radius: 10px; border: 1px solid #cfe0fb; background: #ffffffd9;
        font-family: 'Inter', sans-serif; font-size: 13.5px; color: #101d48;
        outline: none; transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .ps-form-group input:hover,
    .ps-form-group select:hover { border-color: #b3cdf7; }
    .ps-form-group input:focus,
    .ps-form-group select:focus { border-color: #6b8dff; background: #ffffff; box-shadow: 0 0 0 3px #3b4dff1f; }
    .ps-form-group input:disabled { background: #eef4fbcc; color: #6680ad; cursor: not-allowed; }
    .ps-form-hint { margin: 0; font-family: 'Inter', sans-serif; font-size: 11.5px; line-height: 1.5; color: #6680ad; }
    .ps-form-hint i { margin-right: 3px; }
    .ps-input-icon-wrap { position: relative; }
    .ps-input-icon-wrap svg { position: absolute; left: 13px; top: 50%; width: 16px; height: 16px; transform: translateY(-50%); color: #5877ac; pointer-events: none; }
    .ps-input-icon-wrap input { padding-left: 38px; }
    .ps-select-wrap { position: relative; }
    .ps-select-wrap select { padding-right: 36px; appearance: none; -webkit-appearance: none; cursor: pointer; }
    .ps-select-wrap svg { position: absolute; right: 14px; top: 50%; width: 10px; height: 6px; transform: translateY(-50%); color: #5877ac; pointer-events: none; }

    .ps-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; padding-top: 16px; border-top: 1px solid #e3edfc; }
    .ps-save-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        height: 42px; padding: 0 22px;
        border: 0; border-radius: 10px;
        background: linear-gradient(110deg, #6425ff, #004dff 55%, #00a8f0);
        box-shadow: 0 10px 22px #3b4dff33;
        font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 700; color: #ffffff;
        cursor: pointer; transition: transform .2s ease, box-shadow .2s ease;
    }
    .ps-save-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 28px #3b4dff4d; }

    .ps-panel .notice ul { margin: 2px 0 0; padding-left: 16px; }

    /* Notification preference toggles */
    .pref-list { display: grid; gap: 10px; }
    .pref-row {
        display: flex; align-items: center; gap: 14px;
        padding: 12px 14px; border-radius: 10px; border: 1px solid #e3edfc; background: #ffffff8c;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .pref-row:hover { transform: translateY(-2px); border-color: #b9d3ff; box-shadow: 0 12px 24px #5b83c41a; }
    .pref-copy { flex: 1; min-width: 0; }
    .pref-title { font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 700; color: #101d48; }
    .pref-desc { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.5; color: #5877ac; }
    .pref-toggle { position: relative; flex-shrink: 0; width: 44px; height: 24px; cursor: pointer; }
    .pref-toggle input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; z-index: 1; }
    .pref-toggle span { position: absolute; inset: 0; border-radius: 24px; background: #d4def0; transition: background .25s ease; }
    .pref-toggle span::before { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #ffffff; box-shadow: 0 2px 5px #1a2b5c33; transition: transform .25s cubic-bezier(.22,1,.36,1); }
    .pref-toggle input:checked + span { background: linear-gradient(110deg, #6425ff, #004dff 55%, #00a8f0); }
    .pref-toggle input:checked + span::before { transform: translateX(20px); }
    .pref-toggle input:focus-visible + span { box-shadow: 0 0 0 3px #3b4dff33; }

    /* Billing */
    .billing-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .billing-figure { padding: 14px; border-radius: 11px; border: 1px solid #e3edfc; background: #ffffff8c; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
    .billing-figure:hover { transform: translateY(-2px); border-color: #b9d3ff; box-shadow: 0 12px 24px #5b83c41a; }
    .billing-value { margin-top: 10px; font-family: 'DM Sans', sans-serif; font-size: 19px; font-weight: 700; color: #0b124e; }
    .billing-label { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #5877ac; }
    .billing-note { display: flex; gap: 10px; margin-top: 14px; padding: 12px 14px; border-radius: 10px; border: 1px solid #dfe9ff; background: #eef4ffbd; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.6; color: #33477c; }
    .billing-note i { margin-top: 1px; color: #1451ff; }

    /* Social profiles */
    .social-edit-list { display: grid; gap: 10px; container-type: inline-size; }
    .social-edit-row {
        display: grid; grid-template-columns: 40px minmax(118px, 168px) minmax(0, 1fr); align-items: center; gap: 12px 14px;
        padding: 11px 14px; border-radius: 12px; border: 1px solid #e3edfc; background: #ffffff8c;
        transition: border-color .2s ease, box-shadow .2s ease;
    }
    .social-edit-row:hover { border-color: #b9d3ff; }
    .social-edit-row:focus-within { border-color: #9fbcff; box-shadow: 0 10px 22px #5b83c41a; }
    .social-edit-row.has-error { border-color: #f1ccd3; background: #fff7f8; }
    .social-edit-name { min-width: 0; }
    .social-edit-name label { display: block; font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 700; color: #101d48; }
    .social-state { display: inline-flex; align-items: center; gap: 5px; margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11px; color: #7b8fbf; }
    .social-state::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #c3d0e8; }
    .social-state.is-on { color: #0d9c6c; }
    .social-state.is-on::before { background: #0d9c6c; box-shadow: 0 0 0 3px #0d9c6c1f; }
    .social-edit-field { position: relative; min-width: 0; }
    .social-edit-field input {
        width: 100%; height: 42px; padding: 0 44px 0 14px;
        border-radius: 10px; border: 1px solid #cfe0fb; background: #ffffffd9;
        font-family: 'Inter', sans-serif; font-size: 13px; color: #101d48; text-overflow: ellipsis;
        outline: none; transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .social-edit-field input::placeholder { color: #8ea1c8; }
    .social-edit-field input:hover { border-color: #b3cdf7; }
    .social-edit-field input:focus { border-color: #6b8dff; background: #ffffff; box-shadow: 0 0 0 3px #3b4dff1f; }
    .social-open {
        position: absolute; top: 50%; right: 6px; transform: translateY(-50%);
        display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px;
        color: #1451ff; background: #eef4ff; font-size: 13px; transition: background .2s ease;
    }
    .social-open:hover { background: #dfe9ff; }
    .social-preview { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 16px; padding: 12px 14px; border-radius: 10px; border: 1px dashed #c9dcf8; background: #f3f8ffaa; }
    .social-preview-label { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #33477c; }
    .social-preview-empty { font-family: 'Inter', sans-serif; font-size: 12px; color: #6680ad; }
    .social-icons .social-chip.is-muted { opacity: .28; filter: grayscale(1); box-shadow: none; }

    /* Stack the field under the name whenever the panel itself is narrow
       (small phones, or the two-column settings layout on tablets/laptops). */
    @@container (max-width: 520px) {
        .social-edit-row { grid-template-columns: 40px minmax(0, 1fr); gap: 10px 12px; }
        .social-edit-field { grid-column: 1 / -1; }
    }
    @@media(max-width: 640px) {
        .social-edit-row { grid-template-columns: 40px minmax(0, 1fr); gap: 10px 12px; }
        .social-edit-field { grid-column: 1 / -1; }
    }

    /* Rail extras */
    .ps-account-top { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
    .ps-account-top .avatar-circle { width: 44px; height: 44px; font-size: 16px; box-shadow: 0 0 0 3px #ffffff, 0 6px 14px #3b4dff26; }
    .ps-account-name { font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 700; color: #101d48; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ps-account-mail { font-family: 'Inter', sans-serif; font-size: 11.5px; color: #6680ad; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    @@media(max-width: 1100px) {
        .billing-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media(max-width: 980px) {
        .ps-grid { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; grid-template-areas: "nav" "panels" "extra"; }
    }

    @@media(max-width: 560px) {
        .ps-form-grid { grid-template-columns: 1fr; }
        .ps-form-group.full { grid-column: span 1; }
        .ps-panel { padding: 18px; }
        .ps-panel-chip { display: none; }
        .billing-grid { grid-template-columns: 1fr; }
    }

}

<a href="/Dashboard" class="back-to-dashboard">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Back
</a>

<section class="page-hero">
    @await Html.PartialAsync("_HeroWaves")
    <div class="page-hero-intro">
        <p class="page-hero-eyebrow">Settings</p>
        <h1 class="page-hero-title">Manage Your Brand. <span>Stay in Control.</span></h1>
        <p class="page-hero-sub">Update your brand profile, keep your account secure, and choose exactly which campaign updates reach you.</p>
        <dl class="page-hero-stats">
            <div><dd>@verification.Label</dd><dt>Verification</dt></div>
            <div><dd>@Model.MemberSince.ToString("MMM yyyy")</dd><dt>Member since</dt></div>
            <div><dd>@prefsOn of 6</dd><dt>Notification types on</dt></div>
        </dl>
    </div>

    <div class="page-hero-art" aria-hidden="true">
        <div class="hero-glass hero-glass-back"></div>
        <div class="hero-glass hero-glass-front">
            <span class="hero-glass-copy">Your Brand.<br />Your Rules.<br />Your Control.<span></span></span>
        </div>
        <span class="hero-sparkle"></span>
    </div>

    <div class="page-hero-motto">Stay in<br />Control.<span></span></div>
</section>

<div class="ps-grid">

    <!-- SETTINGS NAV -->

    <aside class="ps-side">
        <div class="ui-card ps-nav">
            <div class="ps-nav-label">Settings</div>

            <a href="#brand-profile" class="ps-nav-item is-active" data-ps-nav>
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                </span>
                <span class="ps-nav-title">Brand Profile</span>
                <span class="ps-nav-num">01</span>
            </a>

            <a href="#password" class="ps-nav-item" data-ps-nav>
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </span>
                <span class="ps-nav-title">Password &amp; Security</span>
                <span class="ps-nav-num">02</span>
            </a>

            <a href="#notifications" class="ps-nav-item" data-ps-nav>
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 1 1 12 0c0 4 1.5 5.5 1.5 5.5H4.5S6 13 6 9Z"/><path d="M10 18a2 2 0 0 0 4 0"/></svg>
                </span>
                <span class="ps-nav-title">Notification Settings</span>
                <span class="ps-nav-num">03</span>
            </a>

            <a href="#billing" class="ps-nav-item" data-ps-nav>
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
                </span>
                <span class="ps-nav-title">Billing &amp; Payments</span>
                <span class="ps-nav-num">04</span>
            </a>

            <a href="#social-profiles" class="ps-nav-item" data-ps-nav>
                <span class="ps-nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1"/></svg>
                </span>
                <span class="ps-nav-title">Social Profiles</span>
                <span class="ps-nav-num">05</span>
            </a>
        </div>
    </aside>

    <aside class="ps-side-extra">

        <section class="ui-card">
            <div class="ps-account-top">
                <div class="avatar-circle">
                    @if (!string.IsNullOrEmpty(Model.ExistingProfilePictureUrl))
                    {
                        <img src="@Model.ExistingProfilePictureUrl" alt="" />
                    }
                    else
                    {
                        @(string.IsNullOrEmpty(Model.CompanyName) ? "B" : Model.CompanyName[..1].ToUpperInvariant())
                    }
                </div>
                <div style="min-width:0;">
                    <div class="ps-account-name">@Model.CompanyName</div>
