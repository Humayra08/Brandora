@using Brandora.Web.Models.Domain
@{
    ViewData["Title"] = "Account Under Review";
    Layout = null;
    var status = ViewData["Status"] as VerificationStatus? ?? VerificationStatus.Pending;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brandora</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { position: relative; font-family: 'DM Sans', sans-serif; background: #0a0f24; color: #ffffff; overflow-x: hidden; }
        body::before, body::after { content: ""; position: absolute; z-index: -1; border-radius: 50%; filter: blur(90px); pointer-events: none; }
        body::before { top: -12%; right: -8%; width: 480px; height: 480px; background: conic-gradient(from 180deg, rgba(155,44,255,.35), rgba(0,169,255,.3), rgba(255,90,190,.25), rgba(155,44,255,.35)); }
        body::after { bottom: 0; left: -10%; width: 420px; height: 420px; background: radial-gradient(circle, rgba(60,60,220,.35), transparent 70%); }
        a { text-decoration: none; color: inherit; }

        .auth-shell { padding: 150px 20px 90px; display: flex; justify-content: center; }
        .auth-card {
            position: relative; z-index: 2; width: 100%; max-width: 480px; padding: 44px 44px 36px; text-align: center;
            border-radius: 24px; border: 1px solid rgba(255,255,255,.12);
            background: rgba(18, 20, 42, .55); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
            box-shadow: 0 0 0 1px rgba(255,255,255,.03), 0 25px 70px rgba(2, 3, 20, .6), 0 0 60px rgba(155,44,255,.22), 0 0 90px rgba(0,169,255,.14);
        }
        .status-icon { width: 68px; height: 68px; margin: 0 auto 22px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 30px; }
        .status-icon.pending { background: rgba(255,190,60,.15); color: #ffd27a; }
        .status-icon.rejected { background: rgba(255,90,110,.15); color: #ffb4bd; }
        .status-icon.verified { background: rgba(60,220,150,.15); color: #7af0be; }

        .auth-title { font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: clamp(20px, 3vw, 24px); letter-spacing: -.3px; }
        .auth-subtitle { margin-top: 12px; font-size: 14px; line-height: 1.6; color: rgba(255,255,255,.68); }

        .back-link { display: inline-block; margin-top: 26px; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; color: #4d9dff; }
        .back-link:hover { text-decoration: underline; }
    </style>
</head>
<body>

<div class="auth-page">
    <partial name="_BrandoraNavbar" />

    <main class="auth-shell">
        <div class="auth-card">
            @if (status == VerificationStatus.Rejected)
            {
                <div class="status-icon rejected"><i class="bi bi-x-circle-fill"></i></div>
                <h1 class="auth-title">Registration Not Approved</h1>
                <p class="auth-subtitle">An admin reviewed your submission and it wasn't approved this time. Check the email we sent for the reason, update your profile, and it'll go back into the review queue.</p>
            }
            else if (status == VerificationStatus.Verified)
            {
                <div class="status-icon verified"><i class="bi bi-check-circle-fill"></i></div>
                <h1 class="auth-title">You're Approved!</h1>
                <p class="auth-subtitle">Your account has been verified. You can log in now.</p>
            }
            else
            {
                <div class="status-icon pending"><i class="bi bi-hourglass-split"></i></div>
                <h1 class="auth-title">Thanks! Your registration is being reviewed.</h1>
                <p class="auth-subtitle">We'll email you once an admin has reviewed your account. This usually doesn't take long — no need to do anything else for now.</p>
            }

            <a href="/Account/Login" class="back-link">Back to Login</a>
        </div>
    </main>
</div>

<partial name="_BrandoraFooter" />

</body>
</html>
