@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Brandora</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />

    <style>

        /* =========================================================
           GLOBAL
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #0a0f24;
            color: #ffffff;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }


        /* =========================================================
           PAGE / BACKDROP
        ========================================================= */

        .auth-page {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
        }

        .auth-shell {
            padding: 150px 20px 90px;

            display: flex;
            justify-content: center;
        }

        .auth-page::before,
        .auth-page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
        }

        .auth-page::before {
            top: -12%;
            right: -8%;
            width: 480px;
            height: 480px;

            background:
                conic-gradient(
                    from 180deg,
                    rgba(155,44,255,.35),
                    rgba(0,169,255,.3),
                    rgba(255,90,190,.25),
                    rgba(155,44,255,.35)
                );
        }

        .auth-page::after {
            bottom: -15%;
            left: -10%;
            width: 420px;
            height: 420px;

            background: radial-gradient(circle, rgba(60,60,220,.35), transparent 70%);
        }


        /* =========================================================
           CARD SHELL (glassmorphism)
        ========================================================= */

        .auth-card {
            position: relative;
            z-index: 2;

            width: 100%;
            max-width: 480px;

            padding: 44px 44px 36px;

            border-radius: 24px;
            border: 1px solid rgba(255,255,255,.12);

            background: rgba(18, 20, 42, .55);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);

            box-shadow:
                0 0 0 1px rgba(255,255,255,.03),
                0 25px 70px rgba(2, 3, 20, .6),
                0 0 60px rgba(155,44,255,.22),
                0 0 90px rgba(0,169,255,.14);
        }


        /* =========================================================
           BRAND MARK
        ========================================================= */

        .brand-mark {
            width: 68px;
            height: 68px;
            margin: 0 auto 22px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 20px;

            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.1);

            box-shadow: 0 0 30px rgba(120,80,255,.35);
        }

        .brand-mark img {
            height: 34px;
            width: auto;

            display: block;

            filter: drop-shadow(0 0 10px rgba(140,90,255,.5));
        }


        /* =========================================================
           HEADER
        ========================================================= */

        .auth-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .auth-title {
            font-family: 'DM Sans', sans-serif;
            font-weight: 800;

            font-size: clamp(22px, 3vw, 27px);
            letter-spacing: -.3px;
        }

        .auth-subtitle {
            margin-top: 10px;

            max-width: 380px;
            margin-left: auto;
            margin-right: auto;

            font-size: 14px;
            line-height: 1.6;
            color: rgba(255,255,255,.62);
        }


        /* =========================================================
           FORM
        ========================================================= */

        .field {
            display: flex;
            flex-direction: column;
            gap: 7px;

            margin-bottom: 22px;
        }

        .field label {
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 500;
            color: rgba(255,255,255,.85);
        }

        .field input {
            height: 46px;

            padding: 0 16px;

            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.16);
            background: rgba(255,255,255,.05);

            color: #ffffff;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;

            outline: none;

            transition: .2s;
        }

        .field input::placeholder {
            color: rgba(255,255,255,.38);
        }

        .field input:focus {
            border-color: rgba(255,255,255,.55);
            background: rgba(255,255,255,.08);
        }


        /* =========================================================
           SUBMIT + LINKS
        ========================================================= */

        .submit-btn {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            height: 52px;

            border: none;
            border-radius: 999px;

            color: white;

            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 700;

            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

            cursor: pointer;
            transition: .25s;

            box-shadow: 0 12px 30px rgba(90,60,255,.35);
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 38px rgba(90,60,255,.45);
        }

        .back-to-login {
            display: block;

            margin-top: 20px;

            text-align: center;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #6fb0ff;
        }

        .back-to-login:hover {
            text-decoration: underline;
        }


        /* =========================================================
           DIVIDER + SOCIAL
        ========================================================= */

        .auth-divider {
            display: flex;
            align-items: center;
            gap: 14px;

            margin: 28px 0 20px;

            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            color: rgba(255,255,255,.45);
        }

        .auth-divider::before,
        .auth-divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,.14);
        }

        .social-btn {
            width: 100%;
            height: 46px;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;

            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.14);
            background: rgba(255,255,255,.04);

            color: #ffffff;

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;

            cursor: pointer;
            transition: .2s;
        }

        .social-btn:hover {
            border-color: rgba(255,255,255,.35);
            background: rgba(255,255,255,.07);
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media(max-width: 560px) {

            .auth-card {
                padding: 34px 24px 28px;
            }
        }

    </style>
</head>
<body>

<div class="auth-page">

    <partial name="_BrandoraNavbar" />

    <main class="auth-shell">

    <div class="auth-card">

        <div class="brand-mark">
            <img src="~/images/brandora-mark.png" alt="Brandora" />
        </div>

        <div class="auth-header">
            <h1 class="auth-title">Forgot Password?</h1>
            <p class="auth-subtitle">Enter your registered email address below, and we'll send you a secure password reset link.</p>
        </div>

        <form method="post" action="/Account/ForgotPassword">

            <div class="field">
                <label for="resetEmail">Email Address</label>
                <input type="email" id="resetEmail" name="Email" placeholder="name@company.com" required />
            </div>

            <button type="submit" class="submit-btn">Send Reset Link</button>

        </form>

        <a href="/Account/Login" class="back-to-login">Back to Login</a>

        <div class="auth-divider">OR</div>

        <button type="button" class="social-btn">
            <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.85-.08-1.66-.22-2.44H12v4.62h6.46c-.28 1.5-1.13 2.77-2.4 3.62v3h3.88c2.27-2.09 3.56-5.17 3.56-8.8z"/><path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.9l-3.88-3c-1.08.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.71-4.94H1.28v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.29 14.3a7.2 7.2 0 0 1 0-4.6v-3.1H1.28a12 12 0 0 0 0 10.8l4.01-3.1z"/><path fill="#EA4335" d="M12 4.75c1.76 0 3.34.6 4.58 1.79l3.44-3.44C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.28 6.6l4.01 3.1C6.23 6.86 8.88 4.75 12 4.75z"/></svg>
            Log in with Google
        </button>

    </div>

    </main>

</div>

<partial name="_BrandoraFooter" />

<script>
    document.querySelectorAll('form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            form.reportValidity();
        });
    });
</script>

</body>
</html>
