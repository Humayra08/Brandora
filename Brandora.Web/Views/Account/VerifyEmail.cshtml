@model Brandora.Web.Models.Account.VerifyEmailViewModel
@{
    ViewData["Title"] = "Verify Your Email";
    Layout = null;
    var resendMessage = TempData["ResendMessage"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brandora</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/brandora-shared.css" asp-append-version="true" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { position: relative; font-family: 'DM Sans', sans-serif; background: #0a0f24; color: #ffffff; overflow-x: hidden; }
        body::before, body::after { content: ""; position: absolute; z-index: -1; border-radius: 50%; filter: blur(90px); pointer-events: none; }
        body::before { top: -12%; right: -8%; width: 480px; height: 480px; background: conic-gradient(from 180deg, rgba(155,44,255,.35), rgba(0,169,255,.3), rgba(255,90,190,.25), rgba(155,44,255,.35)); }
        body::after { bottom: 0; left: -10%; width: 420px; height: 420px; background: radial-gradient(circle, rgba(60,60,220,.35), transparent 70%); }
        a { text-decoration: none; color: inherit; }

        .auth-shell { padding: 150px 20px 90px; display: flex; justify-content: center; }
        .auth-card {
            position: relative; z-index: 2; width: 100%; max-width: 460px; padding: 44px 44px 36px;
            border-radius: 24px; border: 1px solid rgba(255,255,255,.12);
            background: rgba(18, 20, 42, .55); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
            box-shadow: 0 0 0 1px rgba(255,255,255,.03), 0 25px 70px rgba(2, 3, 20, .6), 0 0 60px rgba(155,44,255,.22), 0 0 90px rgba(0,169,255,.14);
        }
        .brand-mark { width: 68px; height: 68px; margin: 0 auto 22px; display: flex; align-items: center; justify-content: center; border-radius: 20px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); box-shadow: 0 0 30px rgba(120,80,255,.35); }
        .brand-mark img { height: 34px; width: auto; display: block; filter: drop-shadow(0 0 10px rgba(140,90,255,.5)); }
        .auth-header { text-align: center; margin-bottom: 26px; }
        .auth-title { font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: clamp(20px, 3vw, 24px); letter-spacing: -.3px; }
        .auth-subtitle { margin-top: 10px; font-size: 13.5px; line-height: 1.5; color: rgba(255,255,255,.62); }
        .auth-subtitle b { color: #ffffff; }

        .code-input {
            width: 100%; height: 58px; text-align: center; letter-spacing: 10px; font-size: 24px; font-weight: 700;
            border-radius: 10px; border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.05); color: #ffffff;
            outline: none; font-family: 'Inter', sans-serif;
        }
        .code-input:focus { border-color: rgba(255,255,255,.55); background: rgba(255,255,255,.08); }

        .submit-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 52px; margin-top: 18px; border: none; border-radius: 999px; color: white; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 700; background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff); cursor: pointer; transition: .25s; box-shadow: 0 12px 30px rgba(90,60,255,.35); }
        .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 16px 38px rgba(90,60,255,.45); }

        .form-errors { margin-bottom: 18px; padding: 14px 16px; border-radius: 10px; border: 1px solid rgba(255,90,110,.4); background: rgba(255,60,80,.1); font-family: 'Inter', sans-serif; font-size: 13px; color: #ffb4bd; }
        .form-info { margin-bottom: 18px; padding: 14px 16px; border-radius: 10px; border: 1px solid rgba(90,200,255,.35); background: rgba(60,150,255,.1); font-family: 'Inter', sans-serif; font-size: 13px; color: #bfe4ff; }

        .resend-row { margin-top: 20px; text-align: center; font-family: 'Inter', sans-serif; font-size: 13px; color: rgba(255,255,255,.62); }
        .resend-row button { background: none; border: none; color: #4d9dff; font-weight: 600; cursor: pointer; font-family: inherit; font-size: inherit; }
        .resend-row button:hover { text-decoration: underline; }
    </style>
</head>
<body>

<div class="auth-page">
    <partial name="_BrandoraNavbar" />

    <main class="auth-shell">
        <div class="auth-card">
            <div class="brand-mark"><img src="~/images/brandora-mark.png" alt="Brandora" /></div>

            <div class="auth-header">
                <h1 class="auth-title">Verify Your Email</h1>
                <p class="auth-subtitle">Enter the 6-digit code we sent to <b>@Model.Email</b>.</p>
            </div>

            @if (!string.IsNullOrEmpty(resendMessage))
            {
                <div class="form-info">@resendMessage</div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="form-errors">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post" action="/Account/VerifyEmail">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Email" value="@Model.Email" />
                <input type="text" name="Code" class="code-input" maxlength="6" inputmode="numeric" pattern="[0-9]*" placeholder="000000" autofocus required />
                <button type="submit" class="submit-btn">Verify Code</button>
            </form>

            <div class="resend-row">
                Didn't get a code?
                <form method="post" action="/Account/ResendVerificationCode" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@Model.Email" />
                    <button type="submit">Resend code</button>
                </form>
            </div>
        </div>
    </main>
</div>

<partial name="_BrandoraFooter" />

</body>
</html>
