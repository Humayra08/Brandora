@model Brandora.Web.Models.Dashboard.DashboardViewModel
@using Brandora.Web.Models.Domain
@using Brandora.Web.Models.Influencers
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
    Layout = "_AppLayout";

    var today = DateTime.UtcNow.Date;
    var maxSpend = Model.SpendByMonth.Count > 0 ? Model.SpendByMonth.Max(p => p.Amount) : 0m;
    var budgetPercent = Model.TotalBudget > 0 ? (int)Math.Round(Math.Min(100, (double)(Model.TotalSpend / Model.TotalBudget * 100))) : 0;
    var remainingBudget = Math.Max(0m, Model.TotalBudget - Model.TotalSpend);
    var attentionCount = Model.AttentionItems.Count;
    var nextUp = Model.UpcomingItems.FirstOrDefault();
    var liveCampaigns = Model.PublishedCount + Model.ActiveCount;
    var heroSub = attentionCount > 0
        ? $"{attentionCount} {(attentionCount == 1 ? "item needs" : "items need")} a decision from you. Review proposals, approve creator proof and release payments to keep every collaboration moving."
        : Model.HasAnyCampaigns
            ? "You're all caught up. Check on the campaigns already running, discover new creators or publish your next brief."
            : "Launch your first campaign, discover the right creators and manage every collaboration, milestone and payment from one place.";

    string Plural(int n, string word) => n == 1 ? $"{n} {word}" : $"{n} {word}s";
    string Money(decimal value) => "৳" + value.ToString("N0");

    // Soft icon chip + small badge per item kind (attention rows and "Next Up" dates).
    // Colour lives only in the chip and the badge; the row surface stays white glass.
    (string Icon, string Chip, string Badge, string Label) KindStyle(string kind) => kind switch
    {
        "Proposal" => ("bi-envelope-paper", "violet", "is-violet", "Proposal"),
        "Milestone" => ("bi-flag", "blue", "is-info", "Proof review"),
        "Payment" => ("bi-wallet2", "cyan", "is-pending", "Payment due"),
        "Milestone due" => ("bi-alarm", "blue", "is-info", "Milestone due"),
        "Campaign deadline" => ("bi-alarm", "amber", "is-pending", "Campaign deadline"),
        _ => ("bi-bell", "soft", "is-neutral", kind)
    };

    (string Icon, string Chip, string Badge) StatusStyle(CampaignStatus status) => status switch
    {
        CampaignStatus.Draft => ("bi-pencil-square", "soft", "is-neutral"),
        CampaignStatus.Published => ("bi-globe2", "blue", "is-info"),
        CampaignStatus.Active => ("bi-rocket-takeoff", "violet", "is-success"),
        CampaignStatus.Completed => ("bi-check2-circle", "cyan", "is-violet"),
        _ => ("bi-x-circle", "pink", "is-danger")
    };

    string DeadlineNote(DateTime? deadline)
    {
        if (!deadline.HasValue) return "Open-ended";
        var days = (deadline.Value.Date - today).Days;
        return days < 0 ? "Past deadline" : days == 0 ? "Due today" : days == 1 ? "Tomorrow" : $"In {days} days";
    }

    // "How campaigns work" timeline — each step is marked from the brand's real data.
    var hasPublished = Model.PublishedCount + Model.ActiveCount + Model.CompletedCount > 0;
    var hasCollaboration = Model.ActiveCollaborationCount > 0 || Model.CompletedCount > 0;
    var hasPaid = Model.CompletedPaymentsAmount > 0;
    var journey = new List<(string Title, string Text, bool Done)>
    {
        ("Create your campaign", "Set the brief, budget, platform, niche and milestone plan in the campaign wizard.", Model.HasAnyCampaigns),
        ("Publish & find creators", "Publishing opens the campaign to creator applications. Invite creators or use Smart Match.", hasPublished),
        ("Confirm a proposal", "Accepting a creator's proposal starts a collaboration with its milestones.", hasCollaboration),
        ("Review proof & pay", "Approve each milestone's proof of post, then release payment through bKash or Nagad.", hasPaid)
    };
    var currentStep = journey.FindIndex(s => !s.Done);
}

@section Styles {

    /* =========================================================
       HERO — the card itself is the shared .page-hero component
       (_AppLayout). Only the action buttons are page-specific.
    ========================================================= */

    .dash-hero .page-hero-intro { max-width: 54%; }
    .dash-hero .page-hero-sub { max-width: 520px; }
    .dash-hero .page-hero-stats { margin-top: 16px; }

    .dash-hero .hero-actions { margin-top: 18px; }

    .hero-cta,
    .hero-cta-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 42px;
        padding: 0 20px;
        border-radius: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        transition: transform .28s cubic-bezier(.22,1,.36,1), box-shadow .28s ease, background-position .35s ease, background .25s ease, border-color .25s ease;
    }

    .hero-cta {
        border: none;
        background: linear-gradient(105deg, #6425ff, #004dff 55%, #00a8f0);
        background-size: 180% 180%;
        color: #ffffff;
        box-shadow: 0 10px 24px -8px #3b4dff80;
    }

    .hero-cta i { transition: transform .25s ease; }

    .hero-cta:hover {
        transform: translateY(-2px);
        background-position: 100% 50%;
        box-shadow: 0 14px 30px -8px #3b4dffa0;
        color: #ffffff;
    }

    .hero-cta:hover i { transform: translateX(3px); }

    .hero-cta-ghost {
        border: 1px solid #b9d3ff;
        background: #ffffffc4;
        color: #1b3170;
    }

    .hero-cta-ghost i { color: #5b4dff; }

    .hero-cta-ghost:hover {
        transform: translateY(-2px);
        background: #ffffff;
        border-color: #8f7bff;
        color: #101d48;
        box-shadow: 0 12px 26px -10px #3b5bdb55;
    }

    @@media(max-width: 1100px) {
        .dash-hero .page-hero-intro { max-width: 62%; }
    }

    @@media(max-width: 760px) {
        .dash-hero .page-hero-intro { max-width: 100%; }
        .dash-hero .page-hero-stats { flex-wrap: wrap; gap: 14px; }
        .dash-hero .page-hero-stats > div + div { border-left: 0; padding-left: 0; }
    }

    @@media(max-width: 560px) {
        .dash-hero .hero-actions { flex-direction: column; align-items: stretch; }
    }


    /* =========================================================
       LAYOUT & REVEAL
    ========================================================= */

    .dash-grid { margin-top: 22px; }

    .dash-section {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity .6s ease, transform .6s cubic-bezier(.22,1,.36,1);
    }

    .dash-section.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .dash-count {
        display: inline-grid;
        place-items: center;
        min-width: 22px;
        height: 22px;
        margin-left: 8px;
        padding: 0 7px;
        border-radius: 20px;
        vertical-align: 3px;
        background: linear-gradient(110deg, #6425ff, #004dff 60%, #00a8f0);
        font-family: 'DM Sans', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: #ffffff;
    }

    .dash-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 26px 20px;
        border-radius: 11px;
        border: 1px dashed #c9dcf8;
        background: #f3f8ffaa;
        text-align: center;
    }

    .dash-empty strong {
        margin-top: 4px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #101d48;
    }

    .dash-empty p {
        max-width: 380px;
        margin: 0;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 1.6;
        color: #59699e;
    }

    .dash-empty .btn { margin-top: 8px; }

    .dash-progress {
        height: 7px;
        border-radius: 8px;
        background: #e3edfc;
        overflow: hidden;
    }

    .dash-progress > span {
        display: block;
        height: 100%;
        width: 0%;
        border-radius: 8px;
        background: linear-gradient(90deg, #7224ff, #3735ff 55%, #087fff);
        transition: width 1.1s cubic-bezier(.22,1,.36,1);
    }


    /* =========================================================
       WHAT NEEDS YOUR ATTENTION
    ========================================================= */

    .attention-list {
        display: grid;
        gap: 10px;
    }

    .attention-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 13px 16px;
        border-radius: 11px;
        border: 1px solid #dde9fc;
        background: #ffffffc9;
        transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s ease, border-color .25s ease;
    }

    .attention-row:hover {
        transform: translateY(-2px);
        border-color: #bcd2ff;
        box-shadow: 0 12px 26px -12px #3b5bdb40;
    }

    .attention-body {
        flex: 1;
        min-width: 0;
    }

    .attention-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13.5px;
        color: #101d48;
        overflow-wrap: anywhere;
    }

    .attention-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 10px;
        margin-top: 5px;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: #5877ac;
    }

    .attention-action {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 8px;
        border: 1px solid #c9dbff;
        background: #f3f8ff;
        font-family: 'DM Sans', sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: #1451ff;
        white-space: nowrap;
        transition: background .2s ease, color .2s ease, border-color .2s ease;
    }

    .attention-action i { transition: transform .2s ease; }

    .attention-row:hover .attention-action {
        border-color: transparent;
        background: linear-gradient(105deg, #6425ff, #004dff 55%, #00a8f0);
        color: #ffffff;
    }

    .attention-row:hover .attention-action i { transform: translateX(3px); }

    @@media(max-width: 560px) {
        .attention-row { flex-wrap: wrap; align-items: flex-start; }
        .attention-body { flex: 1 1 calc(100% - 60px); }
        .attention-action { width: 100%; justify-content: center; white-space: normal; text-align: center; }
    }


    /* =========================================================
       ACTIVE CAMPAIGNS
    ========================================================= */

    .campaign-workspace {
        display: grid;
        gap: 10px;
    }

    .campaign-row-card {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) 96px minmax(0, .8fr) minmax(0, 1.1fr) minmax(0, .8fr);
        align-items: center;
        gap: 18px;
        padding: 14px 16px;
        border-radius: 11px;
        border: 1px solid #dde9fc;
        background: #ffffffc9;
        transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s ease, border-color .25s ease;
    }

    .campaign-row-card:hover {
        transform: translateY(-2px);
        border-color: #bcd2ff;
        box-shadow: 0 12px 26px -12px #3b5bdb40;
    }

    .campaign-row-id {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .campaign-row-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #101d48;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .campaign-row-meta {
        margin-top: 3px;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: #5877ac;
    }

    .campaign-row-creators {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 4px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
        color: #3d4fd6;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .campaign-row-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 14.5px;
        color: #101d48;
    }

    .campaign-row-label {
        margin-top: 2px;
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        color: #6680ad;
    }

    .campaign-row-progress-label {
        display: flex;
        justify-content: space-between;
        margin-top: 6px;
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        color: #6680ad;
    }

    .campaign-row-progress-label strong {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        color: #101d48;
    }

    @@media(max-width: 900px) {
        .campaign-row-card { grid-template-columns: 1fr 1fr; row-gap: 12px; }
        .campaign-row-id { grid-column: 1 / -1; }
    }


    /* =========================================================
       COLLABORATION ACTIVITY
    ========================================================= */

    .collab-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .collab-row {
        display: block;
        padding: 14px 16px;
        border-radius: 11px;
        border: 1px solid #dde9fc;
        background: #ffffffc9;
        transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s ease, border-color .25s ease;
    }

    .collab-row:hover {
        transform: translateY(-2px);
        border-color: #bcd2ff;
        box-shadow: 0 12px 26px -12px #3b5bdb40;
    }

    .collab-row-head {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .collab-avatar {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(130deg, #8a12ff, #0759ff 60%, #00b4ff);
        box-shadow: inset 0 0 6px #ffffff55;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #ffffff;
    }

    .collab-row-name {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13.5px;
        color: #101d48;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .collab-row-campaign {
        margin-top: 2px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #5877ac;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .collab-row-head > div { min-width: 0; flex: 1; }
    .collab-row-head .ui-badge { flex-shrink: 0; }

    .collab-row-progress {
        display: flex;
        justify-content: space-between;
        margin: 12px 0 6px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #5877ac;
    }

    .collab-row-progress strong {
        font-family: 'DM Sans', sans-serif;
        color: #101d48;
    }

    .collab-row-due {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 9px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #6680ad;
    }

    .collab-row-due i { color: #5b4dff; }

    @@media(max-width: 700px) {
        .collab-list { grid-template-columns: 1fr; }
    }


    /* =========================================================
       FINANCE OVERVIEW
    ========================================================= */

    .finance-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: 28px;
        align-items: stretch;
    }

    .finance-kicker {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: #5877ac;
    }

    .finance-spend-value {
        margin-top: 4px;
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 32px;
        line-height: 1.1;
        background: linear-gradient(110deg, #7224ff, #3735ff 55%, #087fff);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
    }

    .finance-spend-of {
        margin-top: 5px;
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #33477c;
    }

    .finance-panel .dash-progress { margin-top: 14px; height: 9px; }

    .finance-substats {
        display: grid;
        gap: 2px;
        margin-top: 16px;
    }

    .finance-substat {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 8px 0;
        border-top: 1px solid #e3edfc;
    }

    .finance-substat:first-child { border-top: 0; }

    .finance-substat > span:not(.icon-chip) {
        flex: 1;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #5877ac;
    }

    .finance-substat strong {
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #101d48;
    }

    .finance-chart-wrap {
        display: flex;
        flex-direction: column;
        padding: 16px 18px 12px;
        border-radius: 11px;
        border: 1px solid #e0ecfc;
        background: #ffffff9e;
    }

    .finance-chart-title {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 12.5px;
        font-weight: 700;
        color: #101d48;
    }

    .finance-chart-title small {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 500;
        color: #6680ad;
    }

    .finance-chart {
        flex: 1;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
        min-height: 160px;
        margin-top: 14px;
    }

    .finance-chart-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
    }

    .finance-chart-bar-track {
        width: 100%;
        max-width: 34px;
        height: 130px;
        display: flex;
        align-items: flex-end;
        border-radius: 7px;
        background: #eaf2fe;
        overflow: hidden;
        transition: box-shadow .2s ease;
    }

    .finance-chart-col:hover .finance-chart-bar-track { box-shadow: 0 0 0 2px #c9dbff; }

    .finance-chart-bar-fill {
        width: 100%;
        height: 0%;
        border-radius: 7px;
        background: linear-gradient(180deg, #087fff, #3735ff 55%, #7224ff);
        transition: height 1s cubic-bezier(.22,1,.36,1);
    }

    .finance-chart-label {
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        color: #4a6099;
    }

    @@media(max-width: 900px) {
        .finance-panel { grid-template-columns: 1fr; }
    }


    /* =========================================================
       SMART MATCH — dark navy signature panel
    ========================================================= */

    .smart-match-panel {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: 24px 26px;
        border-radius: 12px;
        background: radial-gradient(circle at 100% 0%, rgba(114,36,255,.22), transparent 40%), radial-gradient(circle at 0% 100%, rgba(8,127,255,.18), transparent 45%), linear-gradient(135deg, #070c22 0%, #0a1433 60%, #0d1b4a 100%);
        box-shadow: 0 18px 36px -14px rgba(7,12,34,.45), inset 0 1px 0 rgba(255,255,255,.1);
        color: #ffffff;
    }

    .smart-match-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .smart-match-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        color: #9fb8ff;
    }

    .smart-match-title {
        margin-top: 6px;
        font: 600 21px/1.3 'Playfair Display', Georgia, serif;
        color: #ffffff;
    }

    .smart-match-sub {
        margin-top: 5px;
        max-width: 480px;
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        line-height: 1.55;
        color: #b8c6e8;
    }

    .smart-match-link {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 10px;
        border: 1px solid #64beff;
        background: linear-gradient(120deg, #258bff55, #468fff88);
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        color: #ffffff;
        white-space: nowrap;
        transition: .2s ease;
    }

    .smart-match-link:hover {
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 0 22px rgba(35,110,255,.35);
    }

    .smart-match-list {
        display: grid;
        gap: 10px;
        margin-top: 20px;
    }

    .smart-match-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 13px 16px;
        border-radius: 11px;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.11);
        color: #ffffff;
        transition: transform .25s ease, background .25s ease, border-color .25s ease;
    }

    .smart-match-row:hover {
        color: #ffffff;
        transform: translateY(-2px);
        background: rgba(255,255,255,.11);
        border-color: rgba(120,160,255,.4);
    }

    .match-score {
        flex-shrink: 0;
        display: grid;
        place-items: center;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: conic-gradient(from -90deg, #00a8f0 0%, #6425ff calc(var(--score) * 1%), rgba(255,255,255,.12) calc(var(--score) * 1%));
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13.5px;
    }

    .match-score-inner {
        display: grid;
        place-items: center;
        width: 43px;
        height: 43px;
        border-radius: 50%;
        background: #0b1433;
    }

    .match-body { flex: 1; min-width: 0; }

    .match-name {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 14px;
    }

    .match-name small {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 11.5px;
        color: #9fb8ff;
    }

    .match-reasons {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 7px;
    }

    .match-reasons span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 20px;
        background: rgba(255,255,255,.08);
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        color: #cdd8f5;
    }

    .match-reasons i { color: #6fc3ff; }

    .smart-match-row > .bi-arrow-right { color: #9fb8ff; transition: transform .2s ease; }
    .smart-match-row:hover > .bi-arrow-right { transform: translateX(3px); }

    .smart-match-empty {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 20px;
        padding: 18px 20px;
        border-radius: 11px;
        border: 1px dashed rgba(255,255,255,.22);
    }

    .smart-match-empty .icon-chip { background: rgba(255,255,255,.1); color: #9fb8ff; }

    .smart-match-empty strong {
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        color: #ffffff;
    }

    .smart-match-empty p {
        margin-top: 3px;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 1.55;
        color: #b8c6e8;
    }


    /* =========================================================
       DISCOVER CREATORS
    ========================================================= */

    .creator-preview-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .mini-creator-card {
        padding: 16px;
        border-radius: 11px;
        border: 1px solid #dde9fc;
        background: #ffffffc9;
        transition: transform .25s cubic-bezier(.22,1,.36,1), box-shadow .25s ease, border-color .25s ease;
    }

    .mini-creator-card:hover {
        transform: translateY(-3px);
        border-color: #bcd2ff;
        box-shadow: 0 14px 28px -12px #3b5bdb40;
    }

    .mini-creator-head {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .mini-creator-head > div { min-width: 0; flex: 1; }
    .mini-creator-card { min-width: 0; }

    .mini-creator-name {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13.5px;
        color: #101d48;
    }

    .mini-creator-name > span:first-child {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mini-creator-handle {
        margin-top: 3px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #5877ac;
    }

    .mini-creator-figures {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin-top: 13px;
        border: 1px solid #e3edfc;
        border-radius: 9px;
        background: #f6faffcc;
    }

    .mini-creator-figures > div { padding: 8px 12px; }
    .mini-creator-figures > div + div { border-left: 1px solid #e3edfc; }

    .mini-figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #101d48;
    }

    .mini-figure-label {
        margin-top: 1px;
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        color: #6680ad;
    }

    .mini-creator-actions {
        display: flex;
        gap: 6px;
        margin-top: 12px;
    }

    .mini-creator-actions form { flex: 1; margin: 0; }

    .mini-action-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #d3e2fb;
        background: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 600;
        color: #33477c;
        cursor: pointer;
        transition: .2s ease;
    }

    .mini-action-btn:hover {
        border-color: #8f7bff;
        color: #1451ff;
    }

    .mini-action-btn.is-primary {
        border: none;
        background: linear-gradient(105deg, #6425ff, #004dff 55%, #00a8f0);
        color: #ffffff;
    }

    .mini-action-btn.is-primary:hover {
        color: #ffffff;
        box-shadow: 0 8px 18px -8px #3b4dff90;
    }

    .mini-action-btn.is-saved {
        border-color: transparent;
        background: #ebe8ff;
        color: #5b3df0;
    }

    @@media(max-width: 700px) {
        .creator-preview-row { grid-template-columns: minmax(0, 1fr); }
    }


    /* =========================================================
       RAIL — Next Up, quick actions, activity
    ========================================================= */

    .rail-title { font-size: 17px; }

    .rail-list { display: grid; grid-template-columns: minmax(0, 1fr); }

    .rail-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 -8px;
        padding: 10px 8px;
        border-radius: 9px;
        border-top: 1px solid #e3edfc;
        transition: background .2s ease, transform .2s ease;
    }

    .rail-row:first-child { border-top-color: transparent; }

    .rail-row:hover {
        background: #eef5ffcc;
        transform: translateX(2px);
    }

    .rail-row-body { flex: 1; min-width: 0; }

    .rail-row-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 12.5px;
        font-weight: 700;
        color: #101d48;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rail-row-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #6680ad;
    }

    .rail-row-text {
        margin-top: 2px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        line-height: 1.45;
        color: #5877ac;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .rail-row .ui-badge { padding: 2px 8px; font-size: 10px; }

    .rail-row > .bi-chevron-right {
        flex-shrink: 0;
        font-size: 11px;
        color: #8095c4;
        transition: transform .2s ease, color .2s ease;
    }

    .rail-row:hover > .bi-chevron-right { transform: translateX(3px); color: #1451ff; }

    .date-tile {
        flex-shrink: 0;
        display: grid;
        place-items: center;
        align-content: center;
        width: 42px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #e4eeff, #cce2ff);
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        line-height: 1;
        color: #135bff;
    }

    .date-tile small {
        margin-top: 3px;
        font-family: 'Inter', sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: #4a6099;
    }

    .activity-time {
        flex-shrink: 0;
        align-self: flex-start;
        margin-top: 2px;
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        color: #8095c4;
    }

    .rail-empty {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 6px 0 2px;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        line-height: 1.55;
        color: #59699e;
    }

    .dash-cta { margin-top: 18px; }

    .dash-cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .cta-banner a.is-quiet {
        border-color: rgba(255,255,255,.22);
        background: rgba(255,255,255,.06);
    }

}

<section class="page-hero dash-hero" id="dashHero">
