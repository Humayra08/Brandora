<div class="page-grid dash-grid">

    <div class="page-main">

        @* ---------- What needs your attention ---------- *@
        <section class="ui-card dash-section" id="attention" data-reveal>
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">
                        What Needs Your Attention
                        @if (attentionCount > 0)
                        {
                            <span class="dash-count">@attentionCount</span>
                        }
                    </div>
                    <p class="ui-card-sub">Proposals, proof reviews and payments waiting on a decision from you.</p>
                </div>
                @if (attentionCount == 0)
                {
                    <span class="ui-badge is-success"><i class="bi bi-check2"></i> All clear</span>
                }
            </div>

            @if (attentionCount > 0)
            {
                <div class="attention-list">
                    @foreach (var item in Model.AttentionItems)
                    {
                        var style = KindStyle(item.Kind);
                        <a href="@item.LinkUrl" class="attention-row">
                            <span class="icon-chip @style.Chip" aria-hidden="true"><i class="bi @style.Icon"></i></span>
                            <div class="attention-body">
                                <div class="attention-title">@item.Title</div>
                                <div class="attention-meta">
                                    <span class="ui-badge @style.Badge">@style.Label</span>
                                    <span>@item.Detail</span>
                                </div>
                            </div>
                            <span class="attention-action">@item.ActionLabel <i class="bi bi-arrow-right"></i></span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="dash-empty">
                    <span class="icon-chip lg soft"><i class="bi bi-check2-circle"></i></span>
                    <strong>You're all caught up</strong>
                    <p>No proposals, milestone proofs or payments are waiting on you right now. A good moment to find your next creator.</p>
                    <a href="/Influencers" class="btn btn-primary">Discover Creators</a>
                </div>
            }
        </section>

        @* ---------- Active campaigns ---------- *@
        <section class="ui-card dash-section" id="campaigns" data-reveal>
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Your Active Campaigns</div>
                    <p class="ui-card-sub">Campaigns moving from planning to creator delivery, with milestone progress.</p>
                </div>
                <a href="/Campaigns" class="ui-card-link">View all campaigns <i class="bi bi-arrow-right"></i></a>
            </div>

            @if (Model.CampaignWorkspace.Count > 0)
            {
                <div class="campaign-workspace">
                    @foreach (var item in Model.CampaignWorkspace)
                    {
                        var c = item.Campaign;
                        var status = StatusStyle(c.Status);
                        <a href="/Campaigns/Detail/@c.Id" class="campaign-row-card">

                            <div class="campaign-row-id">
                                <span class="icon-chip sm @status.Chip" aria-hidden="true"><i class="bi @status.Icon"></i></span>
                                <div style="min-width:0;">
                                    <div class="campaign-row-title">@c.Title</div>
                                    <div class="campaign-row-meta">@(c.Platform ?? "Any platform") &middot; @(c.Niche ?? "General")</div>
                                    @if (item.CreatorNames.Count > 0)
                                    {
                                        <div class="campaign-row-creators"><i class="bi bi-people"></i> @string.Join(", ", item.CreatorNames.Take(2))@(item.CreatorNames.Count > 2 ? $" +{item.CreatorNames.Count - 2}" : "")</div>
                                    }
                                    else if (item.ApplicantCount > 0)
                                    {
                                        <div class="campaign-row-creators"><i class="bi bi-envelope-paper"></i> @Plural(item.ApplicantCount, "proposal")</div>
                                    }
                                </div>
                            </div>

                            <span class="ui-badge @status.Badge">@c.Status</span>

                            <div>
                                <div class="campaign-row-value">@Money(c.Budget)</div>
                                <div class="campaign-row-label">Budget</div>
                            </div>

                            <div>
                                <div class="dash-progress"><span data-fill-to="@item.ProgressPercent"></span></div>
                                <div class="campaign-row-progress-label"><span>Progress</span><strong>@item.ProgressPercent%</strong></div>
                            </div>

                            <div>
                                <div class="campaign-row-value" style="font-size:13px;">@(c.Deadline?.ToString("MMM d, yyyy") ?? "No deadline")</div>
                                <div class="campaign-row-label">@DeadlineNote(c.Deadline)</div>
                            </div>

                        </a>
                    }
                </div>
            }
            else
            {
                <div class="dash-empty">
                    <span class="icon-chip lg soft"><i class="bi bi-rocket-takeoff"></i></span>
                    <strong>Your next campaign starts here</strong>
                    <p>You haven't launched a campaign yet. Define your goals, set your milestones and discover creators who can bring it to life.</p>
                    <a href="/Campaigns/Create" class="btn btn-primary">Create Your First Campaign</a>
                </div>
            }
        </section>

        @* ---------- Collaboration activity ---------- *@
        <section class="ui-card dash-section" id="collaborations" data-reveal>
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Collaboration Activity</div>
                    <p class="ui-card-sub">Live milestone progress across your active creator collaborations.</p>
                </div>
                <a href="/Collaborations" class="ui-card-link">Manage collaborations <i class="bi bi-arrow-right"></i></a>
            </div>

            @if (Model.CollaborationActivity.Count > 0)
            {
                <div class="collab-list">
                    @foreach (var item in Model.CollaborationActivity)
                    {
                        var pct = item.TotalMilestones > 0 ? (int)Math.Round(item.PaidMilestones * 100.0 / item.TotalMilestones) : 0;
                        <a href="/Collaborations/Detail/@item.Collaboration.Id" class="collab-row">
                            <div class="collab-row-head">
                                <span class="collab-avatar" aria-hidden="true">@FollowerFormat.InitialsOf(item.Collaboration.InfluencerProfile.FullName)</span>
                                <div>
                                    <div class="collab-row-name">@item.Collaboration.InfluencerProfile.FullName</div>
                                    <div class="collab-row-campaign">@item.Collaboration.Campaign.Title</div>
                                </div>
                                @if (item.NeedsAttention)
                                {
                                    <span class="ui-badge is-pending">Needs review</span>
                                }
                                else
                                {
                                    <span class="ui-badge is-success">On track</span>
                                }
                            </div>
                            <div class="collab-row-progress"><span>Milestones paid</span><strong>@item.PaidMilestones/@item.TotalMilestones</strong></div>
                            <div class="dash-progress"><span data-fill-to="@pct"></span></div>
                            <div class="collab-row-due">
                                <i class="bi @(item.NeedsAttention ? "bi-exclamation-circle" : "bi-calendar-event")"></i>
                                @(item.NeedsAttention
                                    ? "Proof submitted or a milestone is overdue"
                                    : item.NextDueDate.HasValue
                                        ? $"Next milestone due {item.NextDueDate.Value:MMM d}"
                                        : "No upcoming due dates")
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="dash-empty">
                    <span class="icon-chip lg soft"><i class="bi bi-people"></i></span>
                    <strong>No active collaborations yet</strong>
                    <p>When you accept a creator's proposal, the collaboration appears here with live milestone progress.</p>
                    <a href="/Proposals" class="btn btn-secondary">View Proposals</a>
                </div>
            }
        </section>

        @* ---------- Finance overview ---------- *@
        <section class="ui-card dash-section" id="finance" data-reveal>
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Finance Overview</div>
                    <p class="ui-card-sub">Spend, budget and bKash / Nagad payment activity across your campaigns.</p>
                </div>
                <a href="/Payments" class="ui-card-link">Open finance <i class="bi bi-arrow-right"></i></a>
            </div>

            <div class="finance-panel">
                <div>
                    <div class="finance-kicker">Spent so far</div>
                    <div class="finance-spend-value">@Money(Model.TotalSpend)</div>
                    @if (Model.TotalBudget > 0)
                    {
                        <div class="finance-spend-of">of @Money(Model.TotalBudget) budgeted &middot; <strong>@budgetPercent%</strong> used</div>
                        <div class="dash-progress"><span data-fill-to="@budgetPercent"></span></div>
                    }
                    else
                    {
                        <div class="finance-spend-of">Set a campaign budget to start tracking spend.</div>
                    }

                    <div class="finance-substats">
                        <div class="finance-substat">
                            <span class="icon-chip sm amber" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                            <span>Pending payments</span>
                            <strong>@Money(Model.PendingPaymentsAmount)</strong>
                        </div>
                        <div class="finance-substat">
                            <span class="icon-chip sm violet" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
                            <span>Paid out to creators</span>
                            <strong>@Money(Model.CompletedPaymentsAmount)</strong>
                        </div>
                        <div class="finance-substat">
                            <span class="icon-chip sm blue" aria-hidden="true"><i class="bi bi-piggy-bank"></i></span>
                            <span>Budget remaining</span>
                            <strong>@Money(remainingBudget)</strong>
                        </div>
                    </div>
                </div>

                <div class="finance-chart-wrap">
                    <div class="finance-chart-title">Monthly spend <small>Completed payments &middot; last 6 months</small></div>
                    <div class="finance-chart">
                        @foreach (var point in Model.SpendByMonth)
                        {
                            var pct = maxSpend > 0 ? (int)Math.Round((double)(point.Amount / maxSpend * 100)) : 0;
                            <div class="finance-chart-col" title="@point.Month: @Money(point.Amount)">
                                <div class="finance-chart-bar-track">
                                    <div class="finance-chart-bar-fill" data-fill-height-to="@pct"></div>
                                </div>
                                <div class="finance-chart-label">@point.Month</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>

        @* ---------- Smart Match ---------- *@
        <section class="dash-section" id="smart-match" data-reveal>
            <div class="smart-match-panel">
                <div class="smart-match-head">
                    <div>
                        <div class="smart-match-eyebrow"><i class="bi bi-stars"></i> Signature Feature</div>
                        <div class="smart-match-title">Smart Match</div>
                        <p class="smart-match-sub">
                            Rule-based creator matching against your campaign's platform, niche and engagement criteria &mdash; fully transparent, never a black box.
                        </p>
                    </div>
                    @if (Model.SmartMatchCampaign is not null)
                    {
                        <a href="/Influencers/SmartMatch?campaignId=@Model.SmartMatchCampaign.Id" class="smart-match-link">View full match <i class="bi bi-arrow-right"></i></a>
                    }
                </div>

                @if (Model.SmartMatchCampaign is not null && Model.SmartMatchPreview.Count > 0)
                {
                    <div class="smart-match-list">
                        @foreach (var result in Model.SmartMatchPreview)
                        {
                            <a href="/Influencers/Profile/@result.Creator.Id" class="smart-match-row">
                                <div class="match-score" style="--score: @result.Score;">
                                    <div class="match-score-inner">@result.Score%</div>
                                </div>
                                <div class="match-body">
                                    <div class="match-name">@result.Creator.FullName <small>&middot; for "@Model.SmartMatchCampaign.Title"</small></div>
                                    <div class="match-reasons">
                                        @foreach (var reason in result.Reasons)
                                        {
                                            <span><i class="bi bi-check2"></i> @reason</span>
                                        }
                                    </div>
                                </div>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="smart-match-empty">
                        <span class="icon-chip" aria-hidden="true"><i class="bi bi-stars"></i></span>
                        <div>
                            <strong>No matches to show yet</strong>
                            <p>Set a platform or niche on a published campaign, and Smart Match will surface the creators who fit it best.</p>
                        </div>
                    </div>
                }
            </div>
        </section>

        @* ---------- Discover creators ---------- *@
        <section class="ui-card dash-section" id="discover" data-reveal>
            <div class="ui-card-head">
                <div>
                    <div class="ui-card-title">Discover Creators</div>
                    <p class="ui-card-sub">Fresh profiles from the Brandora creator marketplace you haven't shortlisted yet.</p>
                </div>
                <a href="/Influencers" class="ui-card-link">Browse all creators <i class="bi bi-arrow-right"></i></a>
            </div>

            @if (Model.CreatorPreview.Count > 0)
            {
                <div class="creator-preview-row">
                    @foreach (var creator in Model.CreatorPreview)
                    {
                        var hue = (creator.Id * 47) % 360;
                        var hue2 = (hue + 50) % 360;
                        <div class="mini-creator-card">

                            <div class="mini-creator-head">
                                <div class="creator-avatar" style="width:44px;height:44px;font-size:14px;background: linear-gradient(135deg, hsl(@(hue)deg 75% 58%), hsl(@(hue2)deg 75% 48%));">
                                    @FollowerFormat.InitialsOf(creator.FullName)
                                </div>
                                <div>
                                    <div class="mini-creator-name">
                                        <span>@creator.FullName</span>
                                        @if (creator.Verified)
                                        {
                                            <span class="verified-badge"><i class="bi bi-patch-check-fill"></i> Verified</span>
                                        }
                                    </div>
                                    <div class="mini-creator-handle">@creator.PrimaryPlatform &middot; @creator.ContentNiche</div>
                                </div>
                            </div>

                            <div class="mini-creator-figures">
                                <div>
                                    <div class="mini-figure-value">@FollowerFormat.Format(creator.Followers)</div>
                                    <div class="mini-figure-label">Followers</div>
                                </div>
                                <div>
                                    <div class="mini-figure-value">@creator.EngagementRate.ToString("0.0")%</div>
                                    <div class="mini-figure-label">Engagement</div>
                                </div>
                            </div>

                            <div class="mini-creator-actions">
                                <a href="/Influencers/Profile/@creator.Id" class="mini-action-btn"><i class="bi bi-person"></i> Profile</a>

                                <form method="post" action="/Influencers/ToggleShortlist">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="influencerId" value="@creator.Id" />
                                    <input type="hidden" name="returnUrl" value="/Dashboard" />
                                    <button type="submit" class="mini-action-btn @(Model.IsShortlisted(creator.Id) ? "is-saved" : "")" style="width:100%;">
                                        <i class="bi @(Model.IsShortlisted(creator.Id) ? "bi-bookmark-fill" : "bi-bookmark")"></i>
                                        @(Model.IsShortlisted(creator.Id) ? "Saved" : "Shortlist")
                                    </button>
                                </form>

                                <a href="/Proposals/Invite?influencerId=@creator.Id" class="mini-action-btn is-primary"><i class="bi bi-send"></i> Invite</a>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <div class="dash-empty">
                    <span class="icon-chip lg soft"><i class="bi bi-person-plus"></i></span>
                    <strong>No new creators to show</strong>
                    <p>Once more influencers join Brandora, fresh profiles will appear here for you to discover and shortlist.</p>
                    <a href="/Influencers/Shortlist" class="btn btn-secondary">View Your Shortlist</a>
                </div>
            }
        </section>

    </div>

    <aside class="page-rail">

        @* ---------- Next up ---------- *@
        <section class="ui-card dash-section" id="next-up" data-reveal>
            <div class="ui-card-head" style="margin-bottom:6px;">
                <div>
                    <div class="ui-card-title rail-title">Next Up</div>
                    <p class="ui-card-sub">Deadlines and milestones ahead.</p>
                </div>
                <span class="icon-chip sm soft" aria-hidden="true"><i class="bi bi-calendar3"></i></span>
            </div>

            @if (Model.UpcomingItems.Count > 0)
            {
                <div class="rail-list">
                    @foreach (var item in Model.UpcomingItems)
                    {
                        var style = KindStyle(item.Kind);
                        <a href="@item.LinkUrl" class="rail-row">
                            <span class="date-tile">@item.Date.Day<small>@item.Date.ToString("MMM")</small></span>
                            <div class="rail-row-body">
                                <div class="rail-row-title">@item.Title</div>
                                <div class="rail-row-meta"><span class="ui-badge @style.Badge"><i class="bi @style.Icon"></i> @style.Label</span></div>
                            </div>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="rail-empty">
                    <span class="icon-chip sm soft" aria-hidden="true"><i class="bi bi-calendar-check"></i></span>
                    <span>Nothing scheduled. Campaign deadlines and milestone due dates appear here as you set them.</span>
                </div>
            }
        </section>

        @* ---------- Quick actions ---------- *@
        <section class="ui-card dash-section" data-reveal>
            <div class="ui-card-head" style="margin-bottom:6px;">
                <div class="ui-card-title rail-title">Quick Actions</div>
            </div>
            <div class="rail-list">
                <a href="/Campaigns/Create" class="rail-row">
                    <span class="icon-chip sm violet" aria-hidden="true"><i class="bi bi-plus-lg"></i></span>
                    <div class="rail-row-body"><div class="rail-row-title">Create a campaign</div><div class="rail-row-text">Brief, budget and milestones in four steps</div></div>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
                <a href="/Influencers" class="rail-row">
                    <span class="icon-chip sm blue" aria-hidden="true"><i class="bi bi-search"></i></span>
                    <div class="rail-row-body"><div class="rail-row-title">Find influencers</div><div class="rail-row-text">Filter by platform, niche and reach</div></div>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
                <a href="/Proposals" class="rail-row">
                    <span class="icon-chip sm cyan" aria-hidden="true"><i class="bi bi-envelope-paper"></i></span>
                    <div class="rail-row-body"><div class="rail-row-title">Review proposals</div><div class="rail-row-text">@Plural(Model.PendingProposalCount, "proposal") awaiting you</div></div>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
                <a href="/Collaborations" class="rail-row">
                    <span class="icon-chip sm soft" aria-hidden="true"><i class="bi bi-people"></i></span>
                    <div class="rail-row-body"><div class="rail-row-title">Manage collaborations</div><div class="rail-row-text">@Plural(Model.ActiveCollaborationCount, "active collaboration")</div></div>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
                <a href="/Payments" class="rail-row">
                    <span class="icon-chip sm pink" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
                    <div class="rail-row-body"><div class="rail-row-title">Payments &amp; finance</div><div class="rail-row-text">@Money(Model.PendingPaymentsAmount) pending &middot; @Money(Model.CompletedPaymentsAmount) paid</div></div>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            </div>
        </section>

        @* ---------- How campaigns work ---------- *@
        <section class="info-card dash-section" data-reveal>
            <div class="info-card-head">
                <span class="icon-chip soft" aria-hidden="true"><i class="bi bi-signpost-2"></i></span>
                <div class="info-card-title">How campaigns work on Brandora</div>
            </div>
            <ol class="next-steps">
                @for (var i = 0; i < journey.Count; i++)
                {
                    var step = journey[i];
                    <li class="@(step.Done ? "is-done" : i == currentStep ? "is-current" : "")">
                        <h4>@step.Title</h4>
                        <p>@step.Text</p>
                    </li>
                }
            </ol>
        </section>

        @* ---------- Recent activity ---------- *@
        <section class="ui-card dash-section" id="recent-activity" data-reveal>
            <div class="ui-card-head" style="margin-bottom:6px;">
                <div>
                    <div class="ui-card-title rail-title">Recent Activity</div>
                    <p class="ui-card-sub">What changed across your campaigns.</p>
                </div>
                <a href="/Notifications" class="ui-card-link">All <i class="bi bi-arrow-right"></i></a>
            </div>

            @if (Model.RecentActivity.Count > 0)
            {
                <div class="rail-list">
                    @foreach (var activity in Model.RecentActivity)
                    {
                        <a href="/Notifications/Open/@activity.Id" class="rail-row">
                            <span class="icon-chip sm soft" aria-hidden="true"><i class="bi bi-bell"></i></span>
                            <div class="rail-row-body">
                                <div class="rail-row-title">@activity.Title</div>
                                <div class="rail-row-text">@activity.Body</div>
                            </div>
                            <span class="activity-time">@activity.CreatedAt.ToString("MMM d")</span>
