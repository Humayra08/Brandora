@model Brandora.Web.Models.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
    Layout = "_AppLayout";
}

@section Styles {

    /* =========================================================
       HERO
    ========================================================= */

    .hero-card {
        position: relative;
        overflow: hidden;

        padding: 38px 42px;

        border-radius: 22px;

        background:
            radial-gradient(circle at 85% 0%, rgba(255,90,190,.35), transparent 45%),
            radial-gradient(circle at 0% 100%, rgba(0,169,255,.3), transparent 50%),
            linear-gradient(115deg, #6a1fd6 0%, #3a3fe0 55%, #1c6cff 100%);

        color: #ffffff;

        animation: fade-up .5s ease both;
    }

    .hero-eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,.72);
    }

    .hero-title {
        margin-top: 12px;

        font-family: 'Playfair Display', serif;
        font-weight: 600;

        font-size: clamp(28px, 3.4vw, 38px);
        letter-spacing: -.3px;
    }

    .hero-sub {
        margin-top: 10px;

        max-width: 520px;

        font-size: 14.5px;
        line-height: 1.65;
        color: rgba(255,255,255,.82);
    }

    .hero-cta {
        margin-top: 22px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        height: 46px;
        padding: 0 24px;

        border-radius: 10px;
        border: none;

        background: #ffffff;
        color: #3a1fc9;

        font-family: 'Inter', sans-serif;
        font-size: 13.5px;
        font-weight: 700;

        transition: .2s;
    }

    .hero-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(0,0,0,.2);
    }


    /* =========================================================
       STAT CARDS
    ========================================================= */

    .stat-grid {
        margin-top: 28px;

        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .stat-card {
        padding: 22px 22px 20px;

        border-radius: 16px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        box-shadow: 0 10px 24px rgba(30,34,90,.04);

        transition: transform .2s ease, box-shadow .2s ease;

        animation: fade-up .5s ease both;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 32px rgba(30,34,90,.08);
    }

    .stat-accent {
        width: 34px;
        height: 4px;
        border-radius: 4px;

        margin-bottom: 16px;
    }

    .stat-card.drafts .stat-accent { background: linear-gradient(90deg, #ffb648, #ff8a3d); }
    .stat-card.published .stat-accent { background: linear-gradient(90deg, #2694ff, #6bb7ff); }
    .stat-card.active .stat-accent { background: linear-gradient(90deg, #12c48b, #5be2b4); }
    .stat-card.completed .stat-accent { background: linear-gradient(90deg, #9b2cff, #c98bff); }

    .stat-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 32px;
        letter-spacing: -.5px;
    }

    .stat-label {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        color: #6b7290;
    }


    /* =========================================================
       SPLIT SECTION
    ========================================================= */

    .split-grid {
        margin-top: 22px;

        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 18px;
    }

    .spend-figures {
        margin-top: 22px;

        display: flex;
        align-items: baseline;
        gap: 10px;
    }

    .spend-amount {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 30px;

        background: linear-gradient(100deg, #6a1fd6, #1c6cff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .spend-of {
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #8189a8;
    }

    .spend-bar-track {
        margin-top: 16px;

        height: 10px;
        border-radius: 10px;
        background: #eef0f8;

        overflow: hidden;
    }

    .spend-bar-fill {
        height: 100%;
        border-radius: 10px;

        background: linear-gradient(90deg, #9b2cff, #2694ff);

        width: 0%;
        transition: width 1s cubic-bezier(.22,1,.36,1);
    }

    .pending-count {
        margin-top: 18px;

        display: flex;
        align-items: baseline;
        gap: 8px;
    }

    .pending-number {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 30px;
        color: #131a35;
    }

    .pending-label {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #8189a8;
    }


    /* =========================================================
       RECENT CAMPAIGNS
    ========================================================= */

    .recent-panel {
        margin-top: 18px;
        padding: 26px 28px 8px;
    }

    .campaign-row {
        display: grid;
        grid-template-columns: 1.6fr .8fr .8fr .8fr;
        align-items: center;
        gap: 14px;

        padding: 16px 0;
        border-top: 1px solid #f0f1f7;

        font-family: 'Inter', sans-serif;
        font-size: 13px;

        transition: .15s;
    }

    .campaign-row:first-of-type {
        border-top: none;
    }

    a.campaign-row:hover {
        background: #fafbfe;
        margin: 0 -12px;
        padding: 16px 12px;
        border-radius: 10px;
    }

    .campaign-title {
        font-weight: 600;
        color: #1a2044;
    }

    .campaign-budget {
        color: #4b5273;
    }

    .campaign-date {
        color: #9096b3;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media(max-width: 1100px) {
        .stat-grid { grid-template-columns: repeat(2, 1fr); }
        .split-grid { grid-template-columns: 1fr; }
    }

    @@media(max-width: 820px) {
        .campaign-row { grid-template-columns: 1.4fr .8fr; row-gap: 4px; }
    }

}

<section class="hero-card">
    <div class="hero-eyebrow">Entry Workspace</div>
    <h1 class="hero-title">Welcome Back, @Model.CompanyName.</h1>
    <p class="hero-sub">
        This is your command center for brand&ndash;creator collaboration.
        Creator discovery and Smart Match are arriving in the next phases &mdash;
        for now, here's where your campaigns stand.
    </p>
    <a href="/Campaigns/Create" class="hero-cta">Create Campaign</a>
</section>

<section class="stat-grid">

    <div class="stat-card drafts">
        <div class="stat-accent"></div>
        <div class="stat-value" data-count-to="@Model.DraftCount">0</div>
        <div class="stat-label">Drafts</div>
    </div>

    <div class="stat-card published">
        <div class="stat-accent"></div>
        <div class="stat-value" data-count-to="@Model.PublishedCount">0</div>
        <div class="stat-label">Published</div>
    </div>

    <div class="stat-card active">
        <div class="stat-accent"></div>
        <div class="stat-value" data-count-to="@Model.ActiveCount">0</div>
        <div class="stat-label">Active</div>
    </div>

    <div class="stat-card completed">
        <div class="stat-accent"></div>
        <div class="stat-value" data-count-to="@Model.CompletedCount">0</div>
        <div class="stat-label">Completed</div>
    </div>

</section>

<section class="split-grid">

    <div class="panel">
        <div class="panel-title">Campaign Spend</div>
        <div class="panel-sub">Total spend across all campaigns against total budget allocated.</div>

        @if (Model.TotalBudget > 0)
        {
            <div class="spend-figures">
                <span class="spend-amount">৳@Model.TotalSpend.ToString("N0")</span>
                <span class="spend-of">of ৳@Model.TotalBudget.ToString("N0") budgeted</span>
            </div>
            <div class="spend-bar-track">
                <div class="spend-bar-fill" data-fill-to="@(Math.Min(100, Model.TotalBudget == 0 ? 0 : (double)(Model.TotalSpend / Model.TotalBudget * 100)))"></div>
            </div>
        }
        else
        {
            <div class="empty-block">
                <div class="empty-title">No spend to show yet</div>
                <p class="empty-text">Once you create and fund a campaign, spend against budget will track here in real time.</p>
            </div>
        }
    </div>

    <div class="panel">
        <div class="panel-title">Pending Actions</div>
        <div class="panel-sub">Invites awaiting confirmation.</div>

        @if (Model.PendingProposalCount > 0)
        {
            <div class="pending-count">
                <span class="pending-number">@Model.PendingProposalCount</span>
                <span class="pending-label">awaiting response</span>
            </div>
            <a href="/Proposals?status=Pending" class="btn btn-secondary" style="margin-top: 14px;">Review Proposals</a>
        }
        else
        {
            <div class="empty-block">
                <div class="empty-title">You're all caught up</div>
                <p class="empty-text">Invites you send to creators will show up here until confirmed.</p>
            </div>
        }
    </div>

</section>

<section class="panel recent-panel">
    <div class="panel-title">Recent Campaigns</div>
    <div class="panel-sub">Your most recently created campaigns.</div>

    @if (Model.HasAnyCampaigns)
    {
        <div style="margin-top: 18px;">
            @foreach (var campaign in Model.RecentCampaigns)
            {
                <a href="/Campaigns/Detail/@campaign.Id" class="campaign-row">
                    <span class="campaign-title">@campaign.Title</span>
                    <span class="status-pill @campaign.Status.ToString().ToLowerInvariant()">@campaign.Status</span>
                    <span class="campaign-budget">৳@campaign.Budget.ToString("N0")</span>
                    <span class="campaign-date">@campaign.CreatedAt.ToString("MMM d, yyyy")</span>
                </a>
            }
        </div>
    }
    else
    {
        <div class="empty-block" style="margin-bottom: 24px;">
            <div class="empty-title">No campaigns yet</div>
            <p class="empty-text">Create your first campaign to start building your workspace.</p>
            <a href="/Campaigns/Create" class="btn btn-primary" style="margin-top: 16px;">Create Campaign</a>
        </div>
    }
</section>
