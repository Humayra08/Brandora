        </div>
        <a href="/Campaigns" class="dash-section-link">View All Campaigns &rarr;</a>
    </div>

    @if (Model.CampaignWorkspace.Count > 0)
    {
        <div class="campaign-workspace">
            @foreach (var item in Model.CampaignWorkspace)
            {
                var c = item.Campaign;
                var accent = c.Status switch
                {
                    CampaignStatus.Draft => "linear-gradient(180deg, #ffb648, #ff8a3d)",
                    CampaignStatus.Published => "linear-gradient(180deg, #2694ff, #6bb7ff)",
                    CampaignStatus.Active => "linear-gradient(180deg, #12c48b, #5be2b4)",
                    CampaignStatus.Completed => "linear-gradient(180deg, #9b2cff, #c98bff)",
                    _ => "linear-gradient(180deg, #e0507a, #ff8fae)"
                };
                <a href="/Campaigns/Detail/@c.Id" class="campaign-row-card" style="--campaign-accent: @accent;">

                    <div>
                        <div class="campaign-row-title">@c.Title</div>
                        <div class="campaign-row-meta">@(c.Platform ?? "Any platform") &middot; @(c.Niche ?? "General")</div>
                        @if (item.CreatorNames.Count > 0)
                        {
                            <div class="campaign-row-creators">@string.Join(", ", item.CreatorNames.Take(2))@(item.CreatorNames.Count > 2 ? $" +{item.CreatorNames.Count - 2}" : "")</div>
                        }
