@model Brandora.Web.Models.Dashboard.DashboardViewModel
@using Brandora.Web.Models.Domain
@using Brandora.Web.Models.Influencers
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
    Layout = "_AppLayout";

    var maxSpend = Model.SpendByMonth.Count > 0 ? Model.SpendByMonth.Max(p => p.Amount) : 0m;
    var budgetPercent = Model.TotalBudget > 0 ? (int)Math.Round(Math.Min(100, (double)(Model.TotalSpend / Model.TotalBudget * 100))) : 0;
}

@section Styles {

    /* =========================================================
       HERO — actions row only; the hero card itself (background,
       heading, glass-card visual, motto) is the shared .page-hero
       component in _AppLayout.cshtml, matching the Influencer side.
    ========================================================= */

    .hero-actions {
        margin-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 11px;
    }

    .hero-cta-caption {
        margin-top: 10px;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: #9096b3;
    }

    .hero-cta,
    .hero-cta-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 44px;
        padding: 0 22px;
        border-radius: 11px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 750;
        transition: transform .28s cubic-bezier(.22,1,.36,1), box-shadow .28s ease, background-position .35s ease, background .25s ease, border-color .25s ease;
    }

    .hero-cta {
        border: none;
        background: linear-gradient(105deg, #a326ff, #6745ff 48%, #179eff);
        background-size: 180% 180%;
        color: #ffffff;
        box-shadow: 0 10px 25px rgba(131,48,255,.28);
    }

    .hero-cta::after {
        content: "→";
        font-size: 15px;
        transition: transform .25s ease;
    }

    .hero-cta:hover {
        transform: translateY(-3px);
        background-position: 100% 50%;
        box-shadow: 0 16px 34px rgba(131,48,255,.42);
    }

    .hero-cta:hover::after {
        transform: translateX(4px);
    }

    .hero-cta-ghost {
        border: 1.5px solid #a9c9ff;
        background: #ffffff;
        color: #2b467d;
    }

    .hero-cta-ghost::before {
        content: "✦";
        color: #7224ff;
        transition: transform .3s ease;
    }

    .hero-cta-ghost:hover {
        transform: translateY(-3px);
        background: #f3f8ff;
        border-color: #7224ff;
        color: #171d3d;
        box-shadow: 0 12px 30px rgba(30,34,90,.12);
    }

    .hero-cta-ghost:hover::before {
        transform: rotate(90deg) scale(1.15);
    }

    /* Social-media / brand partnership visual */

    @@media(max-width: 560px) {
        .hero-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .hero-cta,
        .hero-cta-ghost {
            width: 100%;
        }
    }

    /* =========================================================
       METRIC BAND — varied, editorial, real drill-down links
    ========================================================= */

    /* Stat cards — shared .metric-* component, see _AppLayout.cshtml. */


    /* =========================================================
       SECTION SCAFFOLDING
    ========================================================= */

    .dash-section {
        margin-top: 34px;

        opacity: 0;
        transform: translateY(22px);
        transition: opacity .6s ease, transform .6s cubic-bezier(.22,1,.36,1);
    }

    .dash-section.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .dash-section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;

        margin-bottom: 18px;
    }

    .dash-section-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 21px;
        color: #171d3d;
    }

    .dash-section-sub {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #8189a8;
    }

    .dash-section-link {
        flex-shrink: 0;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 700;
        color: #7a1fd6;

        transition: color .2s ease;
    }

    .dash-section-link:hover {
        color: #a326ff;
    }


    /* =========================================================
       CAMPAIGN WORKSPACE — the heart of the dashboard
    ========================================================= */

    .campaign-workspace {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .campaign-row-card {
        position: relative;
        overflow: hidden;

        padding: 24px 26px;

        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        display: grid;
        grid-template-columns: 1.6fr .9fr 1fr 1.1fr .7fr;
        align-items: center;
        gap: 22px;

        transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s ease, border-color .3s ease;
    }

    .campaign-row-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;

        background: var(--campaign-accent, linear-gradient(180deg, #a326ff, #236eff));
    }

    a.campaign-row-card:hover {
        transform: translateY(-3px) translateX(2px);
        box-shadow: 0 20px 40px rgba(30,34,90,.1);
        border-color: transparent;
    }

    .campaign-row-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 16px;
        color: #171d3d;
    }

    .campaign-row-meta {
        margin-top: 5px;

        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: #8189a8;
    }

    .campaign-row-creators {
        margin-top: 8px;

        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 600;
        color: #7a1fd6;
    }

    .campaign-row-budget-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 17px;
        color: #171d3d;
    }

    .campaign-row-budget-label {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .campaign-row-progress-track {
        height: 8px;
        border-radius: 8px;
        background: #eef0f8;
        overflow: hidden;
    }

    .campaign-row-progress-fill {
        height: 100%;
        border-radius: 8px;
        width: 0%;
        background: var(--campaign-accent, linear-gradient(90deg, #a326ff, #236eff));
        transition: width 1.1s cubic-bezier(.22,1,.36,1);
    }

    .campaign-row-progress-label {
        margin-top: 6px;

        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #8189a8;
    }

    .campaign-row-deadline-value {
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 600;
        color: #3c4363;
    }

    .campaign-row-deadline-label {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        color: #9096b3;
    }

    @@media(max-width: 940px) {
        .campaign-row-card { grid-template-columns: 1fr 1fr; row-gap: 14px; }
    }


    /* =========================================================
       SPLIT: ATTENTION + COLLABORATION ACTIVITY
    ========================================================= */

    .split-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 18px;
        align-items: start;
    }

    .tinted-panel {
        padding: 26px 28px;
        border-radius: 20px;

        background: linear-gradient(160deg, #f8f5ff 0%, #f2f6ff 100%);
        border: 1px solid #e8e4ff;
    }

    .attention-list {
        margin-top: 18px;

        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .attention-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;

        padding: 14px 16px;

        border-radius: 13px;
        background: #ffffff;
        border: 1px solid #e8e4ff;

        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    a.attention-row:hover {
        transform: translateX(3px);
        box-shadow: 0 10px 22px rgba(122,31,214,.1);
        border-color: #d6bfff;
    }

    .attention-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13.5px;
        color: #171d3d;
    }

    .attention-detail {
        margin-top: 3px;

        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: #8189a8;
    }

    .attention-action {
        flex-shrink: 0;

        padding: 7px 14px;

        border-radius: 20px;
        background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 700;
        color: #ffffff;

        white-space: nowrap;
    }

    .caught-up {
        margin-top: 18px;
        padding: 30px 20px;

        text-align: center;
    }

    .caught-up-title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 18px;
        color: #171d3d;
    }

    .caught-up-text {
        margin-top: 6px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: #8189a8;
    }

    .collab-list {
        margin-top: 18px;

        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .collab-row {
        display: block;
        padding: 16px 18px;

        border-radius: 14px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        transition: transform .2s ease, box-shadow .2s ease;
    }

    .collab-row.needs-attention {
        border-color: #ffd9a8;
        background: linear-gradient(120deg, #fffaf2, #ffffff);
    }

    a.collab-row:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 26px rgba(30,34,90,.08);
    }

    .collab-row-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .collab-row-name {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #171d3d;
    }

    .collab-row-campaign {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: #8189a8;
    }

    .collab-row-milestones {
        flex-shrink: 0;

        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 700;
        color: #0d9c6c;
    }

    .collab-row.needs-attention .collab-row-milestones {
        color: #b5680a;
    }

    .collab-row-track {
        margin-top: 10px;

        height: 6px;
        border-radius: 6px;
        background: #eef0f8;
        overflow: hidden;
    }

    .collab-row-fill {
        height: 100%;
        border-radius: 6px;
        width: 0%;
        background: linear-gradient(90deg, #18a9ff, #0d9c6c);
        transition: width 1s cubic-bezier(.22,1,.36,1);
    }

    .collab-row-due {
        margin-top: 8px;

        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #9096b3;
    }


    /* =========================================================
       CREATOR DISCOVERY PREVIEW
    ========================================================= */

    .creator-preview-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .mini-creator-card {
        position: relative;
        overflow: hidden;

        padding: 20px 18px;

        border-radius: 16px;
        background: #ffffff;
        border: 1px solid #eaecf5;

        transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s ease;
    }

    .mini-creator-card::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity .3s ease;
        background: var(--card-wash);
    }

    .mini-creator-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 34px rgba(30,34,90,.1);
    }

    .mini-creator-card:hover::before {
        opacity: 1;
    }

    .mini-creator-card > * {
        position: relative;
        z-index: 1;
    }

    .mini-creator-head {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .mini-creator-name {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 13.5px;
        color: #171d3d;
    }

    .mini-creator-handle {
        margin-top: 2px;

        font-family: 'Inter', sans-serif;
        font-size: 11px;
        color: #8189a8;
    }

    .mini-creator-figures {
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid #f0f1f7;

        display: flex;
        justify-content: space-between;
    }

    .mini-figure-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 14.5px;
        color: #171d3d;
    }

    .mini-figure-label {
        margin-top: 1px;

        font-family: 'Inter', sans-serif;
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #9096b3;
    }

    .mini-creator-actions {
        margin-top: 14px;

        display: flex;
        gap: 6px;
    }

    .mini-action-btn {
        flex: 1;

        height: 32px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;
        border: 1px solid #dde1f0;
        background: #ffffff;

        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 700;
        color: #545b7d;

        transition: .2s;
    }

    .mini-action-btn:hover {
        border-color: transparent;
        box-shadow: 0 0 0 1.5px #9b2cff;
    }

    .mini-action-btn.is-primary {
        border: none;
        background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);
        color: #ffffff;
    }

    .mini-action-btn.is-saved {
        border-color: transparent;
        background: #f3e8ff;
        color: #7a1fd6;
    }

    @@media(max-width: 940px) {
        .creator-preview-row { grid-template-columns: repeat(2, 1fr); }
    }


    /* =========================================================
       SMART MATCH — signature feature treatment
    ========================================================= */

    .smart-match-panel {
        position: relative;
        overflow: hidden;

        padding: 30px 32px;

        border-radius: 22px;

        background:
            radial-gradient(circle at 90% 0%, rgba(114,36,255,.28), transparent 42%),
            radial-gradient(circle at 0% 100%, rgba(0,169,255,.22), transparent 46%),
            linear-gradient(135deg, #1a1140 0%, #2c1466 45%, #0d1f5c 100%);

        color: #ffffff;
    }

    .smart-match-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;

        position: relative;
        z-index: 1;
    }

    .smart-match-eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255,255,255,.6);
    }

    .smart-match-title {
        margin-top: 8px;

        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 22px;
    }

    .smart-match-sub {
        margin-top: 6px;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: rgba(255,255,255,.65);
        max-width: 460px;
    }

    .smart-match-link {
        flex-shrink: 0;

        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 700;
        color: #ffffff;

        padding: 10px 18px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.35);

        transition: .2s;
    }

    .smart-match-link:hover {
        background: rgba(255,255,255,.12);
        border-color: rgba(255,255,255,.6);
    }

    .smart-match-list {
        position: relative;
        z-index: 1;

        margin-top: 24px;

        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .smart-match-row {
        display: flex;
        align-items: center;
        gap: 18px;

        padding: 16px 18px;

        border-radius: 16px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.12);
        backdrop-filter: blur(10px);

        transition: transform .25s ease, background .25s ease;
    }

    a.smart-match-row:hover {
        transform: translateX(4px);
        background: rgba(255,255,255,.13);
    }

    .match-score {
        flex-shrink: 0;

        width: 58px;
        height: 58px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: conic-gradient(from -90deg, #18a9ff 0%, #7224ff calc(var(--score) * 1%), rgba(255,255,255,.14) calc(var(--score) * 1%));

        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 15px;
    }

    .match-score-inner {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #1e1250;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .match-body {
        flex: 1;
        min-width: 0;
    }

    .match-name {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 14.5px;
    }

    .match-reasons {
        margin-top: 4px;

        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: rgba(255,255,255,.65);
        line-height: 1.5;
    }

    .smart-match-empty {
        position: relative;
        z-index: 1;
        margin-top: 22px;

        padding: 26px;
        text-align: center;

        border-radius: 16px;
        border: 1px dashed rgba(255,255,255,.25);
    }

    .smart-match-empty p {
        margin-top: 6px;
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        color: rgba(255,255,255,.65);
    }


    /* =========================================================
       FINANCE OVERVIEW
    ========================================================= */

    .finance-panel {
        padding: 30px 32px;
        border-radius: 22px;

        background: linear-gradient(160deg, #f1fbf6 0%, #eef8ff 100%);
        border: 1px solid #d7f0e6;

        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 34px;
        align-items: center;
    }

    .finance-spend-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 36px;

        background: linear-gradient(100deg, #0d9c6c, #18a9ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .finance-spend-of {
        margin-top: 4px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: #4b5273;
    }

    .finance-bar-track {
        margin-top: 16px;
        height: 10px;
        border-radius: 10px;
        background: #dcf0e6;
        overflow: hidden;
    }

    .finance-bar-fill {
        height: 100%;
        border-radius: 10px;
        width: 0%;
        background: linear-gradient(90deg, #0d9c6c, #18a9ff);
        transition: width 1.1s cubic-bezier(.22,1,.36,1);
    }

    .finance-substats {
        margin-top: 20px;

        display: flex;
        gap: 26px;
    }

    .finance-substat-value {
        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 17px;
        color: #171d3d;
    }

    .finance-substat-label {
        margin-top: 2px;
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #6b8478;
    }

    .finance-chart {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;

        height: 140px;
        padding: 0 4px;
    }

    .finance-chart-col {
        flex: 1;

        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .finance-chart-bar-track {
        width: 100%;
        max-width: 34px;
        height: 100px;

        display: flex;
        align-items: flex-end;

        border-radius: 8px;
        background: rgba(13,156,108,.08);
        overflow: hidden;
    }

    .finance-chart-bar-fill {
        width: 100%;
        height: 0%;
        border-radius: 8px;
        background: linear-gradient(180deg, #18a9ff, #0d9c6c);
        transition: height 1s cubic-bezier(.22,1,.36,1);
    }

    .finance-chart-label {
        font-family: 'Inter', sans-serif;
        font-size: 10.5px;
        font-weight: 600;
        color: #4b5273;
    }

    @@media(max-width: 900px) {
        .finance-panel { grid-template-columns: 1fr; }
    }


    /* =========================================================
       UPCOMING + ACTIVITY
    ========================================================= */

    .list-panel {
        padding: 24px 26px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #eaecf5;
    }

    .list-row {
        display: flex;
        align-items: center;
        gap: 14px;

        padding: 12px 0;
        border-top: 1px solid #f0f1f7;

        transition: transform .2s ease;
    }

    .list-row:first-of-type {
        border-top: none;
    }

    a.list-row:hover {
        transform: translateX(3px);
    }

    .list-row-date {
        flex-shrink: 0;

        width: 46px;
        text-align: center;

        font-family: 'DM Sans', sans-serif;
        font-weight: 800;
        font-size: 15px;
        color: #7a1fd6;
    }

    .list-row-date-month {
        display: block;
        margin-top: 1px;

        font-family: 'Inter', sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: #a3a8c3;
    }

    .list-row-body {
        min-width: 0;
    }

    .list-row-title {
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #2a3157;

        overflow: hidden;
