@model object
@{
    // NOTE: real InfluencerProfile fields are used below wherever a real column exists.
    // Fields this mockup shows that have NO real column yet (phone number, submitted
    // documents/ID verification, multi-platform social accounts beyond the one
    // PrimaryPlatform tracked, admin notes storage, verification checklist) render as
    // dummy/placeholder content rather than invented real data — see
    // feedback_backend_wiring_scope memory. No schema changes were made for this pass.
    var type = ViewData["Type"] as string ?? "";
    var influencer = type == "Influencer" ? Model as Brandora.Web.Models.Domain.InfluencerProfile : null;
    var brand = type == "Brand" ? Model as Brandora.Web.Models.Domain.BrandProfile : null;
    var actionId = influencer?.Id ?? brand?.Id ?? 0;
    var actionType = type.ToLowerInvariant();
    var previousCollaborations = ViewData["PreviousCollaborationsCount"] as int? ?? 0;

    string Initials(string name) => string.IsNullOrWhiteSpace(name)
        ? "?"
        : string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();

    string FormatFollowers(int followers) => followers >= 1000 ? (followers / 1000m).ToString("0.#") + "K" : followers.ToString();

    (string Icon, string Color) PlatformIconFor(string? platform) => (platform ?? "").Trim().ToLowerInvariant() switch
    {
        var p when p.Contains("instagram") => ("bi-instagram", "linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)"),
        var p when p.Contains("tiktok") => ("bi-tiktok", "#000000"),
        var p when p.Contains("youtube") => ("bi-youtube", "#ff0000"),
        var p when p.Contains("facebook") => ("bi-facebook", "#1877f2"),
        var p when p.Contains("twitter") || p == "x" => ("bi-twitter-x", "#000000"),
        _ => ("bi-share-fill", "#6b52d8")
    };
}

<style>
    .detail-top-panel { display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px; }
    @@media(max-width: 1100px) { .detail-top-panel { grid-template-columns: 1fr; } }

    .detail-identity { display: flex; align-items: center; gap: 16px; }
    .detail-avatar {
        width: 72px; height: 72px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(145deg, #c93cff, #4e38ff 55%, #159cff); color: #ffffff;
        font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 22px;
    }
    .detail-name-row { display: flex; align-items: center; gap: 10px; }
    .detail-name { font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: 19px; color: #171d3d; }
    .detail-meta-row { margin-top: 6px; display: flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 12.5px; color: #8189a8; }

    .contact-list { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }
    .contact-item { display: flex; align-items: center; gap: 10px; font-family: 'Inter', sans-serif; font-size: 13px; color: #2a3157; }
    .contact-item i { color: #9b2cff; width: 16px; text-align: center; }

    .quick-facts { display: flex; flex-direction: column; gap: 14px; }
    .quick-fact { display: flex; align-items: flex-start; gap: 10px; }
    .quick-fact i { color: #9b2cff; margin-top: 2px; }
    .quick-fact-label { font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; }
    .quick-fact-value { font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 700; color: #2a3157; }

    .content-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 20px; margin-top: 20px; align-items: start; }
    @@media(max-width: 1100px) { .content-grid { grid-template-columns: 1fr; } }

    .info-grid { display: grid; grid-template-columns: 130px 1fr; row-gap: 14px; column-gap: 12px; }
    .info-label { font-family: 'Inter', sans-serif; font-size: 12.5px; color: #8189a8; }
    .info-value { font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 600; color: #2a3157; }

    .social-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f2f3fa; }
    .social-row:last-child { border-bottom: none; }
    .social-row-left { display: flex; align-items: center; gap: 10px; }
    .social-row-icon { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #ffffff; }
    .social-handle { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; color: #2a3157; }
    .social-count { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 13px; color: #171d3d; }

    .doc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 16px; }
    @@media(max-width: 900px) { .doc-grid { grid-template-columns: 1fr 1fr; } }
    .doc-card { border: 1px solid #eaecf5; border-radius: 12px; overflow: hidden; }
    .doc-thumb { height: 100px; background: linear-gradient(135deg, #f1e6ff, #e3f0ff); display: flex; align-items: center; justify-content: center; color: #b7a3e0; font-size: 28px; position: relative; }
    .doc-badge { position: absolute; top: 8px; right: 8px; }
    .doc-info { padding: 10px 12px; }
    .doc-name { font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 700; color: #2a3157; }
    .doc-date { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11px; color: #8189a8; }

    .notes-textarea { width: 100%; min-height: 90px; padding: 12px; margin-top: 12px; border-radius: 10px; border: 1px solid #dde1f0; font-family: 'Inter', sans-serif; font-size: 13px; color: #2a3157; resize: vertical; }
    .char-counter { margin-top: 6px; text-align: right; font-family: 'Inter', sans-serif; font-size: 11px; color: #b7bdd6; }

    .timeline-item { display: flex; gap: 12px; position: relative; padding-bottom: 22px; }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-item::before { content: ""; position: absolute; left: 9px; top: 22px; bottom: 0; width: 2px; background: #eaecf5; }
    .timeline-item:last-child::before { display: none; }
    .timeline-dot { width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0; z-index: 1; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #ffffff; }
    .timeline-dot.done { background: #7a1fd6; }
    .timeline-dot.current { background: #ffffff; border: 2px solid #236eff; }
    .timeline-dot.pending { background: #eaecf5; }
    .timeline-title { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; color: #2a3157; }
    .timeline-title.current { color: #236eff; }
    .timeline-title.pending { color: #b7bdd6; }
    .timeline-time { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; }

    .checklist-item { display: flex; align-items: center; gap: 10px; padding: 9px 0; font-family: 'Inter', sans-serif; font-size: 13px; color: #2a3157; }
    .checklist-item i { color: #0d9c6c; }

    .decision-btn-row { display: flex; gap: 12px; margin-top: 14px; }
    .btn-approve-outline, .btn-reject-outline {
        flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        height: 46px; border-radius: 10px; border: none;
        font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700;
    }
    .btn-approve-outline { background: #dff7ec; color: #0d9c6c; }
    .btn-reject-outline { background: #fde3e3; color: #d92d2d; }

    .reject-reason-panel { margin-top: 16px; padding: 16px; border-radius: 12px; background: #fff8f8; border: 1px solid #f6c9c9; }
    .reject-reason-title { color: #d92d2d; font-weight: 700; font-family: 'Inter', sans-serif; font-size: 13px; }
    .reason-textarea { width: 100%; min-height: 70px; padding: 10px; margin-top: 10px; border-radius: 9px; border: 1px solid #f0b8b8; font-family: 'Inter', sans-serif; font-size: 13px; resize: vertical; }

    .warning-note { margin-top: 14px; padding: 12px 14px; border-radius: 10px; background: #fff7e6; border: 1px solid #f5deac; display: flex; gap: 10px; font-family: 'Inter', sans-serif; font-size: 12px; color: #93710f; }
    .warning-note i { color: #d9a91a; margin-top: 1px; }
</style>

@if (influencer is not null)
{
    <div class="panel detail-top-panel">

        <div>
            <div class="detail-identity">
                <div class="detail-avatar">@Initials(influencer.FullName)</div>
                <div>
                    <div class="detail-name-row">
                        <span class="detail-name">@influencer.FullName</span>
                        <span class="status-pill @(influencer.Verified ? "green" : "blue")">@(influencer.Verified ? "Verified" : "Under Review")</span>
                    </div>
                    <div class="detail-meta-row"><i class="bi bi-person-badge"></i> Influencer &middot; ID: INF-@influencer.Id</div>
                </div>
            </div>

            <div class="contact-list">
                <div class="contact-item"><i class="bi bi-envelope"></i> @(influencer.User?.Email ?? "Not provided")</div>
                <div class="contact-item"><i class="bi bi-telephone"></i> Not provided</div>
                <div class="contact-item"><i class="bi bi-geo-alt"></i> @(influencer.Location ?? "Not provided")</div>
            </div>
        </div>

        <div class="quick-facts">
            <div class="quick-fact"><i class="bi bi-calendar3"></i><div><div class="quick-fact-label">Submitted On</div><div class="quick-fact-value">@influencer.CreatedAt.ToString("MMM d, yyyy, h:mm tt")</div></div></div>
            <div class="quick-fact"><i class="bi bi-share-fill"></i><div><div class="quick-fact-label">Primary Platform</div><div class="quick-fact-value">@influencer.PrimaryPlatform</div></div></div>
            <div class="quick-fact"><i class="bi bi-people-fill"></i><div><div class="quick-fact-label">Followers</div><div class="quick-fact-value">@FormatFollowers(influencer.Followers)</div></div></div>
            <div class="quick-fact"><i class="bi bi-graph-up"></i><div><div class="quick-fact-label">Engagement Rate (Avg)</div><div class="quick-fact-value">@influencer.EngagementRate%</div></div></div>
        </div>

    </div>

    <div class="content-grid">

        <div>
            <div class="panel">
                <div class="panel-title">Profile Overview</div>
                <div class="info-grid" style="margin-top:16px;">
                    <div class="info-label">Full Name</div><div class="info-value">@influencer.FullName</div>
                    <div class="info-label">Username</div><div class="info-value">@influencer.PlatformUsername</div>
                    <div class="info-label">Email</div><div class="info-value">@(influencer.User?.Email ?? "Not provided")</div>
                    <div class="info-label">Phone Number</div><div class="info-value">Not provided</div>
                    <div class="info-label">Location</div><div class="info-value">@(influencer.Location ?? "Not provided")</div>
                    <div class="info-label">Niche / Category</div><div class="info-value"><span class="status-pill blue">@influencer.ContentNiche</span></div>
                    <div class="info-label">Bio</div><div class="info-value">@(influencer.Bio ?? "Not provided")</div>
                    <div class="info-label">Audience Size</div><div class="info-value">@influencer.AudienceSize</div>
                    <div class="info-label">Previous Collabs</div><div class="info-value">@previousCollaborations</div>
                </div>
            </div>

            <div class="panel" style="margin-top:20px;">
                <div class="panel-title">Submitted Documents</div>
                <div class="panel-sub" style="margin-top:4px;">Placeholder &mdash; there's no document-upload / ID-verification feature in the app yet, so nothing real can be shown here.</div>
                <div class="doc-grid">
                    @{
                        (string Name, string Icon)[] docs = [("National ID Card", "bi-card-text"), ("Passport", "bi-passport"), ("Utility Bill", "bi-file-earmark-text"), ("Selfie Photo", "bi-person-badge")];
                    }
                    @foreach (var doc in docs)
                    {
                        <div class="doc-card">
                            <div class="doc-thumb">
                                <i class="bi @doc.Icon"></i>
                                <span class="doc-badge status-pill gray" style="padding:2px 8px; font-size:10px;">Not available</span>
                            </div>
                            <div class="doc-info">
                                <div class="doc-name">@doc.Name</div>
                                <div class="doc-date">Not submitted</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="panel" style="margin-top:20px;">
                <div class="panel-title">Admin Notes</div>
                <div class="panel-sub" style="margin-top:4px;">Not persisted yet &mdash; there's no notes field on the profile to save this to.</div>
                <textarea class="notes-textarea" maxlength="500" placeholder="Add any internal notes about this verification..." oninput="document.getElementById('notesCount').textContent = this.value.length"></textarea>
                <div class="char-counter"><span id="notesCount">0</span>/500</div>
            </div>
        </div>

        <div>
            <div class="panel">
                <div class="panel-title">Social Media Accounts</div>
                <div class="panel-sub" style="margin-top:4px;">Only one platform is tracked on this profile today.</div>
                <div style="margin-top:10px;">
                    @{
                        var platformIcon = PlatformIconFor(influencer.PrimaryPlatform);
                    }
                    <div class="social-row">
                        <div class="social-row-left">
                            <div class="social-row-icon" style="background:@platformIcon.Color;"><i class="bi @platformIcon.Icon"></i></div>
                            <span class="social-handle">@@@influencer.PlatformUsername</span>
                        </div>
                        <span class="social-count">@FormatFollowers(influencer.Followers)</span>
                    </div>
                </div>
            </div>

            <div class="panel" style="margin-top:20px;">
                <div class="panel-title">Verification Status</div>
                <div style="margin-top:16px;">
                    <div class="timeline-item">
                        <div class="timeline-dot done"><i class="bi bi-check-lg"></i></div>
                        <div><div class="timeline-title">Submitted</div><div class="timeline-time">@influencer.CreatedAt.ToString("MMM d, yyyy, h:mm tt")</div></div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot @(influencer.Verified ? "done" : "current")">@(influencer.Verified ? Html.Raw("<i class=\"bi bi-check-lg\"></i>") : null)</div>
                        <div>
                            <div class="timeline-title @(influencer.Verified ? "" : "current")">
                                @(influencer.Verified ? "Verified" : "Under Review")
                                @if (!influencer.Verified)
                                {
                                    <span class="status-pill blue" style="padding:2px 8px; font-size:10px; margin-left:6px;">Current</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel" style="margin-top:20px;">
                <div class="panel-title">Verification Checklist</div>
                <div class="panel-sub" style="margin-top:4px;">Illustrative only &mdash; no automated checks exist behind this yet.</div>
                <div style="margin-top:8px;">
                    <div class="checklist-item"><i class="bi bi-check-circle-fill"></i> Profile information looks authentic</div>
                    <div class="checklist-item"><i class="bi bi-check-circle-fill"></i> Social media account is active</div>
                    <div class="checklist-item"><i class="bi bi-check-circle-fill"></i> Follower count matches profile</div>
                </div>
            </div>

            <div class="panel" style="margin-top:20px;">
                <div class="panel-title">Decision Panel</div>

                @if (!influencer.Verified)
                {
                    <div class="decision-btn-row">
                        <form method="post" action="/Admin/AdminUserVerification/Approve" style="flex:1;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="type" value="@actionType" />
                            <input type="hidden" name="id" value="@actionId" />
                            <button type="submit" class="btn-approve-outline" style="width:100%;"><i class="bi bi-check-circle-fill"></i> Approve</button>
                        </form>
                        <button type="button" class="btn-reject-outline" onclick="document.getElementById('rejectPanel').style.display='block'"><i class="bi bi-x-circle-fill"></i> Reject</button>
                    </div>

                    <div class="reject-reason-panel" id="rejectPanel" style="display:none;">
                        <div class="reject-reason-title">Rejection Reason (Required)</div>
                        <form method="post" action="/Admin/AdminUserVerification/Reject">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="type" value="@actionType" />
                            <input type="hidden" name="id" value="@actionId" />
                            <textarea class="reason-textarea" name="reason" maxlength="500" required placeholder="Provide a clear reason for rejection..." oninput="document.getElementById('reasonCount').textContent = this.value.length"></textarea>
                            <div class="char-counter"><span id="reasonCount">0</span>/500</div>
                            <button type="submit" class="btn-reject-outline" style="width:100%; margin-top:10px;"><i class="bi bi-x-circle-fill"></i> Confirm Reject</button>
                        </form>
                    </div>

                    <div class="warning-note"><i class="bi bi-exclamation-triangle-fill"></i> Please review all information carefully before making a decision.</div>
                }
                else
                {
                    <div class="panel-sub" style="margin-top:8px;">This account is already verified.</div>
                }
            </div>
        </div>

    </div>
}
else if (brand is not null)
{
    <a href="/Admin/AdminUserVerification/Index" class="back-to-dashboard">&larr; Back to User Verification</a>

    <div class="panel">
        <div class="panel-title">@brand.CompanyName</div>
        <div class="panel-sub">Brand &middot; @brand.Industry</div>

        <div class="form-errors" style="margin-top:20px;">
            A dedicated Brand verification detail design hasn't been provided yet &mdash; this is the earlier basic layout.
            Brand verification also has no real <code>Verified</code> status field in the database yet (flagged previously).
        </div>

        <div style="margin-top:16px; display:grid; grid-template-columns: repeat(2, 1fr); gap:16px;">
            <div><strong>Contact</strong><div class="panel-sub">@brand.ContactFullName</div></div>
            <div><strong>Website</strong><div class="panel-sub">@(brand.WebsiteUrl ?? "-")</div></div>
            <div><strong>Monthly Budget</strong><div class="panel-sub">@brand.MonthlyBudget</div></div>
        </div>
    </div>
}
else
{
    <a href="/Admin/AdminUserVerification/Index" class="back-to-dashboard">&larr; Back to User Verification</a>
    <div class="panel">
        <div class="empty-block">
            <div class="empty-title">User not found</div>
            <div class="empty-text">This user may have been removed.</div>
        </div>
    </div>
}
