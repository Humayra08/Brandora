@{
    ViewData["Title"] = "Admin Password Hash Generator";
    Layout = null;
    var hash = ViewData["Hash"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; max-width: 640px; margin: 60px auto; padding: 0 20px; color: #171d3d; }
        h1 { font-size: 20px; }
        p.warn { background: #fff7e6; border: 1px solid #f5deac; padding: 12px 16px; border-radius: 8px; color: #93710f; font-size: 13px; }
        form { display: flex; gap: 10px; margin-top: 20px; }
        input { flex: 1; height: 40px; padding: 0 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; }
        button { height: 40px; padding: 0 16px; border: none; border-radius: 6px; background: #7a1fd6; color: #fff; font-weight: 600; cursor: pointer; }
        textarea { width: 100%; margin-top: 16px; min-height: 90px; padding: 12px; border-radius: 6px; border: 1px solid #ccc; font-family: monospace; font-size: 12.5px; }
    </style>
</head>
<body>
    <h1>Admin Password Hash Generator</h1>
    <p class="warn">Development-only. Enter a password, copy the generated hash into <code>.env</code> as <code>ADMIN_n_PASSWORD</code> yourself. Nothing here is sent anywhere or saved.</p>

    <form method="get" action="/Admin/AdminAccount/HashPassword">
        <input type="text" name="password" placeholder="Enter the password to hash" autocomplete="off" />
        <button type="submit">Generate Hash</button>
    </form>

    @if (!string.IsNullOrEmpty(hash))
    {
        <textarea readonly onclick="this.select()">@hash</textarea>
    }
</body>
</html>
