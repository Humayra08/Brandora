@model Brandora.Web.Areas.Admin.Models.AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Brandora</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            position: relative;
            min-height: 100vh;

            font-family: 'DM Sans', sans-serif;
            background: #0a0f24;
            color: #ffffff;
            overflow-x: hidden;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        body::before,
        body::after {
            content: "";
            position: absolute;
            z-index: -1;

            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
        }

        body::before {
            top: -12%;
            right: -8%;
            width: 480px;
            height: 480px;

            background:
                conic-gradient(
                    from 180deg,
                    rgba(155,44,255,.35),
                    rgba(0,169,255,.3),
                    rgba(255,90,190,.25),
                    rgba(155,44,255,.35)
                );
        }

        body::after {
            bottom: 0;
            left: -10%;
            width: 420px;
            height: 420px;

            background: radial-gradient(circle, rgba(60,60,220,.35), transparent 70%);
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }

        .auth-shell {
            width: 100%;
            padding: 40px 20px;

            display: flex;
            justify-content: center;
        }

        .auth-card {
            position: relative;
            z-index: 2;

            width: 100%;
            max-width: 460px;
            min-width: 0;

            padding: 44px 44px 36px;

            border-radius: 24px;
            border: 1px solid rgba(255,255,255,.12);

            background: rgba(18, 20, 42, .55);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);

            box-shadow:
                0 0 0 1px rgba(255,255,255,.03),
                0 25px 70px rgba(2, 3, 20, .6),
                0 0 60px rgba(155,44,255,.22),
                0 0 90px rgba(0,169,255,.14);
        }

        .brand-mark {
            width: 68px;
            height: 68px;
            margin: 0 auto 22px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 20px;

            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.1);

            box-shadow: 0 0 30px rgba(120,80,255,.35);
        }

        .brand-mark img {
            height: 34px;
            width: auto;

            display: block;

            filter: drop-shadow(0 0 10px rgba(140,90,255,.5));
        }

        .auth-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .auth-title {
            font-family: 'DM Sans', sans-serif;
            font-weight: 800;

            font-size: clamp(22px, 3vw, 27px);
            letter-spacing: -.3px;
        }

        .auth-subtitle {
            margin-top: 10px;

            font-size: 14px;
            line-height: 1.5;
            color: rgba(255,255,255,.62);
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 7px;

            margin-bottom: 18px;
        }

        .field label {
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 500;
            color: rgba(255,255,255,.85);
        }

        .field input {
            height: 46px;

            padding: 0 16px;

            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.16);
            background: rgba(255,255,255,.05);

            color: #ffffff;

            font-family: 'Inter', sans-serif;
            font-size: 13.5px;

            outline: none;

            transition: .2s;
        }

        .field input::placeholder {
            color: rgba(255,255,255,.38);
        }

        .field input:focus {
            border-color: rgba(255,255,255,.55);
            background: rgba(255,255,255,.08);
        }

        .field-password {
            position: relative;
        }

        .field-password input {
            width: 100%;
            padding-right: 46px;
        }

        .password-toggle {
            position: absolute;
            right: 8px;
            bottom: 7px;

            width: 32px;
            height: 32px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: none;
            border-radius: 8px;
            background: rgba(155,44,255,.16);

            color: #c69bff;
            cursor: pointer;

            transition: .2s;
        }

        .password-toggle:hover {
            background: rgba(155,44,255,.28);
        }

        .form-errors {
            margin-bottom: 18px;
            padding: 14px 16px;

            border-radius: 10px;
            border: 1px solid rgba(255,90,110,.4);
            background: rgba(255,60,80,.1);

            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: #ffb4bd;
        }

        .submit-btn {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            height: 52px;

            margin-top: 6px;

            border: none;
            border-radius: 999px;

            color: white;

            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 700;

            background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff);

            cursor: pointer;
            transition: .25s;

            box-shadow: 0 12px 30px rgba(90,60,255,.35);
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 38px rgba(90,60,255,.45);
        }

        .admin-badge {
            display: block;
            width: fit-content;
            margin: 0 auto 14px;

            padding: 4px 14px;

            border-radius: 20px;
            border: 1px solid rgba(163,38,255,.4);
            background: rgba(163,38,255,.12);

            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .6px;
            text-transform: uppercase;
            color: #c69bff;
        }

        @@media(max-width: 560px) {
            .auth-card {
                padding: 30px 20px 24px;
            }
        }

        @@media(max-width: 380px) {
            .auth-card {
                padding: 26px 16px 20px;
            }

            .field input {
                font-size: 13px;
            }
        }

    </style>
</head>
<body>

<main class="auth-shell">

    <div class="auth-card">

        <div class="brand-mark">
            <img src="~/images/brandora-mark.png" alt="Brandora" />
        </div>

        <span class="admin-badge">Administrator</span>

        <div class="auth-header">
            <h1 class="auth-title">Login as Administrator</h1>
            <p class="auth-subtitle">Sign in with your administrator credentials.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="form-errors">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post" action="/Admin/AdminAccount/Login">

            @Html.AntiForgeryToken()

            <div class="field">
                <label for="adminEmail">Email Address</label>
                <input type="email" id="adminEmail" name="Email" placeholder="admin@brandora.com" value="@Model.Email" required />
            </div>

            <div class="field field-password">
                <label for="adminPassword">Password</label>
                <input type="password" id="adminPassword" name="Password" placeholder="Password" required />
                <button type="button" class="password-toggle" data-for="adminPassword" aria-label="Show password">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
            </div>

            <button type="submit" class="submit-btn">Log In</button>

        </form>

    </div>

</main>

<script>
    (function () {
        document.querySelectorAll('.password-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.for);
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
            });
        });

        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    form.reportValidity();
                }
            });
        });
    })();
</script>

</body>
</html>
