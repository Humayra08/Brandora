@model Brandora.Web.Areas.Admin.Controllers.AdminProofReviewViewModel
@using Brandora.Web.Models.Domain
@{
    var statusFilter = ViewData["StatusFilter"] as MilestoneStatus?;
    var search = ViewData["Search"] as string ?? "";

    (string Label, string Color) StatusPill(MilestoneStatus s) => s switch
    {
        MilestoneStatus.Submitted => ("Submitted", "blue"),
        MilestoneStatus.RevisionRequested => ("Needs Revision", "orange"),
        MilestoneStatus.Approved => ("Approved", "green"),
        MilestoneStatus.Paid => ("Paid", "gray"),
        _ => (s.ToString(), "gray")
    };

    string Initials(string name) => string.IsNullOrWhiteSpace(name)
        ? "?"
        : string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();

    string PlatformIcon(string? platform) => (platform ?? "").Trim().ToLowerInvariant() switch
    {
        var p when p.Contains("instagram") => "bi-instagram",
        var p when p.Contains("tiktok") => "bi-tiktok",
        var p when p.Contains("youtube") => "bi-youtube",
        var p when p.Contains("facebook") => "bi-facebook",
        _ => "bi-share-fill"
    };

    bool IsImageUrl(string? url) => !string.IsNullOrWhiteSpace(url) &&
        (url.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || url.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
         url.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || url.EndsWith(".webp", StringComparison.OrdinalIgnoreCase) ||
         url.EndsWith(".gif", StringComparison.OrdinalIgnoreCase));
}

<style>
    .pr-hero {
        position: relative; isolation: isolate; overflow: hidden;
        display: flex; align-items: center; justify-content: space-between; gap: 20px;
        min-height: 150px; padding: 26px 36px;
        border-radius: 18px; margin-bottom: 20px;
        border: 1px solid #dce7ff;
        background: radial-gradient(ellipse at 61% 0%, rgba(163,38,255,.1), transparent 58%), linear-gradient(110deg, #f3f6ff55, #eaf1ff99 55%, #f3f6ff55);
    }
    .pr-hero .dashboard-waves { position: absolute; inset: auto 0 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
    .pr-hero-title { position: relative; z-index: 2; max-width: 60%; }
    .pr-hero-title h1 { margin: 0; font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: 26px; color: #171d3d; }
    .pr-hero-title p { margin-top: 6px; font-family: 'Inter', sans-serif; font-size: 13.5px; color: #6b7290; }
    .pr-hero-tagline {
        position: relative; z-index: 2; flex-shrink: 0;
        font-family: 'Caveat', cursive; font-weight: 700; font-size: 19px; line-height: 1.2;
        color: #2a3157; text-align: center; transform: rotate(-3deg);
    }
    .pr-hero-tagline span { display: block; width: 42px; height: 4px; margin: 6px auto 0; background: linear-gradient(110deg,#a326ff,#236eff); border-radius: 4px; }
    @@media(max-width: 900px) { .pr-hero-tagline { display: none; } }

    .pr-stat-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
    .pr-stat-tile {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 18px; border-radius: 14px; background: #ffffff; border: 1px solid #dce7ff;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .pr-stat-tile:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(20,25,60,.08); }
    .pr-stat-tile.is-active { border-color: transparent; box-shadow: 0 0 0 2px #a978ff; }
    .pr-stat-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
    .pr-stat-icon.purple { background: #f1e6ff; color: #8b2ff2; }
    .pr-stat-icon.blue { background: #e3f0ff; color: #1a73d8; }
    .pr-stat-icon.orange { background: #fdeee0; color: #d97a17; }
    .pr-stat-icon.green { background: #dff7ec; color: #0d9c6c; }
    .pr-stat-icon.gray { background: #eef1fb; color: #6b7290; }
    .pr-stat-label { font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; }
    .pr-stat-value { font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: 18px; color: #171d3d; }

    .pr-toolbar { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .pr-search { position: relative; flex: 1; max-width: 340px; }
    .pr-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #b7bdd6; font-size: 14px; }
    .pr-search input { width: 100%; height: 42px; padding: 0 14px 0 38px; border-radius: 10px; border: 1px solid #dde1f0; font-family: 'Inter', sans-serif; font-size: 13px; color: #2a3157; outline: none; }
    .pr-status-select { height: 42px; padding: 0 14px; border-radius: 10px; border: 1px solid #dde1f0; font-family: 'Inter', sans-serif; font-size: 13px; color: #2a3157; background: #ffffff; }

    .pr-layout { display: grid; grid-template-columns: 1fr 300px; gap: 20px; align-items: start; }
    @@media(max-width: 1150px) { .pr-layout { grid-template-columns: 1fr; } }

    .pr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    @@media(max-width: 1300px) { .pr-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media(max-width: 700px) { .pr-grid { grid-template-columns: 1fr; } }

    .pr-card { border-radius: 15px; background: #ffffff; border: 1px solid #dce7ff; overflow: hidden; transition: transform .15s ease, box-shadow .15s ease; }
    .pr-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(20,25,60,.08); }
    .pr-thumb { position: relative; height: 150px; background: linear-gradient(135deg, #f1e6ff, #e3f0ff); display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .pr-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .pr-thumb-icon { font-size: 34px; color: #b7a3e0; }
    .pr-thumb-status { position: absolute; top: 10px; left: 10px; }
    .pr-thumb-platform { position: absolute; top: 10px; right: 10px; width: 26px; height: 26px; border-radius: 8px; background: rgba(0,0,0,.55); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 13px; }

    .pr-card-body { padding: 14px 16px; }
    .pr-card-title { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 14px; color: #171d3d; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pr-card-sub { margin-top: 3px; display: flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; }
    .pr-card-logo { width: 22px; height: 22px; border-radius: 6px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #14103a; color: #fff; font-size: 9px; font-weight: 700; }
    .pr-card-milestone { margin-top: 10px; display: flex; align-items: center; justify-content: space-between; font-family: 'Inter', sans-serif; font-size: 12px; color: #2a3157; }
    .pr-card-influencer { margin-top: 10px; display: flex; align-items: center; gap: 8px; }
    .pr-card-avatar { width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #c93cff, #4e38ff 55%, #159cff); color: #fff; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 10px; }
    .pr-card-influencer-name { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: #2a3157; }
    .pr-card-date { margin-left: auto; font-family: 'Inter', sans-serif; font-size: 11px; color: #8189a8; }
    .pr-card-actions { margin-top: 12px; display: flex; gap: 8px; }
    .pr-btn-view, .pr-btn-review { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; border-radius: 9px; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; text-decoration: none; }
    .pr-btn-view { background: #f6f7fb; color: #2a3157; border: 1px solid #eaecf5; }
    .pr-btn-review { background: linear-gradient(105deg, #a326ff, #236eff); color: #fff; }
    .pr-btn-view-details { background: #eef1fb; color: #6b52d8; }

    .pr-quick-actions { margin-top: 8px; display: flex; gap: 8px; }
    .pr-quick-form { flex: 1; }
    .pr-quick-approve, .pr-quick-reject { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 34px; border-radius: 9px; border: none; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; cursor: pointer; transition: transform .12s ease, box-shadow .12s ease; }
    .pr-quick-approve { background: linear-gradient(105deg, #0d9c6c, #0bbf82); color: #fff; }
    .pr-quick-approve:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(13,156,108,.28); }
    .pr-quick-reject { background: #fde3e3; color: #d92d2d; }
    .pr-quick-reject:hover { background: #fbd0d0; }
    .pr-quick-reject-panel { display: none; margin-top: 8px; flex-direction: column; gap: 8px; padding: 10px; border-radius: 10px; background: #fff8f8; border: 1px solid #fbd0d0; }
    .pr-quick-reject-panel textarea { width: 100%; min-height: 56px; padding: 8px; border-radius: 8px; border: 1px solid #f0d0d0; font-family: 'Inter', sans-serif; font-size: 12px; resize: vertical; box-sizing: border-box; }
    .pr-quick-reject-actions { display: flex; justify-content: flex-end; gap: 8px; }
    .pr-quick-reject-cancel { height: 30px; padding: 0 12px; border-radius: 8px; border: 1px solid #e3d0d0; background: #fff; color: #8189a8; font-family: 'Inter', sans-serif; font-size: 11.5px; font-weight: 700; cursor: pointer; }
    .pr-quick-reject-send { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 14px; border-radius: 8px; border: none; background: #d92d2d; color: #fff; font-family: 'Inter', sans-serif; font-size: 11.5px; font-weight: 700; cursor: pointer; }
    .pr-quick-reject-send:hover { background: #c02323; }

    .pr-side-panel { padding: 20px; border-radius: 15px; background: #ffffff; border: 1px solid #dce7ff; margin-bottom: 18px; }
    .pr-side-title { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 14.5px; color: #171d3d; }

    .pr-ring-wrap { position: relative; width: 150px; height: 150px; margin: 16px auto 0; }
    .pr-ring-svg { width: 100%; height: 100%; }
    .pr-ring-arc { fill: none; stroke-width: 12; stroke-linecap: round; }
    .pr-ring-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
    .pr-ring-value { font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: 17px; color: #171d3d; }
    .pr-ring-label { font-family: 'Inter', sans-serif; font-size: 10.5px; color: #8189a8; }
    .pr-ring-footer { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 14px; text-align: center; }
    .pr-ring-footer .n { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 14px; color: #171d3d; }
    .pr-ring-footer .l { font-family: 'Inter', sans-serif; font-size: 10px; color: #8189a8; }

    .pr-deadline-item { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #f2f3fa; }
    .pr-deadline-item:last-child { border-bottom: none; }
    .pr-deadline-logo { width: 32px; height: 32px; border-radius: 9px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #14103a; color: #fff; font-size: 10px; font-weight: 700; }
    .pr-deadline-title { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: #2a3157; }
    .pr-deadline-sub { margin-top: 1px; font-family: 'Inter', sans-serif; font-size: 11px; color: #8189a8; }
    .pr-deadline-days { margin-left: auto; padding: 4px 9px; border-radius: 8px; background: #fdeee0; color: #d97a17; font-family: 'Inter', sans-serif; font-size: 10.5px; font-weight: 700; white-space: nowrap; }

    .pr-brand-item { margin-top: 12px; }
    .pr-brand-item .bh { display: flex; justify-content: space-between; font-family: 'Inter', sans-serif; font-size: 12px; color: #2a3157; margin-bottom: 5px; }
    .pr-brand-track { height: 6px; border-radius: 6px; background: #f0f1f8; overflow: hidden; }
    .pr-brand-fill { height: 100%; border-radius: 6px; background: linear-gradient(105deg, #8b6bff, #5b8dff); }
</style>

<section class="pr-hero">
    @await Html.PartialAsync("~/Views/InfluencerDashboard/_Waves.cshtml", "hero")
    <div class="pr-hero-title">
        <h1>Proof-of-Post Review</h1>
        <p>Review influencer submissions and ensure authentic content.</p>
    </div>
    <div class="pr-hero-tagline">Real Creators<br />Real Impact<span></span></div>
</section>

<div class="pr-stat-row">
    <a href="/Admin/AdminProofReview/Index" class="pr-stat-tile @(statusFilter is null ? "is-active" : "")">
        <div class="pr-stat-icon purple"><i class="bi bi-grid-fill"></i></div>
        <div><div class="pr-stat-label">All</div><div class="pr-stat-value">@Model.TotalCount</div></div>
    </a>
    <a href="/Admin/AdminProofReview/Index?status=Submitted" class="pr-stat-tile @(statusFilter == MilestoneStatus.Submitted ? "is-active" : "")">
        <div class="pr-stat-icon blue"><i class="bi bi-clock-history"></i></div>
        <div><div class="pr-stat-label">Submitted</div><div class="pr-stat-value">@Model.SubmittedCount</div></div>
    </a>
    <a href="/Admin/AdminProofReview/Index?status=RevisionRequested" class="pr-stat-tile @(statusFilter == MilestoneStatus.RevisionRequested ? "is-active" : "")">
        <div class="pr-stat-icon orange"><i class="bi bi-arrow-repeat"></i></div>
        <div><div class="pr-stat-label">Needs Revision</div><div class="pr-stat-value">@Model.RevisionCount</div></div>
    </a>
    <a href="/Admin/AdminProofReview/Index?status=Approved" class="pr-stat-tile @(statusFilter == MilestoneStatus.Approved ? "is-active" : "")">
        <div class="pr-stat-icon green"><i class="bi bi-check-circle-fill"></i></div>
        <div><div class="pr-stat-label">Approved</div><div class="pr-stat-value">@Model.ApprovedCount</div></div>
    </a>
    <a href="/Admin/AdminProofReview/Index?status=Paid" class="pr-stat-tile @(statusFilter == MilestoneStatus.Paid ? "is-active" : "")">
        <div class="pr-stat-icon gray"><i class="bi bi-credit-card-fill"></i></div>
        <div><div class="pr-stat-label">Paid</div><div class="pr-stat-value">@Model.PaidCount</div></div>
    </a>
</div>

<div class="pr-layout">

    <div>
        <form method="get" class="pr-toolbar">
            @if (statusFilter is not null)
            {
                <input type="hidden" name="status" value="@statusFilter" />
            }
            <div class="pr-search">
                <i class="bi bi-search"></i>
                <input type="search" name="search" value="@search" placeholder="Search submissions, campaigns, influencers..." />
            </div>
            <button type="submit" class="btn btn-sm btn-secondary">Search</button>
        </form>

        @if (Model.Milestones.Count == 0)
        {
            <div class="panel">
                <div class="empty-block">
                    <div class="empty-title">No submissions found</div>
                    <div class="empty-text">Try a different filter or search term, or check back once influencers submit proof.</div>
                </div>
            </div>
        }
        else
        {
            <div class="pr-grid">
                @foreach (var m in Model.Milestones)
                {
                    var pill = StatusPill(m.Status);
                    var campaign = m.Collaboration.Campaign;
                    var brand = campaign.BrandProfile;
                    var influencer = m.Collaboration.InfluencerProfile;
                    var isActionable = m.Status == MilestoneStatus.Submitted;
                    <div class="pr-card">
                        <div class="pr-thumb">
                            @if (IsImageUrl(m.ProofUrl))
                            {
                                <img src="@m.ProofUrl" alt="Proof for @m.Title" />
                            }
                            else
                            {
                                <i class="bi bi-file-earmark-image pr-thumb-icon"></i>
                            }
                            <span class="pr-thumb-status status-pill @pill.Color">@pill.Label</span>
                            <span class="pr-thumb-platform"><i class="bi @PlatformIcon(campaign.Platform)"></i></span>
                        </div>
                        <div class="pr-card-body">
                            <div class="pr-card-title" title="@m.Title">@m.Title</div>
                            <div class="pr-card-sub">
                                <div class="pr-card-logo">@Initials(brand.CompanyName)</div>
                                <span>@campaign.Title</span>
                            </div>
                            <div class="pr-card-milestone">
                                <span>৳@m.Amount.ToString("N0")</span>
                            </div>
                            <div class="pr-card-influencer">
                                <div class="pr-card-avatar">@Initials(influencer.FullName)</div>
                                <span class="pr-card-influencer-name">@influencer.FullName</span>
                                <span class="pr-card-date">@m.CreatedAt.ToString("MMM d")</span>
                            </div>
                            <div class="pr-card-actions">
                                @if (!string.IsNullOrWhiteSpace(m.ProofUrl))
                                {
                                    <a href="@m.ProofUrl" target="_blank" rel="noopener" class="pr-btn-view">View</a>
                                }
                                <a href="/Admin/AdminProofReview/Details/@m.Id" class="@(isActionable ? "pr-btn-review" : "pr-btn-view-details pr-btn-view")">
                                    @(isActionable ? "Review" : "View Details") <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                            @if (isActionable)
                            {
                                <div class="pr-quick-actions" id="pr-quick-@m.Id">
                                    <form method="post" action="/Admin/AdminProofReview/Approve" class="pr-quick-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button type="submit" class="pr-quick-approve"><i class="bi bi-check-circle-fill"></i> Approve</button>
                                    </form>
                                    <button type="button" class="pr-quick-reject" onclick="document.getElementById('pr-reject-@m.Id').style.display='flex'; document.getElementById('pr-quick-@m.Id').style.display='none';">
                                        <i class="bi bi-x-circle-fill"></i> Reject
                                    </button>
                                </div>
                                <div class="pr-quick-reject-panel" id="pr-reject-@m.Id">
                                    <form method="post" action="/Admin/AdminProofReview/Reject">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <textarea name="comment" maxlength="500" required placeholder="Explain what needs to change..."></textarea>
                                        <div class="pr-quick-reject-actions">
                                            <button type="button" class="pr-quick-reject-cancel" onclick="document.getElementById('pr-reject-@m.Id').style.display='none'; document.getElementById('pr-quick-@m.Id').style.display='flex';">Cancel</button>
                                            <button type="submit" class="pr-quick-reject-send"><i class="bi bi-send-fill"></i> Send</button>
                                        </div>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div>
        @{
            var reviewed = Model.ApprovedCount + Model.PaidCount;
            var reviewedPct = Model.TotalCount == 0 ? 0 : (double)reviewed / Model.TotalCount;
            var ringCircumference = 2 * Math.PI * 52;
            var ringOffset = ringCircumference * (1 - reviewedPct);
        }
        <div class="pr-side-panel">
            <div class="pr-side-title">Review Progress</div>
            <div class="pr-ring-wrap">
                <svg class="pr-ring-svg" viewBox="0 0 120 120">
                    <circle class="pr-ring-arc" cx="60" cy="60" r="52" stroke="#eef1fb" />
                    <circle class="pr-ring-arc" cx="60" cy="60" r="52" stroke="url(#prRingGrad)"
                            stroke-dasharray="@ringCircumference.ToString("0.##")" stroke-dashoffset="@ringOffset.ToString("0.##")"
                            transform="rotate(-90 60 60)" />
                    <defs>
                        <linearGradient id="prRingGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#8b6bff" />
                            <stop offset="100%" stop-color="#4fc3ff" />
                        </linearGradient>
                    </defs>
                </svg>
                <div class="pr-ring-center">
                    <div class="pr-ring-value">@Model.SubmittedCount</div>
                    <div class="pr-ring-label">Pending</div>
                </div>
            </div>
            <div class="pr-ring-footer">
                <div><div class="n">@Model.TotalCount</div><div class="l">Total</div></div>
                <div><div class="n">@Model.ApprovedCount</div><div class="l">Approved</div></div>
                <div><div class="n">@Model.PaidCount</div><div class="l">Paid</div></div>
                <div><div class="n">@Model.RevisionCount</div><div class="l">Revision</div></div>
            </div>
        </div>

        <div class="pr-side-panel">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div class="pr-side-title">Upcoming Deadlines</div>
            </div>
            @if (Model.UpcomingDeadlines.Count == 0)
            {
                <div class="panel-sub" style="margin-top:10px;">No upcoming deadlines.</div>
            }
            else
            {
                @foreach (var d in Model.UpcomingDeadlines)
                {
                    var daysLeft = Math.Max(0, (int)Math.Ceiling((d.DueDate - DateTime.UtcNow).TotalDays));
                    <a href="/Admin/AdminProofReview/Details/@d.MilestoneId" class="pr-deadline-item" style="text-decoration:none;">
                        <div class="pr-deadline-logo">@Initials(d.BrandName)</div>
                        <div>
                            <div class="pr-deadline-title">@d.BrandName</div>
                            <div class="pr-deadline-sub">@d.MilestoneTitle</div>
                        </div>
                        <div class="pr-deadline-days">@daysLeft day@(daysLeft == 1 ? "" : "s") left</div>
                    </a>
                }
            }
        </div>

        <div class="pr-side-panel">
            <div class="pr-side-title">Top Brands by Submissions</div>
            @if (Model.TopBrands.Count == 0)
            {
                <div class="panel-sub" style="margin-top:10px;">No data yet.</div>
            }
            else
            {
                var maxCount = Model.TopBrands.Max(b => b.Count);
                @foreach (var b in Model.TopBrands)
                {
                    <div class="pr-brand-item">
                        <div class="bh"><span>@b.BrandName</span><b>@b.Count</b></div>
                        <div class="pr-brand-track"><div class="pr-brand-fill" style="width:@(maxCount == 0 ? 0 : b.Count * 100 / maxCount)%;"></div></div>
                    </div>
                }
            }
        </div>
    </div>

</div>
