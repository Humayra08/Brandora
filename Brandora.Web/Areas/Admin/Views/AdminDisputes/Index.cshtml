@model Brandora.Web.Areas.Admin.Controllers.DisputeIndexViewModel
@using System.Globalization
@{
    string Money(decimal amount) => "৳" + amount.ToString("N0", CultureInfo.InvariantCulture);
    string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    string Trend(decimal? pct)
    {
        if (pct is null) return "<span class=\"dr-trend flat\">No earlier month yet</span>";
        var up = pct >= 0;
        return $"<span class=\"dr-trend {(up ? "up" : "down")}\"><i class=\"bi bi-arrow-{(up ? "up" : "down")}\"></i> {Math.Abs(pct.Value).ToString("0", CultureInfo.InvariantCulture)}% vs last month</span>";
    }
    string Tone(string status) => status == "Resolved" ? "green" : status == "Under Review" ? "amber" : "red";
    string DetailUrl(Brandora.Web.Areas.Admin.Controllers.DisputeRow r) => $"/Admin/AdminDisputes/Details/{r.Id}";
}

<style>
    .dr-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 150px; padding: 26px 36px; border-radius: 18px; margin-bottom: 20px; border: 1px solid #dce7ff; background: radial-gradient(ellipse at 61% 0%, rgba(163,38,255,.1), transparent 58%), linear-gradient(110deg, #f3f6ff55, #eaf1ff99 55%, #f3f6ff55); }
    .dr-hero .dashboard-waves { position: absolute; inset: auto 0 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
    .dr-hero-title { position: relative; z-index: 2; max-width: 60%; }
    .dr-hero-title h1 { margin: 0; font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: clamp(30px, 3vw, 42px); line-height: 1.1; color: #171d3d; }
    .dr-hero-title p { margin-top: 8px; font: 13.5px 'Inter', sans-serif; color: #6b7290; }
    .dr-hero-tagline { position: relative; z-index: 2; flex-shrink: 0; font: 700 22px/1.2 'Caveat', cursive; color: #2a3157; text-align: center; transform: rotate(-3deg); }
    .dr-hero-tagline span { display: block; width: 42px; height: 4px; margin: 6px auto 0; background: linear-gradient(110deg,#a326ff,#236eff); border-radius: 4px; }
    .dr-art { position: relative; z-index: 2; width: 88px; height: 88px; border-radius: 24px; background: linear-gradient(135deg, #a326ff, #236eff 60%, #18a9ff); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 38px; box-shadow: 0 18px 36px rgba(90,60,255,.25); }

    .dr-flash { margin-bottom: 16px; padding: 12px 16px; border-radius: 12px; font: 600 13px 'Inter', sans-serif; }
    .dr-flash.ok { background: #e2f8ee; color: #0d9c6c; border: 1px solid rgba(13,156,108,.25); }
    .dr-flash.bad { background: #fde8ea; color: #a71b34; border: 1px solid rgba(217,45,63,.25); }

    .dr-kpis { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; margin-bottom: 18px; }
    .dr-kpi { display: flex; gap: 12px; align-items: flex-start; padding: 16px 18px; border-radius: 14px; background: #fff; border: 1px solid #dce7ff; min-width: 0; }
    .dr-kpi-icon { flex: 0 0 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 19px; background: #e3f0ff; color: #236eff; }
    .dr-kpi-icon.red { background: #fde8ea; color: #d92d3f; } .dr-kpi-icon.amber { background: #fff1de; color: #c47410; } .dr-kpi-icon.green { background: #e2f8ee; color: #0d9c6c; } .dr-kpi-icon.purple { background: #f1e6ff; color: #7a2fe0; }
    .dr-kpi-label { font: 600 12px 'Inter', sans-serif; color: #8189a8; }
    .dr-kpi > div:last-child { min-width: 0; }
    .dr-kpi-value { margin-top: 3px; font: 800 clamp(18px, 1.5vw, 24px) 'DM Sans', sans-serif; color: #171d3d; overflow-wrap: anywhere; }
    .dr-kpi-sub { margin-top: 4px; font: 11.5px 'Inter', sans-serif; color: #8189a8; }
    .dr-trend { font: 600 11.5px 'Inter', sans-serif; } .dr-trend.up { color: #0d9c6c; } .dr-trend.down { color: #d92d3f; } .dr-trend.flat { color: #8189a8; font-weight: 500; }

    .dr-panel { padding: 22px 24px; border-radius: 15px; background: #fff; border: 1px solid #dce7ff; }
    .dr-top { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
    .dr-tabs { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 12px; border: 1px solid #dce7ff; background: #f6f8ff; }
    .dr-tabs button { padding: 9px 18px; border: 0; border-radius: 9px; background: transparent; font: 600 12.5px 'Inter', sans-serif; color: #2a3157; cursor: pointer; }
    .dr-tabs button.is-active { color: #fff; background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff); }
    .dr-filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
    .dr-input { height: 40px; padding: 0 12px; border-radius: 10px; border: 1px solid #dde1f0; background: #fff; font: 12.5px 'Inter', sans-serif; color: #2a3157; outline: none; }
    .dr-input.grow { flex: 1; min-width: 240px; }
    .dr-btn { display: inline-flex; align-items: center; gap: 7px; height: 40px; padding: 0 16px; border-radius: 10px; border: 1px solid #cfe0ff; background: #f3f8ff; font: 600 12.5px 'Inter', sans-serif; color: #236eff; cursor: pointer; text-decoration: none; }

    /* ---- dispute list (cards, not a wide scrolling table) ---- */
    .dr-list { display: grid; gap: 10px; }
    .dr-card {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto auto;
        align-items: center;
        gap: 16px;
        padding: 13px 16px;
        border-radius: 12px;
        border: 1px solid #e3edfc;
        background: #fff;
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    .dr-card:hover { transform: translateY(-1px); border-color: #cfe0ff; box-shadow: 0 10px 22px #5b83c414; }
    .dr-id { font: 700 12.5px 'DM Sans', sans-serif; color: #171d3d; white-space: nowrap; }
    .dr-body { min-width: 0; }
    .dr-row1 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .dr-row1 b { font: 700 13px 'DM Sans', sans-serif; color: #171d3d; }
    .dr-row2 { margin-top: 3px; font: 12px 'Inter', sans-serif; color: #6b7290; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dr-row2 b { color: #33477c; font-weight: 600; }
    .dr-row3 { margin-top: 6px; font: 12px 'Inter', sans-serif; color: #33477c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
    .dr-row4 { margin-top: 7px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .dr-who { display: flex; align-items: center; gap: 7px; white-space: nowrap; font: 500 11.5px 'Inter', sans-serif; color: #6b7290; }
    .dr-av { flex: 0 0 24px; width: 24px; height: 24px; min-width: 24px; max-width: 24px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #a326ff, #236eff); color: #fff; font: 700 10px 'DM Sans', sans-serif; }
    .dr-av.is-brand { background: #171d3d; }
    .dr-av img { width: 100%; height: 100%; object-fit: cover; }
    .dr-amt { text-align: right; padding-left: 14px; border-left: 1px solid #eef1fb; white-space: nowrap; }
    .dr-amt b { display: block; font: 700 15px 'DM Sans', sans-serif; color: #171d3d; }
    .dr-amt small { display: block; margin-top: 3px; font: 500 11px 'Inter', sans-serif; color: #8189a8; }
    .dr-tag, .dr-pill { display: inline-block; padding: 4px 10px; border-radius: 7px; font: 600 11px 'Inter', sans-serif; white-space: nowrap; }
    .dr-tag.Brand { background: #e3f0ff; color: #236eff; } .dr-tag.Influencer { background: #f1e6ff; color: #7a2fe0; }
    .dr-pill.red { background: #fde8ea; color: #d92d3f; } .dr-pill.amber { background: #fff1de; color: #c47410; } .dr-pill.green { background: #e2f8ee; color: #0d9c6c; }
    .dr-act { display: flex; align-items: center; gap: 6px; position: relative; }
    .dr-view { padding: 8px 16px; border-radius: 9px; border: 1px solid #cfe0ff; background: #f3f8ff; color: #236eff; font: 600 12px 'Inter', sans-serif; text-decoration: none; white-space: nowrap; }
    .dr-more { flex: 0 0 34px; width: 34px; height: 34px; border-radius: 9px; border: 1px solid #dde1f0; background: #fff; color: #2a3157; cursor: pointer; }
    .dr-menu { position: absolute; right: 0; top: calc(100% + 6px); z-index: 30; display: none; min-width: 190px; padding: 6px; border-radius: 12px; border: 1px solid #eaecf5; background: #fff; box-shadow: 0 16px 34px rgba(30,34,90,.16); }
    .dr-menu.is-open { display: block; }
    .dr-menu a, .dr-menu button { display: block; width: 100%; padding: 9px 12px; border: 0; border-radius: 8px; background: transparent; text-align: left; font: 500 12.5px 'Inter', sans-serif; color: #2a3157; cursor: pointer; text-decoration: none; }
    .dr-menu a:hover, .dr-menu button:hover { background: rgba(155,44,255,.06); color: #7a1fd6; }
    .dr-menu form { margin: 0; }
    .dr-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; font: 12.5px 'Inter', sans-serif; color: #8189a8; }
    .dr-pager { display: flex; gap: 6px; }
    .dr-pager button { min-width: 34px; height: 34px; border-radius: 9px; border: 1px solid #dde1f0; background: #fff; font: 600 12.5px 'Inter', sans-serif; color: #2a3157; cursor: pointer; }
    .dr-pager button.is-active { border: 0; color: #fff; background: linear-gradient(105deg, #a326ff, #236eff); }
    .dr-empty { padding: 30px 18px; border-radius: 12px; border: 1px dashed #dde1f0; background: #fafbfe; text-align: center; font: 12.5px 'Inter', sans-serif; color: #8189a8; }
    .dr-empty b { display: block; margin-bottom: 4px; font: 700 14px 'DM Sans', sans-serif; color: #2a3157; }

    @@media(max-width: 1700px) { .dr-kpis { grid-template-columns: repeat(3, 1fr); } }
    @@media(max-width: 900px) {
        .dr-card { grid-template-columns: auto minmax(0, 1fr); row-gap: 10px; }
        .dr-amt { grid-column: 2; text-align: left; padding-left: 0; border-left: 0; }
        .dr-act { grid-column: 2; justify-content: flex-start; }
    }
    @@media(max-width: 800px) { .dr-kpis { grid-template-columns: 1fr 1fr; } .dr-hero-tagline, .dr-art { display: none; } .dr-hero-title { max-width: 100%; } }
</style>

<section class="dr-hero">
    @await Html.PartialAsync("~/Views/InfluencerDashboard/_Waves.cshtml", "hero")
    <div class="dr-hero-title">
        <h1>Dispute Resolution</h1>
        <p>Review and resolve disputes between brands and influencers fairly.</p>
    </div>
    <div class="dr-hero-tagline">Fair Decisions<br />Stronger Community<span></span></div>
    <div class="dr-art"><i class="bi bi-exclamation-triangle"></i></div>
</section>

@if (TempData["DisputeMessage"] is string ok) { <div class="dr-flash ok">@ok</div> }
@if (TempData["DisputeError"] is string bad) { <div class="dr-flash bad">@bad</div> }

<section class="dr-kpis">
    <div class="dr-kpi"><div class="dr-kpi-icon"><i class="bi bi-folder2"></i></div><div><div class="dr-kpi-label">Total Disputes</div><div class="dr-kpi-value">@Model.Total</div><div class="dr-kpi-sub">@Html.Raw(Trend(Model.TotalTrend))</div></div></div>
    <div class="dr-kpi"><div class="dr-kpi-icon red"><i class="bi bi-clock"></i></div><div><div class="dr-kpi-label">Open</div><div class="dr-kpi-value">@Model.OpenCount</div><div class="dr-kpi-sub">Waiting for review</div></div></div>
    <div class="dr-kpi"><div class="dr-kpi-icon amber"><i class="bi bi-arrow-repeat"></i></div><div><div class="dr-kpi-label">Under Review</div><div class="dr-kpi-value">@Model.UnderReviewCount</div><div class="dr-kpi-sub">Being handled by an admin</div></div></div>
    <div class="dr-kpi"><div class="dr-kpi-icon green"><i class="bi bi-check-lg"></i></div><div><div class="dr-kpi-label">Resolved</div><div class="dr-kpi-value">@Model.ResolvedCount</div><div class="dr-kpi-sub">@Html.Raw(Trend(Model.ResolvedTrend))</div></div></div>
    <div class="dr-kpi"><div class="dr-kpi-icon purple"><i class="bi bi-cash-stack"></i></div><div><div class="dr-kpi-label">Total Amount in Dispute</div><div class="dr-kpi-value">@Money(Model.AmountInDispute)</div><div class="dr-kpi-sub">On unresolved cases</div></div></div>
    <div class="dr-kpi"><div class="dr-kpi-icon red"><i class="bi bi-shield-check"></i></div><div><div class="dr-kpi-label">Compensation Paid</div><div class="dr-kpi-value">@Money(Model.CompensationThisMonth)</div><div class="dr-kpi-sub">This month</div></div></div>
</section>

<div class="dr-panel">
    <div class="dr-top">
        <div class="dr-tabs" id="drTabs">
            <button type="button" class="is-active" data-status="">All (@Model.Total)</button>
            <button type="button" data-status="Open">Open (@Model.OpenCount)</button>
            <button type="button" data-status="Under Review">Under Review (@Model.UnderReviewCount)</button>
            <button type="button" data-status="Resolved">Resolved (@Model.ResolvedCount)</button>
        </div>
        <button type="button" class="dr-btn" id="drExport"><i class="bi bi-download"></i> Export CSV</button>
    </div>

    <div class="dr-filters">
        <input class="dr-input grow" type="search" id="drSearch" placeholder="Search by dispute ID, campaign, brand, influencer or keyword..." />
        <select class="dr-input" id="drCampaign"><option value="">Campaign: All</option>@foreach (var c in Model.Campaigns) { <option>@c</option> }</select>
        <select class="dr-input" id="drStatus"><option value="">Status: All</option><option>Open</option><option>Under Review</option><option>Resolved</option></select>
        <select class="dr-input" id="drRaised"><option value="">Raised by: All</option><option>Brand</option><option>Influencer</option></select>
        <input class="dr-input" type="date" id="drFrom" aria-label="From date" />
        <input class="dr-input" type="date" id="drTo" aria-label="To date" />
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="dr-empty">
            <b>No disputes yet</b>
            When a brand or an influencer reports a problem with a milestone, it will appear here for review.
        </div>
    }
    else
    {
        <div class="dr-list" id="drTable">
            @foreach (var r in Model.Rows)
            {
                <div class="dr-card" data-key="@r.Id" data-search="@((r.Code + " " + r.CampaignTitle + " " + r.MilestoneTitle + " " + r.BrandName + " " + r.InfluencerName + " " + r.Handle + " " + r.Reason).ToLowerInvariant())" data-campaign="@r.CampaignTitle" data-status="@r.Status" data-raised="@r.RaisedBy" data-date="@r.CreatedAt.ToString("yyyy-MM-dd")"
                     data-csv="@r.Code|@r.CampaignTitle|@r.MilestoneTitle|@r.BrandName|@r.InfluencerName|@r.Reason|@r.Amount.ToString("N0", CultureInfo.InvariantCulture)|@r.RaisedBy|@r.CreatedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)|@r.Status">
                    <div class="dr-av is-brand">@if (!string.IsNullOrWhiteSpace(r.BrandPicture)) { <img src="@r.BrandPicture" alt="" /> } else { <text>@Initials(r.BrandName)</text> }</div>

                    <div class="dr-body">
                        <div class="dr-row1"><span class="dr-id">@r.Code</span><b>@r.CampaignTitle</b></div>
                        <div class="dr-row2">@r.MilestoneTitle@(string.IsNullOrWhiteSpace(r.MilestoneType) ? "" : " · " + r.MilestoneType) &middot; @r.CreatedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</div>
                        <div class="dr-row3" title="@r.Reason">@r.Reason</div>
                        <div class="dr-row4">
                            <span class="dr-tag @r.RaisedBy">Raised by @r.RaisedBy</span>
                            <span class="dr-pill @Tone(r.Status)">@r.Status</span>
                            <span class="dr-who"><div class="dr-av" style="width:20px;height:20px;min-width:20px;max-width:20px;font-size:9px;">@Initials(r.BrandName)</div>@r.BrandName</span>
                            <span class="dr-who"><div class="dr-av" style="width:20px;height:20px;min-width:20px;max-width:20px;font-size:9px;">@Initials(r.InfluencerName)</div>@(string.IsNullOrWhiteSpace(r.Handle) ? r.InfluencerName : "@" + r.Handle.TrimStart('@'))</span>
                        </div>
                    </div>

                    <div class="dr-amt">
                        <b>@Money(r.Amount)</b>
                        <small>Amount</small>
                    </div>

                    <div class="dr-act">
                        <a class="dr-view" href="@DetailUrl(r)">View</a>
                        <button type="button" class="dr-more" aria-label="More actions"><i class="bi bi-three-dots"></i></button>
                        <div class="dr-menu">
                            <a href="@DetailUrl(r)">Open details</a>
                            <a href="/Admin/AdminCampaigns/Details/@r.CampaignId">View campaign</a>
                            @if (r.Status != "Resolved")
                            {
                                <form method="post" action="/Admin/AdminDisputes/StartReview/@r.Id">@Html.AntiForgeryToken()<button type="submit">Start review</button></form>
                            }
                            <button type="button" data-copy="@r.Code">Copy dispute ID</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="dr-empty" id="drNoMatch" style="display:none;margin-top:14px;"><b>No disputes match these filters</b>Try clearing a filter or the search box.</div>
        <div class="dr-foot"><span id="drShowing"></span><div class="dr-pager" id="drPager"></div></div>
    }
</div>

<script>
    (function () {
        var table = document.getElementById('drTable');
        if (!table) return;

        var rows = Array.prototype.slice.call(table.querySelectorAll('.dr-card')), PAGE = 10, page = 1, tabStatus = '';
        var q = document.getElementById('drSearch'), camp = document.getElementById('drCampaign'), st = document.getElementById('drStatus'),
            rb = document.getElementById('drRaised'), from = document.getElementById('drFrom'), to = document.getElementById('drTo');

        function match(r) {
            var d = r.getAttribute('data-date'), status = r.getAttribute('data-status');
            return r.getAttribute('data-search').indexOf(q.value.trim().toLowerCase()) !== -1
                && (!tabStatus || status === tabStatus)
                && (!camp.value || r.getAttribute('data-campaign') === camp.value)
                && (!st.value || status === st.value)
                && (!rb.value || r.getAttribute('data-raised') === rb.value)
                && (!from.value || d >= from.value) && (!to.value || d <= to.value);
        }

        function render() {
            var matched = rows.filter(match), pages = Math.max(1, Math.ceil(matched.length / PAGE));
            if (page > pages) page = pages;
            rows.forEach(function (r) { r.style.display = 'none'; r.dataset.match = '0'; });
            matched.forEach(function (r, i) { r.dataset.match = '1'; r.style.display = (i >= (page - 1) * PAGE && i < page * PAGE) ? '' : 'none'; });
            document.getElementById('drNoMatch').style.display = matched.length ? 'none' : 'block';
            var start = matched.length ? (page - 1) * PAGE + 1 : 0, end = Math.min(page * PAGE, matched.length);
            document.getElementById('drShowing').textContent = 'Showing ' + start + '–' + end + ' of ' + matched.length + ' dispute' + (matched.length === 1 ? '' : 's');
            var pager = document.getElementById('drPager'); pager.innerHTML = '';
            if (pages > 1) for (var p = 1; p <= pages; p++) (function (p) {
                var b = document.createElement('button'); b.textContent = p; b.className = p === page ? 'is-active' : '';
                b.addEventListener('click', function () { page = p; render(); }); pager.appendChild(b);
            })(p);
        }

        [q, camp, st, rb, from, to].forEach(function (el) { el.addEventListener('input', function () { page = 1; render(); }); });

        var tabs = document.querySelectorAll('#drTabs button');
        tabs.forEach(function (t) {
            t.addEventListener('click', function () {
                tabs.forEach(function (x) { x.classList.toggle('is-active', x === t); });
                tabStatus = t.getAttribute('data-status'); page = 1; render();
            });
        });

        // "..." menus
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.dr-more');
            document.querySelectorAll('.dr-menu.is-open').forEach(function (m) { if (!btn || m !== btn.parentNode.querySelector('.dr-menu')) m.classList.remove('is-open'); });
            if (btn) btn.parentNode.querySelector('.dr-menu').classList.toggle('is-open');
            var copy = e.target.closest('[data-copy]');
            if (copy && navigator.clipboard) { navigator.clipboard.writeText(copy.getAttribute('data-copy')); copy.textContent = 'Copied!'; setTimeout(function () { copy.textContent = 'Copy dispute ID'; }, 1200); }
        });

        document.getElementById('drExport').addEventListener('click', function () {
            var head = ['Dispute ID', 'Campaign', 'Milestone', 'Brand', 'Influencer', 'Reason', 'Amount (BDT)', 'Raised By', 'Raised Date', 'Status'].map(function (c) { return '"' + c + '"'; }).join(',');
            var lines = [head];
            rows.filter(function (r) { return r.dataset.match === '1'; }).forEach(function (r) {
                var parts = r.getAttribute('data-csv').split('|');
                lines.push(parts.map(function (v) { return '"' + v.replace(/"/g, '""') + '"'; }).join(','));
            });
            var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' })); a.download = 'disputes.csv'; a.click();
        });

        render();
    })();
</script>
