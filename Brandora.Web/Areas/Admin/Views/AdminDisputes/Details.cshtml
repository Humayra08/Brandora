    .dd-modal h4 { margin: 0 0 8px; font: 700 22px 'Playfair Display', Georgia, serif; color: #171d3d; }
    .dd-modal p { margin: 0 0 12px; font-size: 13.5px; line-height: 1.55; color: #4a5170; }
    .dd-modal .sum { margin: 0 0 12px; padding: 12px 14px; border-radius: 12px; background: #fafbff; border: 1px solid #eef1fb; text-align: left; font-size: 13px; line-height: 1.6; }
    .dd-modal .warn { margin: 0 0 14px; padding: 10px 12px; border-radius: 10px; background: #fff4e0; color: #8a5a10; text-align: left; font-size: 12.5px; line-height: 1.5; }

    @@media(max-width: 1650px) { .dd-3col { grid-template-columns: 1fr; } .dd-proof { grid-template-columns: minmax(0, 220px) minmax(0, 1fr); } }
    @@media(max-width: 1500px) { .dd-three { grid-template-columns: 1fr 1fr; } }
    @@media(max-width: 1280px) { .dd-grid { grid-template-columns: 1fr; } .dd-three { grid-template-columns: 1fr; } .dd-two { grid-template-columns: 1fr; } }
    @@media(max-width: 640px) { .dd-proof { grid-template-columns: 1fr; } }
</style>

<div class="dd">
    @if (preview)
    {
        <div class="dd-flash info">
            <i class="bi bi-eye"></i> Design preview with sample data. Nothing here is saved.
            Try: <a href="/Admin/AdminDisputes/Details?preview=true&sides=both">both statements</a> ·
            <a href="/Admin/AdminDisputes/Details?preview=true&sides=brand">only the brand reported</a> ·
            <a href="/Admin/AdminDisputes/Details?preview=true&sides=influencer">only the influencer reported</a>
        </div>
    }
    @if (TempData["DisputeMessage"] is string ok) { <div class="dd-flash ok">@ok</div> }
    @if (TempData["DisputeError"] is string bad) { <div class="dd-flash bad">@bad</div> }
    <div class="dd-flash bad" id="ddPreviewMsg" style="display:none;"></div>

    <div class="dd-head">
        <div>
            <a class="dd-back" href="/Admin/AdminDisputes/Index@(preview ? "?preview=true" : "")"><i class="bi bi-arrow-left"></i> Dispute Resolution</a>
            <div class="dd-title">
                <h1>Dispute #@v.Code</h1>
                <span class="dd-pill @v.StatusTone">@v.StatusLabel</span>
            </div>
            <div class="dd-sub">Raised on @Stamp(v.CreatedAt) &nbsp;•&nbsp; Last updated @Stamp(v.UpdatedAt)</div>
        </div>
        <div class="dd-headbtns">
            <button type="button" class="dd-btn" id="ddEditNote"><i class="bi bi-pencil"></i> Edit Internal Note</button>
            <button type="button" class="dd-btn icon" id="ddMore" aria-label="More actions"><i class="bi bi-three-dots"></i></button>
            <div class="dd-menu" id="ddMenu">
                @if (!preview && v.IsOpen)
                {
                    <form method="post" action="/Admin/AdminDisputes/StartReview/@v.Id">@Html.AntiForgeryToken()<button type="submit">Start review</button></form>
                }
                @if (!preview)
                {
                    <a href="/Admin/AdminCampaigns/Details/@v.CampaignId">Open campaign</a>
                    @if (v.MilestoneId is not null) { <a href="/Admin/AdminProofReview/Details/@v.MilestoneId">Open milestone proof</a> }
                    <a href="/Admin/AdminUserVerification/Details?type=brand&id=@v.BrandProfileId">View brand profile</a>
                    <a href="/Admin/AdminUserVerification/Details?type=influencer&id=@v.InfluencerProfileId">View influencer profile</a>
                    <form method="post" action="/Admin/AdminDisputes/Suspend/@v.Id" data-confirm-title="Suspend the brand account?" data-confirm-text="@v.BrandName will be signed out and unable to log in until an admin restores access.">@Html.AntiForgeryToken()<input type="hidden" name="party" value="Brand" /><button type="submit" class="danger">Suspend brand account</button></form>
                    <form method="post" action="/Admin/AdminDisputes/Suspend/@v.Id" data-confirm-title="Suspend the influencer account?" data-confirm-text="@v.InfluencerName will be signed out and unable to log in until an admin restores access.">@Html.AntiForgeryToken()<input type="hidden" name="party" value="Influencer" /><button type="submit" class="danger">Suspend influencer account</button></form>
                }
                else
                {
                    <button type="button" data-preview-only>Start review</button>
                    <button type="button" data-preview-only class="danger">Suspend brand account</button>
                    <button type="button" data-preview-only class="danger">Suspend influencer account</button>
                }
            </div>
        </div>
    </div>

    <div class="dd-grid">
        <!-- ================= LEFT ================= -->
        <div class="dd-stack">

            <div class="dd-three">
                <div class="dd-card">
                    <h3>Brand @if (raisedKnown) { <small>(@(raisedByBrand ? "Complainant" : "Respondent"))</small> }</h3>
                    <div class="dd-party">
                        <div class="dd-avatar is-brand">@if (!string.IsNullOrWhiteSpace(v.BrandPicture)) { <img src="@v.BrandPicture" alt="" /> } else { <text>@Initials(v.BrandName)</text> }</div>
                        <div style="min-width:0;">
                            <div class="dd-name">@v.BrandName @if (v.BrandVerified) { <i class="bi bi-patch-check-fill" title="Verified"></i> }</div>
                            <div class="dd-meta">@v.BrandEmail</div>
                            <div class="dd-stats"><span><i class="bi bi-megaphone"></i> @v.BrandCampaigns campaign@(v.BrandCampaigns == 1 ? "" : "s")</span><span><i class="bi bi-star"></i> @v.BrandPastDisputes past dispute@(v.BrandPastDisputes == 1 ? "" : "s")</span></div>
                        </div>
                        @if (!preview) { <a class="dd-link" href="/Admin/AdminUserVerification/Details?type=brand&id=@v.BrandProfileId">View Profile</a> }
                    </div>
                </div>

                <div class="dd-card">
                    <h3>Influencer @if (raisedKnown) { <small>(@(raisedByBrand ? "Respondent" : "Complainant"))</small> }</h3>
                    <div class="dd-party">
                        <div class="dd-avatar">@Initials(v.InfluencerName)</div>
                        <div style="min-width:0;">
                            <div class="dd-name">@v.InfluencerName @if (v.InfluencerVerified) { <i class="bi bi-patch-check-fill" title="Verified"></i> }</div>
                            <div class="dd-meta">@@@v.InfluencerHandle.TrimStart('@') &nbsp;·&nbsp; @v.InfluencerEmail</div>
                            <div class="dd-stats"><span><i class="bi bi-people"></i> @v.InfluencerCollaborations collaboration@(v.InfluencerCollaborations == 1 ? "" : "s")</span><span><i class="bi bi-star"></i> @v.InfluencerPastDisputes past dispute@(v.InfluencerPastDisputes == 1 ? "" : "s")</span></div>
                        </div>
                        @if (!preview) { <a class="dd-link" href="/Admin/AdminUserVerification/Details?type=influencer&id=@v.InfluencerProfileId">View Profile</a> }
                    </div>
                </div>

                <div class="dd-card">
                    <h3>Campaign &amp; Milestone</h3>
                    <div class="dd-camp">
                        <div class="dd-camp-img">@if (IsImage(v.CampaignMedia)) { <img src="@v.CampaignMedia" alt="" /> } else { <text>@v.CampaignTitle.Substring(0, 1).ToUpperInvariant()</text> }</div>
                        <div style="min-width:0;">
                            <b>@v.CampaignTitle</b>
                            <small>Campaign ID: @v.CampaignCode</small>
                            <small>Milestone: @(v.MilestoneTitle ?? "—")@(string.IsNullOrWhiteSpace(v.MilestoneType) ? "" : " · " + v.MilestoneType)</small>
                            <small>Agreed amount: <b style="display:inline;">@Money(v.Amount)</b></small>
                            @if (!preview)
                            {
                                <div class="links">
                                    <a href="/Admin/AdminCampaigns/Details/@v.CampaignId">View Campaign →</a>
                                    @if (v.MilestoneId is not null) { <a href="/Admin/AdminProofReview/Details/@v.MilestoneId">View Milestone →</a> }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="dd-3col">
                <div class="dd-card">
                    <h3>Submitted Proof of Post</h3>
                    @if (string.IsNullOrWhiteSpace(v.ProofUrl) && string.IsNullOrWhiteSpace(v.ProofNotes))
                    {
                        <div class="dd-none"><b>No proof was submitted</b>The influencer has not submitted a proof of post for this milestone.</div>
                    }
                    else
                    {
                        <div class="dd-proof">
                            <div class="dd-proof-img">@if (IsImage(v.ProofUrl)) { <img src="@v.ProofUrl" alt="Submitted proof" /> } else { <i class="bi bi-instagram"></i> }</div>
                            <div class="dd-rows">
                                @if (!string.IsNullOrWhiteSpace(v.ProofNotes)) { <div class="dd-row"><span>Post Caption</span><span>@v.ProofNotes</span></div> }
                                @if (!string.IsNullOrWhiteSpace(v.ProofUrl)) { <div class="dd-row"><span>Post Link</span><a href="@v.ProofUrl" target="_blank" rel="noopener">@v.ProofUrl <i class="bi bi-box-arrow-up-right"></i></a></div> }
                                @if (!string.IsNullOrWhiteSpace(v.ProofStatus)) { <div class="dd-row"><span>Status</span><span><span class="dd-tag @v.ProofTone">@v.ProofStatus</span></span></div> }
                            </div>
                        </div>
                    }
                </div>

                <div class="dd-card">
                    <h3><i class="bi bi-clock-history"></i> Timeline</h3>
                    <ul class="dd-time">
                        @foreach (var s in v.Timeline)
                        {
                            <li class="@(s.State == "done" ? "" : s.State)"><b>@s.Title</b>@if (s.At.HasValue) { <small>@Stamp(s.At.Value)</small> }</li>
                        }
                    </ul>
                </div>
            </div>

            <div class="dd-two">
                <div class="dd-card">
                    <div class="dd-stmt-head"><h3><i class="bi bi-file-earmark-text"></i> Brand's Statement</h3>@if (raisedKnown && raisedByBrand) { <span class="dd-tag blue">Complainant</span> }</div>
                    @if (string.IsNullOrWhiteSpace(v.BrandStatement))
                    {
                        <div class="dd-none"><b>Brand's statement not given yet</b>@(v.HasSchemaExtras ? "The brand has not responded to this dispute yet." : "The statement will appear here once the dispute report pages are added.")</div>
                    }
                    else
                    {
                        <div class="dd-quote is-brand">“@v.BrandStatement”<time>@(v.BrandStatementAt.HasValue ? Stamp(v.BrandStatementAt.Value) : "")</time></div>
                    }
                    <div class="dd-evt">Attached Evidence (@v.BrandEvidence.Count)</div>
                    @if (v.BrandEvidence.Count == 0) { <div class="dd-none" style="padding:12px;">No evidence attached.</div> }
                    else
                    {
                        <div class="dd-files">
                            @foreach (var e in v.BrandEvidence)
                            {
                                <a class="dd-file" href="@e.Url"><span class="ic"><i class="bi bi-file-earmark"></i></span><div><b title="@e.FileName">@e.FileName</b><small>@Size(e.SizeBytes)</small></div><i class="bi bi-download dl"></i></a>
                            }
                        </div>
                    }
                </div>

                <div class="dd-card">
                    <div class="dd-stmt-head"><h3><i class="bi bi-file-earmark-text"></i> Influencer's Statement</h3>@if (raisedKnown && !raisedByBrand) { <span class="dd-tag blue">Complainant</span> }</div>
                    @if (string.IsNullOrWhiteSpace(v.InfluencerStatement))
                    {
                        <div class="dd-none"><b>Influencer's statement not given yet</b>@(v.HasSchemaExtras ? "The influencer has not responded to this dispute yet." : "The statement will appear here once the dispute report pages are added.")</div>
                    }
                    else
                    {
                        <div class="dd-quote influencer">“@v.InfluencerStatement”<time>@(v.InfluencerStatementAt.HasValue ? Stamp(v.InfluencerStatementAt.Value) : "")</time></div>
                    }
                    <div class="dd-evt">Attached Evidence (@v.InfluencerEvidence.Count)</div>
                    @if (v.InfluencerEvidence.Count == 0) { <div class="dd-none" style="padding:12px;">No evidence attached.</div> }
                    else
                    {
                        <div class="dd-files">
                            @foreach (var e in v.InfluencerEvidence)
                            {
                                <a class="dd-file" href="@e.Url"><span class="ic"><i class="bi bi-file-earmark"></i></span><div><b title="@e.FileName">@e.FileName</b><small>@Size(e.SizeBytes)</small></div><i class="bi bi-download dl"></i></a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="dd-card">
                <div class="dd-conv-head">
                    <h3><i class="bi bi-chat-square-text"></i> Conversation History (@v.Messages.Count)</h3>
                    <select class="dd-select" id="ddFilter"><option value="">All Messages</option><option value="Brand">Brand only</option><option value="Influencer">Influencer only</option></select>
                </div>

                @if (v.Messages.Count == 0)
                {
                    <div class="dd-none"><b>No messages yet</b>The brand and the influencer have not exchanged any messages.</div>
                }
                else
                {
                    <div class="dd-msgs" id="ddMsgs">
                        @foreach (var m in v.Messages)
                        {
                            <div class="dd-msg" data-party="@m.Party">
                                <div class="av @(m.Party == "Brand" ? "is-brand" : "")">@Initials(m.Name)</div>
                                <div style="min-width:0;">
                                    <div class="who">@m.Name<time>@Stamp(m.At)</time></div>
                                    <div class="body">@m.Body@if (!string.IsNullOrWhiteSpace(m.MediaUrl)) { <div><a href="@m.MediaUrl" target="_blank" rel="noopener">Attachment <i class="bi bi-box-arrow-up-right"></i></a></div> }</div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="dd-sep">Internal notes (admins only)</div>
                @if (v.Notes.Count == 0)
                {
                    <div class="dd-none" style="padding:12px;">No internal notes yet.</div>
                }
                else
                {
                    <div class="dd-msgs" style="max-height:220px;">
                        @foreach (var n in v.Notes)
                        {
                            <div class="dd-note"><div class="who">@n.Admin<time>@Stamp(n.At)</time><span class="badge">Internal note</span></div><div>@n.Body</div></div>
                        }
                    </div>
                }
                <div class="dd-notebox">
                    <textarea id="ddNoteBody" placeholder="Type a message (internal notes are only visible to admins)..." @(v.HasSchemaExtras ? "" : "disabled")></textarea>
                    <button type="button" class="dd-btn primary" id="ddSendNote" style="height:auto;padding:0 26px;">Send</button>
                </div>
                @if (!v.HasSchemaExtras) { <div class="dd-sub" style="margin-top:8px;">Internal notes @soonText.ToLowerInvariant()</div> }
            </div>
        </div>

        <!-- ================= RIGHT ================= -->
        <div class="dd-stack">
            <div class="dd-card">
                <h3><i class="bi bi-cash-coin"></i> Dispute Amount &amp; Payment Status</h3>
                <div class="dd-kv">
                    <div><span>Amount in Dispute</span><b>@Money(v.Amount)</b></div>
                    <div><span>Payment Status</span><span class="dd-tag @payTone">@payStatus</span></div>
                    <div><span>Escrow State</span><span class="dd-tag @(escrow == "Held" ? "blue" : escrow == "Released" ? "green" : escrow == "Refunded" ? "amber" : "gray")">@escrow</span></div>
                    <div><span>Method</span><b style="display:flex;align-items:center;gap:8px;">@Html.Raw(Logo(method, 18))@method</b></div>
                    <div><span>Gateway Reference</span><b>@gatewayRef</b></div>
                </div>
            </div>

            <div class="dd-card">
                <h3><i class="bi bi-exclamation-triangle" style="color:#d92d3f;"></i> Reason for Dispute</h3>
                <div class="dd-reason">@v.Reason</div>
                @if (!string.IsNullOrWhiteSpace(raiserStatement)) { <div class="dd-reason-q">“@raiserStatement”</div> }
            </div>

            <div class="dd-card">
                <h3><i class="bi bi-shield-check"></i> Resolution</h3>

                @if (v.IsResolved)
                {
                    <div class="dd-result">
                        <b>Resolved</b>@(v.ResolvedAt.HasValue ? " on " + Stamp(v.ResolvedAt.Value) : "")<br />
                        @v.ResolutionNote
                    </div>
                }
                else
                {
                    <form method="post" action="/Admin/AdminDisputes/Resolve/@v.Id" id="ddResolveForm">
                        @Html.AntiForgeryToken()

                        <label class="dd-opt @(v.CanRelease ? "" : "disabled")">
                            <span class="t"><input type="radio" name="outcome" value="ReleasePayment" @(defaultOutcome == "ReleasePayment" ? "checked" : "") @(v.CanRelease ? "" : "disabled") /> Release payment to influencer</span>
                            <small>@(v.CanRelease ? $"{Money(v.Amount)} will be released to the influencer from escrow." : "No payment exists for this milestone yet, so there is nothing to release.")</small>
                        </label>

                        <label class="dd-opt @(v.CanRefund ? "" : "disabled")">
                            <span class="t"><input type="radio" name="outcome" value="RefundBrand" @(v.CanRefund ? "" : "disabled") /> Refund brand</span>
                            <small>@(v.CanRefund ? $"{Money(v.Amount)} will be refunded to the brand." : "The payment was already completed. Use compensation instead of a refund.")</small>
                        </label>

                        <label class="dd-opt">
                            <span class="t"><input type="radio" name="outcome" value="Compensation" /> Compensation (from Admin Wallet)</span>
                            <div class="dd-comp">
                                <div><label>Pay to</label><select name="compensationTo" id="ddCompTo" disabled><option value="">Select recipient</option><option value="Brand">Brand · @v.BrandName</option><option value="Influencer">Influencer · @v.InfluencerName</option></select></div>
                                <div><label>Amount (৳)</label><input type="number" name="compensationAmount" id="ddCompAmt" min="1" step="1" placeholder="0" disabled /></div>
                            </div>
                            <div class="dd-walletline">Current Admin Wallet Balance: <b>@Money(v.WalletBalance)</b></div>
                            <div class="dd-warn" id="ddCompWarn" style="display:none;">This is more than the wallet balance, so the platform wallet would go negative.</div>
                        </label>

                        <label class="dd-opt">
                            <span class="t"><input type="radio" name="outcome" value="NoAction" @(defaultOutcome == "NoAction" ? "checked" : "") /> No action</span>
                            <small>Keep the current status. No payment will be made.</small>
                        </label>

                        <div class="dd-label">Resolution Note <b>*</b></div>
                        <textarea class="dd-text" name="notes" id="ddNotes" placeholder="Write a detailed note about your decision..." required></textarea>

                        <div class="dd-infobox"><i class="bi bi-info-circle"></i><div>Both parties will be notified about the resolution.<br />All actions are logged for audit purposes.</div></div>

                        <div class="dd-actions">
                            <a class="dd-btn" href="/Admin/AdminDisputes/Index@(preview ? "?preview=true" : "")">Cancel</a>
                            <button type="button" class="dd-btn primary" id="ddResolveBtn">Confirm &amp; Resolve</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="dd-backdrop" id="ddBackdrop">
    <div class="dd-modal" role="dialog" aria-modal="true">
        <div class="ic"><i class="bi bi-shield-check"></i></div>
        <h4 id="ddModalTitle"></h4>
        <p id="ddModalText"></p>
        <div class="sum" id="ddModalSum" style="display:none;"></div>
        <div class="warn" id="ddModalWarn" style="display:none;"></div>
        <div class="dd-actions">
            <button type="button" class="dd-btn" id="ddModalCancel">Cancel</button>
            <button type="button" class="dd-btn primary" id="ddModalOk">Confirm</button>
        </div>
    </div>
</div>

<script>
    (function () {
        function $(id) { return document.getElementById(id); }
        var PREVIEW = @(preview ? "true" : "false");
        var AMOUNT = @v.Amount.ToString("0.##", CultureInfo.InvariantCulture);
        var WALLET = @v.WalletBalance.ToString("0.##", CultureInfo.InvariantCulture);
        var MISSING = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(missing));
        function money(n) { return '৳' + Number(n).toLocaleString('en-US', { maximumFractionDigits: 0 }); }

        function previewNote(text) {
            var el = $('ddPreviewMsg'); el.textContent = text; el.style.display = '';
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        // "..." menu, edit note, send note
        var menu = $('ddMenu');
        $('ddMore').addEventListener('click', function (e) { e.stopPropagation(); menu.classList.toggle('is-open'); });
        document.addEventListener('click', function (e) { if (!menu.contains(e.target)) menu.classList.remove('is-open'); });
        $('ddEditNote').addEventListener('click', function () { var t = $('ddNoteBody'); t.scrollIntoView({ behavior: 'smooth', block: 'center' }); t.focus(); });
        $('ddSendNote').addEventListener('click', function () {
            var t = $('ddNoteBody');
            if (t.disabled) { previewNote('Internal notes @soonText.ToLowerInvariant()'); return; }
            if (!t.value.trim()) { t.focus(); return; }
            previewNote('Preview only: the note was not saved.');
        });
        document.querySelectorAll('[data-preview-only]').forEach(function (b) {
            b.addEventListener('click', function () { menu.classList.remove('is-open'); previewNote('Preview only: this action is disabled on sample data.'); });
        });

        // conversation filter
        var filter = $('ddFilter');
        filter.addEventListener('change', function () {
            document.querySelectorAll('#ddMsgs .dd-msg').forEach(function (m) { m.style.display = (!filter.value || m.getAttribute('data-party') === filter.value) ? '' : 'none'; });
        });

        // confirm modal
        var backdrop = $('ddBackdrop'), pending = null;
        function ask(o) {
            $('ddModalTitle').textContent = o.title; $('ddModalText').textContent = o.text || '';
            var sum = $('ddModalSum'), warn = $('ddModalWarn');
            sum.style.display = o.summary ? '' : 'none'; if (o.summary) sum.innerHTML = o.summary;
            warn.style.display = o.warning ? '' : 'none'; if (o.warning) warn.textContent = o.warning;
            $('ddModalOk').textContent = o.confirmLabel || 'Confirm';
            pending = o.onConfirm; backdrop.classList.add('is-open');
        }
        function close() { backdrop.classList.remove('is-open'); pending = null; }
        $('ddModalCancel').addEventListener('click', close);
        backdrop.addEventListener('click', function (e) { if (e.target === backdrop) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        $('ddModalOk').addEventListener('click', function () { var f = pending; close(); if (f) f(); });

        document.querySelectorAll('form[data-confirm-title]').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                if (f.dataset.ok) return;
                e.preventDefault();
                ask({ title: f.getAttribute('data-confirm-title'), text: f.getAttribute('data-confirm-text'), confirmLabel: 'Yes, suspend', onConfirm: function () { f.dataset.ok = '1'; f.submit(); } });
            });
        });

        // resolution form
        var form = $('ddResolveForm');
        if (form) {
            var to = $('ddCompTo'), amt = $('ddCompAmt'), warnEl = $('ddCompWarn');
            function outcome() { var r = form.querySelector('input[name="outcome"]:checked'); return r ? r.value : ''; }
            function sync() {
                var comp = outcome() === 'Compensation';
                to.disabled = !comp; amt.disabled = !comp;
                warnEl.style.display = (comp && parseFloat(amt.value) > WALLET) ? '' : 'none';
            }
            form.querySelectorAll('input[name="outcome"]').forEach(function (r) { r.addEventListener('change', sync); });
            amt.addEventListener('input', sync); sync();

            $('ddResolveBtn').addEventListener('click', function () {
                var o = outcome(), note = $('ddNotes').value.trim();
                if (!o) { alert('Choose how to resolve this dispute.'); return; }
                if (o === 'Compensation') {
                    if (!to.value) { alert('Choose who receives the compensation.'); to.focus(); return; }
                    if (!(parseFloat(amt.value) > 0)) { alert('Enter a compensation amount greater than ৳0.'); amt.focus(); return; }
                }
                if (!note) { alert('A resolution note is required.'); $('ddNotes').focus(); return; }

                var what = {
                    ReleasePayment: money(AMOUNT) + ' will be released to the influencer.',
                    RefundBrand: money(AMOUNT) + ' will be refunded to the brand.',
                    Compensation: money(parseFloat(amt.value)) + ' compensation will be awarded to the ' + to.value.toLowerCase() + ' from the Admin Wallet.',
                    NoAction: 'No payment will be made and the dispute will be closed.'
                }[o];
                var missingText = MISSING.length ? 'The ' + MISSING.join(' and the ') + ' ' + (MISSING.length > 1 ? 'have' : 'has') + ' not submitted a statement yet.' : '';
                ask({
                    title: 'Confirm resolution', text: 'This will resolve the dispute. Both parties will be notified.',
                    summary: '<b>Decision:</b> ' + what + '<br><b>Note:</b> ' + note.replace(/</g, '&lt;'),
                    warning: missingText, confirmLabel: 'Confirm & Resolve',
                    onConfirm: function () { if (PREVIEW) { previewNote('Preview only: nothing was resolved or saved.'); } else { form.submit(); } }
                });
            });
        }
    })();
</script>
