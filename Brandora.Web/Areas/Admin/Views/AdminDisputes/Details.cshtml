@model Brandora.Web.Areas.Admin.Controllers.DisputeDetailsVm
@using System.Globalization
@using Brandora.Web.Models.Domain
@{
    var v = Model;
    var preview = v.IsPreview;
    var raisedByBrand = v.RaisedBy == "Brand";
    var raisedKnown = v.RaisedBy != "";

    string Money(decimal a) => "৳" + a.ToString("N0", CultureInfo.InvariantCulture);
    string Stamp(DateTime t) => t.ToString("MMM d, yyyy, h:mm tt", CultureInfo.InvariantCulture);
    string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    string Size(long b) => b >= 1048576 ? (b / 1048576.0).ToString("0.#", CultureInfo.InvariantCulture) + " MB" : Math.Max(1, b / 1024) + " KB";
    bool IsImage(string? url) => !string.IsNullOrWhiteSpace(url) && new[] { ".png", ".jpg", ".jpeg", ".webp", ".gif" }.Any(e => url.Split('?')[0].EndsWith(e, StringComparison.OrdinalIgnoreCase));

    var pay = v.Payment;
    var payStatus = v.SamplePayment?.Status ?? (pay is null ? "Not paid yet" : pay.Status.ToString());
    var payTone = v.SamplePayment?.Tone ?? (pay is null ? "gray" : pay.Status == PaymentStatus.Completed ? "green" : pay.Status == PaymentStatus.Failed ? "red" : "amber");
    var escrow = v.SamplePayment?.Escrow ?? pay?.EscrowStatus.ToString() ?? "—";
    var method = v.SamplePayment?.Method ?? (pay?.Method switch { PaymentMethod.Bkash => "bKash", PaymentMethod.Nagad => "Nagad", PaymentMethod.BankTransfer => "Bank Transfer", _ => "—" });
    var gatewayRef = v.SamplePayment?.Reference ?? (string.IsNullOrWhiteSpace(pay?.TransactionReference) ? "—" : pay!.TransactionReference);

    var defaultOutcome = v.CanRelease ? "ReleasePayment" : "NoAction";
    var raiserStatement = raisedByBrand ? v.BrandStatement : v.InfluencerStatement;
    var missing = new List<string>();
    if (v.HasSchemaExtras)
    {
        if (string.IsNullOrWhiteSpace(v.BrandStatement)) missing.Add("brand");
        if (string.IsNullOrWhiteSpace(v.InfluencerStatement)) missing.Add("influencer");
    }

    string Logo(string m, int h) => m switch
    {
        "bKash" => $"<img src=\"/images/payment-methods/bkash.svg\" alt=\"bKash\" style=\"height:{h}px;width:auto;\" />",
        "Nagad" => $"<img src=\"/images/payment-methods/nagad.svg\" alt=\"Nagad\" style=\"height:{h}px;width:auto;\" />",
        _ => ""
    };
    var soonText = "Available once the dispute report pages are added.";
}

<style>
    .dd { font-family: 'Inter', sans-serif; color: #2a3157; }
    .dd-flash { margin-bottom: 14px; padding: 12px 16px; border-radius: 12px; font: 600 13px 'Inter', sans-serif; }
    .dd-flash.ok { background: #e2f8ee; color: #0d9c6c; border: 1px solid rgba(13,156,108,.25); } .dd-flash.bad { background: #fde8ea; color: #a71b34; border: 1px solid rgba(217,45,63,.25); }
    .dd-flash.info { background: #f3f8ff; color: #2a3157; border: 1px solid #cfe0ff; }
