    .dd-reason { padding: 10px 14px; border-radius: 10px; background: #fdeff2; color: #a71b34; font: 600 13px 'Inter', sans-serif; margin-bottom: 10px; }
    .dd-reason-q { padding: 12px 14px; border-radius: 10px; background: #fdeff2; color: #5b2432; font-size: 12.5px; line-height: 1.55; }

    .dd-opt { display: block; margin-bottom: 8px; padding: 12px 14px; border-radius: 11px; border: 1px solid #eaecf5; cursor: pointer; }
