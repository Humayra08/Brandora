@model List<Brandora.Web.Models.Domain.Payment>
@{
    var statusFilter = ViewData["StatusFilter"] as Brandora.Web.Models.Domain.PaymentStatus?;

    static string PillColor(Brandora.Web.Models.Domain.PaymentStatus s) => s switch
    {
        Brandora.Web.Models.Domain.PaymentStatus.Completed => "green",
        Brandora.Web.Models.Domain.PaymentStatus.Failed => "red",
        _ => "gray"
    };
}

<div class="panel">
    <div class="panel-title">Payment Oversight</div>
    <div class="panel-sub">
        ৳@Model.Where(p => p.Status == Brandora.Web.Models.Domain.PaymentStatus.Completed).Sum(p => p.Amount).ToString("N0") released total
    </div>

    <div class="form-errors" style="margin-top:16px;">
        Payment method (bKash/Nagad) isn't tracked on the <code>Payment</code> entity yet, so a method filter isn't available &mdash; only Status and date range.
    </div>

    <form method="get" action="/Admin/AdminPayments/Index" style="display:flex; gap:10px; flex-wrap:wrap; margin-top:14px; align-items:center;">
        <select name="status" style="height:40px; padding:0 12px; border-radius:9px; border:1px solid #dde1f0; font-family:'Inter',sans-serif; font-size:13px;">
            <option value="">All Statuses</option>
            <option value="Pending" selected="@(statusFilter == Brandora.Web.Models.Domain.PaymentStatus.Pending)">Pending</option>
            <option value="Completed" selected="@(statusFilter == Brandora.Web.Models.Domain.PaymentStatus.Completed)">Completed</option>
            <option value="Failed" selected="@(statusFilter == Brandora.Web.Models.Domain.PaymentStatus.Failed)">Failed</option>
        </select>
        <input type="date" name="from" style="height:40px; padding:0 12px; border-radius:9px; border:1px solid #dde1f0; font-family:'Inter',sans-serif; font-size:13px;" />
        <input type="date" name="to" style="height:40px; padding:0 12px; border-radius:9px; border:1px solid #dde1f0; font-family:'Inter',sans-serif; font-size:13px;" />
        <button type="submit" class="btn btn-sm btn-secondary">Filter</button>
    </form>

    @if (Model.Count == 0)
    {
        <div class="empty-block">
            <div class="empty-title">No transactions found</div>
        </div>
    }
    else
    {
        <div class="admin-table-wrap" style="margin-top: 18px;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Transaction ID</th>
                        <th>Brand</th>
                        <th>Influencer</th>
                        <th>Campaign</th>
                        <th>Milestone</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.Status == Brandora.Web.Models.Domain.PaymentStatus.Failed ? "row-flagged" : "")"
                            onclick="window.location='/Admin/AdminPayments/Details/@p.Id'" style="cursor:pointer;">
                            <td>#@p.Id</td>
                            <td>@p.Collaboration.Campaign.BrandProfile.CompanyName</td>
                            <td>@p.Collaboration.InfluencerProfile.FullName</td>
                            <td>@p.Collaboration.Campaign.Title</td>
                            <td>@(p.Milestone?.Title ?? "-")</td>
                            <td>৳@p.Amount.ToString("N0")</td>
                            <td><span class="status-pill @PillColor(p.Status)">@p.Status</span></td>
                            <td>@p.CreatedAt.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
