@model Brandora.Web.Areas.Admin.Controllers.WithdrawalDrawerViewModel
@using System.Globalization
@using Brandora.Web.Areas.Admin.Services
@{
    var w = Model.Withdrawal;
    string Money(decimal amount) => "৳" + amount.ToString("N0", CultureInfo.InvariantCulture);
    string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var rate = (PlatformFee.Rate * 100).ToString("0.##", CultureInfo.InvariantCulture);
    var tone = w.Status == "Completed" ? "green" : w.Status == "Failed" ? "red" : "blue";
    var feeTaken = w.Status != "Failed";
    var totalPortion = w.Lines.Sum(l => l.Portion);
    var totalFee = w.Lines.Sum(l => l.Fee);
    var handle = (w.Handle ?? "").TrimStart('@');
    string Logo(string method, int height) => method switch
    {
        "bKash" => $"<img src=\"/images/payment-methods/bkash.svg\" alt=\"bKash\" style=\"height:{height}px;width:auto;display:block;\" />",
        "Nagad" => $"<img src=\"/images/payment-methods/nagad.svg\" alt=\"Nagad\" style=\"height:{height}px;width:auto;display:block;\" />",
        _ => $"<i class=\"bi bi-bank\" style=\"font-size:{height}px;color:#236eff;line-height:1;\"></i>"
    };
}

<style>
    .wd { padding: 22px 26px 30px; font-family: 'Inter', sans-serif; color: #2a3157; }
    .wd-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .wd-x { border: 0; background: transparent; font-size: 20px; color: #2a3157; cursor: pointer; }
    .wd h2 { margin: 0 0 16px; font: 700 26px 'Playfair Display', Georgia, serif; color: #171d3d; }
    .wd h4 { margin: 0 0 12px; font: 700 17px 'Playfair Display', Georgia, serif; color: #171d3d; }
    .wd-card { padding: 16px 18px; margin-bottom: 16px; border-radius: 14px; border: 1px solid #eef1fb; background: #fff; }
    .wd-summary { display: flex; justify-content: space-between; gap: 16px; align-items: center; background: #f6f9ff; }
    .wd-code { font: 800 19px 'DM Sans', sans-serif; color: #171d3d; }
    .wd-pill { display: inline-block; margin-left: 8px; padding: 4px 10px; border-radius: 8px; font: 600 11.5px 'Inter', sans-serif; vertical-align: middle; }
    .wd-pill.green { background: #e2f8ee; color: #0d9c6c; } .wd-pill.blue { background: #e3f0ff; color: #236eff; } .wd-pill.red { background: #fde8ea; color: #d92d3f; }
    .wd small { display: block; font-size: 11px; color: #8189a8; }
    .wd-person { display: flex; align-items: center; gap: 14px; }
    .wd-avatar { flex: 0 0 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #a326ff, #236eff); color: #fff; font: 700 18px 'DM Sans', sans-serif; }
    .wd-person b { font: 700 16px 'DM Sans', sans-serif; color: #171d3d; }
    .wd-link { margin-left: auto; font: 600 12.5px 'Inter', sans-serif; color: #236eff; text-decoration: none; white-space: nowrap; }
    .wd-method { display: flex; align-items: center; gap: 12px; }
    .wd-logo { display: flex; align-items: center; justify-content: center; min-width: 64px; }
    .wd-calc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 12px; padding: 14px; border-radius: 12px; border: 1px solid #eef1fb; background: #fafbff; }
    .wd-calc b { display: block; margin-top: 4px; font: 800 20px 'DM Sans', sans-serif; color: #171d3d; }
    .wd-calc b.net { color: #236eff; }
    .wd-table { width: 100%; border-collapse: collapse; }
    .wd-table th { padding: 9px 8px; text-align: left; font-size: 10.5px; font-weight: 700; letter-spacing: .3px; text-transform: uppercase; color: #8189a8; background: #f7f9ff; }
    .wd-table td { padding: 10px 8px; border-top: 1px solid #eef1fb; font-size: 12px; vertical-align: middle; }
    .wd-table tr.total td { font-weight: 800; background: #fafbff; }
    .wd-table a.t { font: 700 12.5px 'DM Sans', sans-serif; color: #171d3d; text-decoration: none; }
    .wd-view { display: inline-block; padding: 5px 11px; border-radius: 8px; border: 1px solid #cfe0ff; background: #f3f8ff; color: #236eff; font: 600 11.5px 'Inter', sans-serif; text-decoration: none; }
    .wd-note { margin: 10px 0 18px; font-size: 12px; line-height: 1.55; color: #6b7290; }
    .wd-empty { padding: 20px; border-radius: 12px; border: 1px dashed #dde1f0; background: #fafbfe; text-align: center; font-size: 12.5px; color: #8189a8; margin-bottom: 10px; }
    .wd-actions { display: flex; gap: 12px; margin-top: 18px; }
    .wd-btn { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; border-radius: 9px; border: 1px solid #cfe0ff; background: #fff; font: 600 13px 'Inter', sans-serif; color: #236eff; cursor: pointer; text-decoration: none; }
    .wd-btn.primary { border: 0; color: #fff; background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff); }
</style>

<div class="wd">
    <div class="wd-top">
        <button type="button" class="wd-x" data-close aria-label="Back"><i class="bi bi-chevron-left"></i></button>
        <button type="button" class="wd-x" data-close aria-label="Close"><i class="bi bi-x-lg"></i></button>
    </div>

    <h2>Withdrawal Details</h2>

    <div class="wd-card wd-summary">
        <div>
            <div><span class="wd-code">@w.Code</span><span class="wd-pill @tone">@w.Status</span></div>
            <small style="margin-top:4px;">@w.At.ToString("MMM d, yyyy, h:mm tt", CultureInfo.InvariantCulture)</small>
        </div>
        <div style="text-align:right;">
            <small>Gateway Reference</small>
            <b style="font:700 13px 'DM Sans',sans-serif;color:#171d3d;" title="@(Model.GatewayReference is null ? "Shown once the payment gateway is connected" : "")">@(Model.GatewayReference ?? "—")</b>
        </div>
    </div>

    <h4>Influencer</h4>
    <div class="wd-card">
        <div class="wd-person">
            <div class="wd-avatar">@Initials(w.InfluencerName)</div>
            <div>
                <b>@w.InfluencerName</b>@if (w.Verified) { <i class="bi bi-patch-check-fill" style="color:#236eff;margin-left:6px;" title="Verified"></i> }
                <small>@@@handle</small>
            </div>
            <a class="wd-link" href="/Admin/AdminUserVerification/Details?type=influencer&id=@w.InfluencerId">View Profile <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>

    <h4>Payout Method</h4>
    <div class="wd-card">
        <div class="wd-method">
            <div class="wd-logo">@Html.Raw(Logo(w.MethodLabel, 34))</div>
            <div><b style="font:700 14px 'DM Sans',sans-serif;color:#171d3d;">@w.MethodLabel</b><small>@w.MaskedAccount</small></div>
        </div>
        <div class="wd-calc">
            <div><small>Amount Withdrawn</small><b>@Money(w.Amount)</b></div>
            <div><small>Platform Fee (@rate%)</small><b>@(feeTaken ? "- " + Money(w.Fee) : "—")</b></div>
            <div><small>Net Paid to Influencer</small><b class="net">@(feeTaken ? Money(w.Net) : "—")</b></div>
        </div>
    </div>

    <h4>Source of this Withdrawal</h4>
    @if (w.Status == "Failed")
    {
        <div class="wd-empty">This withdrawal failed, so no fee was taken and no milestone is assigned to it.</div>
    }
    else if (w.Lines.Count == 0)
    {
        <div class="wd-empty">No paid milestone is linked to this withdrawal yet.</div>
    }
    else
    {
        <table class="wd-table">
            <thead><tr><th>Campaign / Milestone</th><th>Brand</th><th>Amount</th><th>Portion</th><th>Fee (@rate%)</th><th>Paid on</th><th>Proof</th></tr></thead>
            <tbody>
                @foreach (var l in w.Lines)
                {
                    <tr>
                        <td><a class="t" href="/Admin/AdminCampaigns/Details/@l.Earning.CampaignId">@l.Earning.CampaignTitle</a><small>@l.Earning.MilestoneTitle@(string.IsNullOrWhiteSpace(l.Earning.ContentType) ? "" : " · " + l.Earning.ContentType)</small></td>
                        <td>@l.Earning.BrandName</td>
                        <td>@Money(l.Earning.Amount)</td>
                        <td>@Money(l.Portion)</td>
                        <td>@Money(l.Fee)</td>
                        <td>@l.Earning.PaidAt.ToString("MMM d", CultureInfo.InvariantCulture)</td>
                        <td>@if (l.Earning.MilestoneId != 0) { <a class="wd-view" href="/Admin/AdminProofReview/Details/@l.Earning.MilestoneId">View</a> }</td>
                    </tr>
                }
                @if (w.Unallocated > 0)
                {
                    <tr><td colspan="3"><small>Not linked to a paid milestone</small></td><td>@Money(w.Unallocated)</td><td>@Money(PlatformFee.Of(w.Unallocated))</td><td></td><td></td></tr>
                }
                <tr class="total"><td colspan="3">Total</td><td>@Money(totalPortion + w.Unallocated)</td><td>@Money(totalFee + PlatformFee.Of(w.Unallocated))</td><td></td><td></td></tr>
            </tbody>
        </table>
    }
    <div class="wd-note">A withdrawal is assigned to the influencer's paid milestones, oldest first.</div>

    <h4>Recent Milestones from this Influencer</h4>
    @if (Model.Recent.Count == 0)
    {
        <div class="wd-empty">No paid milestones yet.</div>
    }
    else
    {
        <table class="wd-table">
            <tbody>
                @foreach (var r in Model.Recent)
                {
                    <tr>
                        <td><b style="font:700 12.5px 'DM Sans',sans-serif;color:#171d3d;">@r.MilestoneTitle</b><small>@r.CampaignTitle</small></td>
                        <td>@(r.ContentType ?? "—")</td>
                        <td>@Money(r.Amount)</td>
                        <td>Paid on @r.PaidAt.ToString("MMM d", CultureInfo.InvariantCulture)</td>
                        <td>@if (r.MilestoneId != 0) { <a class="wd-view" href="/Admin/AdminProofReview/Details/@r.MilestoneId">View</a> }</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="wd-actions">
        <button type="button" class="wd-btn" data-close>Back to Wallet</button>
        <a class="wd-btn primary" href="/Admin/AdminUserVerification/Details?type=influencer&id=@w.InfluencerId">View Influencer Profile <i class="bi bi-arrow-right"></i></a>
    </div>
</div>
