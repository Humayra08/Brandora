@model Brandora.Web.Areas.Admin.Controllers.CashoutPageViewModel
@using System.Globalization
@using Brandora.Web.Areas.Admin.Services
@{
    var ledger = Model.Ledger;
    string Money(decimal amount) => "৳" + amount.ToString("N0", CultureInfo.InvariantCulture);
    // Official bKash and Nagad logos (already in wwwroot/images/payment-methods); bank uses an icon.
    string Logo(string method, int height) => method switch
    {
        "bKash" => $"<img src=\"/images/payment-methods/bkash.svg\" alt=\"bKash\" style=\"height:{height}px;width:auto;display:block;\" />",
        "Nagad" => $"<img src=\"/images/payment-methods/nagad.svg\" alt=\"Nagad\" style=\"height:{height}px;width:auto;display:block;\" />",
        _ => $"<i class=\"bi bi-bank\" style=\"font-size:{height}px;color:#236eff;line-height:1;\"></i>"
    };
    var maxAmount = Model.Balance;
    var savedJson = System.Text.Json.JsonSerializer.Serialize(ledger.SavedAccounts.Select(a => new { a.Method, a.Account, a.Label }));
}

<style>
    .cw-hero { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 140px; padding: 24px 36px; border-radius: 18px; margin-bottom: 16px; border: 1px solid #dce7ff; background: radial-gradient(ellipse at 61% 0%, rgba(163,38,255,.12), transparent 58%), linear-gradient(110deg, #f3f6ff88, #eaf1ffcc 55%, #f3f6ff88); }
    .cw-hero h1 { margin: 0; font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: clamp(30px, 3vw, 42px); line-height: 1.1; color: #171d3d; }
    .cw-hero p { margin: 8px 0 0; font: 13.5px 'Inter', sans-serif; color: #6b7290; }
    .cw-motto { font: 700 26px/1.2 'Caveat', cursive; color: #2a3157; text-align: center; transform: rotate(-3deg); }
    .cw-art { width: 88px; height: 88px; border-radius: 26px; background: linear-gradient(135deg, #a326ff, #236eff 60%, #18a9ff); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 38px; box-shadow: 0 18px 36px rgba(90,60,255,.25); }
    .cw-notice { display: flex; gap: 12px; margin-bottom: 16px; padding: 12px 18px; border-radius: 12px; border: 1px solid #ffdca8; background: #fff8ec; font: 12.5px/1.55 'Inter', sans-serif; color: #7a4b08; }

    .cw-strip { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 0; margin-bottom: 16px; border-radius: 15px; background: #fff; border: 1px solid #dce7ff; }
    .cw-strip > div { padding: 20px 24px; }
    .cw-strip > div + div { border-left: 1px solid #eef1fb; }
    .cw-bal { display: flex; align-items: center; gap: 16px; }
    .cw-bal-icon { width: 58px; height: 58px; border-radius: 16px; background: linear-gradient(135deg, #f1e6ff, #e3f0ff); color: #7a2fe0; display: flex; align-items: center; justify-content: center; font-size: 26px; }
    .cw-label { font: 600 12px 'Inter', sans-serif; color: #8189a8; }
    .cw-big { margin-top: 4px; font: 800 32px 'DM Sans', sans-serif; color: #171d3d; }
    .cw-mid { margin-top: 6px; font: 800 20px 'DM Sans', sans-serif; color: #171d3d; }
    .cw-sub { margin-top: 3px; font: 11.5px 'Inter', sans-serif; color: #8189a8; }

    .cw-cols { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 16px; align-items: start; margin-bottom: 16px; }
    .cw-card { padding: 22px 24px; border-radius: 15px; background: #fff; border: 1px solid #dce7ff; min-width: 0; }
    .cw-title { margin: 0 0 14px; font: 700 18px 'Playfair Display', Georgia, serif; color: #171d3d; }
    .cw-field-label { margin: 14px 0 7px; font: 600 12.5px 'Inter', sans-serif; color: #2a3157; }
    .cw-amount-wrap { display: flex; align-items: center; border: 1px solid #dde1f0; border-radius: 12px; overflow: hidden; }
    .cw-amount-wrap span { padding: 0 0 0 16px; font: 700 18px 'DM Sans', sans-serif; color: #8189a8; }
    .cw-amount-wrap input { flex: 1; min-width: 0; height: 50px; padding: 0 12px; border: 0; outline: none; font: 700 18px 'DM Sans', sans-serif; color: #171d3d; }
    .cw-max { margin-right: 10px; padding: 6px 14px; border: 0; border-radius: 8px; background: #e3f0ff; color: #236eff; font: 700 12px 'Inter', sans-serif; cursor: pointer; }
    .cw-hint { margin-top: 6px; font: 11.5px 'Inter', sans-serif; color: #8189a8; }
    .cw-methods { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .cw-method { position: relative; display: flex; align-items: center; gap: 10px; padding: 14px; border-radius: 12px; border: 1px solid #dde1f0; background: #fff; cursor: pointer; font: 600 13px 'Inter', sans-serif; color: #171d3d; }
    .cw-method input { position: absolute; top: 9px; left: 9px; }
    .cw-logo { display: flex; align-items: center; justify-content: center; min-width: 58px; margin-left: 12px; }
    .cw-method small { display: block; font: 11px 'Inter', sans-serif; color: #8189a8; }
    .cw-method:has(input:checked) { border-color: #236eff; background: #f3f8ff; }
    .cw-select-row { display: flex; align-items: center; gap: 14px; }
    .cw-select-row select, .cw-input { flex: 1; height: 44px; padding: 0 12px; border-radius: 10px; border: 1px solid #dde1f0; background: #fff; font: 13px 'Inter', sans-serif; color: #2a3157; outline: none; }
    .cw-link { border: 0; background: transparent; color: #236eff; font: 600 12.5px 'Inter', sans-serif; cursor: pointer; white-space: nowrap; }
    .cw-info { margin: 16px 0; padding: 14px 16px; border-radius: 12px; border: 1px solid #cfe0ff; background: #f3f8ff; font: 12px/1.7 'Inter', sans-serif; color: #2a3157; }
    .cw-info ul { margin: 0; padding-left: 18px; }
    .cw-go { width: 100%; height: 50px; border: 0; border-radius: 10px; color: #fff; font: 700 14px 'Inter', sans-serif; background: linear-gradient(105deg, #a326ff, #236eff, #18a9ff); cursor: pointer; }
    .cw-error { margin-top: 10px; padding: 10px 14px; border-radius: 10px; background: #fde8ea; color: #a71b34; font: 600 12.5px 'Inter', sans-serif; }
    .cw-error[hidden] { display: none; }

    .cw-row { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; font: 13px 'Inter', sans-serif; color: #6b7290; }
    .cw-row b { color: #171d3d; font-family: 'DM Sans', sans-serif; text-align: right; }
    .cw-row.total { margin: 6px 0; padding: 12px 14px; border-radius: 10px; background: #f3f8ff; }
    .cw-row.total b { font-size: 17px; color: #236eff; }
    .cw-edit { float: right; border: 0; background: transparent; color: #236eff; font: 600 12.5px 'Inter', sans-serif; cursor: pointer; }
    .cw-notes { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 9px; font: 12.5px/1.5 'Inter', sans-serif; color: #2a3157; }
    .cw-notes li::marker { color: #236eff; }

    .cw-toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 4px 0 14px; }
    .cw-toolbar .cw-input { flex: 0 0 auto; height: 38px; font-size: 12.5px; }
    .cw-toolbar .cw-input[type="search"] { width: 240px; } .cw-toolbar .cw-input[type="date"] { width: 150px; }
    .cw-btn { display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 0 14px; border-radius: 10px; border: 1px solid #cfe0ff; background: #f3f8ff; font: 600 12.5px 'Inter', sans-serif; color: #236eff; cursor: pointer; }
    .cw-table { width: 100%; border-collapse: collapse; }
    .cw-table th { white-space: nowrap; padding: 11px 14px; text-align: left; font: 700 11px 'Inter', sans-serif; letter-spacing: .3px; text-transform: uppercase; color: #8189a8; background: #f7f9ff; }
    .cw-table td { white-space: nowrap; padding: 14px; border-top: 1px solid #eef1fb; font: 12.5px 'Inter', sans-serif; color: #2a3157; vertical-align: middle; }
    .cw-scroll { overflow-x: auto; }
    .cw-m { display: flex; align-items: center; gap: 9px; }
    .cw-pill { display: inline-block; padding: 5px 11px; border-radius: 8px; font: 600 11.5px 'Inter', sans-serif; }
    .cw-pill.green { background: #e2f8ee; color: #0d9c6c; } .cw-pill.red { background: #fde8ea; color: #d92d3f; } .cw-pill.blue { background: #e3f0ff; color: #236eff; }
    .cw-view { padding: 6px 14px; border-radius: 9px; border: 1px solid #cfe0ff; background: #f3f8ff; color: #236eff; font: 600 12px 'Inter', sans-serif; cursor: pointer; }
    .cw-pager { display: flex; justify-content: center; gap: 6px; margin-top: 14px; }
    .cw-pager button { min-width: 34px; height: 34px; border-radius: 9px; border: 1px solid #dde1f0; background: #fff; font: 600 12.5px 'Inter', sans-serif; color: #2a3157; cursor: pointer; }
    .cw-pager button.is-active { border: 0; color: #fff; background: linear-gradient(105deg, #a326ff, #236eff); }
    .cw-empty { padding: 26px 18px; border-radius: 12px; border: 1px dashed #dde1f0; background: #fafbfe; text-align: center; font: 12.5px 'Inter', sans-serif; color: #8189a8; }
    .cw-empty b { display: block; margin-bottom: 4px; font: 700 14px 'DM Sans', sans-serif; color: #2a3157; }

    /* Modal */
    .cw-backdrop { position: fixed; inset: 0; z-index: 2100; display: none; align-items: center; justify-content: center; padding: 20px; background: rgba(15,20,50,.45); }
    .cw-backdrop.is-open { display: flex; }
    .cw-modal { position: relative; width: min(470px, 100%); max-height: 92vh; overflow-y: auto; padding: 28px 28px 24px; border-radius: 18px; background: #fff; box-shadow: 0 30px 70px rgba(15,20,50,.35); text-align: center; font-family: 'Inter', sans-serif; color: #2a3157; }
    .cw-modal-x { position: absolute; top: 14px; right: 16px; border: 0; background: transparent; font-size: 18px; color: #2a3157; cursor: pointer; }
    .cw-badge { width: 60px; height: 60px; margin: 0 auto 12px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; background: #f1e6ff; color: #7a2fe0; }
    .cw-badge.ok { background: #1fb872; color: #fff; } .cw-badge.bad { background: #e5484d; color: #fff; }
    .cw-modal h3 { margin: 0 0 8px; font: 700 24px 'Playfair Display', Georgia, serif; color: #171d3d; }
    .cw-modal p { margin: 0 0 16px; font-size: 13.5px; line-height: 1.55; color: #4a5170; }
    .cw-box { margin-bottom: 14px; padding: 6px 16px; border-radius: 12px; border: 1px solid #eef1fb; background: #fafbff; text-align: left; }
    .cw-warn { margin-bottom: 18px; padding: 12px 14px; border-radius: 12px; background: #fff4e0; border: 1px solid #ffd99a; color: #8a5a10; font-size: 12.5px; line-height: 1.5; text-align: left; }
    .cw-actions { display: flex; gap: 12px; }
    .cw-actions button { flex: 1; height: 46px; border-radius: 10px; border: 1px solid #cfe0ff; background: #fff; font: 600 13.5px 'Inter', sans-serif; color: #236eff; cursor: pointer; }
    .cw-actions button.primary { border: 0; color: #fff; background: linear-gradient(105deg, #a326ff, #236eff); }
    .cw-spin { width: 46px; height: 46px; margin: 0 auto 14px; border-radius: 50%; border: 4px solid #e3ebff; border-top-color: #236eff; animation: cwspin 1s linear infinite; }
    @@keyframes cwspin { to { transform: rotate(360deg); } }
    .cw-stage[hidden] { display: none; }

    /* Drawer */
    .cw-overlay { position: fixed; inset: 0; z-index: 1900; background: rgba(15,20,50,.35); opacity: 0; pointer-events: none; transition: opacity .2s; }
    .cw-overlay.is-open { opacity: 1; pointer-events: auto; }
    .cw-drawer { position: fixed; top: 0; right: 0; bottom: 0; z-index: 2000; width: min(520px, 100vw); overflow-y: auto; background: #fff; border-left: 1px solid #dce7ff; box-shadow: -18px 0 40px rgba(20,25,60,.12); transform: translateX(100%); transition: transform .25s ease; }
    .cw-drawer.is-open { transform: translateX(0); }
    .cw-loading { padding: 40px; font: 13px 'Inter', sans-serif; color: #8189a8; }

    @@media print { body * { visibility: hidden; } #cwDrawer, #cwDrawer * { visibility: visible; } #cwDrawer { position: absolute; left: 0; top: 0; width: 100%; border: 0; box-shadow: none; transform: none; } }
    @@media(max-width: 1100px) { .cw-cols { grid-template-columns: 1fr; } .cw-strip { grid-template-columns: 1fr 1fr; } }
    @@media(max-width: 700px) { .cw-strip { grid-template-columns: 1fr; } .cw-strip > div + div { border-left: 0; border-top: 1px solid #eef1fb; } .cw-methods { grid-template-columns: 1fr; } .cw-motto { display: none; } }
</style>

<section class="cw-hero">
    <div>
        <h1>Withdraw from Platform Wallet</h1>
        <p>Transfer funds from your platform wallet to your bank, bKash or Nagad account.</p>
    </div>
    <div class="cw-motto">Small Payouts<br />Bigger Impact</div>
    <div class="cw-art"><i class="bi bi-wallet2"></i></div>
</section>

<div class="cw-notice"><i class="bi bi-exclamation-triangle"></i><div>There's no payout API for bKash/Nagad merchant accounts — send this money yourself in your own bKash/Nagad app <b>first</b>, then log the real transaction reference below. This just records it; it doesn't move any money.</div></div>

<section class="cw-strip">
    <div class="cw-bal">
        <div class="cw-bal-icon"><i class="bi bi-wallet2"></i></div>
        <div><div class="cw-label">Available Balance</div><div class="cw-big">@Money(Model.Balance)</div></div>
    </div>
    <div><div class="cw-label">Total Cash-outs (All Time)</div><div class="cw-mid">@Money(Model.TotalCashedOut)</div></div>
    <div>
        <div class="cw-label">Last Cash-out</div>
        <div class="cw-mid">@(Model.LastCashout is null ? "—" : Money(Model.LastCashout.Amount))</div>
        <div class="cw-sub">@(Model.LastCashout is null ? "No cash-outs yet" : Model.LastCashout.At.ToString("MMM d, yyyy", CultureInfo.InvariantCulture))</div>
    </div>
    <div>
        <div class="cw-label">Pending Cash-outs</div>
        <div class="cw-mid">@Model.PendingCount</div>
        <div class="cw-sub">@(Model.PendingCount == 0 ? "No pending requests" : "Being processed")</div>
    </div>
</section>

<section class="cw-cols">
    <div class="cw-card">
        <h2 class="cw-title">Cash-out Amount</h2>

        <div class="cw-field-label" style="margin-top:0;">Amount (৳)</div>
        <div class="cw-amount-wrap">
            <span>৳</span>
            <input type="number" id="cwAmount" min="0" max="@maxAmount.ToString("0.##", CultureInfo.InvariantCulture)" step="1" placeholder="0" />
            <button type="button" class="cw-max" id="cwMax">Max</button>
        </div>
        <div class="cw-hint">Maximum: @Money(maxAmount)</div>

        <div class="cw-field-label">Payout Method</div>
        <div class="cw-methods">
            <label class="cw-method" title="bKash"><input type="radio" name="cwMethod" value="bKash" aria-label="bKash" checked /><span class="cw-logo">@Html.Raw(Logo("bKash", 30))</span><small>Mobile wallet</small></label>
            <label class="cw-method" title="Nagad"><input type="radio" name="cwMethod" value="Nagad" aria-label="Nagad" /><span class="cw-logo">@Html.Raw(Logo("Nagad", 30))</span><small>Mobile wallet</small></label>
            <label class="cw-method" title="Bank Transfer"><input type="radio" name="cwMethod" value="Bank Transfer" aria-label="Bank Transfer" /><span class="cw-logo">@Html.Raw(Logo("Bank Transfer", 26))</span><div>Bank Transfer<small>Bank account</small></div></label>
        </div>

        <div class="cw-field-label">Select Account</div>
        <div class="cw-select-row">
            <select id="cwSaved"></select>
            <button type="button" class="cw-link" id="cwAddNew"><i class="bi bi-plus"></i> Add New Account</button>
        </div>
        <div id="cwNewWrap" style="margin-top:10px;">
            <input class="cw-input" style="width:100%;" type="text" id="cwAccount" inputmode="numeric" autocomplete="off" placeholder="01XXXXXXXXX" />
            <div class="cw-hint" id="cwAccountHint">Enter the 11-digit bKash number that will receive the money.</div>
        </div>

        <div class="cw-field-label">Real Transaction Reference</div>
        <input class="cw-input" style="width:100%;" type="text" id="cwReference" autocomplete="off" placeholder="e.g. 8N7K2P3Q9R" />
        <div class="cw-hint">The reference your own bKash/Nagad app gave you once you actually sent this money.</div>

        <div class="cw-info">
            <ul>
                <li>Send the money yourself in your own bKash/Nagad app first — this form only logs it.</li>
                <li>There's no payout API for a merchant-tier bKash/Nagad account, so nothing here moves money automatically.</li>
                <li>Every cash-out is permanent and audited.</li>
            </ul>
        </div>

        <button type="button" class="cw-go" id="cwReview">Review Cash-out <i class="bi bi-arrow-right"></i></button>
        <div class="cw-error" id="cwError" hidden></div>
    </div>

    <div style="display:flex;flex-direction:column;gap:16px;">
        <div class="cw-card">
            <button type="button" class="cw-edit" id="cwEdit"><i class="bi bi-pencil"></i> Edit</button>
            <h2 class="cw-title">Cash-out Preview</h2>
            <div class="cw-row total"><span>Amount</span><b id="pvAmount">৳0</b></div>
            <div class="cw-row"><span>Payout Method</span><b id="pvMethod">bKash</b></div>
            <div class="cw-row"><span>Account</span><b id="pvAccount">—</b></div>
            <div class="cw-row"><span>Reference</span><b id="pvReference">—</b></div>
        </div>

        <div class="cw-card">
            <h2 class="cw-title"><i class="bi bi-file-earmark-text" style="color:#7a2fe0;"></i> Important Notes</h2>
            <ul class="cw-notes">
                <li>Only admins can cash out from the platform wallet.</li>
                <li>This does not affect influencer or brand balances.</li>
                <li>Ensure the account information is correct.</li>
                <li>If you face any issue, contact our support team.</li>
                <li>All transactions are logged for security and audit purposes.</li>
            </ul>
        </div>
    </div>
</section>

<div class="cw-card" id="history">
    <h2 class="cw-title">Cash-out History</h2>

    @if (Model.Cashouts.Count == 0)
    {
        <div class="cw-empty"><b>No cash-outs yet</b>Every cash-out you make will be listed here with its status and gateway reference.</div>
    }
    else
    {
        <div class="cw-toolbar">
            <input class="cw-input" type="date" id="hFrom" aria-label="From date" />
            <input class="cw-input" type="date" id="hTo" aria-label="To date" />
            <select class="cw-input" id="hMethod"><option value="">All Methods</option><option>bKash</option><option>Nagad</option><option>Bank Transfer</option></select>
            <select class="cw-input" id="hStatus"><option value="">All Statuses</option><option>Completed</option><option>Processing</option><option>Failed</option></select>
            <input class="cw-input" type="search" id="hSearch" placeholder="Search by reference or note..." />
            <button type="button" class="cw-btn" id="hExport"><i class="bi bi-download"></i> Export CSV</button>
        </div>
        <div class="cw-scroll">
            <table class="cw-table" id="cwHistory">
                <thead><tr><th>#</th><th>Date &amp; time</th><th>Method</th><th>Account / details</th><th>Amount</th><th>Gateway reference</th><th>Status</th><th>Note</th><th>Actions</th></tr></thead>
                <tbody>
                    @{ var n = 0; }
                    @foreach (var c in Model.Cashouts)
                    {
                        n++;
                        <tr data-search="@((c.GatewayReference + " " + c.Note + " " + c.Code).ToLowerInvariant())" data-method="@c.Method" data-status="@c.Status" data-date="@c.At.ToString("yyyy-MM-dd")">
                            <td>@n</td>
                            <td>@c.At.ToString("MMM d, yyyy h:mm tt", CultureInfo.InvariantCulture)</td>
                            <td><div class="cw-m">@Html.Raw(Logo(c.Method, 18))<span>@c.Method</span></div></td>
                            <td>@c.Account</td>
                            <td>@Money(c.Amount)</td>
                            <td>@(c.GatewayReference ?? "—")</td>
                            <td><span class="cw-pill @(c.Status == "Completed" ? "green" : c.Status == "Failed" ? "red" : "blue")">@c.Status</span></td>
                            <td>@(c.Note ?? "—")</td>
                            <td><button type="button" class="cw-view" data-cashout="@c.Id">View</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="cw-pager" id="cwPager"></div>
    }
</div>

<form id="cwTokenForm">@Html.AntiForgeryToken()</form>

<!-- Confirmation modal: confirm -> processing -> success | failed -->
<div class="cw-backdrop" id="cwBackdrop">
    <div class="cw-modal" role="dialog" aria-modal="true">
        <button type="button" class="cw-modal-x" data-modal-close aria-label="Close"><i class="bi bi-x-lg"></i></button>

        <div class="cw-stage" data-stage="confirm">
            <div class="cw-badge"><i class="bi bi-wallet2"></i></div>
            <h3>Confirm Cash-out</h3>
            <p id="cfSentence"></p>
            <div class="cw-box">
                <div class="cw-row total"><span>Amount</span><b id="cfAmount"></b></div>
                <div class="cw-row"><span>Method</span><b id="cfMethod"></b></div>
                <div class="cw-row"><span>Account</span><b id="cfAccount"></b></div>
                <div class="cw-row"><span>Reference</span><b id="cfReference"></b></div>
            </div>
            <div class="cw-warn"><i class="bi bi-exclamation-circle"></i> This only logs the cash-out — make sure you've <b>already</b> sent the money yourself and the reference above is correct. This cannot be undone.</div>
            <div class="cw-actions">
                <button type="button" data-modal-close>Cancel</button>
                <button type="button" class="primary" id="cfConfirm">Confirm &amp; Withdraw</button>
            </div>
        </div>

        <div class="cw-stage" data-stage="processing" hidden>
            <div class="cw-spin"></div>
            <h3>Processing Your Cash-out</h3>
            <p>Please wait while we process your request. This may take a moment.</p>
        </div>

        <div class="cw-stage" data-stage="success" hidden>
            <div class="cw-badge ok"><i class="bi bi-check-lg"></i></div>
            <h3>Cash-out Logged</h3>
            <p id="okSentence"></p>
            <div class="cw-box"><div class="cw-row"><span>Transaction Reference</span><b id="okRef"></b></div></div>
            <p style="font-size:12.5px;">A confirmation email has been sent to your admin email.</p>
            <div class="cw-actions">
                <button type="button" class="primary" id="okHistory">View in History</button>
            </div>
        </div>

        <div class="cw-stage" data-stage="failed" hidden>
            <div class="cw-badge bad"><i class="bi bi-x-lg"></i></div>
            <h3>Cash-out Failed</h3>
            <p id="badSentence"></p>
            <div class="cw-actions">
                <button type="button" class="primary" id="badRetry">Try Again</button>
                <button type="button" data-modal-close>Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="cw-overlay" id="cwOverlay"></div>
<aside class="cw-drawer" id="cwDrawer" aria-hidden="true"></aside>

<script>
    (function () {
        var MAX = @maxAmount.ToString("0.##", CultureInfo.InvariantCulture);
        var SAVED = @Html.Raw(savedJson);

        function money(n) { return '৳' + Number(n).toLocaleString('en-US', { maximumFractionDigits: 0 }); }
        function $(id) { return document.getElementById(id); }
        function method() { return document.querySelector('input[name="cwMethod"]:checked').value; }
        function mask(m, a) {
            a = (a || '').trim(); if (!a) return '—';
            if (m === 'Bank Transfer') return a.length > 4 ? '****' + a.slice(-4) : a;
            return a.length > 7 ? a.slice(0, 5) + ' ' + a.slice(5, 7) + '****' : a;
        }

        // ----- form + live preview -----
        var amount = $('cwAmount'), account = $('cwAccount'), saved = $('cwSaved'), err = $('cwError'), reference = $('cwReference');
        function currentAccount() {
            if (saved.value && saved.value !== 'new') return saved.value;
            return account.value.trim();
        }
        function refreshSaved() {
            var m = method();
            var list = SAVED.filter(function (s) { return s.Method === m; });
            saved.innerHTML = '';
            list.forEach(function (s) {
                var o = document.createElement('option'); o.value = s.Account; o.textContent = mask(m, s.Account) + (s.Label ? ' (' + s.Label + ')' : ''); saved.appendChild(o);
            });
            var n = document.createElement('option'); n.value = 'new'; n.textContent = list.length ? 'Enter a different account' : 'No saved account. Enter one below'; saved.appendChild(n);
            saved.value = list.length ? list[0].Account : 'new';
            $('cwNewWrap').style.display = saved.value === 'new' ? '' : 'none';
            var mobile = m !== 'Bank Transfer';
            account.placeholder = mobile ? '01XXXXXXXXX' : 'Bank account number';
            $('cwAccountHint').textContent = mobile ? 'Enter the 11-digit ' + m + ' number that will receive the money.' : 'Enter the bank account number that will receive the money.';
        }
        function preview() {
            var a = parseFloat(amount.value) || 0, m = method();
            $('pvAmount').textContent = money(a);
            $('pvMethod').textContent = m;
            $('pvAccount').textContent = mask(m, currentAccount());
            $('pvReference').textContent = reference.value.trim() || '—';
        }
        document.querySelectorAll('input[name="cwMethod"]').forEach(function (r) { r.addEventListener('change', function () { refreshSaved(); preview(); }); });
        [amount, account, reference].forEach(function (el) { el.addEventListener('input', preview); });
        saved.addEventListener('change', function () { $('cwNewWrap').style.display = saved.value === 'new' ? '' : 'none'; preview(); });
        $('cwAddNew').addEventListener('click', function () { saved.value = 'new'; $('cwNewWrap').style.display = ''; account.focus(); preview(); });
        $('cwMax').addEventListener('click', function () { amount.value = MAX; preview(); });
        $('cwEdit').addEventListener('click', function () { amount.focus(); amount.scrollIntoView({ behavior: 'smooth', block: 'center' }); });
        refreshSaved(); preview();

        function validate() {
            var a = parseFloat(amount.value) || 0, m = method(), acct = currentAccount();
            if (a <= 0) return 'Enter an amount greater than ৳0.';
            if (a > MAX) return 'The amount is more than the available balance.';
            var digits = acct.replace(/\D/g, '');
            if (m !== 'Bank Transfer' && !(digits.length === 11 && digits.indexOf('01') === 0)) return 'Enter a valid 11-digit mobile number that starts with 01.';
            if (m === 'Bank Transfer' && acct.length < 6) return 'Enter a valid bank account number.';
            if (!reference.value.trim()) return "Enter the real transaction reference from your bKash/Nagad app — you should have already sent the money.";
            return '';
        }

        // ----- modal -----
        var backdrop = $('cwBackdrop');
        function stage(name) { backdrop.querySelectorAll('.cw-stage').forEach(function (s) { s.hidden = s.getAttribute('data-stage') !== name; }); }
        function openModal() { stage('confirm'); backdrop.classList.add('is-open'); }
        function closeModal() { backdrop.classList.remove('is-open'); }
        backdrop.querySelectorAll('[data-modal-close]').forEach(function (b) { b.addEventListener('click', closeModal); });
        backdrop.addEventListener('click', function (e) { if (e.target === backdrop) closeModal(); });

        $('cwReview').addEventListener('click', function () {
            var msg = validate();
            err.hidden = !msg; err.textContent = msg;
            if (msg) return;
            var a = parseFloat(amount.value), m = method(), acct = currentAccount();
            $('cfSentence').textContent = 'This logs a cash-out of ' + money(a) + ' to ' + m + ' account ' + mask(m, acct) + ' — only if you\'ve already sent it yourself.';
            $('cfAmount').textContent = money(a);
            $('cfMethod').textContent = m; $('cfAccount').textContent = mask(m, acct);
            $('cfReference').textContent = reference.value.trim();
            openModal();
        });

        $('cfConfirm').addEventListener('click', function () {
            var a = parseFloat(amount.value), m = method(), acct = currentAccount(), ref = reference.value.trim();
            stage('processing');
            var body = new URLSearchParams();
            body.set('amount', a); body.set('method', m); body.set('account', acct); body.set('reference', ref);
            body.set('__RequestVerificationToken', document.querySelector('#cwTokenForm input[name="__RequestVerificationToken"]').value);
            fetch('/Admin/AdminWallet/Withdraw', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() })
                .then(function (r) { return r.json().catch(function () { return { ok: false, error: 'Something went wrong. Please try again.' }; }); })
                .then(function (j) {
                    if (j.ok) {
                        $('okSentence').textContent = money(a) + ' logged as sent to ' + m + ' account ' + mask(m, acct) + '.';
                        $('okRef').textContent = j.reference || '—';
                        stage('success');
                    } else {
                        $('badSentence').textContent = j.error || 'We could not process your request.';
                        stage('failed');
                    }
                })
                .catch(function () { $('badSentence').textContent = 'Could not reach the server. Please try again.'; stage('failed'); });
        });
        $('badRetry').addEventListener('click', function () { stage('confirm'); });
        $('okHistory').addEventListener('click', function () { window.location.href = '/Admin/AdminWallet/Withdraw#history'; window.location.reload(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeModal(); closeDrawer(); } });

        // ----- details drawer -----
        var drawer = $('cwDrawer'), overlay = $('cwOverlay');
        function closeDrawer() { drawer.classList.remove('is-open'); overlay.classList.remove('is-open'); drawer.setAttribute('aria-hidden', 'true'); }
        overlay.addEventListener('click', closeDrawer);
        document.querySelectorAll('[data-cashout]').forEach(function (b) {
            b.addEventListener('click', function () {
                drawer.innerHTML = '<div class="cw-loading">Loading…</div>';
                drawer.classList.add('is-open'); overlay.classList.add('is-open'); drawer.setAttribute('aria-hidden', 'false');
                fetch('/Admin/AdminWallet/CashoutDetails/' + b.getAttribute('data-cashout'), { credentials: 'same-origin' })
                    .then(function (r) { if (!r.ok) throw new Error(); return r.text(); })
                    .then(function (html) {
                        drawer.innerHTML = html;
                        drawer.querySelectorAll('[data-close]').forEach(function (x) { x.addEventListener('click', closeDrawer); });
                        drawer.querySelectorAll('[data-again]').forEach(function (x) { x.addEventListener('click', function () { closeDrawer(); amount.focus(); amount.scrollIntoView({ behavior: 'smooth', block: 'center' }); }); });
                        drawer.querySelectorAll('[data-print]').forEach(function (x) { x.addEventListener('click', function () { window.print(); }); });
                    })
                    .catch(function () { drawer.innerHTML = '<div class="cw-loading">Could not load this cash-out. Close and try again.</div>'; });
            });
        });

        // ----- history filters + paging + export -----
        var table = $('cwHistory');
        if (table) {
            var rows = Array.prototype.slice.call(table.tBodies[0].rows), PAGE = 8, page = 1, pager = $('cwPager');
            var f = { from: $('hFrom'), to: $('hTo'), m: $('hMethod'), s: $('hStatus'), q: $('hSearch') };
            function match(r) {
                var d = r.getAttribute('data-date');
                return r.getAttribute('data-search').indexOf(f.q.value.trim().toLowerCase()) !== -1
                    && (!f.m.value || r.getAttribute('data-method') === f.m.value)
                    && (!f.s.value || r.getAttribute('data-status') === f.s.value)
                    && (!f.from.value || d >= f.from.value) && (!f.to.value || d <= f.to.value);
            }
            function render() {
                var matched = rows.filter(match), pages = Math.max(1, Math.ceil(matched.length / PAGE));
                if (page > pages) page = pages;
                rows.forEach(function (r) { r.style.display = 'none'; r.dataset.match = '0'; });
                matched.forEach(function (r, i) { r.dataset.match = '1'; r.style.display = (i >= (page - 1) * PAGE && i < page * PAGE) ? '' : 'none'; });
                pager.innerHTML = '';
                if (pages > 1) for (var p = 1; p <= pages; p++) (function (p) {
                    var b = document.createElement('button'); b.textContent = p; b.className = p === page ? 'is-active' : '';
                    b.addEventListener('click', function () { page = p; render(); }); pager.appendChild(b);
                })(p);
            }
            Object.keys(f).forEach(function (k) { f[k].addEventListener('input', function () { page = 1; render(); }); });
            render();
            $('hExport').addEventListener('click', function () {
                var lines = [Array.prototype.slice.call(table.tHead.rows[0].cells, 0, -1).map(function (c) { return '"' + c.innerText.trim() + '"'; }).join(',')];
                rows.filter(function (r) { return r.dataset.match === '1'; }).forEach(function (r) {
                    lines.push(Array.prototype.slice.call(r.cells, 0, -1).map(function (c) { return '"' + c.innerText.replace(/\s+/g, ' ').trim().replace(/"/g, '""') + '"'; }).join(','));
                });
                var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' })); a.download = 'cash-out-history.csv'; a.click();
            });
        }
    })();
</script>
