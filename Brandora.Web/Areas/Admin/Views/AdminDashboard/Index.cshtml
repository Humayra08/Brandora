    /* ---- Platform wallet ---- */
    .platform-wallet { margin-top: 24px; background: radial-gradient(ellipse at 100% 0%, #e7defe, transparent 55%), radial-gradient(ellipse at 0% 100%, #e1efff, transparent 50%), #ffffff; }
