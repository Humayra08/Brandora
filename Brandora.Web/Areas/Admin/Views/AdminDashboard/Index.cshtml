    .pw-tile-note { margin-top: 3px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; }

    .health-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 20px; margin-top: 24px; }
