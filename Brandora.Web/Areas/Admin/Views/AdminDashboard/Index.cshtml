@model Brandora.Web.Areas.Admin.Controllers.AdminDashboardViewModel
@{
    // NOTE: KPI trend %, sparklines, Platform Health line chart, Quick Shortcuts,
    // Alerts & Flags counts below are DUMMY placeholder data for the visual redesign pass
    // (per user request, "real placeholder ... put dummy data for now") —
    // TODO: wire to real queries once the look is approved.
}

<style>
    .kpi-icon {
        width: 44px; height: 44px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 19px; margin-bottom: 14px;
    }
    .kpi-icon.purple { background: #f1e6ff; color: #8b2ff2; }
    .kpi-icon.orange { background: #fdeee0; color: #d97a17; }
    .kpi-icon.blue { background: #e3f0ff; color: #1a73d8; }
    .kpi-icon.red { background: #fde3e3; color: #e34848; }
    .kpi-icon.green { background: #dff7ec; color: #0d9c6c; }

    .kpi-trend { margin-top: 10px; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; }
    .kpi-trend.up { color: #0d9c6c; }
    .kpi-trend.down { color: #e34848; }

    .health-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 20px; margin-top: 24px; }
    @@media(max-width: 1100px) { .health-grid { grid-template-columns: 1fr; } }

    .chart-legend { display: flex; gap: 18px; margin-top: 4px; flex-wrap: wrap; }
    .chart-legend-item { display: flex; align-items: center; gap: 6px; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #2a3157; }
    .chart-legend-dot { width: 9px; height: 9px; border-radius: 50%; }

    .health-stat-row { display: flex; justify-content: space-between; align-items: baseline; padding: 11px 0; border-bottom: 1px solid #f2f3fa; }
    .health-stat-row:last-child { border-bottom: none; }
    .health-stat-label { font-family: 'Inter', sans-serif; font-size: 12.5px; color: #8189a8; }
    .health-stat-value { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 16px; color: #171d3d; }
    .health-stat-delta { margin-left: 8px; font-family: 'Inter', sans-serif; font-size: 11.5px; font-weight: 600; color: #0d9c6c; }

    .side-panels-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
    @@media(max-width: 1100px) { .side-panels-row { grid-template-columns: 1fr; } }

    .quick-shortcut-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
    .quick-shortcut {
        display: flex; align-items: center;
        padding: 16px; border-radius: 12px; border: 1px solid #eaecf5;
        font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 700;
        transition: .2s;
    }
    .quick-shortcut:hover { border-color: #d3b8ff; background: rgba(155,44,255,.03); transform: translateY(-2px); }
    .quick-shortcut-arrow { margin-left: auto; color: #b7bdd6; }
    .quick-shortcut.purple { color: #8b2ff2; }
    .quick-shortcut.blue { color: #1a73d8; }
    .quick-shortcut.red { color: #e34848; }
    .quick-shortcut.green { color: #0d9c6c; }
    .quick-shortcut.orange { color: #d97a17; }

    .alert-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f2f3fa; }
    .alert-row:last-child { border-bottom: none; }
    .alert-label { font-family: 'Inter', sans-serif; font-size: 13px; color: #2a3157; }
    .alert-count { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 13.5px; }
    .alert-count.red { color: #e34848; }
    .alert-count.orange { color: #d97a17; }

    .activity-row { display: flex; align-items: flex-start; gap: 12px; padding: 13px 0; border-bottom: 1px solid #f2f3fa; }
    .activity-row:last-child { border-bottom: none; }
    .activity-dot { width: 9px; height: 9px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
    .activity-title { font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 700; color: #2a3157; }
    .activity-sub { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 12.5px; color: #8189a8; }
    .activity-meta { margin-left: auto; display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
    .activity-time { font-family: 'Inter', sans-serif; font-size: 12px; color: #8189a8; white-space: nowrap; }
</style>

<div class="kpi-grid">

    <a href="/Admin/AdminUserVerification/Index" class="kpi-card glass-card">
        <div class="kpi-icon purple"><i class="bi bi-people-fill"></i></div>
        <div class="kpi-label">Total Users</div>
        <div class="kpi-value">@Model.TotalUsers.ToString("N0")</div>
        <div class="kpi-trend up"><i class="bi bi-arrow-up-short"></i> 12.4% from last month</div>
    </a>

    <a href="/Admin/AdminUserVerification/Index?status=Pending" class="kpi-card glass-card">
        <div class="kpi-icon orange"><i class="bi bi-person-check-fill"></i></div>
        <div class="kpi-label">Pending Verifications</div>
        <div class="kpi-value">@Model.PendingVerifications.ToString("N0")</div>
        <div class="kpi-trend up"><i class="bi bi-arrow-up-short"></i> 8.7% from last week</div>
    </a>

    <a href="/Admin/AdminProofReview/Index?status=Submitted" class="kpi-card glass-card">
        <div class="kpi-icon blue"><i class="bi bi-clipboard-check-fill"></i></div>
        <div class="kpi-label">Pending Proof Reviews</div>
        <div class="kpi-value">@Model.PendingProofReviews.ToString("N0")</div>
        <div class="kpi-trend up"><i class="bi bi-arrow-up-short"></i> 15.3% from last week</div>
    </a>

    <a href="/Admin/AdminDisputes/Index?status=Open" class="kpi-card glass-card">
        <div class="kpi-icon red"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <div class="kpi-label">Open Disputes</div>
        <div class="kpi-value">@Model.OpenDisputes.ToString("N0")</div>
        <div class="kpi-trend down"><i class="bi bi-arrow-down-short"></i> 4.2% from last week</div>
    </a>

    <a href="/Admin/AdminPayments/Index" class="kpi-card glass-card">
        <div class="kpi-icon green"><i class="bi bi-cash-coin"></i></div>
        <div class="kpi-label">Total Transaction Volume</div>
        <div class="kpi-value">৳@Model.TotalTransactionVolume.ToString("N0")</div>
        <div class="kpi-trend up"><i class="bi bi-arrow-up-short"></i> 18.6% from last month</div>
    </a>

</div>

<div class="health-grid">

    <div class="panel">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="panel-title">Platform Health Overview</div>
            <select style="height:34px; padding:0 10px; border-radius:8px; border:1px solid #dde1f0; font-family:'Inter',sans-serif; font-size:12.5px;">
                <option>This Week</option>
                <option>This Month</option>
            </select>
        </div>

        <div class="chart-legend">
            <span class="chart-legend-item"><span class="chart-legend-dot" style="background:#a326ff;"></span> Verifications</span>
            <span class="chart-legend-item"><span class="chart-legend-dot" style="background:#236eff;"></span> Proof Reviews</span>
            <span class="chart-legend-item"><span class="chart-legend-dot" style="background:#e34848;"></span> Payments</span>
        </div>

        <svg viewBox="0 0 660 240" style="width:100%; height:auto; margin-top:10px;">
            <line x1="20" y1="20" x2="640" y2="20" stroke="#f2f3fa" stroke-width="1" />
            <line x1="20" y1="60" x2="640" y2="60" stroke="#f2f3fa" stroke-width="1" />
            <line x1="20" y1="100" x2="640" y2="100" stroke="#f2f3fa" stroke-width="1" />
            <line x1="20" y1="140" x2="640" y2="140" stroke="#f2f3fa" stroke-width="1" />
            <line x1="20" y1="180" x2="640" y2="180" stroke="#f2f3fa" stroke-width="1" />
            <line x1="20" y1="220" x2="640" y2="220" stroke="#dde1f0" stroke-width="1" />

            <text x="8" y="24" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="end">250</text>
            <text x="8" y="64" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="end">200</text>
            <text x="8" y="104" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="end">150</text>
            <text x="8" y="144" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="end">100</text>
            <text x="8" y="184" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="end">50</text>
            <text x="8" y="224" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="end">0</text>

            <polyline points="20,120 120,100 220,120 320,76 420,96 520,68 620,84" fill="none" stroke="#a326ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <polyline points="20,160 120,152 220,164 320,136 420,144 520,132 620,136" fill="none" stroke="#236eff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <polyline points="20,216 120,212 220,217 320,204 420,208 520,201 620,204" fill="none" stroke="#e34848" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

            @foreach (var pt in new[] { (20,120),(120,100),(220,120),(320,76),(420,96),(520,68),(620,84) })
            {
                <circle cx="@pt.Item1" cy="@pt.Item2" r="3.5" fill="#a326ff" />
            }
            @foreach (var pt in new[] { (20,160),(120,152),(220,164),(320,136),(420,144),(520,132),(620,136) })
            {
                <circle cx="@pt.Item1" cy="@pt.Item2" r="3.5" fill="#236eff" />
            }
            @foreach (var pt in new[] { (20,216),(120,212),(220,217),(320,204),(420,208),(520,201),(620,204) })
            {
                <circle cx="@pt.Item1" cy="@pt.Item2" r="3.5" fill="#e34848" />
            }

            <text x="20" y="236" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="middle">@DateTime.Now.AddDays(-6).ToString("MMM d")</text>
            <text x="120" y="236" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="middle">@DateTime.Now.AddDays(-5).ToString("MMM d")</text>
            <text x="220" y="236" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="middle">@DateTime.Now.AddDays(-4).ToString("MMM d")</text>
            <text x="320" y="236" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="middle">@DateTime.Now.AddDays(-3).ToString("MMM d")</text>
            <text x="420" y="236" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="middle">@DateTime.Now.AddDays(-2).ToString("MMM d")</text>
            <text x="520" y="236" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="middle">@DateTime.Now.AddDays(-1).ToString("MMM d")</text>
            <text x="620" y="236" font-family="Inter, sans-serif" font-size="10" fill="#8189a8" text-anchor="middle">@DateTime.Now.ToString("MMM d")</text>
        </svg>

        <div style="margin-top:6px;">
            <div class="health-stat-row"><span class="health-stat-label">New Users (This Week)</span><span><span class="health-stat-value">842</span><span class="health-stat-delta">↑ 11.2%</span></span></div>
            <div class="health-stat-row"><span class="health-stat-label">Verifications Completed</span><span><span class="health-stat-value">198</span><span class="health-stat-delta">↑ 9.4%</span></span></div>
            <div class="health-stat-row"><span class="health-stat-label">Proofs Approved</span><span><span class="health-stat-value">112</span><span class="health-stat-delta">↑ 14.7%</span></span></div>
            <div class="health-stat-row"><span class="health-stat-label">Disputes Resolved</span><span><span class="health-stat-value">17</span><span class="health-stat-delta">↑ 21.3%</span></span></div>
            <div class="health-stat-row"><span class="health-stat-label">Payments Completed</span><span><span class="health-stat-value">৳1,985,200</span><span class="health-stat-delta">↑ 16.8%</span></span></div>
        </div>
    </div>

    <div>
        <div class="panel">
            <div class="panel-title">Quick Shortcuts</div>
            <div class="quick-shortcut-grid">

                <a href="/Admin/AdminUserVerification/Index?status=Pending" class="quick-shortcut purple">
                    Verify User
                    <i class="bi bi-arrow-right quick-shortcut-arrow"></i>
                </a>

                <a href="/Admin/AdminProofReview/Index?status=Submitted" class="quick-shortcut blue">
                    Review Proof
                    <i class="bi bi-arrow-right quick-shortcut-arrow"></i>
                </a>

                <a href="/Admin/AdminDisputes/Index?status=Open" class="quick-shortcut red">
                    Resolve Dispute
                    <i class="bi bi-arrow-right quick-shortcut-arrow"></i>
                </a>

                <a href="/Admin/AdminPayments/Index" class="quick-shortcut green">
                    View Payments
                    <i class="bi bi-arrow-right quick-shortcut-arrow"></i>
                </a>

                <a href="#" class="quick-shortcut purple" style="opacity:.55; cursor:default;">
                    System Logs
                    <i class="bi bi-arrow-right quick-shortcut-arrow"></i>
                </a>

                <a href="#" class="quick-shortcut orange" style="opacity:.55; cursor:default;">
                    Generate Report
                    <i class="bi bi-arrow-right quick-shortcut-arrow"></i>
                </a>

            </div>
        </div>

        <div class="panel" style="margin-top:20px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div class="panel-title">Alerts &amp; Flags</div>
                <a href="#" style="font-family:'Inter',sans-serif; font-size:12px; font-weight:600; color:#6b52d8;">View All</a>
            </div>

            <div style="margin-top:6px;">
                <div class="alert-row"><span class="alert-label">High priority disputes</span><span class="alert-count red">5</span></div>
                <div class="alert-row"><span class="alert-label">Overdue proof reviews</span><span class="alert-count orange">12</span></div>
                <div class="alert-row"><span class="alert-label">Payment failures</span><span class="alert-count red">3</span></div>
                <div class="alert-row"><span class="alert-label">Users flagged for review</span><span class="alert-count orange">7</span></div>
            </div>
        </div>

    </div>

</div>

<div class="panel" style="margin-top:20px;">
    <div style="display:flex; justify-content:space-between; align-items:center;">
        <div class="panel-title">Recent Activity Feed</div>
        <a href="#" style="font-family:'Inter',sans-serif; font-size:12px; font-weight:600; color:#6b52d8;">View All Activity <i class="bi bi-arrow-right"></i></a>
    </div>

    @{
        // Always show the dummy activity feed during this design pass for consistency
        // (see AdminUserVerification/Index.cshtml for the same fix and why).
        // TODO: switch to Model.RecentActivity once this page's backend is wired up.
    }
    @if (true)
    {
        <div style="margin-top:8px;">
            <div class="activity-row">
                <span class="activity-dot" style="background:#a326ff;"></span>
                <div>
                    <div class="activity-title">Brand verification submitted</div>
                    <div class="activity-sub">GlowUp Skincare Ltd. has submitted verification request</div>
                </div>
                <div class="activity-meta"><span class="status-pill blue">Verification</span><span class="activity-time">10:30 AM</span></div>
            </div>
            <div class="activity-row">
                <span class="activity-dot" style="background:#236eff;"></span>
                <div>
                    <div class="activity-title">Proof submitted for review</div>
                    <div class="activity-sub">Priya Islam submitted proof for Milestone 2 &mdash; Glow Naturally Campaign</div>
                </div>
                <div class="activity-meta"><span class="status-pill blue">Proof Review</span><span class="activity-time">10:15 AM</span></div>
            </div>
            <div class="activity-row">
                <span class="activity-dot" style="background:#e34848;"></span>
                <div>
                    <div class="activity-title">Dispute raised</div>
                    <div class="activity-sub">Case #DIS-2025-015 raised by GlowUp Skincare vs Priya Islam</div>
                </div>
                <div class="activity-meta"><span class="status-pill red">Dispute</span><span class="activity-time">09:45 AM</span></div>
            </div>
            <div class="activity-row">
                <span class="activity-dot" style="background:#0d9c6c;"></span>
                <div>
                    <div class="activity-title">Payment completed</div>
                    <div class="activity-sub">Payment of ৳35,000 released to Afsana Mim</div>
                </div>
                <div class="activity-meta"><span class="status-pill green">Payment</span><span class="activity-time">09:20 AM</span></div>
            </div>
            <div class="activity-row">
                <span class="activity-dot" style="background:#a326ff;"></span>
                <div>
                    <div class="activity-title">User verified</div>
                    <div class="activity-sub">Rahim's Tech Store has been verified as a brand</div>
                </div>
                <div class="activity-meta"><span class="status-pill blue">Verification</span><span class="activity-time">09:10 AM</span></div>
            </div>
        </div>
        <div class="panel-sub" style="margin-top:14px;">Showing latest 5 activities (dummy data — real activity feed to be wired in)</div>
    }
    else
    {
        <div class="admin-table-wrap" style="margin-top: 18px;">
            <table class="admin-table">
                <thead>
                    <tr><th>Activity</th><th>Type</th><th>Status</th><th>Date</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentActivity)
                    {
                        <tr onclick="window.location='@item.Url'" style="cursor:pointer;">
                            <td>@item.Title</td>
                            <td>@item.Category</td>
                            <td><span class="status-pill @item.StatusColor">@item.StatusLabel</span></td>
                            <td>@item.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
