        width: 44px; height: 44px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 19px; margin-bottom: 14px;
    }
    .kpi-icon.purple { background: #f1e6ff; color: #8b2ff2; }
