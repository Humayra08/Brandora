    @@media(max-width: 1100px) { .side-panels-row { grid-template-columns: 1fr; } }

    .activity-row { display: flex; align-items: flex-start; gap: 12px; padding: 13px 0; border-bottom: 1px solid #f2f3fa; }
    .activity-row:last-child { border-bottom: none; }
    .activity-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
    .activity-icon.purple { background: #f1e6ff; color: #8b2ff2; }
    .activity-icon.blue { background: #e3f0ff; color: #1a73d8; }
    .activity-icon.red { background: #fde3e3; color: #e34848; }
    .activity-icon.green { background: #dff7ec; color: #0d9c6c; }
    .activity-title { font-family: 'Inter', sans-serif; font-size: 13.5px; font-weight: 700; color: #2a3157; }
    .activity-sub { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 12.5px; color: #8189a8; }
    .activity-time { margin-left: auto; flex-shrink: 0; font-family: 'Inter', sans-serif; font-size: 12px; color: #8189a8; white-space: nowrap; }

    .campaign-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f2f3fa; }
    .campaign-row:last-child { border-bottom: none; }
    .campaign-thumb { width: 38px; height: 38px; border-radius: 10px; object-fit: cover; flex-shrink: 0; background: #eef1fb; }
    .campaign-title { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; color: #2a3157; }
    .campaign-sub { margin-top: 2px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; }
    .campaign-meta { margin-left: auto; text-align: right; flex-shrink: 0; }
    .campaign-meta-label { font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; }

    /* ==============================
       CHART SYSTEM — Payment Flow / Brandora Pulse / Funnel
    ============================== */

    .chart-wrap { position: relative; }

    .chart-svg .grid-line { stroke: #f2f3fa; stroke-width: 1; }
    .chart-svg .axis-label { font-family: 'Inter', sans-serif; font-size: 10px; fill: #8189a8; }

    .chart-line { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
    .chart-line.draw-anim { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw-line 1.15s cubic-bezier(.22,1,.36,1) forwards; }

    .chart-area { opacity: 0; animation: chart-fade-in .7s ease .85s forwards; }

    .chart-point { r: 3.5; cursor: pointer; transition: r .15s ease; }
    .chart-point:hover, .chart-point.is-hovered { r: 5; }

    .chart-pulse-ring { transform-origin: center; transform-box: fill-box; animation: pulse-ring 2.2s ease-out infinite; }
    .chart-pulse-dot { animation: pulse-dot 2.2s ease-out infinite; }

    @@keyframes draw-line { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @@keyframes chart-fade-in { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes pulse-ring { 0% { opacity: .45; transform: scale(1); } 100% { opacity: 0; transform: scale(2.6); } }
    @@keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: .7; } }

    .pulse-line { stroke-width: 2; fill: none; stroke-linecap: round; opacity: .5; transition: opacity .18s ease, stroke-width .18s ease; }
    .pulse-line.is-active { opacity: 1; stroke-width: 2.75; }
    .pulse-line.draw-anim { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw-line 1.3s cubic-bezier(.22,1,.36,1) forwards; }

    .tracker-line { stroke: #c3c8dd; stroke-width: 1; opacity: 0; transition: opacity .12s ease; pointer-events: none; }
    .tracker-hit { fill: transparent; cursor: crosshair; }

    .chart-tooltip {
        position: absolute;
        z-index: 20;
        min-width: 150px;
        padding: 10px 13px;
        border-radius: 12px;
        border: 1px solid #eaecf5;
        background: rgba(255,255,255,.86);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 14px 34px rgba(30,34,90,.14);
        font-family: 'Inter', sans-serif;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -8px) scale(.96);
        transition: opacity .15s ease, transform .15s ease;
    }
    .chart-tooltip.is-visible { opacity: 1; transform: translate(-50%, -14px) scale(1); }
    .chart-tooltip-title { font-size: 11.5px; font-weight: 700; color: #171d3d; margin-bottom: 4px; }
    .chart-tooltip-row { display: flex; justify-content: space-between; gap: 14px; font-size: 11.5px; color: #6b7290; padding: 1.5px 0; }
    .chart-tooltip-row b { color: #2a3157; font-weight: 700; }

    /* Campaign Lifecycle Funnel */

    .funnel-panel { margin-top: 20px; }
    .funnel-rows { margin-top: 18px; display: flex; flex-direction: column; gap: 12px; }
    .funnel-row { display: flex; align-items: center; gap: 16px; }
    .funnel-track { flex: 1; height: 40px; border-radius: 10px; background: #f6f7fb; overflow: hidden; }
    .funnel-band {
        height: 100%;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 16px;
        background:
            linear-gradient(180deg, rgba(255,255,255,.4), rgba(255,255,255,0) 45%),
            linear-gradient(105deg, #8b6bff, #5b8dff, #4fc3ff);
        border: 1px solid rgba(255,255,255,.35);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 6px 16px rgba(91,141,255,.22);
        transform: scaleX(0);
        transform-origin: left;
        animation: funnel-grow .65s cubic-bezier(.22,1,.36,1) forwards;
    }
    .funnel-row:nth-child(1) .funnel-band { animation-delay: .05s; }
    .funnel-row:nth-child(2) .funnel-band { animation-delay: .2s; }
    .funnel-row:nth-child(3) .funnel-band { animation-delay: .35s; }
    .funnel-row:nth-child(4) .funnel-band { animation-delay: .5s; }
    .funnel-row:nth-child(5) .funnel-band { animation-delay: .65s; }
    @@keyframes funnel-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .funnel-band-label { font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 700; color: #ffffff; white-space: nowrap; }
    .funnel-band-value { font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 800; color: #ffffff; white-space: nowrap; }
    .funnel-conversion { width: 74px; flex-shrink: 0; text-align: right; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #8189a8; }
    .funnel-conversion b { color: #0d9c6c; }

    /* CSS-only tooltip (used by Payment Status Flow + Attention Heatmap) */

    [data-tip] { position: relative; }
    [data-tip]::after {
        content: attr(data-tip);
        position: absolute;
        bottom: calc(100% + 9px);
        left: 50%;
        transform: translateX(-50%) scale(.94);
        opacity: 0;
        pointer-events: none;
        background: rgba(23,29,61,.94);
        color: #fff;
        padding: 7px 11px;
        border-radius: 8px;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
        z-index: 30;
        transition: opacity .15s ease, transform .15s ease;
    }
    [data-tip]:hover::after { opacity: 1; transform: translateX(-50%) scale(1); }

    /* Creator x Brand Marketplace Balance */

    .balance-panel-body { display: flex; align-items: center; gap: 26px; margin-top: 14px; flex-wrap: wrap; }
    .balance-ring-wrap { position: relative; width: 180px; height: 180px; flex-shrink: 0; }
    .balance-ring-svg { width: 100%; height: 100%; }
    .balance-ring-arc { fill: none; stroke-width: 15; stroke-linecap: round; transition: stroke-width .15s ease, opacity .15s ease; cursor: pointer; }
    .balance-ring-arc.draw-anim { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw-line 1.1s cubic-bezier(.22,1,.36,1) forwards; }
    .balance-ring-arc:hover { stroke-width: 19; }
    .balance-ring-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; pointer-events: none; }
    .balance-ring-value { font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: 25px; color: #171d3d; }
    .balance-ring-label { font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; margin-top: 2px; }

    .balance-legend { display: flex; flex-direction: column; gap: 10px; }
    .balance-legend-item { display: flex; align-items: center; gap: 9px; font-family: 'Inter', sans-serif; font-size: 13px; color: #2a3157; }
    .balance-legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .balance-legend-item b { margin-left: auto; font-weight: 700; }

    .balance-stats { display: flex; flex-direction: column; gap: 10px; margin-left: auto; }
    .balance-stat-card { padding: 12px 16px; border-radius: 12px; border: 1px solid #dce7ff; background: #fafbff; font-family: 'Inter', sans-serif; }
    .balance-stat-value { font-weight: 800; font-size: 15px; color: #0d9c6c; }
    .balance-stat-label { margin-top: 2px; font-size: 11.5px; color: #8189a8; }

    /* Payment Status Flow */

    .flow-track-scroll { margin-top: 18px; overflow-x: auto; overflow-y: hidden; padding-bottom: 4px; }
    .flow-track-scroll::-webkit-scrollbar { height: 6px; }
    .flow-track-scroll::-webkit-scrollbar-thumb { background: #dde1f0; border-radius: 6px; }
    .flow-track-scroll::-webkit-scrollbar-track { background: transparent; }

    .flow-track { height: 46px; min-width: 480px; border-radius: 12px; overflow: hidden; display: flex; background: #f6f7fb; }
    .flow-segment {
        height: 100%;
        flex-basis: 0;
        min-width: 0;
        transform: scaleX(0);
        transform-origin: left;
        animation: funnel-grow .7s cubic-bezier(.22,1,.36,1) forwards;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: #ffffff;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        border: 1px solid rgba(255,255,255,.35);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.5);
        cursor: pointer;
    }
    .flow-segment.completed { background: linear-gradient(180deg, rgba(255,255,255,.4), rgba(255,255,255,0) 45%), linear-gradient(105deg, #8b6bff, #5b8dff); animation-delay: .05s; }
    .flow-segment.pending { background: linear-gradient(180deg, rgba(255,255,255,.5), rgba(255,255,255,0) 45%), #c9b8f2; animation-delay: .25s; color: #4a3a7a; }
    .flow-segment.flagged { background: linear-gradient(180deg, rgba(255,255,255,.5), rgba(255,255,255,0) 45%), #f3a6a6; animation-delay: .4s; color: #7a2020; }

    .flow-legend { display: flex; gap: 22px; margin-top: 14px; flex-wrap: wrap; }
    .flow-legend-item { font-family: 'Inter', sans-serif; font-size: 12.5px; color: #6b7290; }
    .flow-legend-item b { color: #171d3d; }
    .flow-legend-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; }

    /* Admin Attention Heatmap */

    .heatmap-grid {
        margin-top: 16px;
        display: grid; grid-template-columns: 96px repeat(7, 1fr); gap: 6px; align-items: center;
        padding: 10px;
        border-radius: 14px;
        background: radial-gradient(circle at 20% 10%, rgba(163,38,255,.05), transparent 50%), radial-gradient(circle at 80% 90%, rgba(24,169,255,.05), transparent 50%), #fafbff;
    }
    .heatmap-col-label { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; color: #8189a8; text-align: center; }
    .heatmap-row-label { font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; color: #2a3157; }
    .heatmap-cell {
        aspect-ratio: 1;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.7);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.6), 0 3px 10px rgba(139,43,242,.06);
        transition: transform .12s ease, box-shadow .12s ease;
        cursor: pointer;
    }
    .heatmap-cell:hover { transform: scale(1.08); box-shadow: inset 0 1px 0 rgba(255,255,255,.6), 0 6px 16px rgba(139,43,242,.16); }

    /* Campaign Category Orbit */

    .orbit-panel-body { display: flex; align-items: center; gap: 30px; margin-top: 14px; flex-wrap: wrap; }
    .orbit-wrap { position: relative; width: 220px; height: 220px; flex-shrink: 0; }
    .orbit-svg { width: 100%; height: 100%; }
    .orbit-arc { fill: none; stroke-width: 13; stroke-linecap: round; transition: stroke-width .15s ease; cursor: pointer; }
    .orbit-arc.draw-anim { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw-line 1.2s cubic-bezier(.22,1,.36,1) forwards; }
    .orbit-arc:hover { stroke-width: 17; }
    .orbit-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; pointer-events: none; }
    .orbit-center-value { font-family: 'DM Sans', sans-serif; font-weight: 800; font-size: 26px; color: #171d3d; }
    .orbit-center-label { font-family: 'Inter', sans-serif; font-size: 11.5px; color: #8189a8; margin-top: 2px; }

    .orbit-legend { display: grid; grid-template-columns: 1fr 1fr; gap: 9px 20px; }
    .orbit-legend-item { display: flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 12.5px; color: #2a3157; white-space: nowrap; }
    .orbit-legend-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .orbit-legend-item b { margin-left: auto; font-weight: 700; }

    .orbit-bars { display: none; margin-top: 16px; flex-direction: column; gap: 10px; }
    .orbit-bar-row { display: flex; align-items: center; gap: 10px; }
    .orbit-bar-label { width: 82px; flex-shrink: 0; font-family: 'Inter', sans-serif; font-size: 12px; color: #2a3157; }
    .orbit-bar-track { flex: 1; height: 8px; border-radius: 6px; background: #f0f1f8; overflow: hidden; }
    .orbit-bar-fill { height: 100%; border-radius: 6px; }
    .orbit-bar-pct { width: 36px; text-align: right; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 700; color: #2a3157; }

    @@media(max-width: 640px) {
        .orbit-panel-body { display: none; }
        .orbit-bars { display: flex; }
    }

    /* Platform Activity Stream */

    .stream-track { position: relative; margin-top: 26px; height: 4px; border-radius: 4px; background: #eef1fb; }
    .stream-dot { display: block; position: absolute; top: 50%; width: 8px; height: 8px; border-radius: 50%; transform: translate(-50%, -50%); cursor: pointer; transition: transform .15s ease; }
    .stream-dot:hover { transform: translate(-50%, -50%) scale(1.6); }
    .stream-dot.is-latest { animation: pulse-dot 2.2s ease-out infinite; }
    .stream-dot.is-latest::after {
        content: ''; position: absolute; inset: -6px; border-radius: 50%;
        border: 1.5px solid currentColor; opacity: .5;
        animation: pulse-ring 2.2s ease-out infinite;
    }
    .stream-axis { display: flex; justify-content: space-between; margin-top: 10px; font-family: 'Inter', sans-serif; font-size: 10.5px; color: #8189a8; }
    .stream-legend { display: flex; gap: 16px; margin-top: 16px; flex-wrap: wrap; }
    .stream-legend-item { display: flex; align-items: center; gap: 6px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: #6b7290; }
    .stream-legend-dot { width: 8px; height: 8px; border-radius: 50%; }

    /* Top Campaign Performance */

    .perf-rows { margin-top: 18px; display: flex; flex-direction: column; gap: 18px; }
    .perf-row-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .perf-name { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 13.5px; color: #171d3d; text-decoration: none; }
    .perf-name:hover { color: #7a1fd6; text-decoration: underline; }
    .perf-brand { margin-left: 6px; font-family: 'Inter', sans-serif; font-size: 12px; color: #8189a8; }
    .perf-metrics { display: flex; gap: 18px; font-family: 'Inter', sans-serif; font-size: 12px; color: #6b7290; }
    .perf-metrics b { color: #2a3157; }
    .perf-track { margin-top: 8px; height: 8px; border-radius: 6px; background: #f0f1f8; overflow: hidden; }
    .perf-fill {
        height: 100%; border-radius: 6px;
        background: linear-gradient(105deg, #8b6bff, #5b8dff, #4fc3ff);
        transform: scaleX(0); transform-origin: left;
    }
    .perf-fill.in-view { animation: funnel-grow .8s cubic-bezier(.22,1,.36,1) forwards; }

    /* Mini Sparklines (KPI cards) */

    .kpi-card { position: relative; }
    .kpi-card-body { display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; }
    .kpi-sparkline { width: 64px; height: 32px; flex-shrink: 0; opacity: .45; transition: opacity .18s ease; }
    .kpi-card:hover .kpi-sparkline { opacity: .9; }
    .kpi-sparkline path { fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

    @@media (prefers-reduced-motion: reduce) {
        .chart-line.draw-anim, .chart-area, .pulse-line.draw-anim, .funnel-band, .chart-pulse-ring, .chart-pulse-dot,
        .balance-ring-arc.draw-anim, .flow-segment, .orbit-arc.draw-anim, .stream-dot.is-latest, .perf-fill.in-view {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
            stroke-dashoffset: 0 !important;
        }
    }
</style>

