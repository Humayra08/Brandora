    .chart-legend-item.is-active { color: #2a3157; }
    .chart-legend-dot { width: 9px; height: 9px; border-radius: 50%; opacity: .55; transition: opacity .15s ease; }
    .chart-legend-item.is-active .chart-legend-dot { opacity: 1; }

    .panel-select { height:34px; padding:0 10px; border-radius:8px; border:1px solid #dde1f0; font-family:'Inter',sans-serif; font-size:12.5px; }

