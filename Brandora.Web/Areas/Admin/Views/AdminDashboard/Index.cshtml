@model Brandora.Web.Areas.Admin.Controllers.AdminDashboardViewModel
@{
    // NOTE: every chart below is wired to Model (real DB queries in AdminDashboardController).
    // The only genuinely-unavailable field is Reach/Engagement per campaign (Top Campaign Performance) —
    // those two columns are not tracked anywhere in the schema yet, so they render as "—" placeholders
    // rather than fabricated numbers, to be filled in once that data exists.
    var firstName = (ViewData["AdminName"] as string ?? "Administrator").Split(' ')[0];

    var pfMonths = Model.PaymentFlow.Select(p => p.Month).ToArray();
    var pfRevenue = Model.PaymentFlow.Select(p => (int)p.Revenue).ToArray();
    var pfCount = Model.PaymentFlow.Select(p => p.PaymentCount).ToArray();
    var pfChangePct = Model.PaymentFlow.Select(p => p.ChangePct).ToArray();

    var bpMonths = Model.BrandoraPulse.Select(p => p.Month).ToArray();
    var bpUsers = Model.BrandoraPulse.Select(p => p.NewUsers).ToArray();
    var bpCampaigns = Model.BrandoraPulse.Select(p => p.NewCampaigns).ToArray();
    var bpCollabs = Model.BrandoraPulse.Select(p => p.CompletedCollaborations).ToArray();

    var funnel = Model.Funnel.Select(f => (f.Label, f.Value)).ToArray();

    static string BuildSmoothPath(List<(double x, double y)> pts)
    {
        if (pts.Count == 0) return "";
        var sb = new System.Text.StringBuilder();
        sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M{pts[0].x},{pts[0].y}");
        for (int i = 0; i < pts.Count - 1; i++)
        {
            var p0 = pts[i];
            var p1 = pts[i + 1];
            var cx1 = p0.x + (p1.x - p0.x) / 3;
            var cx2 = p0.x + (p1.x - p0.x) * 2 / 3;
            sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" C{cx1},{p0.y} {cx2},{p1.y} {p1.x},{p1.y}");
        }
        return sb.ToString();
    }

    // Payment Flow geometry (viewBox 0 0 660 220, plot area x:20-640, y:20-200)
    var pfMax = Math.Max(pfRevenue.DefaultIfEmpty(0).Max(), 1);
    var pfPts = new List<(double x, double y)>();
    for (int i = 0; i < pfMonths.Length; i++)
    {
        var x = 20 + i * (620.0 / (pfMonths.Length - 1));
        var y = 200 - (pfRevenue[i] / (double)pfMax) * 170;
        pfPts.Add((Math.Round(x, 1), Math.Round(y, 1)));
    }
    var pfLinePath = BuildSmoothPath(pfPts);
    var pfAreaPath = pfLinePath + $" L{pfPts[^1].x},200 L{pfPts[0].x},200 Z";

    // Brandora Pulse geometry
    var bpMax = Math.Max(new[] { bpUsers.DefaultIfEmpty(0).Max(), bpCampaigns.DefaultIfEmpty(0).Max(), bpCollabs.DefaultIfEmpty(0).Max() }.Max(), 1);
    List<(double x, double y)> BpPoints(int[] series)
    {
        var pts = new List<(double x, double y)>();
        for (int i = 0; i < bpMonths.Length; i++)
        {
            var x = 20 + i * (620.0 / (bpMonths.Length - 1));
            var y = 200 - (series[i] / (double)bpMax) * 170;
            pts.Add((Math.Round(x, 1), Math.Round(y, 1)));
        }
        return pts;
    }
    var bpUsersPts = BpPoints(bpUsers);
    var bpCampaignsPts = BpPoints(bpCampaigns);
    var bpCollabsPts = BpPoints(bpCollabs);

    var funnelMax = funnel.Length == 0 ? 1 : Math.Max(funnel.Max(f => f.Value), 1);

    // ---- Marketplace Balance (split-ring), from real user counts ----
    var mbTotal = Model.TotalUsers;
    var mbTotalForPct = Math.Max(mbTotal, 1);
    var mbSegments = new (string Label, decimal Pct, string Color)[]
    {
        ("Influencers", Math.Round(Model.InfluencerCount / (decimal)mbTotalForPct * 100, 1), "#8b6bff"),
        ("Brands", Math.Round(Model.BrandCount / (decimal)mbTotalForPct * 100, 1), "#4fc3ff"),
        ("Other", Math.Round(Model.OtherUserCount / (decimal)mbTotalForPct * 100, 1), "#c9b8f2")
    };

    static string BuildRingArc(double cx, double cy, double r, double startDeg, double sweepDeg)
    {
        double ToRad(double d) => d * Math.PI / 180.0;
        var endDeg = startDeg + sweepDeg;
        var x1 = cx + r * Math.Sin(ToRad(startDeg));
        var y1 = cy - r * Math.Cos(ToRad(startDeg));
        var x2 = cx + r * Math.Sin(ToRad(endDeg));
        var y2 = cy - r * Math.Cos(ToRad(endDeg));
        var largeArc = sweepDeg > 180 ? 1 : 0;
        return string.Format(System.Globalization.CultureInfo.InvariantCulture, "M{0:0.##},{1:0.##} A{2:0.##},{2:0.##} 0 {3},1 {4:0.##},{5:0.##}", x1, y1, r, largeArc, x2, y2);
    }

    var mbGapDeg = 4.0;
    var mbArcs = new List<(string Path, string Color, string Label, decimal Pct)>();
    {
        double cursor = 0;
        foreach (var seg in mbSegments)
        {
            var sweep = (double)(seg.Pct / 100m) * 360.0;
            var path = BuildRingArc(90, 90, 74, cursor + mbGapDeg / 2, Math.Max(sweep - mbGapDeg, 1));
            mbArcs.Add((path, seg.Color, seg.Label, seg.Pct));
            cursor += sweep;
        }
    }

    // ---- Payment Status Flow, from real Payment rows grouped by Status ----
    var psCompleted = Model.PaymentStatusFlow.FirstOrDefault(p => p.Label == "Completed")?.Amount ?? 0m;
    var psPending = Model.PaymentStatusFlow.FirstOrDefault(p => p.Label == "Pending")?.Amount ?? 0m;
    var psFlagged = Model.PaymentStatusFlow.FirstOrDefault(p => p.Label == "Failed")?.Amount ?? 0m;
    var psCompletedCount = Model.PaymentStatusFlow.FirstOrDefault(p => p.Label == "Completed")?.Count ?? 0;
    var psPendingCount = Model.PaymentStatusFlow.FirstOrDefault(p => p.Label == "Pending")?.Count ?? 0;
    var psFlaggedCount = Model.PaymentStatusFlow.FirstOrDefault(p => p.Label == "Failed")?.Count ?? 0;
    var psTotal = Math.Max(psCompleted + psPending + psFlagged, 1m);

    // ---- Admin Attention Heatmap, from real pending-item creation dates this week ----
    var heatmapDays = Model.HeatmapDays;
    var heatmapRows = Model.Heatmap.Select(r => (r.Label, r.Values)).ToArray();
    var heatmapMax = Math.Max(heatmapRows.SelectMany(r => r.Values).DefaultIfEmpty(0).Max(), 1);

    // ---- Campaign Category Orbit, from real Campaign.Niche grouping ----
    var orbitTotal = Model.CategoryOrbitTotal;
    var orbitPalette = new[] { "#8b6bff", "#a78bff", "#5b8dff", "#4fc3ff", "#7fd4ff", "#c9b8f2" };
    var orbitCategories = Model.CategoryOrbit
        .Select((c, i) => (Label: c.Label, Pct: c.Pct, Color: orbitPalette[i % orbitPalette.Length]))
        .ToArray();
    var orbitGapDeg = 3.0;
    var orbitArcs = new List<(string Path, string Color, string Label, decimal Pct)>();
    {
        double cursor = 0;
        foreach (var cat in orbitCategories)
        {
            var sweep = (double)(cat.Pct / 100m) * 360.0;
            var path = BuildRingArc(110, 110, 88, cursor + orbitGapDeg / 2, Math.Max(sweep - orbitGapDeg, 1));
            orbitArcs.Add((path, cat.Color, cat.Label, cat.Pct));
            cursor += sweep;
        }
    }

    // ---- Platform Activity Stream, from real events in the last 24h ----
    var streamTypeColors = new Dictionary<string, string>
    {
        ["signup"] = "#8b2ff2",
        ["campaign"] = "#236eff",
        ["proof"] = "#18a9ff",
        ["payment"] = "#0d9c6c",
        ["dispute"] = "#e34848"
    };
    var streamEvents = Model.ActivityStream
        .Select(e => (e.HourAgo, e.Type, e.Label, e.Url, Color: streamTypeColors.GetValueOrDefault(e.Type, "#8189a8")))
        .ToArray();

    // ---- Top Campaign Performance, from real Milestone completion per campaign ----
    // Reach/Engagement have no backing schema field yet — rendered as "—" placeholders, not fabricated.
    var topCampaigns = Model.TopCampaigns
        .Select(c => (c.Name, c.Brand, c.Url, CompletionPct: c.CompletionPct ?? 0))
        .ToArray();

    // ---- Mini Sparkline series (last 7 days, real daily counts) ----
    var sparkUsers = Model.SparkUsers;
    var sparkCampaigns = Model.SparkCampaigns;
    var sparkVerifications = Model.SparkVerifications;
    var sparkDisputes = Model.SparkDisputes;
    var sparkPayments = Model.SparkPayments;

    static string BuildSparklinePath(int[] values, double w, double h)
    {
        var max = values.Max();
        var min = values.Min();
        var range = Math.Max(max - min, 1);
        var pts = new List<(double x, double y)>();
        for (int i = 0; i < values.Length; i++)
        {
            var x = i * (w / (values.Length - 1));
            var y = h - ((values[i] - min) / (double)range) * h;
            pts.Add((Math.Round(x, 1), Math.Round(y, 1)));
        }
        return BuildSmoothPath(pts);
    }
}

<style>
    .hero-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;
