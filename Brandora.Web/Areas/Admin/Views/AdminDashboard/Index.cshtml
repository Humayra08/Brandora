        line-height: 1.25;
        color: #2a3157;
        text-align: center;
        transform: rotate(-4deg);
    }
    .hero-motto span { display: block; width: 60px; height: 4px; margin: 10px auto 0; background: linear-gradient(110deg,#a326ff,#236eff); border-radius: 4px; }

    .hero-date { position: relative; z-index: 2; margin-left: auto; display: flex; align-items: flex-start; gap: 12px; padding-left: 24px; }
