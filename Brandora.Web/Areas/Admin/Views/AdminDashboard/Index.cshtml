<div class="health-grid">

    <!-- ============ PAYMENT FLOW ============ -->
    <div class="panel">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="panel-title">Payment Flow</div>
            <select class="panel-select" id="pfPeriodSelect">
                <option>This Month</option>
                <option>This Week</option>
            </select>
        </div>
        <div class="kpi-value" id="pfTotalValue" data-target="@pfRevenue.Sum()" style="margin-top:10px;">৳0</div>
        @Html.Raw(Trend(Model.PaymentFlow.LastOrDefault()?.ChangePct, "from last month"))

        <div class="chart-wrap" id="pfChartWrap">
            <svg class="chart-svg" viewBox="0 0 660 220" style="width:100%; height:auto; margin-top:14px;" id="pfSvg">
                <defs>
                    <linearGradient id="pfAreaGradient" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#236eff" stop-opacity=".22" />
                        <stop offset="100%" stop-color="#236eff" stop-opacity="0" />
                    </linearGradient>
                </defs>

                <line class="grid-line" x1="20" y1="20" x2="640" y2="20" />
                <line class="grid-line" x1="20" y1="66" x2="640" y2="66" />
                <line class="grid-line" x1="20" y1="112" x2="640" y2="112" />
                <line class="grid-line" x1="20" y1="158" x2="640" y2="158" />
                <line class="grid-line" x1="20" y1="200" x2="640" y2="200" style="stroke:#dde1f0;" />

                <path class="chart-area" d="@pfAreaPath" fill="url(#pfAreaGradient)" />
                <path class="chart-line draw-anim" pathLength="1" d="@pfLinePath" stroke="#236eff" />

                @{
                    var pfDotsMarkup = new System.Text.StringBuilder();
                    for (int i = 0; i < pfPts.Count; i++)
                    {
                        var (x, y) = pfPts[i];
                        var isLast = i == pfPts.Count - 1;
                        if (isLast)
                        {
                            pfDotsMarkup.Append(System.Globalization.CultureInfo.InvariantCulture, $"<circle class=\"chart-pulse-ring\" cx=\"{x}\" cy=\"{y}\" r=\"6\" fill=\"none\" stroke=\"#236eff\" stroke-width=\"2\"></circle>");
                        }
                        var changeLabel = pfChangePct[i] >= 0 ? $"+{pfChangePct[i]:0.0}%" : $"{pfChangePct[i]:0.0}%";
                        pfDotsMarkup.Append(System.Globalization.CultureInfo.InvariantCulture,
                            $"<circle class=\"chart-point{(isLast ? " chart-pulse-dot" : "")}\" cx=\"{x}\" cy=\"{y}\" fill=\"#236eff\" stroke=\"#ffffff\" stroke-width=\"1.5\" " +
                            $"data-month=\"{pfMonths[i]}\" data-revenue=\"৳{pfRevenue[i]:N0}\" data-count=\"{pfCount[i]}\" data-change=\"{changeLabel}\"></circle>");
                    }
                }
                @Html.Raw(pfDotsMarkup.ToString())

                @{
                    var pfLabelsMarkup = new System.Text.StringBuilder();
                    for (int i = 0; i < pfMonths.Length; i++)
                    {
                        pfLabelsMarkup.Append(System.Globalization.CultureInfo.InvariantCulture, $"<text class=\"axis-label\" x=\"{pfPts[i].x}\" y=\"216\" text-anchor=\"middle\">{pfMonths[i]}</text>");
                    }
                }
                @Html.Raw(pfLabelsMarkup.ToString())
            </svg>

            <div class="chart-tooltip" id="pfTooltip"></div>
        </div>
    </div>

    <!-- ============ BRANDORA PULSE ============ -->
    <div class="panel">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="panel-title">Brandora Pulse</div>
            <select class="panel-select">
                <option>Last 7 Months</option>
                <option>Last Year</option>
            </select>
        </div>

        <div class="chart-legend" style="margin-top:12px;" id="bpLegend">
            <span class="chart-legend-item is-active" data-series="users"><span class="chart-legend-dot" style="background:#a326ff;"></span> New Users</span>
            <span class="chart-legend-item is-active" data-series="campaigns"><span class="chart-legend-dot" style="background:#236eff;"></span> Active Campaigns</span>
            <span class="chart-legend-item is-active" data-series="collabs"><span class="chart-legend-dot" style="background:#0d9c6c;"></span> Completed Collabs</span>
        </div>

        <div class="chart-wrap" id="bpChartWrap">
            <svg class="chart-svg" viewBox="0 0 660 220" style="width:100%; height:auto; margin-top:14px;" id="bpSvg">
                <line class="grid-line" x1="20" y1="20" x2="640" y2="20" />
                <line class="grid-line" x1="20" y1="66" x2="640" y2="66" />
                <line class="grid-line" x1="20" y1="112" x2="640" y2="112" />
                <line class="grid-line" x1="20" y1="158" x2="640" y2="158" />
                <line class="grid-line" x1="20" y1="200" x2="640" y2="200" style="stroke:#dde1f0;" />

                <path class="pulse-line draw-anim" data-series="users" pathLength="1" d="@BuildSmoothPath(bpUsersPts)" stroke="#a326ff" />
                <path class="pulse-line draw-anim" data-series="campaigns" pathLength="1" d="@BuildSmoothPath(bpCampaignsPts)" stroke="#236eff" style="animation-delay:.08s;" />
                <path class="pulse-line draw-anim" data-series="collabs" pathLength="1" d="@BuildSmoothPath(bpCollabsPts)" stroke="#0d9c6c" style="animation-delay:.16s;" />

                <line class="tracker-line" id="bpTracker" x1="20" y1="20" x2="20" y2="200" />

                @{
                    var bpLabelsMarkup = new System.Text.StringBuilder();
                    for (int i = 0; i < bpMonths.Length; i++)
                    {
                        bpLabelsMarkup.Append(System.Globalization.CultureInfo.InvariantCulture, $"<text class=\"axis-label\" x=\"{bpUsersPts[i].x}\" y=\"216\" text-anchor=\"middle\">{bpMonths[i]}</text>");
                    }
                }
                @Html.Raw(bpLabelsMarkup.ToString())

                <rect class="tracker-hit" id="bpTrackerHit" x="20" y="10" width="620" height="200" />
            </svg>

            <div class="chart-tooltip" id="bpTooltip"></div>
        </div>
    </div>

</div>

<!-- ============ CAMPAIGN LIFECYCLE FUNNEL ============ -->
<div class="panel funnel-panel">
    <div class="panel-title">Campaign Lifecycle</div>
    <div class="panel-sub">Created &rarr; Applications &rarr; Collaborations &rarr; Proof Submitted &rarr; Completed</div>

    <div class="funnel-rows">
        @{
            for (int i = 0; i < funnel.Length; i++)
            {
                var (label, value) = funnel[i];
                var widthPct = Math.Max(18, (int)Math.Round(value / (double)funnelMax * 100));
                var conversion = (i == 0 || funnel[i - 1].Value == 0) ? (decimal?)null : Math.Round(value / (decimal)funnel[i - 1].Value * 100, 1);
                <div class="funnel-row">
                    <div class="funnel-track">
                        <div class="funnel-band" style="width:@(widthPct)%;">
                            <span class="funnel-band-label">@label</span>
                            <span class="funnel-band-value">@value.ToString("N0")</span>
                        </div>
                    </div>
                    <div class="funnel-conversion">
                        @if (conversion.HasValue)
                        {
                            <span><b>@conversion.Value.ToString("0.#")%</b></span>
                        }
                        else
                        {
                            <span>&mdash;</span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- ============ PAYMENT STATUS FLOW ============ -->
<div class="panel funnel-panel">
    <div class="panel-title">Payment Status Flow</div>
    <div class="panel-sub">৳@psTotal.ToString("N0") total processed this period</div>

    <div class="flow-track-scroll">
        <div class="flow-track">
            <div class="flow-segment completed" style="flex-grow:@psCompleted;"
                 data-tip="৳@psCompleted.ToString("N0") &middot; @psCompletedCount txns &middot; @(Math.Round(psCompleted / psTotal * 100, 1))%"></div>
            <div class="flow-segment pending" style="flex-grow:@psPending;"
                 data-tip="৳@psPending.ToString("N0") &middot; @psPendingCount txns &middot; @(Math.Round(psPending / psTotal * 100, 1))%"></div>
            <div class="flow-segment flagged" style="flex-grow:@psFlagged;"
                 data-tip="৳@psFlagged.ToString("N0") &middot; @psFlaggedCount txns &middot; @(Math.Round(psFlagged / psTotal * 100, 1))%"></div>
        </div>
    </div>

    <div class="flow-legend">
        <span class="flow-legend-item"><span class="flow-legend-dot" style="background:#5b8dff;"></span>Completed &middot; <b>৳@psCompleted.ToString("N0")</b></span>
        <span class="flow-legend-item"><span class="flow-legend-dot" style="background:#c9b8f2;"></span>Pending &middot; <b>৳@psPending.ToString("N0")</b></span>
        <span class="flow-legend-item"><span class="flow-legend-dot" style="background:#f3a6a6;"></span>Flagged &middot; <b>৳@psFlagged.ToString("N0")</b></span>
    </div>
</div>

<div class="side-panels-row">

    <!-- ============ CREATOR x BRAND MARKETPLACE BALANCE ============ -->
    <div class="panel">
        <div class="panel-title">Creator &times; Brand Marketplace Balance</div>

        <div class="balance-panel-body">
            <div class="balance-ring-wrap">
                <svg class="balance-ring-svg" viewBox="0 0 180 180">
                    @{
                        var mbArcMarkup = new System.Text.StringBuilder();
                        for (int i = 0; i < mbArcs.Count; i++)
                        {
                            var arc = mbArcs[i];
                            mbArcMarkup.Append(System.Globalization.CultureInfo.InvariantCulture,
                                $"<path class=\"balance-ring-arc draw-anim\" pathLength=\"1\" style=\"animation-delay:{i * 0.15:0.00}s;\" d=\"{arc.Path}\" stroke=\"{arc.Color}\" data-tip=\"{arc.Label} {arc.Pct:0.#}%\"></path>");
                        }
                    }
                    @Html.Raw(mbArcMarkup.ToString())
                </svg>
                <div class="balance-ring-center">
                    <div class="balance-ring-value">@mbTotal.ToString("N0")</div>
                    <div class="balance-ring-label">Total Users</div>
                </div>
            </div>

            <div class="balance-legend">
                @foreach (var seg in mbSegments)
                {
                    <span class="balance-legend-item"><span class="balance-legend-dot" style="background:@seg.Color;"></span>@seg.Label <b>@seg.Pct.ToString("0.#")%</b></span>
                }
            </div>

            <div class="balance-stats">
                <div class="balance-stat-card">
                    <div class="balance-stat-value">+840</div>
                    <div class="balance-stat-label">creators this month</div>
                </div>
                <div class="balance-stat-card">
                    <div class="balance-stat-value">+320</div>
                    <div class="balance-stat-label">brands this month</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ ADMIN ATTENTION HEATMAP ============ -->
    <div class="panel">
        <div class="panel-title">Admin Attention Heatmap</div>
        <div class="panel-sub">Pending admin actions by day, this week</div>

        <div class="heatmap-grid">
            <div></div>
            @foreach (var day in heatmapDays)
            {
                <div class="heatmap-col-label">@day</div>
            }

            @foreach (var row in heatmapRows)
            {
                <div class="heatmap-row-label">@row.Label</div>
                for (int d = 0; d < heatmapDays.Length; d++)
                {
                    var val = row.Values[d];
                    var intensity = Math.Round(val / (double)heatmapMax, 2);
                    var ci = System.Globalization.CultureInfo.InvariantCulture;
                    var purpleAlpha = (0.10 + intensity * 0.48).ToString("0.00", ci);
                    var blueAlpha = (0.06 + intensity * 0.30).ToString("0.00", ci);
                    var whiteAlpha = (0.55 - intensity * 0.25).ToString("0.00", ci);
                    var bg = $"linear-gradient(135deg, rgba(255,255,255,{whiteAlpha}), rgba(139,43,242,{purpleAlpha}) 55%, rgba(24,169,255,{blueAlpha}))";
                    <div class="heatmap-cell" style="background:@bg;" data-tip="@val @row.Label.ToLower() requests on @heatmapDays[d]"></div>
                }
            }
        </div>
    </div>

</div>

<div class="side-panels-row">

    <!-- ============ CAMPAIGN CATEGORY ORBIT ============ -->
    <div class="panel">
        <div class="panel-title">Campaign Category Orbit</div>

        @if (orbitTotal == 0)
        {
            <div class="empty-block">
                <div class="empty-title">No campaigns yet</div>
                <div class="empty-text">Category share will appear here once brands start creating campaigns.</div>
            </div>
        }

        <div class="orbit-panel-body" style="@(orbitTotal == 0 ? "display:none;" : "")">
            <div class="orbit-wrap">
                <svg class="orbit-svg" viewBox="0 0 220 220">
                    @{
                        var orbitArcMarkup = new System.Text.StringBuilder();
                        for (int i = 0; i < orbitArcs.Count; i++)
                        {
                            var arc = orbitArcs[i];
                            orbitArcMarkup.Append(System.Globalization.CultureInfo.InvariantCulture,
                                $"<path class=\"orbit-arc draw-anim\" pathLength=\"1\" style=\"animation-delay:{i * 0.1:0.00}s;\" d=\"{arc.Path}\" stroke=\"{arc.Color}\" data-tip=\"{arc.Label} {arc.Pct:0.#}%\"></path>");
                        }
                    }
                    @Html.Raw(orbitArcMarkup.ToString())
                </svg>
                <div class="orbit-center">
                    <div class="orbit-center-value">@orbitTotal.ToString("N0")</div>
                    <div class="orbit-center-label">Campaigns</div>
                </div>
            </div>

            <div class="orbit-legend">
                @foreach (var cat in orbitCategories)
                {
                    <span class="orbit-legend-item"><span class="orbit-legend-dot" style="background:@cat.Color;"></span>@cat.Label <b>@cat.Pct.ToString("0.#")%</b></span>
                }
            </div>
        </div>

        @if (orbitTotal > 0)
        {
            <div class="orbit-bars">
                @foreach (var cat in orbitCategories)
                {
                    <div class="orbit-bar-row">
                        <div class="orbit-bar-label">@cat.Label</div>
                        <div class="orbit-bar-track"><div class="orbit-bar-fill" style="width:@(cat.Pct)%; background:@cat.Color;"></div></div>
                        <div class="orbit-bar-pct">@cat.Pct.ToString("0.#")%</div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ============ PLATFORM ACTIVITY STREAM ============ -->
    <div class="panel">
        <div class="panel-title">Platform Activity Stream</div>
        <div class="panel-sub">Last 24 hours across the marketplace</div>

        <div class="stream-track">
            @{
                var streamMarkup = new System.Text.StringBuilder();
                if (streamEvents.Length > 0)
                {
                    var latestIdx = 0;
                    var minHourAgo = streamEvents.Min(e => e.HourAgo);
                    for (int i = 0; i < streamEvents.Length; i++)
                    {
                        if (streamEvents[i].HourAgo == minHourAgo) latestIdx = i;
                    }
                    for (int i = 0; i < streamEvents.Length; i++)
                    {
                        var ev = streamEvents[i];
                        var leftPct = Math.Round((24 - ev.HourAgo) / 24 * 100, 2);
                        var isLatest = i == latestIdx;
                        var tip = $"{ev.Label} &middot; {(ev.HourAgo < 1 ? "just now" : $"{ev.HourAgo:0.#}h ago")}";
                        streamMarkup.Append(System.Globalization.CultureInfo.InvariantCulture,
                            $"<a href=\"{ev.Url}\" class=\"stream-dot{(isLatest ? " is-latest" : "")}\" style=\"left:{leftPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%; background:{ev.Color}; color:{ev.Color};\" data-tip=\"{tip}\"></a>");
                    }
                }
            }
            @Html.Raw(streamMarkup.ToString())
        </div>
        @if (streamEvents.Length == 0)
        {
            <div class="panel-sub" style="margin-top:10px;">No platform activity in the last 24 hours.</div>
        }
        <div class="stream-axis">
            <span>24h ago</span>
            <span>18h</span>
            <span>12h</span>
            <span>6h</span>
            <span>Now</span>
        </div>

        <div class="stream-legend">
            <span class="stream-legend-item"><span class="stream-legend-dot" style="background:#8b2ff2;"></span>Signup</span>
            <span class="stream-legend-item"><span class="stream-legend-dot" style="background:#236eff;"></span>Campaign</span>
            <span class="stream-legend-item"><span class="stream-legend-dot" style="background:#18a9ff;"></span>Proof</span>
            <span class="stream-legend-item"><span class="stream-legend-dot" style="background:#0d9c6c;"></span>Payment</span>
            <span class="stream-legend-item"><span class="stream-legend-dot" style="background:#e34848;"></span>Dispute</span>
        </div>
    </div>

</div>

<!-- ============ TOP CAMPAIGN PERFORMANCE ============ -->
<div class="panel funnel-panel" id="perfPanel">
    <div class="panel-title">Top Campaign Performance</div>
    <div class="panel-sub">Ranked by completion this period</div>

    <div class="perf-rows">
        @if (topCampaigns.Length == 0)
        {
            <div class="empty-block">
                <div class="empty-title">No campaigns with milestones yet</div>
                <div class="empty-text">Once a campaign has collaborations with milestones, its completion ranking will show up here.</div>
            </div>
        }
        @foreach (var c in topCampaigns)
        {
            <div class="perf-row">
                <div class="perf-row-head">
                    <div><a class="perf-name" href="@c.Url">@c.Name</a><span class="perf-brand">@c.Brand</span></div>
                    <div class="perf-metrics">
                        <span>Reach <b title="Not tracked in the schema yet">&mdash;</b></span>
                        <span>Engagement <b title="Not tracked in the schema yet">&mdash;</b></span>
                        <span>Completion <b>@c.CompletionPct%</b></span>
                    </div>
                </div>
                <div class="perf-track"><div class="perf-fill" style="width:@(c.CompletionPct)%;"></div></div>
            </div>
        }
    </div>
</div>

<div class="side-panels-row">

    <div class="panel">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="panel-title">Recent Activity</div>
        </div>

        <div style="margin-top:8px;">
            @if (Model.RecentActivity.Count == 0)
            {
                <div class="empty-block">
                    <div class="empty-title">No activity yet</div>
                    <div class="empty-text">Verifications, proof reviews, disputes and payments will show up here as they happen.</div>
                </div>
            }
            @foreach (var a in Model.RecentActivity)
            {
                var iconClass = a.Category switch
                {
                    "Verification" => "purple bi-shield-check",
                    "Proof Review" => "blue bi-image-fill",
                    "Dispute" => "red bi-chat-left-text-fill",
                    "Payment" => "green bi-wallet2",
                    _ => "purple bi-bell-fill"
                };
                var iconColor = iconClass.Split(' ')[0];
                var iconGlyph = iconClass.Split(' ')[1];
                var elapsed = DateTime.UtcNow - a.CreatedAt;
                var timeLabel = elapsed.TotalMinutes < 1 ? "just now"
                    : elapsed.TotalMinutes < 60 ? $"{(int)elapsed.TotalMinutes} min ago"
                    : elapsed.TotalHours < 24 ? $"{(int)elapsed.TotalHours}h ago"
                    : $"{(int)elapsed.TotalDays}d ago";
                <a href="@a.Url" class="activity-row" style="text-decoration:none;">
                    <span class="activity-icon @iconColor"><i class="bi @iconGlyph"></i></span>
                    <div>
                        <div class="activity-title">@a.Title</div>
                        <div class="activity-sub">@a.Category &middot; @a.StatusLabel</div>
                    </div>
                    <span class="activity-time">@timeLabel</span>
                </a>
            }
        </div>
    </div>

    <div class="panel">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="panel-title">Ongoing Campaigns</div>
        </div>

        <div style="margin-top:8px;">
            @if (Model.OngoingCampaigns.Count == 0)
            {
                <div class="empty-block">
                    <div class="empty-title">No campaigns yet</div>
                    <div class="empty-text">Campaigns created by brands will appear here.</div>
                </div>
            }
            @foreach (var c in Model.OngoingCampaigns)
            {
                <a href="@c.Url" class="campaign-row" style="text-decoration:none;">
                    <div class="campaign-thumb"></div>
                    <div>
                        <div class="campaign-title">@c.Title &mdash; @c.Brand</div>
                        <div class="campaign-sub">
                            @c.InfluencerCount influencer@(c.InfluencerCount == 1 ? "" : "s")
                            @if (c.Deadline.HasValue)
                            {
                                @: &middot; ends @c.Deadline.Value.ToString("MMM d, yyyy")
                            }
                        </div>
                    </div>
                    <div class="campaign-meta"><span class="status-pill @c.StatusColor">@c.StatusLabel</span></div>
                </a>
            }
        </div>
    </div>

</div>

@section Scripts {
<script>
(function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Top Campaign Performance: animate fill once when scrolled into view ----
    var perfFills = document.querySelectorAll('#perfPanel .perf-fill');
    if (perfFills.length) {
        if (reduceMotion || !('IntersectionObserver' in window)) {
            perfFills.forEach(function (el) { el.classList.add('in-view'); });
        } else {
            var perfObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                        perfObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.4 });
            perfFills.forEach(function (el) { perfObserver.observe(el); });
        }
    }

    // ---- Count-up for Payment Flow total ----
    var pfTotalEl = document.getElementById('pfTotalValue');
    if (pfTotalEl) {
        var target = parseInt(pfTotalEl.getAttribute('data-target'), 10) || 0;
        if (reduceMotion) {
            pfTotalEl.textContent = '৳' + target.toLocaleString('en-US');
        } else {
            var start = null;
            var duration = 900;
            function step(ts) {
                if (!start) start = ts;
                var progress = Math.min((ts - start) / duration, 1);
                var eased = 1 - Math.pow(1 - progress, 3);
                var value = Math.round(target * eased);
                pfTotalEl.textContent = '৳' + value.toLocaleString('en-US');
                if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }
    }

    // ---- Shared tooltip helper ----
    function wireTooltip(wrapId, tooltipId, pointSelector, buildContent) {
        var wrap = document.getElementById(wrapId);
        var tooltip = document.getElementById(tooltipId);
        if (!wrap || !tooltip) return;

        wrap.querySelectorAll(pointSelector).forEach(function (pt) {
            pt.addEventListener('mouseenter', function () {
                pt.classList.add('is-hovered');
                tooltip.innerHTML = buildContent(pt);
                positionTooltip(wrap, tooltip, pt);
                tooltip.classList.add('is-visible');
            });
            pt.addEventListener('mouseleave', function () {
                pt.classList.remove('is-hovered');
                tooltip.classList.remove('is-visible');
            });
        });
    }

    function positionTooltip(wrap, tooltip, pt) {
        var svg = pt.ownerSVGElement;
        var pointRect = pt.getBoundingClientRect();
        var wrapRect = wrap.getBoundingClientRect();
        var left = pointRect.left - wrapRect.left + pointRect.width / 2;
        var top = pointRect.top - wrapRect.top;
        tooltip.style.left = left + 'px';
        tooltip.style.top = top + 'px';
    }

    wireTooltip('pfChartWrap', 'pfTooltip', '.chart-point', function (pt) {
        return '<div class="chart-tooltip-title">' + pt.getAttribute('data-month') + ' 2026</div>' +
            '<div class="chart-tooltip-row"><span>Revenue</span><b>' + pt.getAttribute('data-revenue') + '</b></div>' +
            '<div class="chart-tooltip-row"><span>Payments</span><b>' + pt.getAttribute('data-count') + '</b></div>' +
            '<div class="chart-tooltip-row"><span>Change</span><b>' + pt.getAttribute('data-change') + '</b></div>';
    });

    // ---- Brandora Pulse: legend highlight + vertical tracker ----
    var bpLegend = document.getElementById('bpLegend');
    var bpSvg = document.getElementById('bpSvg');
    if (bpLegend && bpSvg) {
        var lines = bpSvg.querySelectorAll('.pulse-line');
        bpLegend.querySelectorAll('.chart-legend-item').forEach(function (item) {
            item.addEventListener('mouseenter', function () {
                var series = item.getAttribute('data-series');
                lines.forEach(function (line) {
                    line.classList.toggle('is-active', line.getAttribute('data-series') === series);
                });
                bpLegend.querySelectorAll('.chart-legend-item').forEach(function (li) {
                    li.classList.toggle('is-active', li === item);
                });
            });
            item.addEventListener('mouseleave', function () {
                lines.forEach(function (line) { line.classList.remove('is-active'); });
                bpLegend.querySelectorAll('.chart-legend-item').forEach(function (li) { li.classList.add('is-active'); });
            });
        });
    }

    var bpMonths = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bpMonths));
    var bpUsers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bpUsers));
    var bpCampaigns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bpCampaigns));
    var bpCollabs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bpCollabs));

    var bpHit = document.getElementById('bpTrackerHit');
    var bpTracker = document.getElementById('bpTracker');
    var bpWrap = document.getElementById('bpChartWrap');
    var bpTooltip = document.getElementById('bpTooltip');

    if (bpHit && bpTracker && bpWrap && bpTooltip) {
        bpHit.addEventListener('mousemove', function (evt) {
            var pt = bpSvg.createSVGPoint();
            pt.x = evt.clientX; pt.y = evt.clientY;
            var svgPt = pt.matrixTransform(bpSvg.getScreenCTM().inverse());
            var stepX = 620 / (bpMonths.length - 1);
            var idx = Math.round((svgPt.x - 20) / stepX);
            idx = Math.max(0, Math.min(bpMonths.length - 1, idx));
            var x = 20 + idx * stepX;

            bpTracker.setAttribute('x1', x);
            bpTracker.setAttribute('x2', x);
            bpTracker.style.opacity = '1';

            bpTooltip.innerHTML =
                '<div class="chart-tooltip-title">' + bpMonths[idx] + ' 2026</div>' +
                '<div class="chart-tooltip-row"><span style="color:#a326ff;">New Users</span><b>' + bpUsers[idx] + '</b></div>' +
                '<div class="chart-tooltip-row"><span style="color:#236eff;">Campaigns</span><b>' + bpCampaigns[idx] + '</b></div>' +
                '<div class="chart-tooltip-row"><span style="color:#0d9c6c;">Collabs</span><b>' + bpCollabs[idx] + '</b></div>';

            var wrapRect = bpWrap.getBoundingClientRect();
            var svgRect = bpSvg.getBoundingClientRect();
            var scaleX = svgRect.width / 660;
            var left = (x * scaleX) + (svgRect.left - wrapRect.left);
            bpTooltip.style.left = left + 'px';
            bpTooltip.style.top = '20px';
            bpTooltip.classList.add('is-visible');
        });

        bpHit.addEventListener('mouseleave', function () {
            bpTracker.style.opacity = '0';
            bpTooltip.classList.remove('is-visible');
        });
    }
})();
</script>
}
