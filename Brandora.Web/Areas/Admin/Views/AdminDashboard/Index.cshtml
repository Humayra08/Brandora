@{
    string Sparkline(int[] series, string color) =>
        $"<svg class=\"kpi-sparkline\" viewBox=\"0 0 64 32\" preserveAspectRatio=\"none\"><path d=\"{BuildSparklinePath(series, 64, 32)}\" stroke=\"{color}\"></path></svg>";

    string Trend(decimal? pct, string period)
    {
        if (pct is null) return "<div class=\"kpi-trend\" style=\"color:#8189a8;\">No prior-period data yet</div>";
        var isUp = pct >= 0;
        var icon = isUp ? "bi-arrow-up-short" : "bi-arrow-down-short";
        var cls = isUp ? "up" : "down";
        var abs = Math.Abs(pct.Value);
        return $"<div class=\"kpi-trend {cls}\"><i class=\"bi {icon}\"></i> {abs.ToString("0.0")}% {period}</div>";
    }
}

