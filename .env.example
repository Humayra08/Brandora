ConnectionStrings__DefaultConnection="Host=YOUR-PROJECT.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR-PROJECT-REF;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"

# ADMIN_n_PASSWORD is a PBKDF2 hash, NOT plaintext, since 2026-09-17.
# Generate one locally: run the app in Development, visit
# /Admin/AdminAccount/HashPassword?password=YOUR_CHOSEN_PASSWORD, and paste the result below.
ADMIN_1_EMAIL=admin1@example.com
ADMIN_1_PASSWORD=PASTE_GENERATED_HASH_HERE
ADMIN_1_NAME="Admin 1"

ADMIN_2_EMAIL=admin2@example.com
ADMIN_2_PASSWORD=PASTE_GENERATED_HASH_HERE
ADMIN_2_NAME="Admin 2"

ADMIN_3_EMAIL=admin3@example.com
ADMIN_3_PASSWORD=PASTE_GENERATED_HASH_HERE
ADMIN_3_NAME="Admin 3"

ADMIN_4_EMAIL=admin4@example.com
ADMIN_4_PASSWORD=PASTE_GENERATED_HASH_HERE
ADMIN_4_NAME="Admin 4"

# Email (one shared sender for verification codes, password reset, approvals AND contact replies).
# Gmail: turn on 2-Step Verification, create an App Password, paste it with NO spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-brandora-gmail@gmail.com
SMTP_PASS=YOUR_16_CHAR_APP_PASSWORD
EMAIL_FROM_ADDRESS=your-brandora-gmail@gmail.com
EMAIL_FROM_NAME=Brandora
